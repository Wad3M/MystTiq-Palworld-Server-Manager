// MystTiq v1.0.0.0: file reviewed for this release (2026-09-30).
// v1.0.0.0: version information, so the signed DLL carries the same product name and version as the .NET binaries.
// Build-ConsoleProxy.ps1 writes MystTiqVersion.h (MYSTTIQ_VERSION_COMMA 1,0,0,0 and MYSTTIQ_VERSION_TEXT "1.0.0.0",
// from Directory.Build.props) into artifacts\native before compiling this file.
#include <winver.h>
#include "MystTiqVersion.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION MYSTTIQ_VERSION_COMMA
 PRODUCTVERSION MYSTTIQ_VERSION_COMMA
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "MystTiq Contributors"
            VALUE "FileDescription", "MystTiq console capture helper"
            VALUE "FileVersion", MYSTTIQ_VERSION_TEXT
            VALUE "InternalName", "MystTiqConsoleProxy"
            VALUE "LegalCopyright", "Copyright (c) 2026 MystTiq Contributors"
            VALUE "OriginalFilename", "MystTiqConsoleProxy.dll"
            VALUE "ProductName", "MystTiq Palworld Server Manager"
            VALUE "ProductVersion", MYSTTIQ_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
