<Project Sdk="Microsoft.NET.Sdk">
  <!-- v0.8.2.0: a stand-in for PalServer.exe in route smokes. The process name must be "PalServer" (the lifecycle
       service matches processes by name and path), so the assembly is named PalServer. Test use only. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PalServer</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
