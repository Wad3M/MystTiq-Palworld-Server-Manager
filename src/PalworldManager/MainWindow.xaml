  <TabItem Header="World Inspector">
   <TabItem.Resources>
    <Style TargetType="TabControl">
     <Setter Property="Background" Value="#0D1822"/><Setter Property="Foreground" Value="#DCE8F5"/><Setter Property="BorderBrush" Value="#263A50"/>
    </Style>
    <Style TargetType="TabItem">
     <Setter Property="Foreground" Value="#AFC9E8"/>
     <Setter Property="Background" Value="#111922"/>
     <Setter Property="BorderBrush" Value="#263A50"/>
     <Setter Property="Padding" Value="14,8"/>
     <Setter Property="Margin" Value="0,0,2,0"/>
     <Setter Property="Template">
