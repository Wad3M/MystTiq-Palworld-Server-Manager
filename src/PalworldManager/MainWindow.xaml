       <WrapPanel Grid.Row="2" Grid.ColumnSpan="2"><TextBlock Text="Players" Foreground="#9FC4EA" VerticalAlignment="Center"/><TextBox x:Name="SetupPlayersBox" Text="32" Width="55" Margin="6,0,14,0"/><TextBlock Text="Game Port" Foreground="#9FC4EA" VerticalAlignment="Center"/><TextBox x:Name="SetupPublicPortBox" Text="8211" Width="70" Margin="6,0,14,0"/><TextBlock Text="REST Port" Foreground="#9FC4EA" VerticalAlignment="Center"/><TextBox x:Name="SetupRestPortBox" Text="8212" Width="70" Margin="6,0,0,0"/></WrapPanel>
