        </Grid>
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,10,0,10">
         <Button Content="＋ ADD PLAYER" Style="{StaticResource ConfigPrimaryButton}" Click="AddPlayerToGuild_Click" ToolTip="Add Player."/>
         <Button Content="♛ TRANSFER LEADER" Style="{StaticResource DiagnosticButton}" Click="TransferGuildLeadership_Click" ToolTip="Transfer Leader."/>
         <Button Content="⚑ CLAIM ORPHAN" Style="{StaticResource SecondaryButton}" Click="ClaimOrphanedGuild_Click" ToolTip="Claim Orphan."/>
         <Button Content="⚒ REPAIR MAPPINGS" Style="{StaticResource WarningButton}" Click="RepairGuildMappings_Click" ToolTip="Repair Mappings."/>
         <Button Content="✓ APPLY REPAIR" Style="{StaticResource SuccessButton}" Click="ApplyGuildRepair_Click" ToolTip="Apply Repair."/>
        </UniformGrid>
        <Grid Grid.Row="2">
