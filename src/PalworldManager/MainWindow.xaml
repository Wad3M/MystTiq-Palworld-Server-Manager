      <TextBlock x:Name="BackupsStatusText" Text="Backup status: Ready" Foreground="#9FC4EA" TextWrapping="Wrap"/>
     </Border>

     <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DataGrid x:Name="BackupsGrid" Grid.Column="0" IsReadOnly="True" AutoGenerateColumns="False" SelectionMode="Single" MinHeight="360">
       <DataGrid.Columns>
        <DataGridTextColumn Header="Created" Binding="{Binding Created}" Width="150"/>
        <DataGridTextColumn Header="Size (MB)" Binding="{Binding SizeMb}" Width="90"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
        <DataGridTextColumn Header="Verified" Binding="{Binding VerifiedAt}" Width="150"/>
        <DataGridTextColumn Header="Archive" Binding="{Binding FilePath}" Width="*"/>
       </DataGrid.Columns>
      </DataGrid>
      <StackPanel Grid.Column="1" Margin="10,0,0,0">
       <Border Background="#111922" BorderBrush="#263A50" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,10">
        <StackPanel><TextBlock Text="RETENTION POLICY" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="BackupCenterPolicyText" Text="—" Foreground="#9FC4EA" TextWrapping="Wrap" Margin="0,6,0,10"/><WrapPanel><Button Content="👁  PREVIEW CLEANUP" Style="{StaticResource InfoButton}" Click="BackupCenterPreviewRetention_Click" ToolTip="Preview Cleanup."/><Button Content="✓  APPLY CLEANUP" Style="{StaticResource SuccessButton}" Click="BackupCenterApplyRetention_Click" ToolTip="Apply Cleanup."/></WrapPanel><TextBlock x:Name="BackupCenterPreviewText" Text="No cleanup preview generated." Foreground="#91A3B8" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
       </Border>
       <Border Background="#111922" BorderBrush="#263A50" BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel><TextBlock Text="BACKUP LOCATIONS" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock Text="Server backups are restorable snapshots. World archives, repair backups, and mod snapshots are tracked separately and are never deleted by server-backup retention." Foreground="#9FC4EA" TextWrapping="Wrap" Margin="0,6,0,10"/><Button Content="📂  OPEN BACKUP ROOT" Style="{StaticResource InfoButton}" Click="BackupCenterOpenFolder_Click" ToolTip="Open Backup Root."/></StackPanel>
       </Border>
      </StackPanel>
     </Grid>
    </StackPanel>
   </ScrollViewer>
  </TabItem>
  <TabItem Header="MOD Dashboard">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ScrollViewer.Resources>
     <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBar}"/>
    </ScrollViewer.Resources>
    <StackPanel Margin="18">
     <Border Style="{StaticResource SectionBanner}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="MOD Dashboard" FontSize="28" FontWeight="Bold" Foreground="White"/><TextBlock Text="Confirm that server mods are installed, enabled, and ready for runtime verification." Foreground="#9FC4EA" FontSize="15" Margin="0,5,20,0"/></StackPanel>
       <WrapPanel Grid.Column="1" Style="{StaticResource ModActionWrapPanel}"><Button Content="✓  VERIFY &amp; SCAN ALL MODS" Style="{StaticResource RefreshButton}" Click="VerifyAllMods_Click" ToolTip="Runs the authoritative MOD workflow: inventory, verification, compatibility, dependencies, runtime evidence, health, Dashboard, Library, and notifications."/></WrapPanel>
      </Grid>
     </Border>

     <UniformGrid Columns="6" Margin="0,0,0,12">
      <Border Background="#111922" BorderBrush="#263A50" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0"><StackPanel><TextBlock Text="INSTALLED" Foreground="#7FA8CE" FontWeight="Bold"/><TextBlock x:Name="ModDashInstalled" Text="0" Foreground="White" FontSize="28" FontWeight="Bold"/><TextBlock Text="Detected" Foreground="#9FC4EA"/></StackPanel></Border>
      <Border Background="#111922" BorderBrush="#263A50" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0"><StackPanel><TextBlock Text="HEALTHY" Foreground="#7FA8CE" FontWeight="Bold"/><TextBlock x:Name="ModDashHealthy" Text="0" Foreground="#54D98C" FontSize="28" FontWeight="Bold"/><TextBlock Text="Runtime verified" Foreground="#9FC4EA"/></StackPanel></Border>
      <Border Background="#111922" BorderBrush="#263A50" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0"><StackPanel><TextBlock Text="UPDATES" Foreground="#7FA8CE" FontWeight="Bold"/><TextBlock x:Name="ModDashUpdates" Text="0" Foreground="#64B5F6" FontSize="28" FontWeight="Bold"/><TextBlock Text="Local source newer" Foreground="#9FC4EA"/></StackPanel></Border>
      <Border Background="#111922" BorderBrush="#263A50" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0"><StackPanel><TextBlock Text="CONFLICTS" Foreground="#7FA8CE" FontWeight="Bold"/><TextBlock x:Name="ModDashConflicts" Text="0" Foreground="#F0B44D" FontSize="28" FontWeight="Bold"/><TextBlock Text="Confirmed" Foreground="#9FC4EA"/></StackPanel></Border>
      <Border Background="#111922" BorderBrush="#263A50" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,6,0"><StackPanel><TextBlock Text="DEPENDENCIES" Foreground="#7FA8CE" FontWeight="Bold"/><TextBlock x:Name="ModDashDependencies" Text="0" Foreground="#F0B44D" FontSize="28" FontWeight="Bold"/><TextBlock Text="Missing" Foreground="#9FC4EA"/></StackPanel></Border>
      <Border Background="#111922" BorderBrush="#263A50" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel><TextBlock Text="FAILED" Foreground="#7FA8CE" FontWeight="Bold"/><TextBlock x:Name="ModDashFailed" Text="0" Foreground="#E06A6A" FontSize="28" FontWeight="Bold"/><TextBlock Text="Verification" Foreground="#9FC4EA"/></StackPanel></Border>
     </UniformGrid>

     <Border x:Name="ModDashHealthBanner" Background="#173A2A" BorderBrush="#2D7E55" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="MOD HEALTH" Foreground="#7FA8CE" FontWeight="Bold"/><TextBlock x:Name="ModDashHealthText" Text="No mods detected" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,3,0,0"/><TextBlock x:Name="ModDashHealthDetails" Text="Install mods from the MOD Library to begin verification." Foreground="#C9D9E8" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel><TextBlock Grid.Column="1" x:Name="ModDashScore" Text="—" Foreground="#54D98C" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="20,0,4,0"/></Grid>
     </Border>

     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#111922" BorderBrush="#263A50" BorderThickness="1" CornerRadius="8" Padding="14">
       <DockPanel>
        <StackPanel DockPanel.Dock="Top"><TextBlock Text="INSTALLED MODS" Foreground="White" FontSize="16" FontWeight="Bold"/><TextBlock x:Name="ModDashLastVerified" Text="Last Scan: Never  •  Duration: —  •  One Scan" Foreground="#7FA8CE" Margin="0,3,0,10"/></StackPanel>
        <DataGrid x:Name="ModDashboardGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="ModDashboardGrid_SelectionChanged">
         <DataGrid.Columns>
          <DataGridTextColumn Header="MOD" Binding="{Binding Name}" Width="2*"/>
          <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="125"/>
          <DataGridTextColumn Header="STATUS" Binding="{Binding Health}" Width="105"/>
          <DataGridTextColumn Header="HEALTH" Binding="{Binding ScoreDisplay}" Width="75"/>
         </DataGrid.Columns>
        </DataGrid>
       </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="#111922" BorderBrush="#263A50" BorderThickness="1" CornerRadius="8" Padding="16">
       <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ScrollViewer.Resources>
         <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBar}"/>
        </ScrollViewer.Resources>
        <StackPanel>
         <TextBlock Text="MOD DETAILS" Foreground="#7FA8CE" FontWeight="Bold"/>
         <TextBlock x:Name="ModDetailName" Text="Select a mod" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,3,0,0"/>
         <TextBlock x:Name="ModDetailType" Text="" Foreground="#9FC4EA" Margin="0,2,0,14"/>
         <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="OVERALL HEALTH" Foreground="#7FA8CE" FontWeight="Bold"/><TextBlock x:Name="ModDetailHealth" Text="—" Foreground="#F0B44D" FontSize="18" FontWeight="Bold"/></StackPanel><TextBlock Grid.Column="1" x:Name="ModDetailScore" Text="—" Foreground="#54D98C" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/></Grid>
         <TextBlock Text="INSTALLATION" Foreground="#64B5F6" FontWeight="Bold" Margin="0,4,0,4"/>
         <TextBlock x:Name="ModDetailInstallation" Foreground="#DCE6F2" TextWrapping="Wrap"/>
         <TextBlock Text="RUNTIME" Foreground="#64B5F6" FontWeight="Bold" Margin="0,12,0,4"/>
         <TextBlock x:Name="ModDetailRuntime" Foreground="#DCE6F2" TextWrapping="Wrap"/>
         <TextBlock Text="COMPATIBILITY" Foreground="#64B5F6" FontWeight="Bold" Margin="0,12,0,4"/>
         <TextBlock x:Name="ModDetailCompatibility" Foreground="#DCE6F2" TextWrapping="Wrap"/>
         <TextBlock Text="DETAILS / EVIDENCE" Foreground="#64B5F6" FontWeight="Bold" Margin="0,12,0,4"/>
         <TextBlock x:Name="ModDetailEvidence" Text="Select a mod to view verification evidence." Foreground="#C9D9E8" TextWrapping="Wrap"/>
         <WrapPanel Margin="0,11,0,0"><Button Content="✓  VERIFY SELECTED" Style="{StaticResource RefreshButton}" Click="VerifySelectedMod_Click" ToolTip="Verifies the selected mod installation and runtime requirements. A successful result does not guarantee stability."/><Button Content="📂  OPEN MODS FOLDER" Style="{StaticResource InfoButton}" Click="OpenModsRoot_Click" ToolTip="Opens the managed Palworld mods folder in File Explorer."/></WrapPanel>
        </StackPanel>
       </ScrollViewer>
      </Border>
     </Grid>
    </StackPanel>
   </ScrollViewer>
  </TabItem>
  <TabItem Header="MOD Library">
   <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
     <Border Style="{StaticResource SectionBanner}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="MOD Library" FontSize="28" FontWeight="Bold" Foreground="White"/><TextBlock Text="Install, organize, update, enable, and remove server mods from one library." Foreground="#9FC4EA" FontSize="15" Margin="0,5,20,0"/></StackPanel>
       <WrapPanel Grid.Column="1" Style="{StaticResource ModActionWrapPanel}"><Button Content="＋  INSTALL MOD ZIP" Style="{StaticResource ModWarningButton}" Click="BrowseModZip_Click" ToolTip="Installs a mod package from ZIP, RAR, or 7Z using the Smart MOD installer."/></WrapPanel>
      </Grid>
     </Border>
     <Border Background="#0D151E" BorderBrush="#263A50" BorderThickness="1" CornerRadius="6" Padding="10,7" Margin="0,0,0,10"><TextBlock Text="Installed mods are scanned automatically and compared with the local Steam Workshop copy. Multiple option folders are grouped beneath one Workshop item instead of being displayed as unrelated mods." Foreground="#9FC4EA" TextWrapping="Wrap"/></Border>
    </StackPanel>
    <Grid>
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1.05*"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="1.05*"/>
      <ColumnDefinition Width="12"/>
      <ColumnDefinition Width="0.9*"/>
     </Grid.ColumnDefinitions>

     <DockPanel Grid.Column="0">
      <StackPanel DockPanel.Dock="Top">
       <StackPanel Margin="0,0,0,8">
        <TextBlock Text="INSTALLED SERVER MODS" Foreground="White" FontWeight="Bold" FontSize="16"/>
        <TextBlock x:Name="ModLibrarySummaryText" Text="Installed: 0  •  Enabled: 0  •  Disabled: 0" Foreground="#7FA8CE" Margin="0,3,0,8"/>
        <UniformGrid Columns="3" Rows="2" HorizontalAlignment="Stretch">
         <Button Content="▶  ENABLE SELECTED" MinHeight="32" Margin="2" Style="{StaticResource ModSuccessButton}" Click="EnableSelectedMod_Click" ToolTip="Enables the selected managed mod."/>
         <Button Content="▶  ENABLE ALL" MinHeight="32" Margin="2" Style="{StaticResource ModSuccessButton}" Click="EnableAllMods_Click" ToolTip="Enables all discovered mods without reinstalling them."/>
         <Button Content="■  DISABLE SELECTED" MinHeight="32" Margin="2" Style="{StaticResource ModWarningButton}" Click="DisableSelectedMod_Click" ToolTip="Disables the selected managed mod without deleting its files."/>
         <Button Content="■  DISABLE ALL" MinHeight="32" Margin="2" Style="{StaticResource ModWarningButton}" Click="DisableAllMods_Click" ToolTip="Disables all managed user mods. Installed files are preserved."/>
         <Button Content="🔧  REPAIR STATES" MinHeight="32" Margin="2" Style="{StaticResource DiagnosticButton}" Click="RepairModStates_Click" ToolTip="Repairs enabled flags, deployment, manifests, and orphan states without reinstalling or updating."/>
         <Button Content="🗑  DELETE SELECTED" MinHeight="32" Margin="2" Style="{StaticResource DangerButton}" Click="DeleteMod_Click" ToolTip="Deletes the selected managed mod after confirmation."/>
        </UniformGrid>
       </StackPanel>
      </StackPanel>
      <DataGrid x:Name="ModsGrid" IsReadOnly="False" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="ModsGrid_SelectionChanged">
       <DataGrid.Columns>
        <DataGridCheckBoxColumn Header="ON" Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}" Width="52"/>
        <DataGridTextColumn Header="MOD" Binding="{Binding Name}" Width="2*" IsReadOnly="True"/>
        <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="105" IsReadOnly="True"/>
        <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="90" IsReadOnly="True"/>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>

     <DockPanel Grid.Column="2">
      <Grid DockPanel.Dock="Top" Margin="0,0,0,6" MinHeight="48">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock Text="AVAILABLE LOCAL STEAM&#10;MODS" Foreground="White" FontWeight="Bold" FontSize="16" LineHeight="18" TextWrapping="Wrap" VerticalAlignment="Center"/>
       <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Button Content="↻  REFRESH" Style="{StaticResource RefreshButton}" Click="RefreshLocalSteamMods_Click" ToolTip="Rescans local Steam Workshop mods and refreshes both the local and managed mod lists."/>
        <Button Content="⇩  IMPORT SELECTED" Style="{StaticResource ModDiagnosticButton}" Click="ImportLocalMod_Click" ToolTip="Imports the selected locally discovered Steam/Workshop mod into the dedicated server."/>
       </WrapPanel>
      </Grid>
      <DataGrid x:Name="LocalModsGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="LocalModsGrid_SelectionChanged">
       <DataGrid.Columns>
        <DataGridTextColumn Header="MOD / GROUP" Binding="{Binding Name}" Width="2*"/>
        <DataGridTextColumn Header="WORKSHOP ID" Binding="{Binding WorkshopId}" Width="110"/>
        <DataGridTextColumn Header="OPTIONS" Binding="{Binding Variants}" Width="125"/>
        <DataGridTemplateColumn Header="STATUS" Width="135">
         <DataGridTemplateColumn.CellTemplate><DataTemplate>
          <Border x:Name="ModUpdateBadge" CornerRadius="4" Padding="7,3" Background="#465568"><TextBlock Text="{Binding UpdateStatus}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center"/></Border>
          <DataTemplate.Triggers>
           <DataTrigger Binding="{Binding UpdateStatus}" Value="CURRENT"><Setter TargetName="ModUpdateBadge" Property="Background" Value="#1F8B4C"/></DataTrigger>
           <DataTrigger Binding="{Binding UpdateStatus}" Value="UPDATE AVAILABLE"><Setter TargetName="ModUpdateBadge" Property="Background" Value="#B37A18"/></DataTrigger>
          </DataTemplate.Triggers>
         </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
       </DataGrid.Columns>
      </DataGrid>
     </DockPanel>

     <Border Grid.Column="4" Background="#111922" BorderBrush="#263A50" BorderThickness="1" CornerRadius="8" Padding="16">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBar}"/></ScrollViewer.Resources>
       <StackPanel>
        <TextBlock Text="MOD INFORMATION" Foreground="White" FontWeight="Bold" FontSize="16" Margin="0,0,0,12"/>
        <TextBlock x:Name="ModInfoName" Text="Select a mod" Foreground="#64B5F6" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap"/>
        <TextBlock x:Name="ModInfoSource" Text="Choose an installed or Steam mod to view details." Foreground="#9FC4EA" Margin="0,4,0,14" TextWrapping="Wrap"/>
        <Border x:Name="ModHealthBanner" Background="#465568" CornerRadius="6" Padding="10,7" Margin="0,0,0,12">
         <TextBlock x:Name="ModHealthText" Text="SELECT A MOD" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </Border>
        <TextBlock Text="STATUS" Foreground="#7FA8CE" FontWeight="Bold"/>
        <TextBlock x:Name="ModInfoStatus" Text="—" Foreground="White" Margin="0,3,0,12" TextWrapping="Wrap"/>
        <TextBlock Text="COMPATIBILITY" Foreground="#7FA8CE" FontWeight="Bold"/>
        <TextBlock x:Name="ModInfoCompatibility" Text="Compatibility has not been checked." Foreground="#DCEBFA" Margin="0,3,0,12" TextWrapping="Wrap"/>
        <TextBlock Text="VERSION / UPDATED" Foreground="#7FA8CE" FontWeight="Bold"/>
        <TextBlock x:Name="ModInfoVersion" Text="—" Foreground="White" Margin="0,3,0,12" TextWrapping="Wrap"/>
        <TextBlock Text="AUTHOR" Foreground="#7FA8CE" FontWeight="Bold"/>
        <TextBlock x:Name="ModInfoAuthor" Text="—" Foreground="White" Margin="0,3,0,12" TextWrapping="Wrap"/>
        <TextBlock Text="DESCRIPTION" Foreground="#7FA8CE" FontWeight="Bold"/>
        <TextBlock x:Name="ModInfoDescription" Text="No mod selected." Foreground="#DCEBFA" Margin="0,5,0,14" TextWrapping="Wrap"/>
        <TextBlock Text="DETAILS" Foreground="#7FA8CE" FontWeight="Bold"/>
        <TextBlock x:Name="ModInfoDetails" Text="—" Foreground="#DCEBFA" Margin="0,5,0,14" TextWrapping="Wrap"/>
        <TextBlock Text="ONLINE INFORMATION" Foreground="#7FA8CE" FontWeight="Bold"/>
        <TextBlock x:Name="ModInfoOnlineStatus" Text="Select a Steam Workshop mod to retrieve current information." Foreground="#9FC4EA" Margin="0,5,0,14" TextWrapping="Wrap"/>
        <WrapPanel>
         <Button Content="↻  REFRESH INFO" Style="{StaticResource RefreshButton}" Click="RefreshSelectedModInfo_Click" ToolTip="Refreshes detected metadata and status for the selected mod."/>
         <Button Content="⌕  SEARCH ONLINE" Style="{StaticResource InfoButton}" Click="SearchSelectedModOnline_Click" ToolTip="Searches online for information about the selected mod."/>
         <Button Content="📂  OPEN FOLDER" Style="{StaticResource InfoButton}" Click="OpenSelectedModFolder_Click" ToolTip="Opens the selected mod installation folder."/>
         <Button Content="↗  OPEN WORKSHOP" Style="{StaticResource InfoButton}" Click="OpenSelectedWorkshop_Click" ToolTip="Opens the selected mod Workshop page when a Workshop ID is known."/>
        </WrapPanel>
       </StackPanel>
      </ScrollViewer>
     </Border>
    </Grid>
   </DockPanel>
  </TabItem>
  <TabItem Header="Settings">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="18">
     <Border Style="{StaticResource SectionBanner}">
      <Grid>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="Manager Settings" FontSize="28" FontWeight="Bold" Foreground="White"/>
        <TextBlock Text="Configure server paths, REST API access, credentials, and launch arguments." Foreground="#9FC4EA" FontSize="15" Margin="0,5,20,0"/>
       </StackPanel>
      </Grid>
     </Border>
     <Border Background="#0D1822" BorderBrush="#263A50" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,12">
      <TextBlock x:Name="SettingsStatusText" Text="Settings are ready." Foreground="#9FC4EA" FontSize="13" TextWrapping="Wrap"/>
     </Border>
    <Border Background="#111922" BorderBrush="#273344" BorderThickness="1" CornerRadius="9" Padding="16,13" Margin="0,0,0,12">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
       <TextBlock Text="Automation" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
       <TextBlock Text="Optional scheduled maintenance and guarded crash recovery." Foreground="#91A3B8" Margin="0,3,24,0" TextWrapping="Wrap"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
       <CheckBox x:Name="ScheduledRestartCheck" Content="Daily restart" Foreground="White" VerticalAlignment="Center" Margin="0,0,14,0" Checked="ScheduledRestartCheck_Changed" Unchecked="ScheduledRestartCheck_Changed"/>
       <TextBlock Text="Time" Foreground="#DCE8F5" VerticalAlignment="Center" Margin="0,0,6,0"/>
       <TextBox x:Name="ScheduledRestartTimeBox" Width="72" Height="32" Text="04:00" VerticalContentAlignment="Center" Margin="0,0,16,0"/>
       <CheckBox x:Name="AutoCrashRecoveryCheck" Content="Crash recovery" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,0"/>
       <Button Content="✓  SAVE AUTOMATION" Style="{StaticResource ConfigPrimaryButton}" MinWidth="172" Height="34" Padding="16,7" Margin="0" Click="SaveAutomation_Click" ToolTip="Saves scheduled restart and crash-recovery settings."/>
      </StackPanel>
     </Grid>
    </Border>
    <Border Background="#111922" BorderBrush="#273344" BorderThickness="1" CornerRadius="9" Padding="16" Margin="0,0,0,12">
     <StackPanel>
      <TextBlock Text="Advanced" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
      <TextBlock Text="Compatibility options for features being retired or relocated." Foreground="#91A3B8" Margin="0,3,0,10"/>
      <TextBlock Text="Deprecated pages are hidden by default. Enable this only when you need a legacy workflow that has not yet been relocated." Foreground="#E6C56B" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0"/>
     </StackPanel>
    </Border>
    <Border Padding="22" Background="#111922" BorderBrush="#273344" BorderThickness="1" CornerRadius="9">
     <Grid>
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="210"/>
       <ColumnDefinition Width="*"/>
       <ColumnDefinition Width="140"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.ColumnSpan="3" Text="Paths and Connection" FontSize="20" FontWeight="SemiBold" Margin="5,0,5,18" Foreground="#DCEBFA"/>

      <TextBlock Grid.Row="1" Text="Server root" Margin="5" VerticalAlignment="Center"/>
      <TextBox x:Name="ServerRootBox" Grid.Row="1" Grid.Column="1" Margin="5"/>
      <Button Grid.Row="1" Grid.Column="2" Content="⌕  BROWSE" Margin="8,5,5,5" MinWidth="0" Width="126" Padding="12,10" HorizontalAlignment="Right" Click="BrowseServerRoot_Click" ToolTip="Selects the Palworld dedicated-server root folder." Style="{StaticResource InfoButton}"/>

      <TextBlock Grid.Row="2" Text="SteamCMD path" Margin="5" VerticalAlignment="Center"/>
      <TextBox x:Name="SteamCmdBox" Grid.Row="2" Grid.Column="1" Margin="5"/>
      <Button Grid.Row="2" Grid.Column="2" Content="⌕  BROWSE" Margin="8,5,5,5" MinWidth="0" Width="126" Padding="12,10" HorizontalAlignment="Right" Click="BrowseSteamCmd_Click" ToolTip="Selects the SteamCMD installation folder." Style="{StaticResource InfoButton}"/>

      <TextBlock Grid.Row="3" Text="Backup root" Margin="5" VerticalAlignment="Center"/>
      <TextBox x:Name="BackupRootBox" Grid.Row="3" Grid.Column="1" Margin="5"/>
      <Button Grid.Row="3" Grid.Column="2" Content="⌕  BROWSE" Margin="8,5,5,5" MinWidth="0" Width="126" Padding="12,10" HorizontalAlignment="Right" Click="BrowseBackupRoot_Click" ToolTip="Selects the folder used for MystTiq server backups." Style="{StaticResource InfoButton}"/>

      <TextBlock Grid.Row="4" Text="REST API URL" Margin="5" VerticalAlignment="Center"/>
      <TextBox x:Name="ApiUrlBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Margin="5"/>

      <TextBlock Grid.Row="5" Text="REST API user" Margin="5" VerticalAlignment="Center"/>
      <TextBox x:Name="ApiUserBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Margin="5"/>

      <TextBlock Grid.Row="6" Text="REST API password" Margin="5" VerticalAlignment="Center"/>
      <Grid Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Margin="5">
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="44"/>
       </Grid.ColumnDefinitions>

       <PasswordBox x:Name="ApiPasswordBox" Grid.Column="0" Padding="8" PasswordChanged="ApiPasswordBox_PasswordChanged"/>

       <TextBox x:Name="ApiPasswordVisibleBox" Grid.Column="0" Padding="8" Visibility="Collapsed" TextChanged="ApiPasswordVisibleBox_TextChanged"/>

       <ToggleButton x:Name="PasswordVisibilityToggle" Grid.Column="1" Margin="5,0,0,0" Content="👁" FontSize="17" ToolTip="Show or hide the REST API password" Checked="PasswordVisibilityToggle_Checked" Unchecked="PasswordVisibilityToggle_Unchecked"/>
