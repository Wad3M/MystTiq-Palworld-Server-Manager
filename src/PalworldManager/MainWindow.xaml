        <Border Background="#111922" BorderBrush="#2A394B" BorderThickness="1" CornerRadius="8" Padding="9"><StackPanel><TextBlock Text="SAVE FILES" Foreground="#7FA8CE" FontSize="10"/><TextBlock x:Name="PlayerSaveCountText" Text="0" Foreground="White" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
       </UniformGrid>
       <TextBlock x:Name="PlayerBannedCountText" Visibility="Collapsed"/><TextBlock x:Name="PlayerFilteredCountText" Visibility="Collapsed"/><TextBlock x:Name="PlayerPlatformCountText" Visibility="Collapsed"/>
       <Border Background="#111922" BorderBrush="#2A394B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
        <StackPanel><DockPanel><TextBlock Text="SELECTED PLAYER" Foreground="#9FC4EA" FontWeight="Bold"/><TextBlock x:Name="PlayerHealthText" DockPanel.Dock="Right" Text="—" Foreground="#79D89B" FontWeight="Bold"/></DockPanel><TextBlock x:Name="PlayerDetailText" Text="Select a player." Foreground="#DCE8F5" TextWrapping="Wrap" Margin="0,8,0,0"/><TextBlock x:Name="PlayerIdentityText" Text="" Foreground="#AFC9E8" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel>
       </Border>
       <Border Background="#111922" BorderBrush="#2A394B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
        <StackPanel>
         <DockPanel Margin="0,0,0,8"><TextBlock Text="PLAYER TOOLKIT" Foreground="#9FC4EA" FontWeight="Bold"/><TextBlock x:Name="PlayerToolkitHealthText" DockPanel.Dock="Right" Text="Not analyzed" Foreground="#79D89B" FontWeight="Bold"/></DockPanel>
         <TextBlock x:Name="PlayerToolkitSummaryText" Text="Analyze the selected player to review save, identity, mapping, duplicate, and discovery health." Foreground="#DCE8F5" TextWrapping="Wrap" Margin="0,0,0,8"/>
