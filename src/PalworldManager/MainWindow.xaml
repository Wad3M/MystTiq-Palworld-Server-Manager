        <Grid Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,22,0" Panel.ZIndex="90">
            <Grid>
                <Button x:Name="NotificationBellButton" Width="42" Height="38" Padding="0" Visibility="Collapsed"
