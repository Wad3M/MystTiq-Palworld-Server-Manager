<?xml version='1.0' encoding='UTF-8'?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="PalworldManager.MainWindow" Title="MystTiq Palworld Server Manager" Width="1680" Height="1000" MinWidth="1280" MinHeight="800" WindowStartupLocation="CenterScreen" Icon="/Assets/PalworldServerManager.ico">

    <Window.Resources>
        <!-- v2.10.6: standard icon treatment for buttons whose labels are supplied by data binding. -->
        <DataTemplate x:Key="DynamicActionButtonTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚙" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding}" VerticalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="SidebarSectionExpander" TargetType="Expander">
            <Setter Property="Foreground" Value="#8FA5BC"/>
            <Setter Property="Margin" Value="10,5,10,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite" Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Foreground="#8FA5BC" HorizontalContentAlignment="Stretch" Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBorder" Background="#0E1721" BorderBrush="#213449" BorderThickness="1" CornerRadius="6" Padding="8,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="Chevron" Text="▶" Foreground="#64B5F6" FontSize="11" VerticalAlignment="Center"/>
                                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Text" Value="▼"/><Setter TargetName="HeaderBorder" Property="Background" Value="#132232"/><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="#2A557D"/></Trigger>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="#17283A"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" ContentSource="Content"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarNavigationButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#AEBBD0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,2"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="9,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="NavigationBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border x:Name="SelectionBar" Grid.Column="0" Background="Transparent" CornerRadius="4,0,0,4"/>

                                <ContentPresenter Grid.Column="1" Margin="{TemplateBinding Padding}" HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="NavigationBorder" Property="Background" Value="#172332"/>
                                <Setter Property="Foreground" Value="#F5F8FC"/>
                            </Trigger>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="NavigationBorder" Property="Background" Value="#153A62"/>
                                <Setter TargetName="NavigationBorder" Property="BorderBrush" Value="#238DFF"/>
                                <Setter TargetName="SelectionBar" Property="Background" Value="#2C9BFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark application scrollbar used by the live log and other internal viewers. -->
        <Style x:Key="DarkScrollBarThumb" TargetType="Thumb">
            <Setter Property="Background" Value="#2B6FAF"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="{TemplateBinding Background}" CornerRadius="5" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#359BFF"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#64B6FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkVerticalScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="13"/>
            <Setter Property="Background" Value="#0B1119"/>
            <Setter Property="Foreground" Value="#2B6FAF"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkHorizontalScrollBar" TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBar}">
            <Setter Property="Height" Value="13"/>
            <Setter Property="Width" Value="Auto"/>
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" Orientation="Horizontal" Focusable="False">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Global scrollbar theme. Every ScrollViewer/DataGrid/TextBox scrollbar inherits the MystTiq dark theme. -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBar}">
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="13"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="{TemplateBinding Background}">
                                    <Track x:Name="PART_Track" Orientation="Horizontal" Focusable="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Applied only inside log text boxes through local resources. -->
        <Style x:Key="LogViewerTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#0B1119"/>
            <Setter Property="Foreground" Value="#6BE178"/>
            <Setter Property="BorderBrush" Value="#2A394B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}">
                                <ScrollViewer.Resources>
                                    <!--
                                      A control cannot set its own Style property from a
                                      Style trigger. Instead, this implicit style switches
                                      the scrollbar's dimensions and Template directly.
                                    -->
                                    <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBar}">
                                        <Style.Triggers>
                                            <Trigger Property="Orientation" Value="Horizontal">
                                                <Setter Property="Width" Value="Auto"/>
                                                <Setter Property="Height" Value="13"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ScrollBar">
                                                            <Grid Background="{TemplateBinding Background}">
                                                                <Track x:Name="PART_Track" Orientation="Horizontal" Focusable="False">
                                                                    <Track.DecreaseRepeatButton>
                                                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/>
                                                                    </Track.DecreaseRepeatButton>
                                                                    <Track.Thumb>
                                                                        <Thumb Style="{StaticResource DarkScrollBarThumb}"/>
                                                                    </Track.Thumb>
                                                                    <Track.IncreaseRepeatButton>
                                                                        <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/>
                                                                    </Track.IncreaseRepeatButton>
                                                                </Track>
                                                            </Grid>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ScrollViewer.Resources>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#101A25"/>
            <Setter Property="Foreground" Value="#EAF3FC"/>
            <Setter Property="BorderBrush" Value="#2B6FAF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="MaxWidth" Value="430"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}" MaxWidth="430">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" TextWrapping="Wrap" LineHeight="18"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfigPrimaryButton" TargetType="Button">
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
            <Setter Property="ToolTipService.ShowDuration" Value="18000"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="22,12"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="150"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#42A5FF"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2C9BFF" Offset="0"/>
                        <GradientStop Color="#1677D2" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Border x:Name="Glow" Background="#22FFFFFF" CornerRadius="5" Opacity="0"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="1"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#84CAFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                    <Setter.Value><TranslateTransform Y="1"/></Setter.Value>
                                </Setter>
                                <Setter TargetName="Glow" Property="Opacity" Value="0.5"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ConfigSecondaryButton" TargetType="Button" BasedOn="{StaticResource ConfigPrimaryButton}">
            <Setter Property="BorderBrush" Value="#647A94"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#26384C" Offset="0"/>
                        <GradientStop Color="#172638" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Unified application button styling. Individual buttons may override Background/BorderBrush for warning actions. -->
        <Style x:Key="AppButton" TargetType="Button" BasedOn="{StaticResource ConfigPrimaryButton}">
            <Setter Property="MinWidth" Value="112"/>
            <Setter Property="Padding" Value="17,10"/>
            <Setter Property="Margin" Value="7,0,0,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="Button" BasedOn="{StaticResource AppButton}"/>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="BorderBrush" Value="#F05B57"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E34B47" Offset="0"/>
                        <GradientStop Color="#A92D2A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="BorderBrush" Value="#56D987"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#35C975" Offset="0"/>
                        <GradientStop Color="#18864A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- v2.10.7 semantic action styles. New buttons must use one approved style. -->
        <Style x:Key="RefreshButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4DAF72"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#197347" Offset="0"/>
                        <GradientStop Color="#0E4F31" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#5FA9E8"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#276EA6" Offset="0"/>
                        <GradientStop Color="#19496F" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UpdateButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="Foreground" Value="#17120A"/>
            <Setter Property="BorderBrush" Value="#FFE178"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#F6D75C" Offset="0"/>
                        <GradientStop Color="#C89A1B" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NeutralButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#6A7480"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#454F5A" Offset="0"/>
                        <GradientStop Color="#2A323A" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="BorderBrush" Value="#FFD05A"/>
            <Setter Property="Foreground" Value="#17120A"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#FFC84A" Offset="0"/>
                        <GradientStop Color="#D68A13" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Semantic action colors used consistently across every tab. -->
        <Style x:Key="DiagnosticButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="BorderBrush" Value="#B88CFF"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#8B5CF6" Offset="0"/>
                        <GradientStop Color="#5B35B5" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="BorderBrush" Value="#647A94"/>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#26384C" Offset="0"/>
                        <GradientStop Color="#172638" Offset="1"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Workspace Manager actions. Keep semantic MystTiq colors while
             reducing control density for the workspace operations page. -->
        <Style x:Key="WorkspaceRefreshButton" TargetType="Button" BasedOn="{StaticResource RefreshButton}">
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="5,2,0,2"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="WorkspaceSuccessButton" TargetType="Button" BasedOn="{StaticResource SuccessButton}">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="5,2,0,2"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="WorkspaceInfoButton" TargetType="Button" BasedOn="{StaticResource InfoButton}">
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="5,2,0,2"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="WorkspaceSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="Margin" Value="5,2,0,2"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>
        <Style x:Key="WorkspaceSaveButton" TargetType="Button" BasedOn="{StaticResource SuccessButton}">
            <Setter Property="MinWidth" Value="108"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="5,2,0,2"/>
            <Setter Property="FontSize" Value="11.5"/>
        </Style>

        <!-- Compact MODS/UE4SS/Server Doctor actions. These preserve the semantic
             button colors while allowing dense action rows to wrap cleanly at
             smaller window sizes and common Windows DPI scaling levels. -->
        <Style x:Key="ModPrimaryButton" TargetType="Button" BasedOn="{StaticResource ConfigPrimaryButton}">
            <Setter Property="MinWidth" Value="104"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="6,3,0,3"/>
            <Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="ModSuccessButton" TargetType="Button" BasedOn="{StaticResource SuccessButton}">
            <Setter Property="MinWidth" Value="104"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="6,3,0,3"/><Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="ModWarningButton" TargetType="Button" BasedOn="{StaticResource WarningButton}">
            <Setter Property="MinWidth" Value="104"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="6,3,0,3"/><Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="ModDiagnosticButton" TargetType="Button" BasedOn="{StaticResource DiagnosticButton}">
            <Setter Property="MinWidth" Value="104"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="6,3,0,3"/><Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="ModSecondaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="MinWidth" Value="104"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="6,3,0,3"/><Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="ModDangerButton" TargetType="Button" BasedOn="{StaticResource DangerButton}">
            <Setter Property="MinWidth" Value="104"/><Setter Property="MinHeight" Value="38"/><Setter Property="Padding" Value="13,8"/><Setter Property="Margin" Value="6,3,0,3"/><Setter Property="FontSize" Value="12.5"/>
        </Style>
        <Style x:Key="ModActionWrapPanel" TargetType="WrapPanel">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="MaxWidth" Value="650"/>
        </Style>

        <Style x:Key="ConfigViewButton" TargetType="Button" BasedOn="{StaticResource AppButton}">
            <Setter Property="MinWidth" Value="145"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="ConfigViewSelectedButton" TargetType="Button" BasedOn="{StaticResource SuccessButton}">
            <Setter Property="MinWidth" Value="145"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="QolComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#EAF3FC"/>
            <Setter Property="Background" Value="#101A25"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#1D4770"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#176EAF"/></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="QolComboBox" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F4F8FC"/>
            <Setter Property="Background" Value="#101A25"/>
            <Setter Property="BorderBrush" Value="#2B6FAF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource QolComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="DropBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="34"/></Grid.ColumnDefinitions>
                                                <TextBlock Margin="12,0,4,0" VerticalAlignment="Center" HorizontalAlignment="Left" Foreground="White" FontWeight="SemiBold" Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"/>
                                                <Path Grid.Column="1" Data="M 0 0 L 5 5 L 10 0" Stroke="#64B5F6" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DropBorder" Property="BorderBrush" Value="#359BFF"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#101A25" BorderBrush="#2B6FAF" BorderThickness="1" CornerRadius="7" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260" Margin="0,3,0,0">
                                    <ScrollViewer Margin="2" VerticalScrollBarVisibility="Auto">
                                        <ScrollViewer.Resources>
                                            <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBar}"/>
                                        </ScrollViewer.Resources>
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Apply the dark dropdown template globally after the keyed style has been declared. -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource QolComboBox}"/>

        <Style x:Key="SectionBanner" TargetType="Border">
