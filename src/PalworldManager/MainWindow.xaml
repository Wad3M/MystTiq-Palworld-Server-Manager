          <DataGrid.Columns><DataGridTextColumn Header="COMPONENT" Binding="{Binding Component}" Width="1.2*"/><DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="80"/><DataGridTextColumn Header="CONFIDENCE" Binding="{Binding Confidence}" Width="90"/><DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="2*"/></DataGrid.Columns>
         </DataGrid>
         <TextBlock x:Name="PlayerRepairPreviewText" Text="No repair preview generated." Foreground="#FFD56A" TextWrapping="Wrap"/>
        </StackPanel>
       </Border>
       <StackPanel Visibility="Collapsed"><TextBlock x:Name="PlayerAdministrationReadinessText"/><TextBlock x:Name="PlayerAdministrationSummaryText"/></StackPanel>
       <Border Background="#111922" BorderBrush="#2A394B" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,10">
        <StackPanel><TextBlock Text="PLAYER TIMELINE" Foreground="#9FC4EA" FontWeight="Bold"/><TextBlock Text="Player-specific events from Activity &amp; Audit." Foreground="#91A3B8" FontSize="11" Margin="0,2,0,6"/><ListBox x:Name="PlayerTimelineList" Height="145" Background="#0B1118" BorderBrush="#263A50" Foreground="#DCE8F5"/></StackPanel>
       </Border>
       <Border Background="#111922" BorderBrush="#2A394B" BorderThickness="1" CornerRadius="8" Padding="12">
        <StackPanel><TextBlock Text="PRIVATE ADMIN NOTES" Foreground="#9FC4EA" FontWeight="Bold"/><TextBox x:Name="PlayerNotesBox" Height="65" Margin="0,7,0,0" TextWrapping="Wrap" AcceptsReturn="True" IsEnabled="False"/><Button x:Name="SavePlayerNoteButton" Content="✓  SAVE NOTE" Style="{StaticResource PlayerCommandSuccessButton}" HorizontalAlignment="Right" Margin="0,6,0,0" IsEnabled="False" Click="SavePlayerNote_Click" ToolTip="Save Note."/></StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>
  </TabItem>
  <TabItem Header="Guilds">
