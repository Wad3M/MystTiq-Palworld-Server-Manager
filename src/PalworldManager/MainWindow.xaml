                                <RadioButton GroupName="MainNavigation" Style="{StaticResource SidebarNavigationButton}" Tag="11" Click="Nav_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⚠" FontSize="18" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Crash Analyzer" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></RadioButton>
                                <RadioButton GroupName="MainNavigation" Style="{StaticResource SidebarNavigationButton}" Tag="19" Click="Nav_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="🐍" FontSize="16" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Palworld Save Tools" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></RadioButton>
