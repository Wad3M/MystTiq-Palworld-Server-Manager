                                <RadioButton GroupName="MainNavigation" Style="{StaticResource SidebarNavigationButton}" Tag="8" Click="Nav_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⬡" FontSize="18" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="MOD Library" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></RadioButton>
