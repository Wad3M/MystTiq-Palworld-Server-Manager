       <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,8"><TextBlock Text="Description" Foreground="#9FC4EA"/><TextBox x:Name="SetupDescriptionBox" Text="A Palworld server managed by MystTiq Palworld Server"/></StackPanel>
