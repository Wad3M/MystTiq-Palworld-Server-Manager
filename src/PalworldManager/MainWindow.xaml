  <TabItem Header="Server Doctor">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBar}"/></ScrollViewer.Resources>
    <StackPanel Margin="18">
     <Border Style="{StaticResource SectionBanner}">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="Server Doctor" FontSize="28" FontWeight="Bold" Foreground="White"/><TextBlock Text="Diagnose server health, compare Vanilla versus UE4SS, and run timed idle-stability tests with resource history." Foreground="#9FC4EA" FontSize="15" Margin="0,5,20,0" TextWrapping="Wrap"/></StackPanel>
       <WrapPanel Grid.Column="1" Style="{StaticResource ModActionWrapPanel}"><Button Content="✚  RUN FULL DIAGNOSTIC" Style="{StaticResource ModSuccessButton}" Click="RunServerDoctor_Click" ToolTip="Runs Server Doctor diagnostics for server, runtime, mods, processes, and configuration health."/><Button Content="⚠  FORCE CLEANUP" Style="{StaticResource DangerButton}" Click="ForceCleanup_Click" ToolTip="Force-stops remaining Palworld server processes when a normal shutdown cannot complete. Use only when needed."/></WrapPanel>
      </Grid>
     </Border>
     <Border Background="#0D1822" BorderBrush="#263A50" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,12">
      <TextBlock x:Name="ServerDoctorSummaryText" Text="Run a diagnostic to evaluate server health." Foreground="#9FC4EA" FontSize="13" TextWrapping="Wrap"/>
     </Border>

     <Border Background="#101A24" BorderBrush="#31506C" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
      <StackPanel>
       <TextBlock Text="IDLE STABILITY TEST" Foreground="#7FB9F2" FontSize="12" FontWeight="Bold"/>
       <Grid Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="120"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="Duration" Foreground="#D7E4F2" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <ComboBox x:Name="StabilityDurationBox" Grid.Column="1" SelectedIndex="2"><ComboBoxItem Content="5 minutes" Tag="5"/><ComboBoxItem Content="10 minutes" Tag="10"/><ComboBoxItem Content="15 minutes" Tag="15"/><ComboBoxItem Content="30 minutes" Tag="30"/></ComboBox>
        <WrapPanel Grid.Column="2" Margin="12,0,0,0"><Button x:Name="StartStabilityTestButton" Content="▶  START TEST" Style="{StaticResource ModSuccessButton}" Click="StartStabilityTest_Click" ToolTip="Starts the 15-minute Idle Stability Test and watches the server for hangs, exits, and abnormal runtime behavior."/><Button x:Name="StopStabilityTestButton" Content="■  STOP TEST" Style="{StaticResource DangerButton}" Click="StopStabilityTest_Click" IsEnabled="False" ToolTip="Stops the active stability test without stopping the Palworld server unless the test workflow requires it."/></WrapPanel>
        <TextBlock Grid.Column="3" x:Name="StabilityStatusText" Text="Idle test not running." Foreground="#9FC4EA" VerticalAlignment="Center" Margin="16,0,0,0" TextWrapping="Wrap"/>
       </Grid>
       <ProgressBar x:Name="StabilityProgressBar" Minimum="0" Maximum="100" Value="0" Height="8" Margin="0,10,0,10"/>
       <DataGrid x:Name="StabilityHistoryGrid" Height="185" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding}">
        <DataGrid.Columns>
         <DataGridTextColumn Header="ELAPSED" Binding="{Binding Elapsed}" Width="75"/><DataGridTextColumn Header="PROCESS" Binding="{Binding Process}" Width="85"/><DataGridTextColumn Header="RESPONDING" Binding="{Binding Responding}" Width="95"/><DataGridTextColumn Header="RAM" Binding="{Binding Memory}" Width="90"/><DataGridTextColumn Header="PRIVATE" Binding="{Binding PrivateMemory}" Width="90"/><DataGridTextColumn Header="HANDLES" Binding="{Binding Handles}" Width="75"/><DataGridTextColumn Header="THREADS" Binding="{Binding Threads}" Width="70"/><DataGridTextColumn Header="8211" Binding="{Binding GamePort}" Width="70"/><DataGridTextColumn Header="27015" Binding="{Binding SteamPort}" Width="70"/><DataGridTextColumn Header="8212" Binding="{Binding RestPort}" Width="70"/><DataGridTextColumn Header="25575" Binding="{Binding RconPort}" Width="70"/>
        </DataGrid.Columns>
       </DataGrid>
      </StackPanel>
     </Border>

     <Border Background="#111922" BorderBrush="#2A394B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="RUNTIME ISOLATION" Foreground="#7FB9F2" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="StabilityIsolationStatusText" Text="Current configuration will be tested." Foreground="#D7E4F2" Margin="0,6,20,0" TextWrapping="Wrap"/><TextBlock Text="Prepare Vanilla disables UE4SS and all user mods. Prepare UE4SS Only disables user mods but keeps the runtime enabled. Restore returns the saved pre-test state. PalServer must be stopped." Foreground="#91A3B8" TextWrapping="Wrap" Margin="0,4,20,0"/></StackPanel>
       <WrapPanel Grid.Column="1" Style="{StaticResource ModActionWrapPanel}"><Button Content="ℹ  VANILLA" Style="{StaticResource ModSecondaryButton}" Click="PrepareVanillaIsolation_Click" ToolTip="Prepares a vanilla isolation test by disabling UE4SS and managed user mods. Installed files and snapshots are preserved."/><Button Content="ℹ  UE4SS ONLY" Style="{StaticResource ModSecondaryButton}" Click="PrepareUe4ssIsolation_Click" ToolTip="Prepares an isolation test with UE4SS enabled and managed user mods disabled. Installed mod files are preserved."/><Button Content="↶  RESTORE STATE" Style="{StaticResource ModWarningButton}" Click="RestoreIsolationState_Click" ToolTip="Restores the runtime/mod state saved before the current isolation test."/></WrapPanel>
      </Grid>
     </Border>

     <Border Background="#111922" BorderBrush="#2A394B" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="RECENT WINDOWS SERVER EVENTS" Foreground="#7FB9F2" FontSize="12" FontWeight="Bold"/><TextBox x:Name="RecentServerEventsText" Text="Select Refresh Events to inspect recent Application Error / Windows Error Reporting entries." IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,8,16,0"/></StackPanel>
       <Button Grid.Column="1" Content="↻  REFRESH EVENTS" Style="{StaticResource RefreshButton}" Click="RefreshServerEvents_Click" VerticalAlignment="Top" ToolTip="Refreshes recent server diagnostic and stability-test events."/>
      </Grid>
     </Border>

     <DataGrid x:Name="ServerDoctorGrid" MinHeight="260" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
      <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="#111922"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Healthy"><Setter Property="Background" Value="#10261C"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Attention"><Setter Property="Background" Value="#2A2111"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Background" Value="#2A1517"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Unknown"><Setter Property="Background" Value="#1A2028"/></DataTrigger></Style.Triggers></Style></DataGrid.RowStyle>
      <DataGrid.Columns><DataGridTextColumn Header="COMPONENT" Binding="{Binding Component}" Width="180"/><DataGridTemplateColumn Header="STATUS" Width="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="DoctorStatusBadge" Background="#465568" CornerRadius="4" Padding="8,3" Margin="3"><TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Status}" Value="Healthy"><Setter TargetName="DoctorStatusBadge" Property="Background" Value="#1F8B4C"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Attention"><Setter TargetName="DoctorStatusBadge" Property="Background" Value="#B37A18"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter TargetName="DoctorStatusBadge" Property="Background" Value="#B53B3B"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="2*"/><DataGridTextColumn Header="RECOMMENDATION" Binding="{Binding Recommendation}" Width="2*"/></DataGrid.Columns>
     </DataGrid>
    </StackPanel>
   </ScrollViewer>
  </TabItem>

  <TabItem Header="Crash Analyzer">
   <Grid Margin="18">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Style="{StaticResource SectionBanner}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="Crash Analyzer" FontSize="28" FontWeight="Bold" Foreground="White"/>
       <TextBlock Text="Review requested shutdowns and unexpected exits using direct crash signatures, lifecycle evidence, and enabled-MOD context." Foreground="#9FC4EA" FontSize="15" Margin="0,5,20,0" TextWrapping="Wrap"/>
      </StackPanel>
      <WrapPanel Grid.Column="1" Style="{StaticResource ModActionWrapPanel}">
       <Button Content="↻  REFRESH" Style="{StaticResource RefreshButton}" Click="RefreshCrashAnalyzer_Click" ToolTip="Refreshes crash/hang analysis using current MystTiq diagnostic data."/>
       <Button Content="▣  OPEN DIAGNOSTICS" Style="{StaticResource InfoButton}" Click="OpenDiagnosticsFolder_Click" ToolTip="Opens the MystTiq diagnostics folder in File Explorer."/>
      </WrapPanel>
     </Grid>
    </Border>

    <Border Grid.Row="1" Background="#0D1822" BorderBrush="#263A50" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,12">
     <TextBlock x:Name="CrashAnalyzerSummaryText" Text="No crash analysis has been selected. Clean shutdowns and abnormal exits will appear here after they are captured." Foreground="#9FC4EA" FontSize="13" TextWrapping="Wrap"/>
    </Border>

    <Grid Grid.Row="2">
     <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.35*"/></Grid.ColumnDefinitions>

     <Border Grid.Column="0" Background="#101A26" BorderBrush="#283B50" BorderThickness="1" CornerRadius="8" Padding="10">
      <Grid>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock Text="RECENT SERVER EXITS" Foreground="#90A5BC" FontSize="11" FontWeight="Bold" Margin="2,0,0,9"/>
       <DataGrid Grid.Row="1" x:Name="CrashHistoryGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" SelectionChanged="CrashHistoryGrid_SelectionChanged">
        <DataGrid.Columns>
         <DataGridTextColumn Header="TIME" Binding="{Binding TimestampDisplay}" Width="150"/>
         <DataGridTextColumn Header="RESULT" Binding="{Binding Result}" Width="130"/>
         <DataGridTextColumn Header="PHASE" Binding="{Binding Phase}" Width="90"/>
         <DataGridTextColumn Header="CODE" Binding="{Binding ExitCode}" Width="65"/>
         <DataGridTextColumn Header="CONFIDENCE" Binding="{Binding Confidence}" Width="100"/>
        </DataGrid.Columns>
       </DataGrid>
      </Grid>
     </Border>

     <Border Grid.Column="2" Background="#101A26" BorderBrush="#283B50" BorderThickness="1" CornerRadius="8" Padding="14">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
       <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBar}"/></ScrollViewer.Resources>
       <StackPanel>
        <TextBlock Text="SELECTED EXIT" Foreground="#90A5BC" FontSize="11" FontWeight="Bold"/>
        <TextBlock x:Name="CrashResultText" Text="No report selected" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,5,0,2"/>
        <TextBlock x:Name="CrashPhaseText" Text="" Foreground="#9FC4EA" FontSize="13"/>

        <Border Height="1" Background="#2A3D52" Margin="0,12"/>
        <TextBlock Text="SUMMARY" Foreground="#90A5BC" FontSize="11" FontWeight="Bold"/>
        <TextBlock x:Name="CrashDetailText" Text="Select a captured server exit to view the diagnostic summary." Foreground="#DCE8F5" TextWrapping="Wrap" Margin="0,5,0,0"/>

        <TextBlock Text="LIKELY CONTRIBUTOR" Foreground="#90A5BC" FontSize="11" FontWeight="Bold" Margin="0,16,0,0"/>
        <TextBlock x:Name="CrashContributorText" Text="—" Foreground="#F0B246" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0"/>
        <TextBlock x:Name="CrashConfidenceText" Text="" Foreground="#9FC4EA" FontSize="12" Margin="0,2,0,0"/>

        <TextBlock Text="ENABLED MODS" Foreground="#90A5BC" FontSize="11" FontWeight="Bold" Margin="0,16,0,0"/>
        <TextBlock x:Name="CrashEnabledModsText" Text="—" Foreground="#DCE8F5" TextWrapping="Wrap" Margin="0,4,0,0"/>

        <TextBlock Text="TRIGGER EVIDENCE" Foreground="#90A5BC" FontSize="11" FontWeight="Bold" Margin="0,16,0,0"/>
        <TextBox x:Name="CrashTriggerText" IsReadOnly="True" TextWrapping="Wrap" MinHeight="55" MaxHeight="120" VerticalScrollBarVisibility="Auto"/>

        <TextBlock Text="RECENT SERVER EVIDENCE" Foreground="#90A5BC" FontSize="11" FontWeight="Bold" Margin="0,16,0,0"/>
        <TextBox x:Name="CrashEvidenceText" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="190" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
       </StackPanel>
      </ScrollViewer>
     </Border>
    </Grid>
   </Grid>
  </TabItem>


  <TabItem Header="Update Center">
   <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Style="{StaticResource SectionBanner}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="Update Center" FontSize="28" FontWeight="Bold" Foreground="White"/><TextBlock Text="Review update readiness for the Palworld server, SteamCMD, UE4SS, and locally available Workshop mods from one place." Foreground="#9FC4EA" FontSize="15" Margin="0,5,20,0" TextWrapping="Wrap"/></StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="UpdateCheckAllButton" Content="↻  CHECK ALL UPDATES" Style="{StaticResource SecondaryButton}" Click="RefreshUpdateCenter_Click" ToolTip="Checks Core Server, Dependencies, and Installed MODs for available updates."/><Button x:Name="UpdateAllAvailableButton" Content="⬇  UPDATE ALL AVAILABLE" Style="{StaticResource UpdateButton}" Click="UpdateAllAvailable_Click" ToolTip="Updates every component with a confirmed available update." IsEnabled="False"/></WrapPanel>
     </Grid>
    </Border>
    <Border Grid.Row="1" x:Name="UpdateCenterSummaryBorder" Background="#0D1822" BorderBrush="#263A50" BorderThickness="1" CornerRadius="7" Padding="12,9" Margin="0,0,0,12">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock x:Name="UpdateCenterSummaryText" Text="Select Check All to evaluate installed components and locally available Workshop updates." Foreground="#9FC4EA" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <TextBlock Grid.Column="1" x:Name="UpdateCenterCheckedBadge" Text="NOT CHECKED" Foreground="#90A5BC" FontWeight="Bold" Margin="18,0,0,0" VerticalAlignment="Center"/>
     </Grid>
    </Border>
    <DataGrid Grid.Row="2" x:Name="UpdateCenterGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
     <DataGrid.GroupStyle>
      <GroupStyle>
       <GroupStyle.HeaderTemplate><DataTemplate>
        <Border Background="#182839" BorderBrush="#31506C" BorderThickness="0,1,0,1" Padding="12,7" Margin="0,8,0,2">
         <TextBlock Text="{Binding Name}" Foreground="#7FB9F2" FontSize="14" FontWeight="Bold"/>
        </Border>
       </DataTemplate></GroupStyle.HeaderTemplate>
      </GroupStyle>
     </DataGrid.GroupStyle>
     <DataGrid.RowStyle>
      <Style TargetType="DataGridRow">
       <Setter Property="Background" Value="#111922"/>
       <Setter Property="MinHeight" Value="34"/>
       <Setter Property="VerticalContentAlignment" Value="Center"/>
       <Style.Triggers>
        <DataTrigger Binding="{Binding Status}" Value="CURRENT"><Setter Property="Background" Value="#10261C"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="READY"><Setter Property="Background" Value="#10261C"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="UP TO DATE"><Setter Property="Background" Value="#10261C"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="CHECKING"><Setter Property="Background" Value="#10213A"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="UPDATE AVAILABLE"><Setter Property="Background" Value="#2A2111"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="NOT INSTALLED"><Setter Property="Background" Value="#1A2028"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="CHECK FAILED"><Setter Property="Background" Value="#2A1517"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="UNABLE TO CHECK"><Setter Property="Background" Value="#2A1517"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="MANUAL CHECK REQUIRED"><Setter Property="Background" Value="#2A2111"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="INSTALLED / VERIFIED"><Setter Property="Background" Value="#10261C"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="MISSING"><Setter Property="Background" Value="#2A1517"/></DataTrigger>
        <DataTrigger Binding="{Binding Status}" Value="ATTENTION"><Setter Property="Background" Value="#2A2111"/></DataTrigger>
       </Style.Triggers>
      </Style>
     </DataGrid.RowStyle>
     <DataGrid.Columns>
      <DataGridTextColumn Header="COMPONENT" Binding="{Binding Component}" Width="190"/>
      <DataGridTextColumn Header="INSTALLED VERSION" Binding="{Binding Installed}" Width="145"/>
      <DataGridTextColumn Header="LATEST VERSION" Binding="{Binding Available}" Width="165"/>
      <DataGridTextColumn Header="LAST CHECKED" Binding="{Binding LastChecked}" Width="140"/>
      <DataGridTextColumn Header="LAST UPDATED" Binding="{Binding LastUpdated}" Width="140"/>
      <DataGridTemplateColumn Header="STATUS" Width="170">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <Border x:Name="UpdateStatusBadge" Background="#465568" CornerRadius="4" Padding="8,3" Margin="3">
         <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <DataTemplate.Triggers>
         <DataTrigger Binding="{Binding Status}" Value="CURRENT"><Setter TargetName="UpdateStatusBadge" Property="Background" Value="#1F8B4C"/></DataTrigger>
         <DataTrigger Binding="{Binding Status}" Value="READY"><Setter TargetName="UpdateStatusBadge" Property="Background" Value="#1F8B4C"/></DataTrigger>
         <DataTrigger Binding="{Binding Status}" Value="UPDATE AVAILABLE"><Setter TargetName="UpdateStatusBadge" Property="Background" Value="#B37A18"/></DataTrigger>
         <DataTrigger Binding="{Binding Status}" Value="MISSING"><Setter TargetName="UpdateStatusBadge" Property="Background" Value="#B53B3B"/></DataTrigger>
         <DataTrigger Binding="{Binding Status}" Value="ATTENTION"><Setter TargetName="UpdateStatusBadge" Property="Background" Value="#B37A18"/></DataTrigger>
         <DataTrigger Binding="{Binding Status}" Value="UP TO DATE"><Setter TargetName="UpdateStatusBadge" Property="Background" Value="#1F8B4C"/></DataTrigger>
         <DataTrigger Binding="{Binding Status}" Value="CHECKING"><Setter TargetName="UpdateStatusBadge" Property="Background" Value="#2B6FAF"/></DataTrigger>
         <DataTrigger Binding="{Binding Status}" Value="NOT INSTALLED"><Setter TargetName="UpdateStatusBadge" Property="Background" Value="#465568"/></DataTrigger>
         <DataTrigger Binding="{Binding Status}" Value="CHECK FAILED"><Setter TargetName="UpdateStatusBadge" Property="Background" Value="#B53B3B"/></DataTrigger>
         <DataTrigger Binding="{Binding Status}" Value="UNABLE TO CHECK"><Setter TargetName="UpdateStatusBadge" Property="Background" Value="#B53B3B"/></DataTrigger>
         <DataTrigger Binding="{Binding Status}" Value="MANUAL CHECK REQUIRED"><Setter TargetName="UpdateStatusBadge" Property="Background" Value="#B37A18"/></DataTrigger>
         <DataTrigger Binding="{Binding Status}" Value="INSTALLED / VERIFIED"><Setter TargetName="UpdateStatusBadge" Property="Background" Value="#1F8B4C"/></DataTrigger>
        </DataTemplate.Triggers>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="SOURCE" Width="165">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <TextBlock Text="{Binding Source}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Source}" Margin="4,0"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="ACTION" Width="104">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <Button Content="{Binding Action}" Click="UpdateCenterRowAction_Click" Style="{StaticResource SecondaryButton}" Width="82" Height="28" Padding="4,2" Margin="3" FontSize="10.5"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
      <DataGridTemplateColumn Header="DETAILS" Width="3*">
       <DataGridTemplateColumn.CellTemplate><DataTemplate>
        <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="5,4" ToolTip="{Binding Recommendation}"/>
       </DataTemplate></DataGridTemplateColumn.CellTemplate>
      </DataGridTemplateColumn>
     </DataGrid.Columns>
    </DataGrid>
    <Border Grid.Row="3" Background="#101E2B" BorderBrush="#29445E" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,0">
     <TextBlock Text="Update safety: MystTiq only reports an update when it has reliable evidence. Components without reliable automatic version metadata finish as MANUAL CHECK REQUIRED or UNABLE TO CHECK rather than remaining unchecked. UPDATE SERVER uses SteamCMD validation/update and does not modify your world saves." Foreground="#8FB7DB" TextWrapping="Wrap"/>
    </Border>
   </Grid>
  </TabItem>

  <TabItem Header="UE4SS">
   <Grid Margin="18">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource SectionBanner}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="UE4SS" FontSize="28" FontWeight="Bold" Foreground="White"/><TextBlock Text="Manage, test, switch, verify, back up, and recover the UE4SS runtime independently from server setup. User mods remain separate from runtime maintenance." Foreground="#9FC4EA" FontSize="15" Margin="0,5,20,0" TextWrapping="Wrap"/></StackPanel>
      <WrapPanel Grid.Column="1" Style="{StaticResource ModActionWrapPanel}"><Button Content="↻  REFRESH" Style="{StaticResource RefreshButton}" Click="RefreshModRuntime_Click" ToolTip="Refreshes UE4SS runtime detection, status, and installed-version information."/><Button Content="📂  OPEN RUNTIME" Style="{StaticResource InfoButton}" Click="OpenModRuntimeFolder_Click" ToolTip="Opens the installed UE4SS runtime folder."/></WrapPanel>
     </Grid>
    </Border>

    <Border Grid.Row="1" Background="#101A24" BorderBrush="#31506C" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="UE4SS RUNTIME" Foreground="#7FB9F2" FontSize="12" FontWeight="Bold"/>
       <TextBlock x:Name="ModRuntimeStatusText" Text="Checking..." Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,5,0,0"/>
       <TextBlock x:Name="ModRuntimeVersionText" Text="Version: —" Foreground="#B8C9DB" Margin="0,6,0,0"/>
       <TextBlock x:Name="ModRuntimeFlavorText" Text="Runtime profile: —" Foreground="#B8C9DB" Margin="0,3,0,0"/>
       <TextBlock x:Name="ModRuntimePathText" Text="Path: —" Foreground="#7FA8CE" Margin="0,3,0,0" TextWrapping="Wrap"/>
      </StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
       <Button x:Name="ModRuntimeToggleButton" Content="■  DISABLE" Style="{StaticResource ModDangerButton}" Click="ToggleModRuntime_Click" ToolTip="Enables or disables the UE4SS runtime without deleting the runtime files."/>
       <Button Content="✓  VERIFY" Style="{StaticResource RefreshButton}" Click="VerifyModRuntime_Click" ToolTip="Verifies the installed UE4SS runtime files and current enable/disable state."/>
      </WrapPanel>
     </Grid>
    </Border>

    <Border Grid.Row="2" Background="#101A24" BorderBrush="#31506C" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="GITHUB VERSION MANAGER" Foreground="#7FB9F2" FontSize="12" FontWeight="Bold"/>
