       <StackPanel Grid.Column="2" VerticalAlignment="Bottom"><Button Content="✖  CLEAR FILTERS" Style="{StaticResource InfoButton}" Click="ClearGuildFilters_Click" ToolTip="Clear Filters."/></StackPanel>
      </Grid>
