                                <RadioButton GroupName="MainNavigation" Style="{StaticResource SidebarNavigationButton}" Tag="3" Click="Nav_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="▤" FontSize="18" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Console" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></RadioButton>
                                <RadioButton GroupName="MainNavigation" Style="{StaticResource SidebarNavigationButton}" Tag="21" Click="Nav_Click"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="▦" FontSize="18" HorizontalAlignment="Center"/><TextBlock Grid.Column="1" Text="Workspace" VerticalAlignment="Center" Margin="8,0,0,0"/></Grid></RadioButton>
