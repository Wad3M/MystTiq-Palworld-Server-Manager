       <Button Grid.Column="1" Content="✓  SAVE SETTINGS" Style="{StaticResource ConfigPrimaryButton}" MinWidth="154" Height="34" Padding="16,7" HorizontalAlignment="Right" Click="SaveSettings_Click" ToolTip="Saves MystTiq Palworld Server application paths and management settings."/>
