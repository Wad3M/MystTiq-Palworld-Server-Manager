        <ControlTemplate.Triggers>
         <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#1B3145"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="#4A7AA2"/><Setter Property="Foreground" Value="White"/></Trigger>
         <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="#182B3D"/><Setter Property="Foreground" Value="White"/></Trigger>
         <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger>
        </ControlTemplate.Triggers>
       </ControlTemplate>
      </Setter.Value>
     </Setter>
    </Style>
    <Style TargetType="TreeView">
     <Setter Property="Background" Value="#0B141D"/><Setter Property="Foreground" Value="#DCE8F5"/><Setter Property="BorderBrush" Value="#263A50"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8"/>
    </Style>
    <Style TargetType="TreeViewItem">
     <Setter Property="Foreground" Value="#DCE8F5"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="3"/>
