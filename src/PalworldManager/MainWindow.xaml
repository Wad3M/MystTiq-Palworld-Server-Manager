       <TextBlock Text="Check availability, install missing components, or verify the complete server environment." Foreground="#8FB7DB" Margin="0,3,18,0"/>
      </StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center">
       <Button Content="↻  CHECK FOR UPDATES" Style="{StaticResource UpdateButton}" Click="CheckForUpdates_Click" ToolTip="Checks required server components for available updates."/>
       <Button Content="⬇  INSTALL MISSING" Style="{StaticResource WarningButton}" Click="InstallRequired_Click" ToolTip="Installs required components that are currently missing, including Python when required."/>
       <Button Content="✓  VERIFY FILES" Style="{StaticResource RefreshButton}" Click="VerifyEnvironment_Click" ToolTip="Verifies required files, paths, and components without changing the server."/>
      </WrapPanel>
     </Grid>
    </Border>

    <Border x:Name="InstallActivityBorder" Grid.Row="4" Background="#0E1A25" BorderBrush="#31506C" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,10,0,0">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
      <StackPanel>
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="OPERATION MONITOR" Foreground="White" FontWeight="Bold"/>
        <Border x:Name="InstallStateBadge" Background="#465568" CornerRadius="4" Padding="8,2" Margin="10,0,0,0">
         <TextBlock x:Name="InstallStateText" Text="IDLE" Foreground="White" FontSize="11" FontWeight="Bold"/>
        </Border>
       </StackPanel>
       <TextBlock x:Name="InstallOperationTitleText" Text="No operation currently running" Foreground="#D7E7F5" FontSize="15" FontWeight="SemiBold" Margin="0,7,12,0"/>
       <TextBlock x:Name="InstallStatusText" Text="Select an operation above or use an action in the component checklist." Foreground="#9FC4EA" TextWrapping="Wrap" Margin="0,4,12,0"/>
       <TextBlock x:Name="InstallRecentActivityText" Text="Recent activity: None during this session." Foreground="#718DA8" FontSize="12" Margin="0,6,12,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
       <TextBlock Text="OVERALL PROGRESS" Foreground="#8FB7DB" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,5"/>
       <ProgressBar x:Name="InstallProgressBar" Height="20" Minimum="0" Maximum="100" Value="0"/>
       <TextBlock x:Name="InstallPercentText" Text="0%" Foreground="White" HorizontalAlignment="Right" Margin="0,4,0,0"/>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
  </TabItem>
  <TabItem Header="Configuration">
   <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top">
     <Border Style="{StaticResource SectionBanner}">
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock x:Name="ConfigTitleText" Text="Server Configuration" Foreground="White" FontSize="24" FontWeight="Bold"/>
        <TextBlock Text="Use Simple Settings for common quality-of-life options, or Advanced Settings for every Palworld value." Foreground="#9FC4EA" FontSize="13" Margin="0,3,16,0" TextWrapping="Wrap"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
        <Button Content="↻  LOAD ACTIVE" Style="{StaticResource WarningButton}" Click="LoadActive_Click" ToolTip="Reload settings from PalWorldSettings.ini"/>
        <Button Content="↶  RESET DEFAULTS" Style="{StaticResource DangerButton}" Click="LoadDefaults_Click" ToolTip="Reset the editor to Palworld default values"/>
        <Button x:Name="SaveConfigButton" Content="✓  SAVE CHANGES" Style="{StaticResource ConfigPrimaryButton}" Click="SaveConfig_Click" ToolTip="Save active values to PalWorldSettings.ini"/>
       </StackPanel>
      </Grid>
     </Border>
     <Border Background="#0D151E" BorderBrush="#263A50" BorderThickness="1" CornerRadius="7" Padding="7" Margin="0,0,0,6">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel Orientation="Horizontal">
        <Button x:Name="SimpleConfigViewButton" Content="⚙  SIMPLE SETTINGS" Style="{StaticResource ConfigViewSelectedButton}" Click="ShowSimpleConfig_Click" ToolTip="Shows the simplified quality-of-life configuration controls."/>
        <Button x:Name="AdvancedConfigViewButton" Content="⚙  ADVANCED SETTINGS" Style="{StaticResource ConfigViewButton}" Click="ShowAdvancedConfig_Click" ToolTip="Shows the full advanced Palworld configuration table."/>
       </StackPanel>
       <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
        <Grid Width="220" Height="30" Margin="6,0">
         <TextBox x:Name="ConfigSearchBox" Height="30" Padding="28,3,8,3" TextChanged="ConfigFilter_Changed" ToolTip="Search setting name or description"/>
         <TextBlock Text="⌕  Search settings..." Foreground="#71869A" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
          <TextBlock.Style>
           <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
             <DataTrigger Binding="{Binding Text, ElementName=ConfigSearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger>
            </Style.Triggers>
           </Style>
          </TextBlock.Style>
         </TextBlock>
        </Grid>
        <ComboBox x:Name="ConfigCategoryCombo" Width="135" Height="30" SelectionChanged="ConfigFilter_Changed">
         <ComboBoxItem Content="All Categories" IsSelected="True"/><ComboBoxItem Content="Gameplay"/><ComboBoxItem Content="World"/><ComboBoxItem Content="Players"/><ComboBoxItem Content="Performance"/><ComboBoxItem Content="Network"/><ComboBoxItem Content="Remote Admin"/><ComboBoxItem Content="Security"/><ComboBoxItem Content="Mods"/><ComboBoxItem Content="Other"/>
        </ComboBox>
       </StackPanel>
       <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0">
        <Button Style="{StaticResource SuccessButton}" Width="116" Height="34" Padding="9,3" Click="ImportConfig_Click" ToolTip="Imports Palworld settings from a configuration file."><TextBlock Text="IMPORT SETTINGS" TextAlignment="Center"/></Button>
        <Button Style="{StaticResource ConfigPrimaryButton}" Width="116" Height="34" Padding="9,3" Click="ExportConfig_Click" ToolTip="Exports the current configuration to a file for backup or reuse."><TextBlock Text="⇧  EXPORT" TextAlignment="Center"/></Button>
       </StackPanel>
      </Grid>
     </Border>
     <Border Background="#0D151E" BorderBrush="#263A50" BorderThickness="1" CornerRadius="6" Padding="8,5" Margin="0,0,0,7">
      <TextBlock x:Name="ConfigStatusText" Text="Simple and Advanced views edit the same active configuration. Changes are not written until Save Changes is clicked." Foreground="#9FC4EA" FontSize="13" TextWrapping="Wrap"/>
     </Border>
    </StackPanel>

    <Grid>
     <!-- SIMPLE SETTINGS -->
     <ScrollViewer x:Name="SimpleConfigPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ScrollViewer.Resources>
       <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBar}"/>
       <DataTemplate x:Key="QolOptionTemplate">
        <Border Background="#101A25" BorderBrush="#2A4865" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,5">
         <Grid>
          <Grid.ColumnDefinitions>
           <ColumnDefinition Width="Auto"/>
           <ColumnDefinition Width="*"/>
           <ColumnDefinition Width="180"/>
           <ColumnDefinition Width="88"/>
           <ColumnDefinition Width="150"/>
          </Grid.ColumnDefinitions>
          <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Click="QolOption_Changed" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Enable this quality-of-life adjustment"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
           <TextBlock Text="{Binding Label}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
           <TextBlock Text="{Binding Description}" Foreground="#91A9C0" FontSize="11" TextWrapping="Wrap" Margin="0,1,8,0"/>
          </StackPanel>
          <Slider Grid.Column="2" Value="{Binding Percentage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding TickFrequency}" IsSnapToTickEnabled="True" IsEnabled="{Binding IsEnabled}" ValueChanged="QolSlider_Changed" VerticalAlignment="Center" Margin="6,0,8,0"/>
          <Grid Grid.Column="3" Margin="0,0,10,0">
           <TextBox Text="{Binding Percentage, UpdateSourceTrigger=LostFocus, StringFormat=0.##}" IsEnabled="{Binding IsEnabled}" LostFocus="QolOption_Changed" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" Padding="6,3,24,3"/>
           <TextBlock Text="{Binding ValueSuffix}" Foreground="#9FC4EA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
          </Grid>
          <TextBlock Grid.Column="4" Text="{Binding ResultText}" Foreground="#5FD39A" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" TextAlignment="Right" TextWrapping="Wrap"/>
         </Grid>
        </Border>
       </DataTemplate>
      </ScrollViewer.Resources>
      <StackPanel Margin="0,0,8,0">
       <Border Background="#101A25" BorderBrush="#C69A3A" BorderThickness="2" CornerRadius="8" Padding="12" Margin="0,0,0,8">
        <StackPanel>
         <TextBlock Text="🖥  SERVER IDENTITY" Foreground="#F0C96B" FontSize="17" FontWeight="Bold" Margin="0,0,0,2"/>
         <TextBlock Text="These values identify your server and are never changed when a QoL preset is applied." Foreground="#9FC4EA" Margin="0,0,0,7" TextWrapping="Wrap"/>
         <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
           <TextBlock Text="Server Name" Foreground="White" FontWeight="Bold" FontSize="15" Margin="0,0,0,5" ToolTip="This is the name players see in the Palworld server browser."/>
           <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SimpleServerNameTextBox" Height="34" Padding="9,4" VerticalContentAlignment="Center" TextChanged="SimpleServerIdentity_Changed" ToolTip="This is the name players see in the Palworld server browser."/>
            <Button Grid.Column="1" Content="🎲  GENERATE" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="GenerateServerName_Click" ToolTip="Generate a new random server name. The name is not saved until Save Changes is clicked."/>
           </Grid>
          </StackPanel>
          <StackPanel Grid.Column="2">
           <TextBlock Text="Server Description" Foreground="#DCEBFA" FontWeight="SemiBold" Margin="0,0,0,5"/>
           <TextBox x:Name="SimpleServerDescriptionTextBox" Height="34" Padding="9,4" VerticalContentAlignment="Center" TextChanged="SimpleServerIdentity_Changed"/>
          </StackPanel>
         </Grid>
        </StackPanel>
       </Border>

       <Border Background="#101A25" BorderBrush="#2A4865" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,8">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="Quality of Life Presets" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Text="Choose a starting profile, then fine-tune any enabled option. Manual changes are identified as a Custom Configuration." Foreground="#9FC4EA" Margin="0,5,20,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="QolPresetDescriptionText" Text="Balanced quality-of-life improvements that reduce grind while preserving progression." Foreground="#B8C9DB" FontStyle="Italic" Margin="0,8,20,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="QolCustomProfileText" Text="Current Profile: Custom Configuration" Foreground="#8FA4B8" FontStyle="Italic" Margin="0,6,20,0" Visibility="Collapsed"/>
         </StackPanel>
         <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ComboBox x:Name="QolPresetCombo" Width="190" Height="34" Margin="0,0,10,0" SelectedIndex="2" Style="{StaticResource QolComboBox}" SelectionChanged="QolPresetCombo_SelectionChanged">
           <ComboBoxItem Content="Official / Vanilla" Tag="Official"/>
           <ComboBoxItem Content="Balanced QoL" Tag="Balanced"/>
           <ComboBoxItem Content="Relaxed" Tag="Relaxed"/>
          </ComboBox>
         </StackPanel>
        </Grid>
       </Border>

       <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,0,7">
        <StackPanel>
         <TextBlock Text="🌍  WORLD" Foreground="#64B5F6" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
         <Border Background="#101A25" BorderBrush="#2A4865" BorderThickness="1" CornerRadius="7" Padding="8" Margin="0,0,0,5">
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
           <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Death Penalty" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
            <TextBlock Text="Choose what a player drops on death. This setting is available here without requiring Advanced Settings." Foreground="#91A9C0" FontSize="11" TextWrapping="Wrap" Margin="0,1,8,0"/>
           </StackPanel>
           <ComboBox x:Name="SimpleDeathPenaltyCombo" Grid.Column="1" Height="32" VerticalAlignment="Center" SelectionChanged="SimpleDeathPenalty_Changed">
            <ComboBoxItem Content="None — keep everything" Tag="None"/>
            <ComboBoxItem Content="Items only" Tag="Item"/>
            <ComboBoxItem Content="Items and equipment" Tag="ItemAndEquipment"/>
            <ComboBoxItem Content="All — items, equipment and Pals" Tag="All"/>
           </ComboBox>
          </Grid>
         </Border>
         <ItemsControl x:Name="WorldQolItems" ItemTemplate="{StaticResource QolOptionTemplate}"/>
        </StackPanel>
       </Border>
       <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,0,7">
        <StackPanel>
         <TextBlock Text="❤  PLAYER &amp; PAL" Foreground="#64B5F6" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
         <ItemsControl x:Name="PlayerPalQolItems" ItemTemplate="{StaticResource QolOptionTemplate}"/>
        </StackPanel>
       </Border>
       <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,0,7">
        <StackPanel>
         <TextBlock Text="⚒  GAMEPLAY" Foreground="#64B5F6" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
         <ItemsControl x:Name="GameplayQolItems" ItemTemplate="{StaticResource QolOptionTemplate}"/>
        </StackPanel>
       </Border>
       <Border Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,0,0,7">
        <StackPanel>
         <TextBlock Text="⌂  BASES" Foreground="#64B5F6" FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>
         <ItemsControl x:Name="BaseQolItems" ItemTemplate="{StaticResource QolOptionTemplate}"/>
        </StackPanel>
       </Border>
       <Border Background="#101A25" BorderBrush="#2A4865" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
        <StackPanel>
         <TextBlock Text="PROFILE SUMMARY" Foreground="#64B5F6" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
         <ItemsControl x:Name="QolSummaryItems">
          <ItemsControl.ItemTemplate>
           <DataTemplate>
            <TextBlock Text="{Binding}" Foreground="#D8E6F3" FontSize="13" Margin="2,2" TextWrapping="Wrap"/>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </Border>
       <TextBlock Text="Disabling an option restores its Palworld default. Rate controls are measured from 100%; count and interval controls show their actual values. All changes stay synchronized with Advanced Settings." Foreground="#7897B6" FontStyle="Italic" Margin="4,2,4,12" TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>

     <!-- ADVANCED SETTINGS -->
     <DataGrid x:Name="ConfigGrid" Visibility="Collapsed" IsReadOnly="False" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" SelectionMode="Single">
      <DataGrid.Resources>
       <Style TargetType="ScrollBar" BasedOn="{StaticResource DarkVerticalScrollBar}">
        <Style.Triggers>
         <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="13"/>
          <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
           <Grid Background="{TemplateBinding Background}"><Track x:Name="PART_Track" Orientation="Horizontal" Focusable="False">
            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource DarkScrollBarThumb}"/></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
           </Track></Grid>
          </ControlTemplate></Setter.Value></Setter>
         </Trigger>
        </Style.Triggers>
       </Style>
      </DataGrid.Resources>
      <DataGrid.RowStyle>
       <Style TargetType="DataGridRow" BasedOn="{StaticResource DarkDataGridRowBase}">
        <Style.Triggers>
         <DataTrigger Binding="{Binding IsModified}" Value="True"><Setter Property="Background" Value="#5B4617"/><Setter Property="ToolTip" Value="This active value differs from DefaultPalWorldSettings.ini"/></DataTrigger>
         <DataTrigger Binding="{Binding IsValid}" Value="False"><Setter Property="Background" Value="#612323"/><Setter Property="ToolTip" Value="{Binding ValidationMessage}"/></DataTrigger>
         <DataTrigger Binding="{Binding IsDirty}" Value="True"><Setter Property="Background" Value="#173F63"/><Setter Property="BorderBrush" Value="#45A8FF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="ToolTip" Value="This value has been edited and has not been saved"/></DataTrigger>
        </Style.Triggers>
       </Style>
      </DataGrid.RowStyle>
      <DataGrid.Columns>
       <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="110" IsReadOnly="True"/>
       <DataGridTextColumn Header="Setting" Binding="{Binding DisplayName}" Width="1.3*" IsReadOnly="True"/>
       <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="2.2*" IsReadOnly="True"/>
       <DataGridTextColumn Header="Default Value" Binding="{Binding DefaultValue}" Width="1.4*" IsReadOnly="True"/>
       <DataGridTextColumn Header="Active Value" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="1.4*"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>
   </DockPanel>
  </TabItem>
  <TabItem Header="Console">
   <Grid Margin="12">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Style="{StaticResource SectionBanner}">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock Text="Live Console &amp; RCON" FontSize="28" FontWeight="Bold" Foreground="White"/><TextBlock Text="Capture persistent server logs, filter activity, and administer Palworld through RCON." Foreground="#9FC4EA" FontSize="15" Margin="0,5,20,0"/></StackPanel>
      <WrapPanel Grid.Column="1" VerticalAlignment="Center">
       <Button Content="📂  OPEN LOGS" Style="{StaticResource InfoButton}" Click="OpenLogsFolder_Click" ToolTip="Opens the MystTiq server log folder in File Explorer."/>
       <Button Content="⇩  EXPORT VIEW" Style="{StaticResource ConfigPrimaryButton}" Click="SaveVisibleLog_Click" ToolTip="Exports the currently visible console/log view to a file."/>
      </WrapPanel>
     </Grid>
    </Border>
    <Border Grid.Row="1" Background="#111922" BorderBrush="#2A394B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,10">
     <WrapPanel VerticalAlignment="Center">
      <TextBlock Text="Severity" VerticalAlignment="Center" Foreground="#91A3B8" Margin="0,0,6,0"/>
      <ComboBox x:Name="ConsoleSeverityFilter" Width="120" SelectionChanged="ConsoleFilter_Changed" SelectedIndex="0"><ComboBoxItem Content="All"/><ComboBoxItem Content="Status"/><ComboBoxItem Content="Info"/><ComboBoxItem Content="Warning"/><ComboBoxItem Content="Error"/><ComboBoxItem Content="Critical"/></ComboBox>
      <TextBlock Text="Category" VerticalAlignment="Center" Foreground="#91A3B8" Margin="12,0,6,0"/>
      <ComboBox x:Name="ConsoleCategoryFilter" Width="125" SelectionChanged="ConsoleFilter_Changed" SelectedIndex="0"><ComboBoxItem Content="All"/><ComboBoxItem Content="Manager"/><ComboBoxItem Content="Server"/><ComboBoxItem Content="Players"/><ComboBoxItem Content="REST API"/><ComboBoxItem Content="RCON"/><ComboBoxItem Content="UE4SS"/><ComboBoxItem Content="Mods"/><ComboBoxItem Content="Backup"/><ComboBoxItem Content="SteamCMD"/></ComboBox>
      <TextBox x:Name="ConsoleSearchBox" Width="190" Margin="12,0,0,0" ToolTip="Search logs..." TextChanged="ConsoleSearch_Changed"/>
      <CheckBox x:Name="ConsoleAutoScrollCheckBox" Content="Auto-scroll" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#66B5FF" FontWeight="SemiBold"/>
      <CheckBox x:Name="HideRoutineRestCheckBox" Content="Hide REST traffic" IsChecked="True" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#66B5FF" FontWeight="SemiBold" Checked="ConsoleFilter_Changed" Unchecked="ConsoleFilter_Changed"/>
      <Button Content="↻  REFRESH VIEW" Style="{StaticResource RefreshButton}" Margin="16,0,0,0" Click="RefreshConsole_Click" ToolTip="Refreshes the console view from the current server session log."/>
      <Button x:Name="PauseConsoleButton" Content="Ⅱ  PAUSE" Margin="8,0,0,0" Click="PauseConsole_Click" ToolTip="Pauses or resumes automatic console display updates. Server logging continues." Style="{StaticResource SecondaryButton}"/>
      <Button Content="✕  CLEAR VIEW" Style="{StaticResource DangerButton}" Click="ClearConsole_Click" ToolTip="Clears only the visible console view; log files are not deleted."/>
     </WrapPanel>
    </Border>
    <TextBox Grid.Row="2" x:Name="ServerLogBox" Style="{StaticResource LogViewerTextBox}"/>
    <Border Grid.Row="3" Background="#111922" BorderBrush="#2A394B" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,10,0,0">
     <Grid>
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0">
       <StackPanel DockPanel.Dock="Left"><TextBlock Text="RCON" FontSize="17" FontWeight="Bold" Foreground="White"/><TextBlock x:Name="RconDoctorStatusText" Text="Doctor: not run" Foreground="#9FC4EA" FontSize="11" Margin="0,3,0,0"/></StackPanel>
       <WrapPanel DockPanel.Dock="Right"><TextBlock x:Name="RconStatusText" Text="Disconnected" Foreground="Gold" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Content="⚕  RCON DOCTOR" Style="{StaticResource SecondaryButton}" Click="RconDoctor_Click" ToolTip="Checks RCON configuration, WorldOption.sav overrides, TCP reachability, and authentication."/><Button Content="●  CONNECT" Style="{StaticResource SuccessButton}" Click="RconConnect_Click" ToolTip="Connects MystTiq to the Palworld RCON service using the configured credentials."/><Button Content="■  DISCONNECT" Style="{StaticResource DangerButton}" Click="RconDisconnect_Click" ToolTip="Disconnects the current MystTiq RCON session."/></WrapPanel>
      </DockPanel>
      <Grid Grid.Row="1" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="175"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <ComboBox x:Name="RconPresetCombo" Grid.Column="0" SelectedIndex="0" SelectionChanged="RconPreset_Changed"><ComboBoxItem Content="Command Library"/><ComboBoxItem Content="Server Info" Tag="Info"/><ComboBoxItem Content="Show Players" Tag="ShowPlayers"/><ComboBoxItem Content="Save World" Tag="Save"/><ComboBoxItem Content="Broadcast Message" Tag="Broadcast "/><ComboBoxItem Content="Kick Player" Tag="KickPlayer "/><ComboBoxItem Content="Ban Player" Tag="BanPlayer "/><ComboBoxItem Content="Shutdown" Tag="Shutdown 60 Server shutting down"/></ComboBox>
       <TextBox x:Name="RconCommandBox" Grid.Column="1" Margin="8,0" KeyDown="RconCommandBox_KeyDown" ToolTip="Type a Palworld RCON command. Press Enter to send; Up/Down recalls command history."/>
       <Button Grid.Column="2" Content="➤  SEND COMMAND" Style="{StaticResource ConfigPrimaryButton}" Click="RconSend_Click" ToolTip="Sends the entered command to the connected Palworld RCON service."/>
      </Grid>
     </Grid>
    </Border>
    <Border Grid.Row="4" Background="#101A24" BorderBrush="#31506C" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,8,0,0">
     <DockPanel>
      <StackPanel DockPanel.Dock="Left"><TextBlock Text="ADMIN COMMANDS MOD" FontSize="15" FontWeight="Bold" Foreground="White"/><TextBlock Text="In-game command extension — MystTiq monitors runtime load state but does not forward !commands over RCON." Foreground="#8299AF" FontSize="11" Margin="0,4,10,0" TextWrapping="Wrap"/></StackPanel>
      <TextBlock x:Name="AdminCommandsStatusText" Text="Not loaded — enable Admin Commands and start the server" Foreground="Gold" DockPanel.Dock="Right" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
   </Grid>
  </TabItem>
  <TabItem Header="Players">
   <Grid Margin="12">
    <Grid.Resources>
     <Style x:Key="PlayerCommandButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
      <Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="112"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="11.5"/>
     </Style>
     <Style x:Key="PlayerCommandSuccessButton" TargetType="Button" BasedOn="{StaticResource SuccessButton}"><Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="112"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="11.5"/></Style>
     <Style x:Key="PlayerCommandDangerButton" TargetType="Button" BasedOn="{StaticResource DangerButton}"><Setter Property="Height" Value="32"/><Setter Property="MinWidth" Value="112"/><Setter Property="Margin" Value="4"/><Setter Property="Padding" Value="10,4"/><Setter Property="FontSize" Value="11.5"/></Style>
