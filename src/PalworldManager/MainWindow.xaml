      <Border Background="#101A24" BorderBrush="#31506C" BorderThickness="1" CornerRadius="8" Padding="12" Margin="4"><StackPanel><TextBlock Text="BASES" Foreground="#9FC4EA" FontWeight="Bold"/><TextBlock x:Name="GuildBasesCardText" Text="0" Foreground="White" FontSize="24" FontWeight="Bold"/></StackPanel></Border>
