    <Border Grid.Row="0" Style="{StaticResource SectionBanner}">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="Server Setup" FontSize="28" FontWeight="Bold" Foreground="White"/>
       <TextBlock Text="Install, verify, and maintain the components required to run your Palworld dedicated server." Foreground="#9FC4EA" FontSize="15" Margin="0,5,20,0"/>
      </StackPanel>
      <Border Grid.Column="1" Background="#15283A" BorderBrush="#31506C" BorderThickness="1" CornerRadius="7" Padding="12,7" VerticalAlignment="Center">
       <StackPanel Orientation="Horizontal">
        <TextBlock Text="ENVIRONMENT HEALTH" Foreground="#8FB7DB" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0"/>
        <TextBlock x:Name="EnvironmentHealthText" Text="Checking..." Foreground="White" FontWeight="Bold" VerticalAlignment="Center"/>
       </StackPanel>
      </Border>
     </Grid>
    </Border>

    <Grid Grid.Row="1" Margin="0,10,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="SERVER ENVIRONMENT" Foreground="White" FontWeight="Bold" FontSize="16" Margin="4,0,0,6"/>
     <DataGrid x:Name="EnvironmentGrid" Grid.Row="1" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" MinHeight="250">
      <DataGrid.Columns>
       <DataGridTemplateColumn Header="ACTION" Width="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><Button Content="{Binding Action}" Padding="9,3" Margin="2" Click="EnvironmentAction_Click" ToolTip="Runs the recommended setup or repair action for this environment item." ContentTemplate="{StaticResource DynamicActionButtonTemplate}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="COMPONENT" Binding="{Binding Component}" Width="210"/>
       <DataGridTemplateColumn Header="STATUS" Width="115"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border x:Name="StatusBadge" CornerRadius="4" Padding="8,3" HorizontalAlignment="Stretch" Background="#465568"><TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="10" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding Status}" Value="READY"><Setter TargetName="StatusBadge" Property="Background" Value="#1F8B4C"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="MISSING"><Setter TargetName="StatusBadge" Property="Background" Value="#B53B3B"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="DISABLED"><Setter TargetName="StatusBadge" Property="Background" Value="#B37A18"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="OPTIONAL"><Setter TargetName="StatusBadge" Property="Background" Value="#B37A18"/></DataTrigger></DataTemplate.Triggers></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
       <DataGridTextColumn Header="LOCATION" Binding="{Binding Location}" Width="2*"/>
       <DataGridTextColumn Header="DETAILS" Binding="{Binding Details}" Width="2.4*"/>
      </DataGrid.Columns>
     </DataGrid>
    </Grid>

