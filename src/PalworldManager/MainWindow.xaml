        </Grid>
       </Grid>
      </Border>
     </Grid>

     <StackPanel Visibility="Collapsed"><DataGrid x:Name="GuildWorldPlayersGrid"/><TextBlock x:Name="GuildDiagnosticsText"/></StackPanel>
