       </ScrollViewer>
       <UniformGrid Grid.Row="2" Columns="2">
        <Button Content="ℹ  MARK READ" Style="{StaticResource SecondaryButton}" Click="NotificationMarkRead_Click" ToolTip="Mark Read."/>
        <Button Content="ℹ  PIN / UNPIN" Style="{StaticResource SecondaryButton}" Click="NotificationPin_Click" ToolTip="Pin / Unpin."/>
        <Button Content="📂  OPEN RELATED" Style="{StaticResource InfoButton}" Click="NotificationOpenRelated_Click" ToolTip="Open Related."/>
        <Button Content="ℹ  DISMISS" Style="{StaticResource NeutralButton}" Click="NotificationDismiss_Click" ToolTip="Dismiss."/>
       </UniformGrid>
      </Grid>
     </Border>
    </Grid>
    <TextBlock Grid.Row="3" x:Name="NotificationStatusText" Text="Notifications are stored locally and persist between manager launches." Foreground="#9FC4EA" Margin="2,10,0,0" TextWrapping="Wrap"/>
   </Grid>
  </TabItem>

