<!-- MystTiq v0.9.9.0: file reviewed for this release (2026-09-29). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:services="using:MystTiq.Desktop.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MystTiq.Desktop.Views.ConfirmDeletePlayerDialog"
        Title="{services:Tr ui.delete_player}"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardGradient}"
        Icon="/Assets/PalworldServerManager.ico">
  <StackPanel Margin="22" Spacing="16">
    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold"/>
    <ItemsControl x:Name="FindingsList">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{services:TrText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,2"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{services:Tr ui.this_permanently_deletes_the_player_s_save_file_7971d5}" Foreground="{DynamicResource OrangeBrush}" TextWrapping="Wrap" FontSize="12"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="{services:Tr ui.cancel}" Click="Cancel_OnClick"/>
      <Button Classes="danger" Content="{services:Tr ui.delete_permanently}" Click="Confirm_OnClick"/>
    </StackPanel>
  </StackPanel>
</Window>
