<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MystTiq.Desktop.Views.ConfirmSaveDiscardDialog"
        Title="Unsaved Changes"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardGradient}"
        Icon="/Assets/PalworldServerManager.ico">
  <StackPanel Margin="22" Spacing="16">
    <TextBlock Text="Unsaved configuration changes" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Cancel" Click="Cancel_OnClick"/>
      <Button Content="Discard" Click="Discard_OnClick"/>
      <Button Classes="primary" Content="Save Changes" Click="Save_OnClick"/>
    </StackPanel>
  </StackPanel>
</Window>
