<!-- MystTiq v0.9.1.0: file reviewed for this release (2026-09-28). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:services="using:MystTiq.Desktop.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MystTiq.Desktop.Views.SelectPlayerDialog"
        Title="{services:Tr ui.select_player}"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardGradient}"
        Icon="/Assets/PalworldServerManager.ico">
  <StackPanel Margin="22" Spacing="14">
    <TextBlock x:Name="PromptText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <ComboBox x:Name="PlayerCombo" HorizontalAlignment="Stretch"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="{services:Tr ui.cancel}" Click="Cancel_OnClick"/>
      <Button Classes="primary" Content="{services:Tr ui.next_1ff57a}" Click="Next_OnClick"/>
    </StackPanel>
  </StackPanel>
</Window>
