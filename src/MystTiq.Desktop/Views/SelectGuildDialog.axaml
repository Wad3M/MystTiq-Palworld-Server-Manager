<!-- MystTiq v1.0.2.0: file reviewed for this release (2026-10-05). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:services="using:MystTiq.Desktop.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MystTiq.Desktop.Views.SelectGuildDialog"
        Title="{services:Tr ui.select_guild}"
        Width="420" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardGradient}"
        Icon="/Assets/PalworldServerManager.ico">
  <StackPanel Margin="22" Spacing="14">
    <TextBlock x:Name="PromptText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <ComboBox AutomationProperties.Name="{services:Tr ui.a11y_guild}" x:Name="GuildCombo" HorizontalAlignment="Stretch"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Classes="plain" Content="{services:Tr ui.cancel}" Click="Cancel_OnClick"/>
      <Button Classes="plain" Content="{services:Tr ui.next_1ff57a}" Click="Next_OnClick"/>
    </StackPanel>
  </StackPanel>
</Window>
