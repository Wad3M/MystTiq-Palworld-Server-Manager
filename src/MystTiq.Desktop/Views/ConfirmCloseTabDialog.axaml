<!-- MystTiq v1.0.5.0: file reviewed for this release (2026-10-06). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:services="using:MystTiq.Desktop.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MystTiq.Desktop.Views.ConfirmCloseTabDialog"
        Title="{services:Tr ui.close_tab}"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardGradient}"
        Icon="/Assets/PalworldServerManager.ico">
  <StackPanel Margin="22" Spacing="16">
    <TextBlock Text="{services:Tr ui.server_is_running}" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Classes="plain" Content="{services:Tr ui.cancel}" Click="Cancel_OnClick"/>
      <Button Classes="caution" Content="{services:Tr ui.leave_running}" Click="LeaveRunning_OnClick"/>
      <Button Classes="danger" Content="{services:Tr ui.stop_and_close}" Click="StopAndClose_OnClick"/>
    </StackPanel>
  </StackPanel>
</Window>
