<!-- MystTiq v0.9.0.0: file reviewed for this release (2026-09-28). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:services="using:MystTiq.Desktop.Services"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MystTiq.Desktop.Views.ConfirmOperationDialog"
        Title="{services:Tr ui.confirm}"
        Width="480" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardGradient}"
        Icon="/Assets/PalworldServerManager.ico">
  <StackPanel Margin="22" Spacing="16">
    <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <ItemsControl x:Name="FindingsList">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,2"/>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock Text="{services:Tr ui.a_fresh_safety_backup_is_taken_automatically_bef_98a00f}" Foreground="{DynamicResource OrangeBrush}" TextWrapping="Wrap" FontSize="12"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="{services:Tr ui.cancel}" Click="Cancel_OnClick"/>
      <Button x:Name="ConfirmButton" Click="Confirm_OnClick"/>
    </StackPanel>
  </StackPanel>
</Window>
