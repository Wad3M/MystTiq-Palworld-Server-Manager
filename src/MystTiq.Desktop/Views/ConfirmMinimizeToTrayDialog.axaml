<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="MystTiq.Desktop.Views.ConfirmMinimizeToTrayDialog"
        Title="Server Still Running"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource CardGradient}"
        Icon="/Assets/PalworldServerManager.ico">
  <StackPanel Margin="22" Spacing="16">
    <TextBlock Text="Server is running" FontSize="16" FontWeight="SemiBold"/>
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
    <TextBlock Text="To stop the server and fully exit instead, use the tray icon's Safe Exit or Force Exit after minimizing." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button Content="Cancel" Click="Cancel_OnClick"/>
      <Button Classes="primary" Content="Minimize to Tray" Click="MinimizeToTray_OnClick"/>
    </StackPanel>
  </StackPanel>
</Window>
