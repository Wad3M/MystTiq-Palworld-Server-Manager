  <Style Selector="ToggleButton.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <Setter Property="Height" Value="58"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="#F4F8FC"/>
    <!-- FluentTheme's ToggleButton template paints its own checked/pointerover background
         directly on an internal template part; a plain Background setter on the control
         cannot override that state-specific template paint. Replacing the template with a
         bare ContentPresenter removes that default chrome entirely, so the only visuals
         are the ones this app draws itself via the child Border.navSurface. -->
    <Setter Property="Template">
      <ControlTemplate TargetType="ToggleButton">
        <ContentPresenter Content="{TemplateBinding Content}"
                           Padding="{TemplateBinding Padding}"
                           HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                           VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </ControlTemplate>
    </Setter>
  </Style>
  <Style Selector="ToggleButton.nav:checked">
    <Setter Property="Foreground" Value="#FFFFFF"/>
  </Style>
  <Style Selector="Border.navSurface">
