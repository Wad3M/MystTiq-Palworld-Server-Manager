<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Styles.Resources>
    <LinearGradientBrush x:Key="PageArtReadabilityGradient" StartPoint="0%,50%" EndPoint="100%,50%">
      <GradientStop Color="#E80A1624" Offset="0"/>
      <GradientStop Color="#C00A1624" Offset="0.45"/>
      <GradientStop Color="#180A1624" Offset="1"/>
    </LinearGradientBrush>
    <Color x:Key="Bg0">#07111D</Color>
    <Color x:Key="Bg1">#0A1624</Color>
    <Color x:Key="Bg2">#0E1D2E</Color>
    <Color x:Key="Card">#E6112235</Color>
    <Color x:Key="CardStrong">#F0122539</Color>
    <Color x:Key="Border">#365C78</Color>
    <Color x:Key="BorderSoft">#223D55</Color>
    <Color x:Key="Blue">#2EA8FF</Color>
    <Color x:Key="Cyan">#35D5E8</Color>
    <Color x:Key="Green">#63DF7B</Color>
    <Color x:Key="Amber">#F4B83F</Color>
    <Color x:Key="Orange">#FF9558</Color>
    <Color x:Key="Violet">#A96DFF</Color>
    <Color x:Key="Magenta">#E676FF</Color>
    <Color x:Key="Red">#FF646D</Color>
    <Color x:Key="Muted">#91A8BF</Color>
    <Color x:Key="Text">#F4F8FC</Color>

    <SolidColorBrush x:Key="Bg0Brush" Color="{DynamicResource Bg0}"/>
    <SolidColorBrush x:Key="Bg1Brush" Color="{DynamicResource Bg1}"/>
    <SolidColorBrush x:Key="Bg2Brush" Color="{DynamicResource Bg2}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{DynamicResource Card}"/>
    <SolidColorBrush x:Key="CardStrongBrush" Color="{DynamicResource CardStrong}"/>
    <!-- v0.8.16.0: the card border (Midnight and High contrast change it) and the density sizes ThemeApplier.ApplyDensity
         sets. These are the Comfortable values; a class-specific style keeps its own size in either density. -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#426784"/>
    <x:Double x:Key="ControlMinHeight">31</x:Double>
    <Thickness x:Key="CardPadding">11</Thickness>
    <Thickness x:Key="InputPadding">9,4</Thickness>
    <Thickness x:Key="ListItemPadding">4,3</Thickness>
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource Border}"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{DynamicResource BorderSoft}"/>
    <SolidColorBrush x:Key="BlueBrush" Color="{DynamicResource Blue}"/>
    <SolidColorBrush x:Key="CyanBrush" Color="{DynamicResource Cyan}"/>
    <SolidColorBrush x:Key="GreenBrush" Color="{DynamicResource Green}"/>
    <SolidColorBrush x:Key="AmberBrush" Color="{DynamicResource Amber}"/>
    <SolidColorBrush x:Key="OrangeBrush" Color="{DynamicResource Orange}"/>
    <SolidColorBrush x:Key="VioletBrush" Color="{DynamicResource Violet}"/>
    <SolidColorBrush x:Key="MagentaBrush" Color="{DynamicResource Magenta}"/>
    <SolidColorBrush x:Key="RedBrush" Color="{DynamicResource Red}"/>
    <SolidColorBrush x:Key="MutedBrush" Color="{DynamicResource Muted}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{DynamicResource Text}"/>
    <SolidColorBrush x:Key="Bg0ScrimBrush" Color="{DynamicResource Bg0Scrim}"/>

    <!-- v0.7.0.0 theming: every Color below is a gradient-stop resource that ThemeApplier.cs
         overwrites at runtime for the selected accent theme/variant (see Services/ThemeCatalog.cs).
         The literal value declared here is always the Default-theme/Dark-variant baseline, so the
         app's current look is unchanged until the user actually picks a different theme. -->
    <Color x:Key="ButtonGradientStop0">#27455E</Color>
    <Color x:Key="ButtonGradientStop1">#183248</Color>
    <Color x:Key="ButtonGradientStop2">#102537</Color>
    <Color x:Key="ButtonGradientHoverStop0">#356886</Color>
    <Color x:Key="ButtonGradientHoverStop1">#22516E</Color>
    <Color x:Key="ButtonGradientHoverStop2">#173C56</Color>
    <Color x:Key="ButtonGradientPressedStop0">#173A50</Color>
    <Color x:Key="ButtonGradientPressedStop1">#102D42</Color>
    <Color x:Key="ButtonGradientPressedStop2">#0A2032</Color>
    <Color x:Key="SuccessGradientStop0">#3FCB8C</Color>
    <Color x:Key="SuccessGradientStop1">#23A96F</Color>
    <Color x:Key="SuccessGradientStop2">#14724A</Color>
    <Color x:Key="SuccessGradientHoverStop0">#5EE0AA</Color>
    <Color x:Key="SuccessGradientHoverStop1">#34C482</Color>
    <Color x:Key="SuccessGradientHoverStop2">#1C8F5C</Color>
    <Color x:Key="SuccessGradientPressedStop0">#14724A</Color>
    <Color x:Key="SuccessGradientPressedStop1">#0F5C3C</Color>
    <Color x:Key="SuccessGradientPressedStop2">#0B4630</Color>
    <Color x:Key="WarningGradientStop0">#FFCB5C</Color>
    <Color x:Key="WarningGradientStop1">#F0B02E</Color>
    <Color x:Key="WarningGradientStop2">#B87A10</Color>
    <Color x:Key="WarningGradientHoverStop0">#FFDE8A</Color>
    <Color x:Key="WarningGradientHoverStop1">#FFC454</Color>
    <Color x:Key="WarningGradientHoverStop2">#D4941C</Color>
    <Color x:Key="WarningGradientPressedStop0">#B87A10</Color>
    <Color x:Key="WarningGradientPressedStop1">#96630D</Color>
    <Color x:Key="WarningGradientPressedStop2">#744C09</Color>
    <Color x:Key="DangerGradientStop0">#F06469</Color>
    <Color x:Key="DangerGradientStop1">#A92E43</Color>
    <!-- v0.7.35.0: two new semantic button hues, neither reusing Primary/Success/Danger/Warning's
         gradients, for the app-wide button color system (item 32). InspectGradient (cyan) covers
         non-mutating "look at/confirm" actions (Browse, Verify, Generate; Save Changes is still
         required after Generate). TargetGradient (violet) covers "act on a specific thing" actions
         (Open/reveal-in-explorer, Manage). -->
    <Color x:Key="InspectGradientStop0">#4FE0F0</Color>
    <Color x:Key="InspectGradientStop1">#2AAECC</Color>
    <Color x:Key="InspectGradientStop2">#1A7488</Color>
    <Color x:Key="InspectGradientHoverStop0">#8CF3FF</Color>
    <Color x:Key="InspectGradientHoverStop1">#4FD0E6</Color>
    <Color x:Key="InspectGradientHoverStop2">#2C93A8</Color>
    <Color x:Key="InspectGradientPressedStop0">#1A7488</Color>
    <Color x:Key="InspectGradientPressedStop1">#155C6C</Color>
    <Color x:Key="InspectGradientPressedStop2">#0F4650</Color>
    <Color x:Key="TargetGradientStop0">#C48CFF</Color>
    <Color x:Key="TargetGradientStop1">#9857E0</Color>
    <Color x:Key="TargetGradientStop2">#653C9E</Color>
    <Color x:Key="TargetGradientHoverStop0">#DAB4FF</Color>
    <Color x:Key="TargetGradientHoverStop1">#B87BFF</Color>
    <Color x:Key="TargetGradientHoverStop2">#7C4FC0</Color>
    <Color x:Key="TargetGradientPressedStop0">#653C9E</Color>
    <Color x:Key="TargetGradientPressedStop1">#4E2E7C</Color>
    <Color x:Key="TargetGradientPressedStop2">#38225C</Color>
    <Color x:Key="PrimaryGradientStop0">#20A9FF</Color>
    <Color x:Key="PrimaryGradientStop1">#2584E8</Color>
    <Color x:Key="PrimaryGradientStop2">#5C4DE4</Color>
    <Color x:Key="CommandSurfaceGradientStop0">#F3173048</Color>
    <Color x:Key="CommandSurfaceGradientStop1">#F111263B</Color>
    <Color x:Key="CommandSurfaceGradientStop2">#F00B1B2D</Color>
    <Color x:Key="CommandSurfaceGradientStop3">#F006121F</Color>
    <Color x:Key="NavSurfaceGradientStop0">#F1122536</Color>
    <Color x:Key="NavSurfaceGradientStop1">#F00A1826</Color>
    <Color x:Key="NavSurfaceGradientStop2">#F0071320</Color>
    <Color x:Key="StatusSurfaceGradientStop0">#F1112639</Color>
    <Color x:Key="StatusSurfaceGradientStop1">#F0091725</Color>
    <Color x:Key="StatusSurfaceGradientStop2">#F00C1A2A</Color>
    <Color x:Key="CardGradientStop0">#F51C3B55</Color>
    <Color x:Key="CardGradientStop1">#F2163048</Color>
    <Color x:Key="CardGradientStop2">#F00D2032</Color>
    <Color x:Key="CardGradientStop3">#F0081422</Color>
    <Color x:Key="ServerTabGradientStop0">#F0071523</Color>
    <Color x:Key="ServerTabGradientStop1">#E90D2236</Color>
    <Color x:Key="ServerTabGradientStop2">#E712304A</Color>
    <Color x:Key="CategoryActiveGradientStop0">#CCA8C0E8</Color>
    <Color x:Key="CategoryActiveGradientStop1">#C088D0FC</Color>
    <Color x:Key="CategoryActiveGradientStop2">#8A3F94E0</Color>
    <Color x:Key="CategoryActiveGradientStop3">#521E5A9E</Color>
    <Color x:Key="CategoryActiveGradientStop4">#260E2648</Color>
    <Color x:Key="ServerTabActiveGradientStop0">#F0061321</Color>
    <Color x:Key="ServerTabActiveGradientStop1">#F0092035</Color>
    <Color x:Key="ServerTabActiveGradientStop2">#F00D3655</Color>
    <Color x:Key="ServerTabActiveGradientStop3">#F0105D86</Color>
    <Color x:Key="InputFieldBg">#0B1A29</Color>
    <Color x:Key="ScrollTrackBg">#081522</Color>
    <Color x:Key="ListRowAltBg">#0C1826</Color>
    <Color x:Key="ListRowHoverBg">#1B3247</Color>
    <Color x:Key="ListRowSelectedBg">#24425C</Color>

    <LinearGradientBrush x:Key="ButtonGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource ButtonGradientStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource ButtonGradientStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource ButtonGradientStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonGradientHover" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource ButtonGradientHoverStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource ButtonGradientHoverStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource ButtonGradientHoverStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ButtonGradientPressed" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource ButtonGradientPressedStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource ButtonGradientPressedStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource ButtonGradientPressedStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource SuccessGradientStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource SuccessGradientStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource SuccessGradientStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessGradientHover" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource SuccessGradientHoverStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource SuccessGradientHoverStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource SuccessGradientHoverStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessGradientPressed" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource SuccessGradientPressedStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource SuccessGradientPressedStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource SuccessGradientPressedStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InspectGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource InspectGradientStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource InspectGradientStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource InspectGradientStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InspectGradientHover" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource InspectGradientHoverStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource InspectGradientHoverStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource InspectGradientHoverStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InspectGradientPressed" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource InspectGradientPressedStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource InspectGradientPressedStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource InspectGradientPressedStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TargetGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource TargetGradientStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource TargetGradientStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource TargetGradientStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TargetGradientHover" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource TargetGradientHoverStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource TargetGradientHoverStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource TargetGradientHoverStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TargetGradientPressed" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource TargetGradientPressedStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource TargetGradientPressedStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource TargetGradientPressedStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WarningGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource WarningGradientStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource WarningGradientStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource WarningGradientStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WarningGradientHover" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource WarningGradientHoverStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource WarningGradientHoverStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource WarningGradientHoverStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="WarningGradientPressed" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="{DynamicResource WarningGradientPressedStop0}"/>
      <GradientStop Offset="0.48" Color="{DynamicResource WarningGradientPressedStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource WarningGradientPressedStop2}"/>
    </LinearGradientBrush>
    <!-- Directional option sheen from the approved mockup: a bright glass lip over a
         translucent blue face, with enough lower-edge depth to avoid a flat fill. -->
    <LinearGradientBrush x:Key="GlassOptionHoverGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#C15FA9D8"/>
      <GradientStop Offset="0.08" Color="#9A3277A8"/>
      <GradientStop Offset="0.26" Color="#7A1F567E"/>
      <GradientStop Offset="0.62" Color="#D0143855"/>
      <GradientStop Offset="1" Color="#ED081A2C"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="{DynamicResource PrimaryGradientStop0}"/>
      <GradientStop Offset="0.55" Color="{DynamicResource PrimaryGradientStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource PrimaryGradientStop2}"/>
    </LinearGradientBrush>
    <!-- Resting-state glass treatment for primary buttons: a bright translucent lip over a
         softly-tinted blue face, matching the glass look the hover states already use. -->
    <LinearGradientBrush x:Key="PrimaryGlassGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#9A6FC2F5"/>
      <GradientStop Offset="0.22" Color="#7A4498D8"/>
      <GradientStop Offset="0.6" Color="#682D6ED0"/>
      <GradientStop Offset="1" Color="#7A6B4DE4"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGlassHoverGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#C48ED4FF"/>
      <GradientStop Offset="0.22" Color="#9E5FB0F0"/>
      <GradientStop Offset="0.6" Color="#8A3E8CE8"/>
      <GradientStop Offset="1" Color="#9C7F5EEE"/>
    </LinearGradientBrush>
    <!-- Softer, translucent Start/Stop treatment: same glass structure and alpha weight as
         PrimaryGlassGradient above (so Start/Stop read at the same visual intensity as every
         other ribbon button), just tinted green/red instead of full-opacity danger/success fills. -->
    <LinearGradientBrush x:Key="SuccessGlassGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#9A7FE5B0"/>
      <GradientStop Offset="0.22" Color="#7A4FC48C"/>
      <GradientStop Offset="0.6" Color="#68389E70"/>
      <GradientStop Offset="1" Color="#7A5A9A6E"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SuccessGlassHoverGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#C49EF0C4"/>
      <GradientStop Offset="0.22" Color="#9E6BD4A0"/>
      <GradientStop Offset="0.6" Color="#8A4CAE84"/>
      <GradientStop Offset="1" Color="#9C88B080"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGlassGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#9AF0989C"/>
      <GradientStop Offset="0.6" Color="#68C4666F"/>
      <GradientStop Offset="1" Color="#7AA9525E"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGlassHoverGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#C4F5B4B7"/>
      <GradientStop Offset="0.6" Color="#8AD68890"/>
      <GradientStop Offset="1" Color="#9CBF7480"/>
    </LinearGradientBrush>
    <!-- v0.7.79.0: same glass structure/alpha weight as SuccessGlassGradient above, amber-tinted.
         Added for the Server Setup environment table's status pills (Ready/Disabled/Missing), which
         previously used flat DynamicResource GreenBrush/AmberBrush/RedBrush fills; no amber glass
         variant existed yet. -->
    <LinearGradientBrush x:Key="WarningGlassGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#9AFFD585"/>
      <GradientStop Offset="0.22" Color="#7AF0B850"/>
      <GradientStop Offset="0.6" Color="#689E7A30"/>
      <GradientStop Offset="1" Color="#7AB08850"/>
    </LinearGradientBrush>

    <!-- v0.5.0.8 surface lighting: brighter upper-left edge, deeper lower-right face. -->
    <LinearGradientBrush x:Key="CommandSurfaceGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="{DynamicResource CommandSurfaceGradientStop0}"/>
      <GradientStop Offset="0.36" Color="{DynamicResource CommandSurfaceGradientStop1}"/>
      <GradientStop Offset="0.72" Color="{DynamicResource CommandSurfaceGradientStop2}"/>
      <GradientStop Offset="1" Color="{DynamicResource CommandSurfaceGradientStop3}"/>
    </LinearGradientBrush>
    <!-- Selected-state glass. A near-white specular lip at the top-left is what actually reads as
         "glass" against a same-hue backdrop: pure alpha-blended blue over a blue navbar just looks
         like a richer blue, not translucent, so the highlight has to carry its own contrast. -->
    <LinearGradientBrush x:Key="CategoryActiveGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="{DynamicResource CategoryActiveGradientStop0}"/>
      <GradientStop Offset="0.38" Color="{DynamicResource CategoryActiveGradientStop1}"/>
      <GradientStop Offset="0.66" Color="{DynamicResource CategoryActiveGradientStop2}"/>
      <GradientStop Offset="0.88" Color="{DynamicResource CategoryActiveGradientStop3}"/>
      <GradientStop Offset="1" Color="{DynamicResource CategoryActiveGradientStop4}"/>
    </LinearGradientBrush>
    <!-- Darkened to match the connection-profile tab strip's near-black selected look, instead
         of fading up to a light lavender/white top edge. -->
    <LinearGradientBrush x:Key="NavSelectedGlassGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#D0182838"/>
      <GradientStop Offset="0.38" Color="#C0142230"/>
      <GradientStop Offset="0.68" Color="#B00E1A24"/>
      <GradientStop Offset="0.9" Color="#A00A1218"/>
      <GradientStop Offset="1" Color="#9A05080C"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavHoverGlassGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#A882C0E0"/>
      <GradientStop Offset="0.4" Color="#7C4E8EC4"/>
      <GradientStop Offset="0.72" Color="#582C5C90"/>
      <GradientStop Offset="1" Color="#2A122850"/>
    </LinearGradientBrush>
    <!-- Selected AND hovered at once: hovering an already-checked nav item must still visibly
         shift (checked's own Background otherwise wins over pointerover's with no change at all),
         so this is a uniformly lightened pass of NavSelectedGlassGradient's stops. -->
    <LinearGradientBrush x:Key="NavSelectedHoverGlassGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#E0203444"/>
      <GradientStop Offset="0.38" Color="#D01A2C3C"/>
      <GradientStop Offset="0.68" Color="#C0142230"/>
      <GradientStop Offset="0.9" Color="#B00E1A24"/>
      <GradientStop Offset="1" Color="#A80A1218"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DashboardGlassGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#4C1C3D62"/>
      <GradientStop Offset="0.35" Color="#300B1B2C"/>
      <GradientStop Offset="0.70" Color="#301B3260"/>
      <GradientStop Offset="1" Color="#26071120"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextBlueGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#3B174B78"/>
      <GradientStop Offset="1" Color="#CA0D2033"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextVioletGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#442B245A"/>
      <GradientStop Offset="1" Color="#CA11182B"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextAmberGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#46392D19"/>
      <GradientStop Offset="1" Color="#CA171A1D"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextMagentaGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#42362755"/>
      <GradientStop Offset="1" Color="#CA171727"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ContextOrangeGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#463A271E"/>
      <GradientStop Offset="1" Color="#CA17191E"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavSurfaceGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="{DynamicResource NavSurfaceGradientStop0}"/>
      <GradientStop Offset="0.55" Color="{DynamicResource NavSurfaceGradientStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource NavSurfaceGradientStop2}"/>
    </LinearGradientBrush>
    <!-- Glass treatment for the sidebar surface. The panel is tall and narrow, so a corner-to-corner
         diagonal squeezes the highlight into a sliver; a top-to-bottom gradient with a genuinely
         bright cap reads as glass lit from above, matching how the tabs/buttons read once their
         bright stop was given real area instead of a thin corner lip. -->
    <LinearGradientBrush x:Key="NavGlassSurfaceGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#8C4E80AC"/>
      <GradientStop Offset="0.12" Color="#6C386896"/>
      <GradientStop Offset="0.3" Color="#582A5678"/>
      <GradientStop Offset="0.65" Color="#4A17324C"/>
      <GradientStop Offset="1" Color="#4A0A1826"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="StatusSurfaceGradient" StartPoint="0%,0%" EndPoint="1,0">
      <GradientStop Offset="0" Color="{DynamicResource StatusSurfaceGradientStop0}"/>
      <GradientStop Offset="0.55" Color="{DynamicResource StatusSurfaceGradientStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource StatusSurfaceGradientStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="{DynamicResource CardGradientStop0}"/>
      <GradientStop Offset="0.16" Color="{DynamicResource CardGradientStop1}"/>
      <GradientStop Offset="0.58" Color="{DynamicResource CardGradientStop2}"/>
      <GradientStop Offset="1" Color="{DynamicResource CardGradientStop3}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardGreenGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#F0183B3D"/>
      <GradientStop Offset="0.28" Color="#F0122B3C"/>
      <GradientStop Offset="1" Color="#F00A1726"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardCyanGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#F0183850"/>
      <GradientStop Offset="0.34" Color="#F0122A40"/>
      <GradientStop Offset="1" Color="#F00A1828"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardVioletGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#F0282850"/>
      <GradientStop Offset="0.35" Color="#F0172442"/>
      <GradientStop Offset="1" Color="#F00B182A"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardRedGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#F0602828"/>
      <GradientStop Offset="0.35" Color="#F0481E1E"/>
      <GradientStop Offset="1" Color="#F0200E10"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardNeutralGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#F0335370"/>
      <GradientStop Offset="0.35" Color="#F0294460"/>
      <GradientStop Offset="1" Color="#F0142A3E"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardAmberGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#F0654420"/>
      <GradientStop Offset="0.35" Color="#F04C3418"/>
      <GradientStop Offset="1" Color="#F02A1F10"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardDarkGreenGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#F01F4C32"/>
      <GradientStop Offset="0.35" Color="#F0173D28"/>
      <GradientStop Offset="1" Color="#F00E2418"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardPurpleGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#F0553076"/>
      <GradientStop Offset="0.35" Color="#F0442760"/>
      <GradientStop Offset="1" Color="#F0261640"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ServerTabGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="{DynamicResource ServerTabGradientStop0}"/>
      <GradientStop Offset="0.58" Color="{DynamicResource ServerTabGradientStop1}"/>
      <GradientStop Offset="1" Color="{DynamicResource ServerTabGradientStop2}"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ServerTabHoverGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#F0091C2D"/>
      <GradientStop Offset="0.58" Color="#E9163D5C"/>
      <GradientStop Offset="1" Color="#E91B5F8B"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ServerTabActiveGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="{DynamicResource ServerTabActiveGradientStop0}"/>
      <GradientStop Offset="0.55" Color="{DynamicResource ServerTabActiveGradientStop1}"/>
      <GradientStop Offset="0.86" Color="{DynamicResource ServerTabActiveGradientStop2}"/>
      <GradientStop Offset="1" Color="{DynamicResource ServerTabActiveGradientStop3}"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BlueGraphFill" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#7052C4FF"/>
      <GradientStop Offset="0.62" Color="#2839A6D8"/>
      <GradientStop Offset="1" Color="#0039A6D8"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CyanGraphFill" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#7035D5E8"/>
      <GradientStop Offset="0.62" Color="#2535D5E8"/>
      <GradientStop Offset="1" Color="#0035D5E8"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="VioletGraphFill" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#70C377FF"/>
      <GradientStop Offset="0.62" Color="#25A96DFF"/>
      <GradientStop Offset="1" Color="#00A96DFF"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GreenGraphFill" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#707ED45C"/>
      <GradientStop Offset="0.62" Color="#257ED45C"/>
      <GradientStop Offset="1" Color="#007ED45C"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AmberGraphFill" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#70F4B83F"/>
      <GradientStop Offset="0.62" Color="#25F4B83F"/>
      <GradientStop Offset="1" Color="#00F4B83F"/>
    </LinearGradientBrush>

    <!-- v0.5.0.8 contextual/data-surface gradients -->
    <LinearGradientBrush x:Key="BackupContextGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#5C4B3518"/>
      <GradientStop Offset="0.45" Color="#E21C2630"/>
      <GradientStop Offset="1" Color="#D70C1723"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BackupProtectionGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#F02F3822"/>
      <GradientStop Offset="0.4" Color="#F0172B30"/>
      <GradientStop Offset="1" Color="#F00A1724"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BackupStorageGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#F0193851"/>
      <GradientStop Offset="0.45" Color="#F00F273B"/>
      <GradientStop Offset="1" Color="#F0091726"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BackupRetentionGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="#F03B2D1B"/>
      <GradientStop Offset="0.45" Color="#F024221E"/>
      <GradientStop Offset="1" Color="#F00B1723"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RestoreGradient" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#5A8B5A23"/>
      <GradientStop Offset="0.48" Color="#C64B351A"/>
      <GradientStop Offset="1" Color="#D6231D18"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="RestoreGradientHover" StartPoint="0%,0%" EndPoint="0%,100%">
      <GradientStop Offset="0" Color="#8ABF7A2B"/>
      <GradientStop Offset="0.48" Color="#E2714E1D"/>
      <GradientStop Offset="1" Color="#E83A2718"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="DangerGradient" StartPoint="0%,0%" EndPoint="100%,100%">
      <GradientStop Offset="0" Color="{DynamicResource DangerGradientStop0}"/>
      <GradientStop Offset="1" Color="{DynamicResource DangerGradientStop1}"/>
    </LinearGradientBrush>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource Bg0Brush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Inter, Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="TextBlock.display">
    <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable Display, Inter"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
  </Style>
  <Style Selector="TextBlock.ellipsis">
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style Selector="TextBlock.path">
    <Setter Property="TextWrapping" Value="NoWrap"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Inter"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style Selector="TextBlock.flatIcon">
    <Setter Property="FontFamily" Value="Segoe UI Symbol, Segoe UI, Inter"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="FontSize" Value="20"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextAlignment" Value="Center"/>
  </Style>
  <!-- v0.7.25.0: ribbon icon colors used to be set inline per-button (Foreground="{DynamicResource
       AmberBrush}" etc.) directly in MainWindow.axaml. Now that ribbon buttons are data-bound
       (RibbonActionViewModel.IconColor), the color still has to route through DynamicResource,
       not a resolved-at-construction brush, so it keeps following live theme changes exactly like
       every other themed color in the app. These selectors are the binding target for that. -->
  <Style Selector="TextBlock.flatIcon.amber"><Setter Property="Foreground" Value="{DynamicResource AmberBrush}"/></Style>
  <Style Selector="TextBlock.flatIcon.green"><Setter Property="Foreground" Value="{DynamicResource GreenBrush}"/></Style>
  <Style Selector="TextBlock.flatIcon.blue"><Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/></Style>
  <Style Selector="TextBlock.flatIcon.red"><Setter Property="Foreground" Value="{DynamicResource RedBrush}"/></Style>
  <Style Selector="TextBlock.flatIcon.cyan"><Setter Property="Foreground" Value="{DynamicResource CyanBrush}"/></Style>
  <!-- v0.8.1.0: the user's vector Ribbon icons, drawn to their spec: 24 DIP on a 24x24 grid, 1.8 rounded stroke,
       no fill, stroke in the same theme-aware colour as the glyph it replaces. Disabled state stays the whole
       button's opacity (Button:disabled), so colour never has to signal availability on its own. -->
  <Style Selector="Path.ribbonIcon">
    <Setter Property="Width" Value="24"/>
    <Setter Property="Height" Value="24"/>
    <Setter Property="Stretch" Value="Uniform"/>
    <Setter Property="StrokeThickness" Value="1.8"/>
    <Setter Property="StrokeLineCap" Value="Round"/>
    <Setter Property="StrokeJoin" Value="Round"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Path.ribbonIcon.amber"><Setter Property="Stroke" Value="{DynamicResource AmberBrush}"/></Style>
  <Style Selector="Path.ribbonIcon.green"><Setter Property="Stroke" Value="{DynamicResource GreenBrush}"/></Style>
  <Style Selector="Path.ribbonIcon.blue"><Setter Property="Stroke" Value="{DynamicResource BlueBrush}"/></Style>
  <Style Selector="Path.ribbonIcon.red"><Setter Property="Stroke" Value="{DynamicResource RedBrush}"/></Style>
  <Style Selector="Path.ribbonIcon.cyan"><Setter Property="Stroke" Value="{DynamicResource CyanBrush}"/></Style>

  <Style Selector="Button">
    <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}"/>
    <Setter Property="Padding" Value="12,5"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Background" Value="{DynamicResource ButtonGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_5F7F98}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <!-- v0.8.25.0: white, or a Windows contrast theme's button text (its buttons take its button face). -->
    <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource ButtonGradientHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
  </Style>
  <Style Selector="Button:pointerover Border.iconTile">
    <Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_1}"/>
  </Style>
  <Style Selector="Button:pointerover Border.navIcon">
    <Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_2}"/>
  </Style>
  <Style Selector="Button:pressed">
    <Setter Property="Opacity" Value="0.92"/>
    <Setter Property="Background" Value="{DynamicResource ButtonGradientPressed}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_5AAED4}"/>
  </Style>
  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.38"/>
  </Style>
  <!-- v0.7.75.0: no MenuItem styling existed anywhere in this app; context menus (e.g. the
       Players page's Kick/Ban/Whisper/Promote/Give Item right-click menu) relied entirely on
       FluentTheme's own default disabled-state dimming, which reads as barely distinguishable from
       enabled against this app's own dark backgrounds. Reported live as "right-click looks broken":
       Kick/Ban are correctly CanExecute-gated on the selected player being online (this app has no
       server running / no online player at the time), but with no clear disabled look, a
       legitimately-disabled item is indistinguishable from a genuinely broken one. Matches the same
       0.38 opacity convention Button:disabled already established above, for consistency.-->
  <Style Selector="MenuItem:disabled">
    <Setter Property="Opacity" Value="0.38"/>
  </Style>
  <!-- v0.7.63.0: moved from App.axaml's now-removed legacy style block, which hardcoded #75C8FF
       regardless of theme; keyboard-focus outline now follows the active accent theme instead. -->
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>
  <!-- v0.7.5.0 no-scroll pass: a header-styled toggle for collapsible secondary sections
       (deep-dive tools shown collapsed by default so a page's primary content is reachable
       without scrolling past them). Looks like plain text, not a button, until hovered. -->
  <Style Selector="Button.sectionToggle">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Cursor" Value="Hand"/>
  </Style>
  <Style Selector="Button.sectionToggle:pointerover">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Opacity" Value="0.8"/>
  </Style>
  <Style Selector="Button.sectionToggle:pressed">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="Opacity" Value="0.7"/>
  </Style>
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryGlassGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_7DD9FF}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="10" Color="{DynamicResource Blue}" Opacity="0.32"/></Setter>
  </Style>
  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource PrimaryGlassHoverGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_C4F1FF}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="16" Color="{DynamicResource Blue}" Opacity="0.62"/></Setter>
  </Style>
  <Style Selector="Button.danger">
    <Setter Property="Background" Value="{DynamicResource DangerGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_FF858C}"/>
  </Style>
  <Style Selector="Button.danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource DangerGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_FFC0C4}"/>
  </Style>
  <Style Selector="Button.success">
    <Setter Property="Background" Value="{DynamicResource SuccessGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_5EE0AA}"/>
    <Setter Property="Foreground" Value="{DynamicResource SuccessButtonForegroundBrush}"/>
  </Style>
  <Style Selector="Button.success:pointerover">
    <Setter Property="Background" Value="{DynamicResource SuccessGradientHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_9AF0C8}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="12" Color="{DynamicResource Green}" Opacity="0.5"/></Setter>
  </Style>
  <Style Selector="Button.success:pressed">
    <Setter Property="Background" Value="{DynamicResource SuccessGradientPressed}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_2E9E6C}"/>
  </Style>
  <Style Selector="Button.warning">
    <Setter Property="Background" Value="{DynamicResource WarningGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_FFDE8A}"/>
    <Setter Property="Foreground" Value="{DynamicResource DecoForeground_2A1B04}"/>
  </Style>
  <Style Selector="Button.warning:pointerover">
    <Setter Property="Background" Value="{DynamicResource WarningGradientHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_FFEBB0}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="12" Color="{DynamicResource Amber}" Opacity="0.5"/></Setter>
  </Style>
  <Style Selector="Button.warning:pressed">
    <Setter Property="Background" Value="{DynamicResource WarningGradientPressed}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_C4841A}"/>
  </Style>
  <!-- v0.7.35.0 button color system (item 32): inspectAction (cyan) for non-mutating "look at /
       confirm" actions, e.g. Workspace's Browse buttons, Server Setup's VERIFY/RESCAN row actions,
       Configuration's Generate. targetAction (violet) for "act on a specific thing" actions, e.g.
       Workspace's Open-in-explorer buttons, Server Setup's MANAGE/INSTALL/CREATE/ENABLE row
       actions. Neither reuses Primary/Success/Danger/Warning, so these read as their own thing
       rather than looking like a Save/Start button. -->
  <Style Selector="Button.inspectAction">
    <Setter Property="Background" Value="{DynamicResource InspectGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_6FE8F5}"/>
    <Setter Property="Foreground" Value="{DynamicResource DecoForeground_EAFEFF}"/>
  </Style>
  <Style Selector="Button.inspectAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource InspectGradientHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_B0F7FF}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="12" Color="{DynamicResource Cyan}" Opacity="0.5"/></Setter>
  </Style>
  <Style Selector="Button.inspectAction:pressed">
    <Setter Property="Background" Value="{DynamicResource InspectGradientPressed}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_1A7488}"/>
  </Style>
  <Style Selector="Button.targetAction">
    <Setter Property="Background" Value="{DynamicResource TargetGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_D4B3FF}"/>
    <Setter Property="Foreground" Value="{DynamicResource DecoForeground_F5ECFF}"/>
  </Style>
  <Style Selector="Button.targetAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource TargetGradientHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_E9D6FF}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="12" Color="{DynamicResource Violet}" Opacity="0.5"/></Setter>
  </Style>
  <Style Selector="Button.targetAction:pressed">
    <Setter Property="Background" Value="{DynamicResource TargetGradientPressed}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_653C9E}"/>
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
  </Style>
  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="{DynamicResource DecoBackground_25334C61}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_466987}"/>
  </Style>
  <Style Selector="Button.ribbon">
    <Setter Property="MinWidth" Value="64"/>
    <Setter Property="Height" Value="64"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="Background" Value="{DynamicResource ButtonGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_385B73}"/>
  </Style>
  <Style Selector="Button.ribbon:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassOptionHoverGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="13" Color="{DynamicResource Blue}" Opacity="0.5"/></Setter>
  </Style>
  <Style Selector="Button.ribbon:pointerover Border.iconTile">
    <Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_3}"/>
  </Style>
  <!-- Ribbon buttons that are also primary (e.g. Start) must re-assert the glass treatment here:
       Button.ribbon's own Background/hover setters above are declared later than Button.primary's
       and win ties on equal (single-class) specificity, so without this the ribbon flat fill
       silently wins over the primary glass look for any button carrying both classes. -->
  <Style Selector="Button.ribbon.primary">
    <Setter Property="Background" Value="{DynamicResource PrimaryGlassGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_7DD9FF}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="10" Color="{DynamicResource Blue}" Opacity="0.32"/></Setter>
  </Style>
  <Style Selector="Button.ribbon.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource PrimaryGlassHoverGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_C4F1FF}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="18" Color="{DynamicResource Blue}" Opacity="0.72"/></Setter>
  </Style>
  <!-- Same fix for ribbon+danger (Stop): without this, the ribbon flat fill silently wins over
       the danger background too. Uses the softer translucent DangerGlassGradient (not the fully-
       opaque DangerGradient other danger buttons use elsewhere) so Stop reads at the same lighter
       intensity as Start below, rather than standing out as the one saturated ribbon button. -->
  <Style Selector="Button.ribbon.danger">
    <Setter Property="Background" Value="{DynamicResource DangerGlassGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_E39399}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="10" Color="{DynamicResource Red}" Opacity="0.22"/></Setter>
  </Style>
  <Style Selector="Button.ribbon.danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource DangerGlassHoverGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_FFC0C4}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="16" Color="{DynamicResource Red}" Opacity="0.45"/></Setter>
  </Style>
  <!-- Start uses this (Classes="ribbon success") instead of ribbon.primary, so it reads as a
       distinct, lightly-green-highlighted action: the same translucent glass weight as Stop's
       danger treatment above, just tinted green, rather than sharing the generic blue "primary"
       look every other ribbon button already uses. -->
  <Style Selector="Button.ribbon.success">
    <Setter Property="Background" Value="{DynamicResource SuccessGlassGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_8FE0B0}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="10" Color="{DynamicResource Green}" Opacity="0.22"/></Setter>
  </Style>
  <Style Selector="Button.ribbon.success:pointerover">
    <Setter Property="Background" Value="{DynamicResource SuccessGlassHoverGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_C4F1D9}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="16" Color="{DynamicResource Green}" Opacity="0.45"/></Setter>
  </Style>

  <Style Selector="Button.ribbon StackPanel">
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
  </Style>
  <Style Selector="Button.ribbon TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- v0.7.14.0: App.axaml's Button:focus-visible ring (BorderBrush #75C8FF) has equal selector
       specificity to Button.ghost/.ribbon's own always-on BorderBrush setters above, so whichever
       is declared later in document order wins the tie: these classes, loaded via StyleInclude
       after App.axaml's inline styles, always won and silently swallowed the focus ring. Tabbing to
       any ghost/ribbon button (window chrome, tab-close, ribbon actions) showed no visible focus
       indicator at all. Re-asserting the same ring color here at :focus-visible restores it. -->
  <Style Selector="Button.ghost:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
  </Style>
  <Style Selector="Button.ribbon:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
  </Style>
  <Style Selector="Button.ribbonCompact:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
  </Style>
  <Style Selector="Button.ribbonMedium:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
  </Style>

  <Style Selector="Border.iconTile">
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_4}"/>
    <Setter Property="Margin" Value="0,0,0,3"/>
  </Style>
  <Style Selector="Border.navIcon">
    <Setter Property="Width" Value="28"/>
    <Setter Property="Height" Value="28"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <!-- v0.7.4.0 "card flare": a passive per-nav-category accent (soft border tint + low-intensity
       glow), applied broadly across each category's cards so a page visually identifies which
       section of the app it belongs to at a glance. Declared BEFORE the status-driven glowGreen/
       glowRed/etc. selectors below on purpose: those carry real meaning (something is actually
       healthy/failing/warning) and must win the cascade on the rare element that ends up
       carrying both an accent class and a status-glow class, since both are 2-class selectors of
       otherwise-equal specificity and Avalonia resolves such ties by declaration order. Much
       lower-alpha than the status glows (~0x30 vs ~0x5A) since this is decorative, not a signal. -->
  <Style Selector="Border.card.accentHome, Border.statuscard.accentHome">
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource BlueAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.card.accentServer, Border.statuscard.accentServer">
    <Setter Property="BorderBrush" Value="{DynamicResource CyanAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource CyanAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.card.accentWorld, Border.statuscard.accentWorld">
    <Setter Property="BorderBrush" Value="{DynamicResource VioletAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource VioletAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.card.accentBackups, Border.statuscard.accentBackups">
    <Setter Property="BorderBrush" Value="{DynamicResource AmberAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource AmberAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.card.accentMods, Border.statuscard.accentMods">
    <Setter Property="BorderBrush" Value="{DynamicResource MagentaAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource MagentaAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.card.accentTools, Border.statuscard.accentTools">
    <Setter Property="BorderBrush" Value="{DynamicResource OrangeAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource OrangeAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.card.accentSystem, Border.statuscard.accentSystem">
    <Setter Property="BorderBrush" Value="{DynamicResource GreenAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource GreenAccentGlowShadowLow}"/>
  </Style>

  <!-- v0.7.82.0: unsaved-edit highlight for Simple Settings rows (Server Identity, Network toggles,
       World Settings sliders), distinct from Advanced Settings' Border.differsFromDefault, which
       flags active value against Palworld's factory default, regardless of save state. This flags
       active value against what was last loaded/saved, i.e. Configuration's own IsDirty/"Unsaved"
       state. Declared after the accentXxx block above so it wins the equal-specificity (2-class)
       cascade tie on rows that also carry an accent class. -->
  <Style Selector="Border.statuscard.dirty">
    <Setter Property="BorderBrush" Value="{DynamicResource AmberAccentBorderBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="Background" Value="{DynamicResource CardAmberGradient}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource AmberAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="TextBox.dirty">
    <Setter Property="BorderBrush" Value="{DynamicResource AmberBrush}"/>
    <Setter Property="BorderThickness" Value="2"/>
  </Style>

  <Style Selector="Border.card.glowGreen">
    <Setter Property="Background" Value="{DynamicResource CardGreenGradient}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource GreenAccentGlowShadowHigh}"/>
  </Style>
  <Style Selector="Border.card.glowCyan">
    <Setter Property="Background" Value="{DynamicResource CardCyanGradient}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource CyanAccentGlowShadowHigh}"/>
  </Style>
  <Style Selector="Border.card.glowViolet">
    <Setter Property="Background" Value="{DynamicResource CardVioletGradient}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource VioletAccentGlowShadowHigh}"/>
  </Style>
  <Style Selector="Button.ribbonCompact">
    <Setter Property="Height" Value="38"/>
    <Setter Property="MinWidth" Value="42"/>
    <Setter Property="Padding" Value="8,4"/>
  </Style>
  <Style Selector="Button.ribbonCompact:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassOptionHoverGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="10" Color="{DynamicResource Blue}" Opacity="0.46"/></Setter>
  </Style>
  <Style Selector="Button.ribbonMedium">
    <Setter Property="Height" Value="40"/>
    <Setter Property="MinWidth" Value="88"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="Margin" Value="0,0,5,0"/>
  </Style>
  <Style Selector="Button.ribbonMedium:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassOptionHoverGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="11" Color="{DynamicResource Blue}" Opacity="0.46"/></Setter>
  </Style>
  <Style Selector="ToggleButton.categoryTab">
    <Setter Property="Height" Value="36"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Margin" Value="1,1,1,0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0,2,0,2"/>
    <!-- v0.7.80.0 bugfix: reported live; #F4F8FC is byte-identical to Structural["Text"]["Dark"]
         (TextBrush's own Dark value), so this was clearly meant to reference it, not hardcode a
         copy. Hardcoded, the category tab labels stayed near-white in Light mode too, unreadable
         against Light's now-correctly-light chrome. -->
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Border.categoryTabGlow">
    <Setter Property="Padding" Value="14,4"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="ToggleButton.categoryTab:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="11" Color="{DynamicResource Blue}" Opacity="0.46"/></Setter>
  </Style>
  <!-- v0.7.34.0: was reversed; checked used the bright CategoryActiveGradient and pointerover
       used the darker GlassOptionHoverGradient, contradicting the "Category selection is dark
       glass" comment below and how every other selected/hover glass surface in this app reads
       (hover is the bright glass sheen, selection settles into the darker glass look). Swapped. -->
  <Style Selector="ToggleButton.categoryTab:pointerover Border.categoryTabGlow">
    <Setter Property="Background" Value="{DynamicResource CategoryActiveGradient}"/>
  </Style>
  <Style Selector="ToggleButton.categoryTab:checked">
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <!-- v0.7.80.0 bugfix: reported live as a "weird broken outline" on the selected category tab in
       Light mode; this glow was a fixed hex color independent of both theme and which category's
       own border color (Cyan/Violet/Amber/Magenta/Orange/Green) surrounds it, so a mismatched
       purple-blue glow behind e.g. a green-bordered "System" tab read as broken rather than a
       cohesive highlight, worse once GlassOptionHoverGradient's own Background correctly lightens
       in Light mode and this fixed dark-tuned glow doesn't follow. BlueAccentGlowShadowHigh is
       already Dark/Light + accent-theme aware; doesn't yet match each category's own border hue,
       a further per-category pass would need its own BoxShadow resource per category color. -->
  <Style Selector="ToggleButton.categoryTab:checked Border.categoryTabGlow">
    <Setter Property="Background" Value="{DynamicResource GlassOptionHoverGradient}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource BlueAccentGlowShadowHigh}"/>
  </Style>
  <!-- v0.7.14.0: same missing-focus-ring gap as Button.ghost/.ribbon above; ToggleButton derives
       from Button, so App.axaml's Button:focus-visible rule does technically match, but this
       class's own BorderBrush (Transparent by default, a checked color otherwise) is declared later
       and always won the tie. Tabbing through the 7 category tabs showed no focus indicator. -->
  <Style Selector="ToggleButton.categoryTab:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
  </Style>
  <!-- Category selection is dark glass; semantic color lives on the overline, underline and glow.
       v0.7.55.0: server/system both used to be one-off near-cyan hex values with no home in the
       catalog at all (#52C4FF, #72C8E8) rather than reusing Cyan/Green like every sibling category
       here reuses its own page-accent color; switched to the same Cyan/Green derived resources
       accentServer/accentSystem already use elsewhere, so this row is internally consistent with
       the rest of the per-page accent system instead of carrying its own separate two-off palette. -->
  <Style Selector="ToggleButton.categoryTab.server:checked"><Setter Property="BorderBrush" Value="{DynamicResource Cyan}"/></Style>
  <Style Selector="ToggleButton.categoryTab.world:checked"><Setter Property="BorderBrush" Value="{DynamicResource Violet}"/></Style>
  <Style Selector="ToggleButton.categoryTab.backups:checked"><Setter Property="BorderBrush" Value="{DynamicResource Amber}"/></Style>
  <Style Selector="ToggleButton.categoryTab.mods:checked"><Setter Property="BorderBrush" Value="{DynamicResource Magenta}"/></Style>
  <Style Selector="ToggleButton.categoryTab.tools:checked"><Setter Property="BorderBrush" Value="{DynamicResource Orange}"/></Style>
  <Style Selector="ToggleButton.categoryTab.system:checked"><Setter Property="BorderBrush" Value="{DynamicResource Green}"/></Style>
  <Style Selector="ToggleButton.categoryTab.mods:checked Border.categoryTabGlow"><Setter Property="BoxShadow" Value="{DynamicResource MagentaAccentGlowShadowHigh}"/></Style>
  <Style Selector="ToggleButton.categoryTab.backups:checked Border.categoryTabGlow"><Setter Property="BoxShadow" Value="{DynamicResource AmberAccentGlowShadowHigh}"/></Style>
  <Style Selector="ToggleButton.categoryTab.world:checked Border.categoryTabGlow"><Setter Property="BoxShadow" Value="{DynamicResource VioletAccentGlowShadowHigh}"/></Style>
  <Style Selector="ToggleButton.categoryTab.tools:checked Border.categoryTabGlow"><Setter Property="BoxShadow" Value="{DynamicResource OrangeAccentGlowShadowHigh}"/></Style>
  <Style Selector="ToggleButton.categoryTab.system:checked Border.categoryTabGlow"><Setter Property="BoxShadow" Value="{DynamicResource GreenAccentGlowShadowHigh}"/></Style>
  <!-- v0.8.17.0: the HOST tab. -->
  <Style Selector="ToggleButton.categoryTab.host:checked"><Setter Property="BorderBrush" Value="{DynamicResource Blue}"/></Style>
  <Style Selector="ToggleButton.categoryTab.host:checked Border.categoryTabGlow"><Setter Property="BoxShadow" Value="{DynamicResource BlueAccentGlowShadowHigh}"/></Style>

  <Style Selector="Border.worldTabHeader">
    <Setter Property="Background" Value="{DynamicResource DecoBackground_B8162638}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_4E6E8BA8}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="7,5"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_5}"/>
  </Style>
  <Style Selector="TextBlock.worldTabLabel">
    <Setter Property="FontSize" Value="9"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <!-- v0.7.80.0 bugfix: same family as the other fixes in this pass; close to MutedBrush's own
         Dark value, hardcoded instead of referenced. -->
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="4,0,8,0"/>
  </Style>
  <!-- v0.7.82.0 bugfix: reported live ("dark parts... haven't changed enough"); this whole
       control (World page's own sub-tab strip) still had fully hardcoded Background/BorderBrush/
       Foreground, untouched by any earlier pass since those only covered app-wide chrome
       (nav/category tabs/ribbon), not this page-local control. Same token substitutions as the
       ribbonGroup fix; :checked keeps its original violet identity via the already-theme-aware
       VioletAccentBorderBrush/VioletAccentHighlightBrush pair instead of fixed hex. -->
  <Style Selector="ToggleButton.worldTab">
    <Setter Property="Height" Value="28"/>
    <Setter Property="MinWidth" Value="64"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="CornerRadius" Value="5"/>
    <Setter Property="Background" Value="{DynamicResource CardStrongBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontSize" Value="10"/>
  </Style>
  <Style Selector="ToggleButton.worldTab:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassOptionHoverGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="10" Color="{DynamicResource Blue}" Opacity="0.48"/></Setter>
  </Style>
  <Style Selector="ToggleButton.worldTab:checked">
    <Setter Property="Background" Value="{DynamicResource VioletAccentBorderBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VioletAccentHighlightBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="ToggleButton.worldTab.primary">
    <Setter Property="MinWidth" Value="92"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="FontSize" Value="11"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
  <Style Selector="ToggleButton.worldTab.nested">
    <Setter Property="Height" Value="26"/>
    <Setter Property="MinWidth" Value="60"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
  </Style>

  <Style Selector="ToggleButton.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
    <!-- v0.7.43.0: was 58, sized for the original 20x20 (later 28x28) nav icon; the 56x56 icon
         (nav icons doubled again, 28 to 56) needs real room, 72 leaves an even ~8px margin
         above and below the icon once Border.navSurface's 2px BorderThickness is subtracted. -->
    <Setter Property="Height" Value="72"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="0"/>
    <!-- v0.7.80.0 bugfix: same as Button.categoryTab above; #F4F8FC is byte-identical to
         TextBrush's own Dark value, hardcoded here instead of referenced. This is the entire left
         nav pane's default text color, so it was the single highest-impact instance of this bug:
         every nav item label went near-invisible in Light mode. -->
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <!-- FluentTheme's ToggleButton template paints its own checked/pointerover background
         directly on an internal template part; a plain Background setter on the control
         cannot override that state-specific template paint. Replacing the template with a
         bare ContentPresenter removes that default chrome entirely, so the only visuals
         are the ones this app draws itself via the child Border.navSurface. -->
    <Setter Property="Template">
      <ControlTemplate TargetType="ToggleButton">
        <ContentPresenter Content="{TemplateBinding Content}"
                           Padding="{TemplateBinding Padding}"
                           HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                           VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"/>
      </ControlTemplate>
    </Setter>
  </Style>
  <!-- v0.7.80.0 bugfix: pure white, same problem as the base ToggleButton.nav style above; the
       selected nav item's own background (NavSelectedGlassGradient) already lightens correctly in
       Light mode, so white text on it was doubly unreadable there. -->
  <Style Selector="ToggleButton.nav:checked">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="Border.navSurface">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="VerticalAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Border.navSurface TextBlock">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style Selector="ToggleButton.nav:pointerover Border.navSurface">
    <Setter Property="Background" Value="{DynamicResource NavHoverGlassGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="10" Color="{DynamicResource DecoGlowColor_49BFFF}" Opacity="0.4"/></Setter>
  </Style>
  <Style Selector="ToggleButton.nav:pointerover Border.navSurface TextBlock">
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="8" Color="{DynamicResource DecoGlowColor_8CE8FF}" Opacity="0.85"/></Setter>
  </Style>
  <Style Selector="ToggleButton.nav:checked Border.navSurface TextBlock">
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="7" Color="{DynamicResource DecoGlowColor_C8F0FF}" Opacity="0.65"/></Setter>
  </Style>
  <Style Selector="ToggleButton.nav:checked Border.navSurface">
    <Setter Property="Background" Value="{DynamicResource NavSelectedGlassGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_62D8FF}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="2" BlurRadius="10" Color="{DynamicResource Cyan}" Opacity="0.55"/></Setter>
  </Style>
  <Style Selector="ToggleButton.nav:checked:pointerover Border.navSurface">
    <Setter Property="Background" Value="{DynamicResource NavSelectedHoverGlassGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_B0EEFF}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="2" BlurRadius="14" Color="{DynamicResource DecoGlowColor_6CE8FF}" Opacity="0.75"/></Setter>
  </Style>
  <Style Selector="ToggleButton.nav:checked Border.navIcon">
    <Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_6}"/>
  </Style>

  <!-- Compatibility style for page-local subnavigation buttons used inside prototype pages. -->
  <Style Selector="Button.nav">
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Background" Value="{DynamicResource ButtonGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_365C78}"/>
    <Setter Property="Padding" Value="9,4"/>
  </Style>
  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource GlassOptionHoverGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="11" Color="{DynamicResource Blue}" Opacity="0.46"/></Setter>
  </Style>

  <Style Selector="ToggleButton.serverTab">
    <Setter Property="MinWidth" Value="175"/>
    <Setter Property="Height" Value="56"/>
    <Setter Property="Margin" Value="0,5,6,5"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="CornerRadius" Value="6,6,1,1"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
  </Style>
  <Style Selector="Border.serverTabSurface">
    <Setter Property="Background" Value="{DynamicResource ServerTabGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_365A75}"/>
    <Setter Property="BorderThickness" Value="1,1,1,2"/>
    <Setter Property="CornerRadius" Value="6,6,1,1"/>
    <Setter Property="Padding" Value="10,5"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_7}"/>
  </Style>
  <Style Selector="ToggleButton.serverTab:pointerover Border.serverTabSurface">
    <Setter Property="Background" Value="{DynamicResource ServerTabHoverGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentHighlightBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_8}"/>
  </Style>
  <Style Selector="ToggleButton.serverTab:checked Border.serverTabSurface">
    <Setter Property="Background" Value="{DynamicResource ServerTabActiveGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_62D8FF}"/>
    <Setter Property="BorderThickness" Value="1,1,1,3"/>
    <Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_9}"/>
  </Style>

  <Style Selector="Border.appIcon">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="{DynamicResource DecoBackground_E8152B42}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_5EC6EB}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_10}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="Border.brandWordmark">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="CornerRadius" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="ClipToBounds" Value="False"/>
    <Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_11}"/>
  </Style>
  <!-- v0.7.80.0 bugfix: same hardcoded-near-white-text problem as the nav pane/category tabs;
       the "MYSTTIQ" wordmark sits on StatusSurfaceGradient (the title bar), which is already
       Dark/Light-aware, so the text needs to be too. -->
  <Style Selector="TextBlock.brandText">
    <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable Display, Inter"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
  </Style>
  <Style Selector="TextBlock.brandVersion">
    <Setter Property="FontFamily" Value="Bahnschrift, Segoe UI Variable Text, Inter"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="LetterSpacing" Value="0.45"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
  </Style>
  <Style Selector="Border.dashboardGlass">
    <Setter Property="Background" Value="{DynamicResource DashboardGlassGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_315A7A}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_12}"/>
  </Style>
  <Style Selector="Border.ribbonGroup.contextBlue">
    <Setter Property="Margin" Value="12,0,4,0"/>
    <Setter Property="Background" Value="{DynamicResource ContextBlueGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource BlueAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.ribbonGroup.contextViolet">
    <Setter Property="Margin" Value="12,0,4,0"/>
    <Setter Property="Background" Value="{DynamicResource ContextVioletGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource VioletAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource VioletAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.ribbonGroup.contextAmber">
    <Setter Property="Margin" Value="12,0,4,0"/>
    <Setter Property="Background" Value="{DynamicResource BackupContextGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AmberAccentBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1,2,1,1"/>
    <Setter Property="BoxShadow" Value="{DynamicResource AmberAccentGlowShadowHigh}"/>
  </Style>
  <Style Selector="Border.ribbonGroup.contextMagenta">
    <Setter Property="Margin" Value="12,0,4,0"/>
    <Setter Property="Background" Value="{DynamicResource ContextMagentaGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource MagentaAccentBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1,2,1,1"/>
    <Setter Property="BoxShadow" Value="{DynamicResource MagentaAccentGlowShadowHigh}"/>
  </Style>
  <Style Selector="Border.ribbonGroup.contextOrange">
    <Setter Property="Margin" Value="12,0,4,0"/>
    <Setter Property="Background" Value="{DynamicResource ContextOrangeGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OrangeAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource OrangeAccentGlowShadowLow}"/>
  </Style>

  <!-- v0.7.82.0 bugfix: reported live; these three Backups-page ribbon buttons had fully
       hardcoded dark Background/BorderBrush pairs, untouched by any earlier pass since they
       override the base Button.ribbon style with their own class-specific selectors. Swapped to
       the same already-theme-aware Context{Name}Gradient/CardGreenGradient + {Name}
       AccentBorderBrush resources used elsewhere for this exact "colored ribbon action" pattern
       (e.g. the InstallMissing button just above uses ContextOrangeGradient identically). -->
  <Style Selector="Button.ribbon.backupCreate">
    <Setter Property="BorderBrush" Value="{DynamicResource AmberAccentBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource ContextAmberGradient}"/>
  </Style>
  <Style Selector="Button.ribbon.backupCreate:pointerover">
    <Setter Property="Background" Value="{DynamicResource AmberAccentBorderBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AmberAccentHighlightBrush}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="15" Color="{DynamicResource Amber}" Opacity="0.58"/></Setter>
  </Style>
  <Style Selector="Button.ribbon.backupVerify">
    <Setter Property="BorderBrush" Value="{DynamicResource GreenAccentBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource CardGreenGradient}"/>
  </Style>
  <Style Selector="Button.ribbon.backupVerify:pointerover">
    <Setter Property="Background" Value="{DynamicResource GreenAccentBorderBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GreenAccentHighlightBrush}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="15" Color="{DynamicResource Green}" Opacity="0.56"/></Setter>
  </Style>
  <Style Selector="Button.ribbon.backupRetention">
    <Setter Property="BorderBrush" Value="{DynamicResource OrangeAccentBorderBrush}"/>
    <Setter Property="Background" Value="{DynamicResource ContextOrangeGradient}"/>
  </Style>
  <Style Selector="Button.ribbon.backupRetention:pointerover">
    <Setter Property="Background" Value="{DynamicResource OrangeAccentBorderBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OrangeAccentHighlightBrush}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="15" Color="{DynamicResource Orange}" Opacity="0.58"/></Setter>
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource CardGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="{DynamicResource CardPadding}"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_13}"/>
  </Style>
  <!-- v0.7.63.0 theme-system bugfix: App.axaml's legacy Border.statuscard style (hardcoded
       #0E2133/#1E5279) has equal specificity to this one and is declared first, so this later
       declaration wins the cascade the same way Border.card above already does; but until now
       nothing here actually declared a bare (non-accent) Border.statuscard, so the legacy hardcoded
       version was the only one that ever applied, and never re-themed. Every accentXxx/glowXxx
       variant below already overrides this for its own compound selector; this is only the base
       look shown when neither is set (e.g. the sidebar's mini server-status card, the duplicate-
       install warning banner). Reuses CardStrongBrush/BorderSoftBrush rather than CardGradient/
       #426784, a plain flat tint distinguishable from Border.card's own gradient look, closer to
       what the legacy hardcoded values visually were. -->
  <!-- v0.7.78.0: Padding was never set here at all (unlike Border.card's Padding="11" just above),
       so every statuscard's text sat flush against its own border; direct live feedback ("the
       text is too close to the edges"), reproduced on the UE4SS page's INSTALLED VERSION/RUNTIME
       HEALTH/ACTIVE FORK cards, its Active/Runtime Mods Root boxes, and its release list rows, but
       this is a shared style so it fixes every statuscard app-wide, not just that one page. -->
  <Style Selector="Border.statuscard">
    <Setter Property="Background" Value="{DynamicResource CardStrongBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="{DynamicResource CardPadding}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <!-- Status-driven card glows: declared after Border.card so they win the Background/BoxShadow
       cascade for equal-specificity single-class selectors (Avalonia resolves ties by declaration
       order, not by "how specific this feels"). Unscoped from .card so they also apply to
       .statuscard elements (e.g. the Dashboard's SERVER card). Toggled via Classes.glowX bindings. -->
  <Style Selector="Border.glowGreen">
    <Setter Property="Background" Value="{DynamicResource CardGreenGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GreenAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource GreenAccentGlowShadowHigh}"/>
  </Style>
  <Style Selector="Border.glowRed">
    <Setter Property="Background" Value="{DynamicResource CardRedGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource RedAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource RedAccentGlowShadowHigh}"/>
  </Style>
  <Style Selector="Border.glowAmber">
    <Setter Property="Background" Value="{DynamicResource CardAmberGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AmberAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource AmberAccentGlowShadowHigh}"/>
  </Style>
  <Style Selector="Border.glowPurple">
    <Setter Property="Background" Value="{DynamicResource CardPurpleGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource PurpleAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource PurpleAccentGlowShadowHigh}"/>
  </Style>
  <Style Selector="Border.glowDarkGreen">
    <Setter Property="Background" Value="{DynamicResource CardDarkGreenGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DarkGreenAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource DarkGreenAccentGlowShadowHigh}"/>
  </Style>
  <Style Selector="Border.glowNeutral">
    <Setter Property="Background" Value="{DynamicResource CardNeutralGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource NeutralAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource NeutralAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.card TextBlock">
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style Selector="Border.card Grid">
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.card StackPanel">
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.card DockPanel">
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.card WrapPanel">
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.card Button">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="MaxHeight" Value="34"/>
    <Setter Property="Padding" Value="9,4"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.card.backupProtection">
    <Setter Property="Background" Value="{DynamicResource BackupProtectionGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource AmberAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource AmberAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.card.backupStorage">
    <Setter Property="Background" Value="{DynamicResource BackupStorageGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BlueAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource BlueAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.card.backupRetention">
    <Setter Property="Background" Value="{DynamicResource BackupRetentionGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource OrangeAccentBorderBrush}"/>
    <Setter Property="BoxShadow" Value="{DynamicResource OrangeAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.statusBadge">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="7,2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style Selector="Border.statusBadge.verified">
    <Setter Property="Background" Value="{DynamicResource CardStrongBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource GreenAccentBorderBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BoxShadow" Value="{DynamicResource GreenAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.statusBadge.enabled, Border.statusBadge.healthy">
    <Setter Property="Background" Value="{DynamicResource CardStrongBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource GreenAccentBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BoxShadow" Value="{DynamicResource GreenAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.statusBadge.update">
    <Setter Property="Background" Value="{DynamicResource CardStrongBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AmberAccentBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BoxShadow" Value="{DynamicResource AmberAccentGlowShadowLow}"/>
  </Style>
  <Style Selector="Border.card.modPlatform"><Setter Property="BorderBrush" Value="{DynamicResource MagentaAccentBorderBrush}"/><Setter Property="BoxShadow" Value="{DynamicResource MagentaAccentGlowShadowLow}"/></Style>
  <Style Selector="Border.card.modRuntime"><Setter Property="BorderBrush" Value="{DynamicResource GreenAccentBorderBrush}"/><Setter Property="BoxShadow" Value="{DynamicResource GreenAccentGlowShadowLow}"/></Style>
  <Style Selector="Border.card.modUpdates"><Setter Property="Background" Value="{DynamicResource BackupRetentionGradient}"/><Setter Property="BorderBrush" Value="{DynamicResource OrangeAccentBorderBrush}"/><Setter Property="BoxShadow" Value="{DynamicResource OrangeAccentGlowShadowLow}"/></Style>
  <Style Selector="Border.card.modDetails"><Setter Property="BorderBrush" Value="{DynamicResource MagentaAccentBorderBrush}"/><Setter Property="BoxShadow" Value="{DynamicResource MagentaAccentGlowShadowLow}"/></Style>
  <Style Selector="Border.selectionActions"><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="{DynamicResource DecoBackground_312C1C42}"/><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_785194}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Border.modRow"><Setter Property="Background" Value="{DynamicResource DecoBackground_100A1724}"/><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_193A5268}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style Selector="Border.modRow:pointerover"><Setter Property="Background" Value="{DynamicResource DecoBackground_3A35234A}"/><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_9767B2}"/></Style>
  <Style Selector="Border.modRow.selected"><Setter Property="Background" Value="{DynamicResource DecoBackground_503B2455}"/><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_E676FF}"/><Setter Property="BorderThickness" Value="3,0,0,1"/><Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_14}"/></Style>
  <Style Selector="Button.disableAction"><Setter Property="Background" Value="{DynamicResource DecoBackground_E3141A22}"/><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_5D3D46}"/><Setter Property="Foreground" Value="{DynamicResource DecoForeground_C9B9BF}"/></Style>
  <Style Selector="Button.disableAction:pointerover"><Setter Property="Background" Value="{DynamicResource DecoBackground_6B44231D}"/><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_FF8058}"/><Setter Property="Foreground" Value="{DynamicResource DecoForeground_FFD4C6}"/><Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="12" Color="{DynamicResource DecoGlowColor_FF704D}" Opacity="0.48"/></Setter></Style>
  <Style Selector="Button.updateAction"><Setter Property="Background" Value="{DynamicResource DecoBackground_59412318}"/><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_C78135}"/><Setter Property="Foreground" Value="{DynamicResource DecoForeground_FFD277}"/></Style>
  <Style Selector="Button.updateAction:pointerover"><Setter Property="Background" Value="{DynamicResource DecoBackground_79552D18}"/><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_FFB65A}"/><Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="12" Color="{DynamicResource Orange}" Opacity="0.5"/></Setter></Style>
  <Style Selector="Border.card.prototypeMetric"><Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_15}"/></Style>
  <Style Selector="Border.card.prototypeMetric.accent"><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_4B9DC4}"/><Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_16}"/></Style>
  <Style Selector="Border.card.prototypeTable"><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_426E8B}"/></Style>
  <Style Selector="Border.prototypeRow"><Setter Property="Background" Value="{DynamicResource DecoBackground_100A1724}"/><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_193A5268}"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style Selector="Border.prototypeRow:pointerover"><Setter Property="Background" Value="{DynamicResource DecoBackground_33243B4C}"/><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_4F81A3}"/><Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_17}"/></Style>
  <Style Selector="Border.statusBadge.prototypeState"><Setter Property="Background" Value="{DynamicResource DecoBackground_241B4A2B}"/><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_437E58}"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Border.card.prototypeDetails"><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_4A83A8}"/><Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_18}"/></Style>
  <Style Selector="Border.card.prototypeActions"><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_9A633B}"/><Setter Property="Background" Value="{DynamicResource ContextOrangeGradient}"/><Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_19}"/></Style>
  <!-- v0.7.56.0: Central Theme System Completion, Remaining Decorative Gradients. Routed through
       ThemeApplier-computed resources (DataRow*) instead of hardcoded hex, so this list row style
       now re-themes with the rest of the app. -->
  <Style Selector="Border.dataRow">
    <Setter Property="Background" Value="{DynamicResource DataRowBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DataRowBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Border.dataRow:pointerover">
    <Setter Property="Background" Value="{DynamicResource DataRowHoverBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DataRowHoverBorderBrush}"/>
  </Style>
  <Style Selector="Border.dataRow.selected">
    <Setter Property="Background" Value="{DynamicResource DataRowSelectedBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DataRowSelectedBorderBrush}"/>
    <Setter Property="BorderThickness" Value="2,0,0,1"/>
    <Setter Property="BoxShadow" Value="{DynamicResource DataRowSelectedGlowShadow}"/>
  </Style>
  <Style Selector="Button.cardAction">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="MinWidth" Value="80"/>
    <Setter Property="Background" Value="{DynamicResource ButtonGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_4A7593}"/>
  </Style>
  <Style Selector="Button.cardAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource ButtonGradientHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_7BE0FF}"/>
    <Setter Property="Effect">
      <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="14" Color="{DynamicResource DecoGlowColor_52C4FF}" Opacity="0.65"/>
    </Setter>
  </Style>
  <Style Selector="Button.cardAction:pressed">
    <Setter Property="Background" Value="{DynamicResource ButtonGradientPressed}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_5AB6D9}"/>
  </Style>
  <Style Selector="Button.cardAction.restore">
    <Setter Property="Background" Value="{DynamicResource RestoreGradient}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_A77639}"/>
    <Setter Property="Foreground" Value="{DynamicResource DecoForeground_FFE3AD}"/>
  </Style>
  <Style Selector="Button.cardAction.restore:pointerover">
    <Setter Property="Background" Value="{DynamicResource RestoreGradientHover}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_FFC864}"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="13" Color="{DynamicResource Amber}" Opacity="0.55"/></Setter>
  </Style>
  <!-- v0.7.80.0 bugfix: reported live; both Background and BorderBrush were hardcoded hex, unlike
       every other Border style in this file, so the ribbon's own button-group panels (Server
       Control, Quick Actions, Danger) stayed dark navy in Light mode regardless of everything
       around them re-theming correctly. CardStrongBrush/BorderSoftBrush are already Dark/Light-aware
       Structural tokens; CardStrongBrush's own Dark value (#F0122539) is close to the literal this
       replaces, so Dark mode's look is effectively unchanged. -->
  <Style Selector="Border.ribbonGroup">
    <Setter Property="Background" Value="{DynamicResource CardStrongBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="5"/>
    <Setter Property="Margin" Value="0,0,5,0"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_20}"/>
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="7,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <!-- v0.7.79.0: direct live feedback on the Server Doctor page's new state badges ("can we make
       the green a little darker or add a drop shadow to PASS to make it more readable?"). Added a
       text shadow on the badge's own label instead of changing the shared GreenBrush itself (which
       is used in many other places this feedback wasn't about). -->
  <Style Selector="TextBlock.badgeText">
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="3" Color="Black" Opacity="0.65"/></Setter>
  </Style>

  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="8"/>
    <Setter Property="MinWidth" Value="8"/>
    <Setter Property="Background" Value="{DynamicResource ScrollTrackBg}"/>
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="8"/>
    <Setter Property="MinHeight" Value="8"/>
    <Setter Property="Background" Value="{DynamicResource ScrollTrackBg}"/>
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="6"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="Background" Value="{DynamicResource DecoBackground_173049}"/>
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource InputPadding}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="{DynamicResource InputFieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="{DynamicResource ControlMinHeight}"/>
    <Setter Property="Padding" Value="{DynamicResource InputPadding}"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="{DynamicResource InputFieldBg}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <!-- Global list-row delineation: every ListBox gets an alternating row tint and a thin
       bottom divider by default, even where the item's own DataTemplate has no border. -->
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="{DynamicResource ListItemPadding}"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_152B3D}"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="ListBoxItem:nth-child(2n)">
    <Setter Property="Background" Value="{DynamicResource ListRowAltBg}"/>
  </Style>
  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource ListRowHoverBg}"/>
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource ListRowSelectedBg}"/>
  </Style>
</Styles>
