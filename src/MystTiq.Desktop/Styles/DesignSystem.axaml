  </Style>
  <Style Selector="Border.statusBadge.enabled, Border.statusBadge.healthy">
    <Setter Property="Background" Value="#241B4A2B"/><Setter Property="BorderBrush" Value="#4C9B64"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BoxShadow" Value="0 0 9 0 #2863DF7B"/>
  </Style>
  <Style Selector="Border.statusBadge.update">
    <Setter Property="Background" Value="#2E4A3518"/><Setter Property="BorderBrush" Value="#B27C31"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BoxShadow" Value="0 0 9 0 #35F4B83F"/>
  </Style>
  <Style Selector="Border.card.modPlatform"><Setter Property="BorderBrush" Value="#8753AE"/><Setter Property="BoxShadow" Value="-3 -3 12 0 #2CE676FF, 0 10 24 0 #59000000"/></Style>
  <Style Selector="Border.card.modRuntime"><Setter Property="BorderBrush" Value="#4D8C5F"/><Setter Property="BoxShadow" Value="-3 -3 12 0 #2863DF7B, 0 10 24 0 #59000000"/></Style>
  <Style Selector="Border.card.modUpdates"><Setter Property="Background" Value="{DynamicResource BackupRetentionGradient}"/><Setter Property="BorderBrush" Value="#C27C38"/><Setter Property="BoxShadow" Value="-3 -3 14 0 #45FF9558, 0 10 24 0 #59000000"/></Style>
  <Style Selector="Border.card.modDetails"><Setter Property="BorderBrush" Value="#8957A8"/><Setter Property="BoxShadow" Value="-3 -3 13 0 #31E676FF, 0 10 24 0 #59000000"/></Style>
  <Style Selector="Border.selectionActions"><Setter Property="Padding" Value="12"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Background" Value="#312C1C42"/><Setter Property="BorderBrush" Value="#785194"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Border.modRow"><Setter Property="Background" Value="#100A1724"/><Setter Property="BorderBrush" Value="#193A5268"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style Selector="Border.modRow:pointerover"><Setter Property="Background" Value="#3A35234A"/><Setter Property="BorderBrush" Value="#9767B2"/></Style>
  <Style Selector="Border.modRow.selected"><Setter Property="Background" Value="#503B2455"/><Setter Property="BorderBrush" Value="#E676FF"/><Setter Property="BorderThickness" Value="3,0,0,1"/><Setter Property="BoxShadow" Value="0 0 15 0 #42E676FF"/></Style>
  <Style Selector="Button.disableAction"><Setter Property="Background" Value="#E3141A22"/><Setter Property="BorderBrush" Value="#5D3D46"/><Setter Property="Foreground" Value="#C9B9BF"/></Style>
  <Style Selector="Button.disableAction:pointerover"><Setter Property="Background" Value="#6B44231D"/><Setter Property="BorderBrush" Value="#FF8058"/><Setter Property="Foreground" Value="#FFD4C6"/><Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="12" Color="#FF704D" Opacity="0.48"/></Setter></Style>
  <Style Selector="Button.updateAction"><Setter Property="Background" Value="#59412318"/><Setter Property="BorderBrush" Value="#C78135"/><Setter Property="Foreground" Value="#FFD277"/></Style>
  <Style Selector="Button.updateAction:pointerover"><Setter Property="Background" Value="#79552D18"/><Setter Property="BorderBrush" Value="#FFB65A"/><Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="12" Color="#FF9558" Opacity="0.5"/></Setter></Style>
  <Style Selector="Border.card.prototypeMetric"><Setter Property="BoxShadow" Value="-3 -3 12 0 #2548BFFF, 0 9 22 0 #56000000"/></Style>
  <Style Selector="Border.card.prototypeMetric.accent"><Setter Property="BorderBrush" Value="#4B9DC4"/><Setter Property="BoxShadow" Value="-3 -3 13 0 #3B35D5E8, 0 9 22 0 #56000000"/></Style>
  <Style Selector="Border.card.prototypeTable"><Setter Property="BorderBrush" Value="#426E8B"/></Style>
  <Style Selector="Border.prototypeRow"><Setter Property="Background" Value="#100A1724"/><Setter Property="BorderBrush" Value="#193A5268"/><Setter Property="BorderThickness" Value="0,0,0,1"/></Style>
  <Style Selector="Border.prototypeRow:pointerover"><Setter Property="Background" Value="#33243B4C"/><Setter Property="BorderBrush" Value="#4F81A3"/><Setter Property="BoxShadow" Value="0 0 10 0 #2535BFFF"/></Style>
  <Style Selector="Border.statusBadge.prototypeState"><Setter Property="Background" Value="#241B4A2B"/><Setter Property="BorderBrush" Value="#437E58"/><Setter Property="BorderThickness" Value="1"/></Style>
  <Style Selector="Border.card.prototypeDetails"><Setter Property="BorderBrush" Value="#4A83A8"/><Setter Property="BoxShadow" Value="-3 -3 13 0 #2E35D5E8, 0 10 24 0 #59000000"/></Style>
  <Style Selector="Border.card.prototypeActions"><Setter Property="BorderBrush" Value="#9A633B"/><Setter Property="Background" Value="{DynamicResource ContextOrangeGradient}"/><Setter Property="BoxShadow" Value="-3 -3 12 0 #31FF9558, 0 10 24 0 #59000000"/></Style>
  <Style Selector="Border.dataRow">
    <Setter Property="Background" Value="#120B1825"/>
    <Setter Property="BorderBrush" Value="#193A5268"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <Style Selector="Border.dataRow:pointerover">
    <Setter Property="Background" Value="#38263F50"/>
    <Setter Property="BorderBrush" Value="#4F81A3"/>
  </Style>
  <Style Selector="Border.dataRow.selected">
    <Setter Property="Background" Value="#423C321C"/>
    <Setter Property="BorderBrush" Value="#B88236"/>
    <Setter Property="BorderThickness" Value="2,0,0,1"/>
    <Setter Property="BoxShadow" Value="0 0 12 0 #2CF4B83F"/>
  </Style>
  <Style Selector="Button.cardAction">
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="Height" Value="30"/>
    <Setter Property="Padding" Value="10,3"/>
    <Setter Property="MinWidth" Value="80"/>
    <Setter Property="Background" Value="{DynamicResource ButtonGradient}"/>
    <Setter Property="BorderBrush" Value="#4A7593"/>
  </Style>
  <Style Selector="Button.cardAction:pointerover">
    <Setter Property="Background" Value="{DynamicResource ButtonGradientHover}"/>
    <Setter Property="BorderBrush" Value="#7BE0FF"/>
    <Setter Property="Effect">
      <DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="14" Color="#52C4FF" Opacity="0.65"/>
    </Setter>
  </Style>
  <Style Selector="Button.cardAction:pressed">
    <Setter Property="Background" Value="{DynamicResource ButtonGradientPressed}"/>
    <Setter Property="BorderBrush" Value="#5AB6D9"/>
  </Style>
  <Style Selector="Button.cardAction.restore">
    <Setter Property="Background" Value="{DynamicResource RestoreGradient}"/>
    <Setter Property="BorderBrush" Value="#A77639"/>
    <Setter Property="Foreground" Value="#FFE3AD"/>
  </Style>
  <Style Selector="Button.cardAction.restore:pointerover">
    <Setter Property="Background" Value="{DynamicResource RestoreGradientHover}"/>
    <Setter Property="BorderBrush" Value="#FFC864"/>
    <Setter Property="Effect"><DropShadowEffect OffsetX="0" OffsetY="0" BlurRadius="13" Color="#F4B83F" Opacity="0.55"/></Setter>
  </Style>
  <Style Selector="Border.ribbonGroup">
    <Setter Property="Background" Value="#C4142739"/>
    <Setter Property="BorderBrush" Value="#365B76"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="Margin" Value="0,0,5,0"/>
    <Setter Property="ClipToBounds" Value="True"/>
    <Setter Property="BoxShadow" Value="0 5 14 0 #40000000"/>
  </Style>
  <Style Selector="Border.badge">
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Padding" Value="7,2"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <Style Selector="ScrollBar:vertical">
    <Setter Property="Width" Value="8"/>
    <Setter Property="MinWidth" Value="8"/>
    <Setter Property="Background" Value="#081522"/>
  </Style>
  <Style Selector="ScrollBar:horizontal">
    <Setter Property="Height" Value="8"/>
    <Setter Property="MinHeight" Value="8"/>
    <Setter Property="Background" Value="#081522"/>
  </Style>

  <Style Selector="ProgressBar">
    <Setter Property="Height" Value="6"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="Background" Value="#173049"/>
  </Style>

  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="9,4"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="#0B1A29"/>
    <Setter Property="BorderBrush" Value="#365C78"/>
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="34"/>
    <Setter Property="Padding" Value="9,4"/>
    <Setter Property="CornerRadius" Value="6"/>
    <Setter Property="Background" Value="#0B1A29"/>
    <Setter Property="BorderBrush" Value="#365C78"/>
  </Style>
  <Style Selector="CheckBox">
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>

  <!-- Global list-row delineation: every ListBox gets an alternating row tint and a thin
       bottom divider by default, even where the item's own DataTemplate has no border. -->
  <Style Selector="ListBoxItem">
    <Setter Property="Padding" Value="4,3"/>
    <Setter Property="BorderThickness" Value="0,0,0,1"/>
    <Setter Property="BorderBrush" Value="#152B3D"/>
    <Setter Property="CornerRadius" Value="0"/>
  </Style>
  <Style Selector="ListBoxItem:nth-child(2n)">
    <Setter Property="Background" Value="#0C1826"/>
  </Style>
  <Style Selector="ListBoxItem:pointerover">
    <Setter Property="Background" Value="#1B3247"/>
  </Style>
  <Style Selector="ListBoxItem:selected">
    <Setter Property="Background" Value="#24425C"/>
  </Style>
</Styles>
