    <Setter Property="BorderBrush" Value="#E0A83E"/>
    <Setter Property="BoxShadow" Value="0 0 22 2 #5AF4B83F, 0 8 22 0 #55000000"/>
  </Style>
  <Style Selector="Border.glowPurple">
    <Setter Property="Background" Value="{DynamicResource CardPurpleGradient}"/>
    <Setter Property="BorderBrush" Value="#8E62B8"/>
    <Setter Property="BoxShadow" Value="0 0 22 2 #5AA96DFF, 0 8 22 0 #55000000"/>
  </Style>
