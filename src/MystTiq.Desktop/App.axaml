<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="MystTiq.Desktop.App" RequestedThemeVariant="Dark">

  <TrayIcon.Icons>
    <TrayIcons>
      <TrayIcon Icon="/Assets/PalworldServerManager.ico" ToolTipText="MystTiq — Palworld Server Manager">
        <TrayIcon.Menu>
          <NativeMenu>
            <NativeMenuItem Header="Show MystTiq" Click="ShowWindow_OnClick"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Start Palworld Server" Click="StartServer_OnClick"/>
            <NativeMenuItem Header="Restart Palworld Server" Click="RestartServer_OnClick"/>
            <NativeMenuItem Header="Stop Palworld Server" Click="StopServer_OnClick"/>
            <NativeMenuItemSeparator/>
            <NativeMenuItem Header="Safe Exit — stop server and management backend" Click="SafeExit_OnClick"/>
            <NativeMenuItem Header="Force Exit — terminate server and management backend" Click="ForceExit_OnClick"/>
            <NativeMenuItem Header="Exit GUI Only — keep services running" Click="ExitGui_OnClick"/>
          </NativeMenu>
        </TrayIcon.Menu>
      </TrayIcon>
    </TrayIcons>
  </TrayIcon.Icons>
  <!-- v0.7.63.0 theme-system bugfix: this file used to also declare a full parallel set of
       hardcoded-hex color resources plus base structural styles, left over from before
       Styles/DesignSystem.axaml existed. Every one of those selectors that any live XAML still
       matches was also declared in DesignSystem.axaml at equal specificity and later in the
       cascade, so DesignSystem.axaml's theme-aware version always won in practice; Avalonia
       resolves equal-specificity ties by declaration order. But the dead hardcoded copies here were
       a live trap, exactly the kind of shadowed but untouched styles that caused this session's real
       bug: one status-card selector had no DesignSystem.axaml equivalent at all, so this file's own
       hardcoded colors were genuinely what rendered for it; several other status colors had their
       own separate hardcoded copy computed directly in C#, same root cause. Two nav-item selectors
       here were also found fully dead (zero XAML usages; the real nav uses a different mechanism
       entirely). Removed all of it rather than leaving unreachable code that looks load-bearing; see
       docs/architecture/v0.7.63.0-central-theme-system-audit-and-fix.md for the full account.
       DesignSystem.axaml is now the only place any of this is defined; the one selector here that
       had no DesignSystem.axaml equivalent at all was moved there instead of deleted, now using a
       theme-aware resource instead of its old hardcoded color. -->
  <Application.Styles>
    <FluentTheme />
    <Style Selector="ListBox"><Setter Property="ToolTip.ShowDelay" Value="300"/></Style>
    <Style Selector="ComboBox"><Setter Property="ToolTip.ShowDelay" Value="300"/></Style>
    <Style Selector="Border.card TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="Border.statuscard TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style Selector="Border.card Grid"><Setter Property="ClipToBounds" Value="True"/></Style>
    <Style Selector="Border.card StackPanel"><Setter Property="ClipToBounds" Value="True"/></Style>
    <StyleInclude Source="avares://MystTiq.Desktop/Styles/DesignSystem.axaml"/>
    <StyleInclude Source="avares://MystTiq.Desktop/Styles/IconGeometries.axaml"/>
  </Application.Styles>
</Application>
