<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MystTiq.Desktop.ViewModels"
        xmlns:models="using:MystTiq.Desktop.Models"
        xmlns:services="using:MystTiq.Desktop.Services"
        xmlns:controls="using:MystTiq.Desktop.Controls"
        xmlns:converters="using:MystTiq.Desktop.Converters"
        x:Class="MystTiq.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="MystTiq — Palworld Server Manager"
        Width="1440" Height="880" MinWidth="950" MinHeight="650"
        SystemDecorations="None" ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen" SizeChanged="Window_OnSizeChanged"
        Icon="/Assets/PalworldServerManager.ico">
  <Grid RowDefinitions="66,42,Auto,*,44">
    <!-- v0.7.63.0: per-tab identity color (item 2, v0.7.52.0) previously only showed as a small
         dot in the tab strip; reported as too subtle to tell at a glance which server is active.
         This bottom border is the same ActiveTab.AccentBrush already used for that dot, now also
         drawn as a persistent 3px strip under the title bar, visible above every page regardless
         of scroll position. See also the page-header Border's BorderBrush below, tinted the same
         way, for a second, larger reinforcement of the same signal. -->
    <Border Grid.Row="0" Background="{DynamicResource StatusSurfaceGradient}" BorderBrush="{Binding ActiveTabAccentBrush}" BorderThickness="0,0,0,3" PointerPressed="TitleBar_OnPointerPressed">
      <Grid ColumnDefinitions="430,*,Auto">
        <Grid Grid.Column="0" Margin="14,7,10,7" ColumnDefinitions="52,Auto,Auto">
          <Border Classes="appIcon" Width="48" Height="48"><Image Source="/Assets/PalworldServerManager.png" Stretch="UniformToFill"/></Border>
          <StackPanel Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Center" Spacing="1">
            <Image Source="/Assets/mysttiq-wordmark-v5.png" Width="145" Height="27" HorizontalAlignment="Left" Stretch="Uniform"/>
            <TextBlock Classes="brandVersion" Text="{Binding Version}"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="Palworld Server Manager" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,1,0,0"/>
        </Grid>
        <!-- v0.7.16.0: was hardcoded MaxWidth="720" regardless of actual available window width,
             and tabs past whatever fit were silently clipped with no way to reach them. Now sized
             from TabStripHost_OnSizeChanged (code-behind) via MainWindowViewModel.UpdateTabStripWidth,
             which splits Tabs into VisibleTabs/OverflowTabs: the ListBox below only ever shows
             VisibleTabs, and the chevron button after it opens a flyout for the rest. -->
        <StackPanel x:Name="TabStripHost" Grid.Column="1" Orientation="Horizontal" ClipToBounds="True" SizeChanged="TabStripHost_OnSizeChanged">
        <ListBox ItemsSource="{Binding VisibleTabs}" SelectedItem="{Binding ActiveTab}" Background="Transparent" BorderThickness="0" Margin="0,6">
          <ListBox.Styles>
            <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="6"/></Style>
            <Style Selector="ListBoxItem:nth-child(2n)"><Setter Property="Background" Value="Transparent"/></Style>
            <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="Transparent"/></Style>
            <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="Transparent"/></Style>
            <Style Selector="ListBoxItem:selected Border.serverTabSurface"><Setter Property="Background" Value="{DynamicResource ServerTabActiveGradient}"/><Setter Property="BorderBrush" Value="#62D8FF"/><Setter Property="BorderThickness" Value="1,1,1,3"/><Setter Property="BoxShadow" Value="0 0 18 1 #6049BFFF, 0 8 20 0 #55000000"/></Style>
          </ListBox.Styles>
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TabSession">
              <!-- v0.7.74.0: BorderBrush bound directly here (this DataTemplate's x:DataType is the
                   TabSession itself, unlike the ListBox.Styles selector above which can't reliably
                   data-bind against the item). A local binding takes precedence over the
                   ":selected Border.serverTabSurface" style Setter's own BorderBrush, so every tab,
                   selected or not, now shows its own identity color as its border, while that
                   style's other selected-state properties (Background, thicker bottom edge,
                   BoxShadow glow) are untouched and still apply normally when selected. -->
              <Border Classes="serverTabSurface" BorderBrush="{Binding AccentBrush}" MinWidth="200" Margin="2,0" Padding="12,7">
                <!-- v0.7.52.0: Per-Tab Color Coding, item 2. A per-server identity stripe (column
                     0), independent from the status dot (column 1, a live health signal). The
                     selected-tab highlight's border also now follows this same identity color as
                     of v0.7.74.0 (see the Border above); its Background/BoxShadow glow stay a fixed
                     app-wide look regardless of tab, so the three signals stay visually distinct
                     rather than merging into one. -->
                <Grid ColumnDefinitions="4,10,*,Auto" RowDefinitions="Auto,Auto">
                  <Rectangle Grid.RowSpan="2" Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="{Binding AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                  <Ellipse Grid.Column="1" Grid.RowSpan="2" Width="8" Height="8" Fill="{Binding StatusDotColorKey, Converter={x:Static converters:SemanticStatusColorConverter.Instance}}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" FontWeight="SemiBold" FontSize="12" Text="{Binding ProfileName}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="1" Grid.Column="2" Foreground="{DynamicResource BlueBrush}" Text="{Binding ConnectionKindText}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                  <!-- v0.7.11.0: Click + Tag instead of Command/CommandParameter, since closing a
                       running server's tab now needs to show a confirmation dialog first (see
                       CloseTabButton_OnClick), which a plain ICommand can't do without either
                       giving the ViewModel a reference to a View or a more elaborate
                       request/response event, neither of which fits this codebase's existing
                       pattern of code-behind handling anything that needs a native window/dialog. -->
                  <!-- v0.7.14.0: was 20x20; Fluent's minimum recommended pointer target is ~32-40px,
                       and this sat inside a dense horizontal tab strip where mis-clicks were likely
                       once several servers were open. Bumped to 28x28, the smallest step that
                       materially helps without the tab row growing too tall. -->
                  <Button Grid.RowSpan="2" Grid.Column="3" Classes="ghost" Width="28" Height="28" Padding="0" Margin="6,0,0,0"
                          Click="CloseTabButton_OnClick" Tag="{Binding}"
                          ToolTip.Tip="Close tab" AutomationProperties.Name="Close tab">
                    <TextBlock FontFamily="Segoe Fluent Icons" FontSize="10" Text="&#xE711;"/>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- v0.7.16.0: appears only once VisibleTabs no longer holds every open tab. Opens a flyout
             listing the hidden ones (click to switch) plus "Set Up New Server", the same entry the
             "+" button's own flyout offers, so creating a new tab is reachable from here too without
             needing to first free up strip space. -->
        <Button x:Name="TabOverflowButton" Width="36" Height="44" Margin="2,10" Padding="0" Classes="ghost"
                IsVisible="{Binding HasOverflowTabs}" Click="TabOverflowButton_OnClick"
                ToolTip.Tip="Show hidden tabs" AutomationProperties.Name="Show hidden tabs">
          <TextBlock FontSize="16" Text="»" Foreground="{DynamicResource TextBrush}"/>
        </Button>
        <Button x:Name="AddTabButton" Width="44" Height="44" Margin="4,10" Classes="ghost"
                Click="AddTabButton_OnClick" ToolTip.Tip="Open a new tab" AutomationProperties.Name="Open a new tab">
          <Path Data="{StaticResource IconAddTab}" Fill="{DynamicResource TextBrush}" Width="20" Height="20" Stretch="Uniform"/>
        </Button>
        </StackPanel>
        <!-- v0.7.14.0: window-chrome buttons had ToolTip coverage everywhere else in the app except
             here (Minimize/Maximize/Close had none), and none of these six icon-only buttons had an
             AutomationProperties.Name: a ToolTip.Tip is not exposed as the accessible name to
             screen readers, so without this these were silent to Narrator/NVDA/UIA. -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0">
          <Button Classes="ghost" Width="42" Height="38" Padding="0" Command="{Binding NavigateCommand}" CommandParameter="Notifications" ToolTip.Tip="Open Notifications" AutomationProperties.Name="Open Notifications"><TextBlock Classes="flatIcon" FontSize="18" Text="●" Foreground="{DynamicResource MutedBrush}"/></Button>
          <Button Classes="ghost" Width="42" Height="38" Padding="0" Command="{Binding NavigateCommand}" CommandParameter="Settings" ToolTip.Tip="Open Settings" AutomationProperties.Name="Open Settings"><TextBlock FontFamily="Segoe Fluent Icons" FontSize="17" Text="&#xE713;"/></Button>
          <Border Width="1" Height="24" Background="{DynamicResource BorderBrush}" Margin="7,0"/>
          <Button Classes="ghost" Width="42" Height="38" Click="Minimize_OnClick" ToolTip.Tip="Minimize" AutomationProperties.Name="Minimize"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE921;"/></Button>
          <Button Classes="ghost" Width="42" Height="38" Padding="0" Click="Maximize_OnClick" ToolTip.Tip="Maximize" AutomationProperties.Name="Maximize"><TextBlock x:Name="MaximizeGlyph" FontFamily="Segoe Fluent Icons" FontSize="14" Text="&#xE922;"/></Button>
          <Button Classes="ghost" Width="42" Height="38" Click="Close_OnClick" ToolTip.Tip="Close" AutomationProperties.Name="Close window"><TextBlock FontFamily="Segoe Fluent Icons" Text="&#xE8BB;"/></Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- v0.7.77.0: BorderBrush/BoxShadow now follow the active tab's identity color, matching the
         page-header/nav-pane/footer elsewhere on this same row band. -->
    <Border Grid.Row="1" Grid.RowSpan="2" Margin="8,4" CornerRadius="8" Background="{DynamicResource CommandSurfaceGradient}" BorderBrush="{Binding ActiveTabAccentBrush}" BorderThickness="1" BoxShadow="{Binding ActiveTabAccentGlowShadow}" ClipToBounds="True" IsVisible="{Binding !IsCreatingNewProfile}"/>
    <!-- v0.7.13.0: hidden while a tab is mid-setup (IsCreatingNewProfile): category tabs, ribbon,
         and nav sidebar have no meaning for a connection that doesn't exist yet, matching how
         comparable apps keep a "new connection" flow a focused, separate sequence rather than the
         regular chrome with some buttons disabled. -->
    <Border Grid.Row="1" Margin="9,5,9,0" Background="Transparent" IsVisible="{Binding !IsCreatingNewProfile}">
      <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
        <ToggleButton Classes="categoryTab home" IsChecked="{Binding IsV5HomeCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"><Border Classes="categoryTabGlow"><TextBlock Text="Home"/></Border></ToggleButton>
        <ToggleButton Classes="categoryTab server" IsChecked="{Binding IsV5ServerCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="ServerSetup"><Border Classes="categoryTabGlow"><TextBlock Text="Server"/></Border></ToggleButton>
        <ToggleButton Classes="categoryTab world" IsChecked="{Binding IsV5WorldCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Inspector"><Border Classes="categoryTabGlow"><TextBlock Text="World"/></Border></ToggleButton>
        <ToggleButton Classes="categoryTab backups" IsChecked="{Binding IsV5BackupsCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Backups"><Border Classes="categoryTabGlow"><TextBlock Text="Backups"/></Border></ToggleButton>
        <ToggleButton Classes="categoryTab mods" IsChecked="{Binding IsV5ModsCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="ModDashboard"><Border Classes="categoryTabGlow"><TextBlock Text="Mods"/></Border></ToggleButton>
        <ToggleButton Classes="categoryTab tools" IsChecked="{Binding IsV5ToolsCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="UpdateCenter"><Border Classes="categoryTabGlow"><TextBlock Text="Tools"/></Border></ToggleButton>
        <ToggleButton Classes="categoryTab system" IsChecked="{Binding IsV5SystemCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Settings"><Border Classes="categoryTabGlow"><TextBlock Text="System"/></Border></ToggleButton>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Margin="9,0,9,5" Background="Transparent" Padding="10,7,10,6" ClipToBounds="True" IsVisible="{Binding !IsCreatingNewProfile}">
      <!-- v0.7.25.0: ribbon groups/buttons are now data-bound (RibbonGroupViewModel/RibbonActionViewModel,
           MainWindowViewModel.VisibleRibbonGroups) instead of hand-authored per group, so the ribbon can
           shrink to fit. RibbonHost_OnSizeChanged feeds the measured width to
           MainWindowViewModel.UpdateRibbonWidth, which moves whichever trailing groups don't fit into
           OverflowRibbonGroups (reachable via the "»" button's flyout), the same way the tab strip's own
           VisibleTabs/OverflowTabs already work (v0.7.16.0). -->
      <StackPanel x:Name="RibbonHost" Orientation="Horizontal" SizeChanged="RibbonHost_OnSizeChanged">
        <ItemsControl ItemsSource="{Binding VisibleRibbonGroups}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:RibbonGroupViewModel">
              <Border Classes="ribbonGroup">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <!-- v0.7.14.0's accessibility fix carries forward: Content is a StackPanel (icon
                           glyph + label), not plain text, so AutomationProperties.Name is bound
                           explicitly rather than left to fall back to Content.ToString(). -->
                      <DataTemplate x:DataType="models:RibbonActionViewModel">
                        <Button Classes="ribbon" Classes.success="{Binding IsSuccessButton}" Classes.danger="{Binding IsDangerButton}"
                                Command="{Binding Command}" CommandParameter="{Binding CommandParameter}"
                                Click="RibbonAction_OnClick" AutomationProperties.Name="{Binding AutomationName}">
                          <StackPanel>
                            <Border Classes="iconTile">
                              <TextBlock Classes="flatIcon" Text="{Binding Glyph}"
                                         Classes.amber="{Binding IsAmberIcon}" Classes.green="{Binding IsGreenIcon}"
                                         Classes.blue="{Binding IsBlueIcon}" Classes.red="{Binding IsRedIcon}" Classes.cyan="{Binding IsCyanIcon}"/>
                            </Border>
                            <TextBlock Text="{Binding Label}"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="muted" FontSize="10" Text="{Binding Title}" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="RibbonOverflowButton" Width="36" Height="64" Margin="2,0" Padding="0" Classes="ghost"
                IsVisible="{Binding HasOverflowRibbonGroups}" Click="RibbonOverflowButton_OnClick"
                ToolTip.Tip="Show hidden ribbon actions" AutomationProperties.Name="Show hidden ribbon actions">
          <TextBlock FontSize="16" Text="»" Foreground="{DynamicResource TextBrush}"/>
        </Button>
      </StackPanel>
    </Border>

    <!-- v0.7.62.0 bug fix: MinWidth with no MaxWidth, relying solely on HorizontalAlignment="Right"
         to stay confined to the right portion of this single-column Grid (no Grid.ColumnDefinitions
         exist; every row-1/2 child shares one column and only alignment keeps them visually apart).
         Reported live: after a reconnect, this panel's own opaque CardGradient background was
         covering the category tabs and ribbon underneath ("looks like it's in the background"),
         on every page, not just Dashboard; consistent with an Arrange pass that stops respecting
         HorizontalAlignment="Right" and expands this Border across the full row width instead of
         its intended ~460-600px. A MaxWidth bounds the damage regardless of the exact Avalonia
         layout mechanism at fault, without a larger, riskier restructuring into real Grid columns. -->
    <!-- v0.7.63.0: fixed Height replaces the previous Auto-content sizing. Before this, the row
         housing this header (the outer Grid's ribbon row, RowDefinitions="66,42,Auto,*,44") sized
         itself independently per page; Dashboard carried an extra help line + background artwork
         no other page had, so its row came out visibly taller than e.g. Server Setup's. A fixed
         Height guarantees every page's header (and therefore the shared ribbon row) renders at the
         same size regardless of content; ClipToBounds remains as a safety net for any subtitle long
         enough to wrap past two lines. -->
    <Border Grid.Row="1" Grid.RowSpan="2" Height="112" Margin="9,5" HorizontalAlignment="Right" MinWidth="460" MaxWidth="620" CornerRadius="8" Background="{DynamicResource CardGradient}" BorderBrush="{Binding ActiveTabAccentBrush}" BorderThickness="2" BoxShadow="{Binding ActiveTabAccentGlowShadow}" Padding="20,10" ClipToBounds="True" IsVisible="{Binding !IsCreatingNewProfile}">
      <Grid RowDefinitions="Auto,*">
        <!-- v0.7.54.0: Per-Page Title Background Artwork, item 8. Real illustrated artwork behind
             the page header, per category tab, Dark/Light aware. Only Home and World have art so
             far (a free anonymous AI-image-generation session hit its daily guest limit after
             these two), so the remaining categories fall through with no Image shown at all, same
             as today, rather than a placeholder. -->
        <!-- v0.7.62.0 bug fix: these images had no height constraint. The outer ribbon row is
             Auto-sized, so Avalonia measures this inner Grid's "*" row as unconstrained; an
             unconstrained Image with Stretch="UniformToFill" reports its own native pixel
             dimensions as desired size, inflating this Border's measured height and, through it,
             the whole Auto ribbon row well past its intended content height. ClipToBounds on the
             outer Border only clips rendering, not measurement, so it never prevented this.
             MaxHeight caps the image's desired size directly, fixing the measure-phase cause; now
             matched to the Border's own fixed Height above. -->
        <Image Grid.RowSpan="2" MaxHeight="112" Source="/Assets/page-art-home-dark.jpg" Stretch="UniformToFill" Opacity="0.3" IsVisible="{Binding IsHomePageArtDark}"/>
        <Image Grid.RowSpan="2" MaxHeight="112" Source="/Assets/page-art-home-light.jpg" Stretch="UniformToFill" Opacity="0.3" IsVisible="{Binding IsHomePageArtLight}"/>
        <Image Grid.RowSpan="2" MaxHeight="112" Source="/Assets/page-art-world-dark.jpg" Stretch="UniformToFill" Opacity="0.3" IsVisible="{Binding IsWorldPageArtDark}"/>
        <Image Grid.RowSpan="2" MaxHeight="112" Source="/Assets/page-art-world-light.jpg" Stretch="UniformToFill" Opacity="0.3" IsVisible="{Binding IsWorldPageArtLight}"/>
        <!-- v0.7.79.0: requested directly; raster background art can't be re-themed per accent
             theme itself (no vector source, disclosed gap since v0.7.48.0), but a translucent wash
             in the active theme's own signature color over top approximates the effect cheaply.
             BlueAccentBorderBrush already varies correctly per accentTheme+variant (confirmed
             during this same pass), so this needs no new resource. A full per-theme art swap is
             deferred to a later version; see memory. -->
        <Border Grid.RowSpan="2" CornerRadius="8" Background="{DynamicResource BlueAccentBorderBrush}" Opacity="0.16" IsVisible="{Binding !IsCreatingNewProfile}"/>
        <!-- v0.7.76.0: BorderBrush bound here (a local value on Border.badge, same technique as the
             tab strip's own selected-border fix) so this pill's outline also follows the active
             tab's identity color, extending the same signal already on the header box around it. -->
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" IsVisible="{Binding ShowGlobalPageHeader}"><CheckBox Content="Auto refresh" IsChecked="{Binding AutoRefreshEnabled}"/><Border Classes="badge" BorderBrush="{Binding ActiveTabAccentBrush}"><TextBlock Text="{Binding ConnectionState}"/></Border></StackPanel>
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="3">
          <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding PageTitle}"/>
          <TextBlock Text="{Binding PageSubtitle}" Classes="muted" TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3" ColumnDefinitions="260,*" ClipToBounds="True" IsVisible="{Binding !IsCreatingNewProfile}">
      <!-- v0.7.34.0: darker glass-hover gradient (the same one used on hover across ribbon
           buttons, category tabs, and nav buttons), was the flatter NavGlassSurfaceGradient. -->
      <!-- v0.7.74.0: BorderBrush now follows ActiveTab.AccentBrush (same per-tab identity color as
           the title-bar strip and page-header border) instead of a fixed blue. BoxShadow stays on
           the fixed resource; Avalonia's BoxShadow shorthand can't bind to a per-tab value, the
           same disclosed limitation the v0.7.48.0 theme-derivation pass ran into for DynamicResource. -->
      <Border Grid.Column="0" Margin="8" CornerRadius="6" Background="{DynamicResource GlassOptionHoverGradient}" BorderBrush="{Binding ActiveTabAccentBrush}" BorderThickness="1" BoxShadow="{Binding ActiveTabAccentGlowShadow}" ClipToBounds="True">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="7,0">
              <!-- v0.7.19.0: every nav destination now uses the full hand-authored "glass orb" icon
                   set (src/MystTiq.Desktop/Assets/Icons/icon-*.png) instead of the old mix of 7
                   StreamGeometry vectors plus 18 plain Unicode-glyph text prefixes: see
                   docs/architecture/v0.7.19.0-full-nav-icon-set.md for why PNG over SVG/StreamGeometry. -->
              <StackPanel IsVisible="{Binding IsV5HomeCategory}" Spacing="3">
                <ToggleButton Classes="nav" IsChecked="{Binding IsDashboardPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-dashboard.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Dashboard"/></Grid></Border></ToggleButton>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsV5ServerCategory}" Spacing="3">
                <ToggleButton Classes="nav" IsChecked="{Binding IsServerSetupPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="ServerSetup"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-server_setup.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Server Setup"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsServerPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Configuration"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-configuration.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Configuration"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsConsolePage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Console"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-console.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Console"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsWorkspacePage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Workspace"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-workspace.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Workspace"/></Grid></Border></ToggleButton>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsV5WorldCategory}" VerticalAlignment="Top" Spacing="3">
                <ToggleButton Classes="nav" IsChecked="{Binding IsWorldExplorerPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Inspector"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-inspector.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Inspector"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsPlayersPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Players"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-players.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Players"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsBasesPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Bases"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-bases.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Bases"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsGuildsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Guilds"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-guilds.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Guilds"/></Grid></Border></ToggleButton>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsV5BackupsCategory}" Spacing="3"><ToggleButton Classes="nav" IsChecked="{Binding IsBackupsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Backups"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-backup-sphere.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Backup Center"/></Grid></Border></ToggleButton></StackPanel>
              <StackPanel IsVisible="{Binding IsV5ModsCategory}" Spacing="3">
                <ToggleButton Classes="nav" IsChecked="{Binding IsModDashboardPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="ModDashboard"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-mod_dashboard.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="MOD Dashboard"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsModLibraryPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="ModLibrary"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-mod_library.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="MOD Library"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsUe4ssPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Ue4ss"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-ue4ss.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="UE4SS"/></Grid></Border></ToggleButton>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsV5ToolsCategory}" Spacing="3">
                <ToggleButton Classes="nav" IsChecked="{Binding IsUpdateCenterPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="UpdateCenter"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-update_center.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Update Center"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsDoctorPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Doctor"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-server_doctor.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Server Doctor"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsCrashAnalyzerPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="CrashAnalyzer"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-crash_analyzer.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Crash Analyzer"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsSaveToolsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="SaveTools"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-save_tools.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Save Tools"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsDiagnosticsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="DiagnosticsCenter"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-diagnostics.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Diagnostics"/></Grid></Border></ToggleButton>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsV5SystemCategory}" Spacing="3">
                <ToggleButton Classes="nav" IsChecked="{Binding IsSettingsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Settings"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-settings.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Settings"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsNotificationsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Notifications"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-notifications.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Notifications"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsActivityAuditPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="ActivityAudit"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-activity_audit.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Activity &amp; Audit"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsAutomationPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Automation"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-automation.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Automation"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsAlertCenterPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="AlertCenter"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-alert_center.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Alert Center"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsSecurityPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Security"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-security.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Security"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsFleetPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Fleet"><Border Classes="navSurface"><Grid ColumnDefinitions="60,*" ColumnSpacing="12"><Image Source="/Assets/Icons/icon-fleet.png" Width="56" Height="56" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="Fleet"/></Grid></Border></ToggleButton>
              </StackPanel>
            </Grid>
          </ScrollViewer>
          <Border Grid.Row="1" Classes="statuscard" Margin="7,5,7,9" Padding="10"><StackPanel Spacing="3"><TextBlock Text="{Binding ServerState}" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}"/><TextBlock Text="{Binding ConnectionState}" FontSize="10" Foreground="{DynamicResource BlueBrush}" TextWrapping="Wrap"/></StackPanel></Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1" ClipToBounds="True">
        <Image Source="/Assets/dashboard-atmosphere-v3.png" Stretch="UniformToFill" Opacity="0.94"/>
        <Border Background="{DynamicResource Bg0ScrimBrush}"/>
        <!-- v0.7.79.0: same theme-color wash as the page-header art above. -->
        <Border Background="{DynamicResource BlueAccentBorderBrush}" Opacity="0.14"/>
        <ScrollViewer Margin="4,8,8,8">
          <StackPanel Margin="22" Spacing="20">
        <!-- DASHBOARD -->
        <!-- v0.7.53.0: Dashboard Layout Density, item 13. Smaller/denser stat cards, matching the
             v0.2.16.4 reference and the same padding/font-size treatment the v0.7.32.0 density pass
             already applied to Server Setup/Backups/MOD Library/Server Doctor. Structural changes
             from that same reference (inline ribbon buttons, collapsible-tree nav) are a different,
             much larger change and explicitly out of scope here, this is card density only. -->
        <StackPanel IsVisible="{Binding IsDashboardPage}" Spacing="6">

          <!-- v0.7.31.0: identity is the install location, not host:port; see
               MainWindowViewModel.RecomputeDuplicateInstallWarnings. This can only be discovered
               after connecting (a ConnectionProfile alone has no install-path concept), so it's a
               warning banner here rather than something that could block the wizard beforehand. -->
          <Border Classes="statuscard" BorderBrush="{DynamicResource AmberBrush}" BorderThickness="1" Padding="10,7" IsVisible="{Binding ActiveTab.HasDuplicateInstallWarning}">
            <TextBlock Text="{Binding ActiveTab.DuplicateInstallWarning}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" FontSize="12"/>
          </Border>

          <Border Classes="card accentHome" Padding="7,5" IsVisible="{Binding ManagementApiConnected}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Text="LIFECYCLE" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}" FontSize="11"/>
              <TextBlock Grid.Column="1" Text="{Binding LifecycleStatusText}" TextWrapping="Wrap" FontSize="11"/>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="1.15*,1.15*,1.15*,1.15*" ColumnSpacing="8">
            <Border Classes="statuscard" Padding="8,6" Classes.glowGreen="{Binding IsServerGlowGreen}" Classes.glowRed="{Binding IsServerGlowRed}" Classes.glowAmber="{Binding IsServerGlowAmber}">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <TextBlock Text="SERVER" Classes="muted"/>
                <TextBlock Grid.Row="1" Text="{Binding ServerState}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Text="{Binding DashboardSessionText}" Classes="muted"/>
                <Border Grid.Column="1" Grid.RowSpan="3" Background="{DynamicResource CardStrongBrush}" BorderBrush="{DynamicResource BlueAccentBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="8,3" VerticalAlignment="Center"><TextBlock Text="{Binding UptimeText}" Foreground="{DynamicResource BlueBrush}" FontWeight="Bold" FontSize="12"/></Border>
              </Grid>
            </Border>
            <Border Grid.Column="1" Classes="card glowDarkGreen" Padding="8,6">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <TextBlock Text="ACTIVE WORLD" Classes="muted"/>
                <Button Grid.Column="1" Content="OPEN" Padding="8,3" Command="{Binding NavigateCommand}" CommandParameter="Inspector"/>
                <TextBlock Grid.Row="1" Text="{Binding DashboardWorldNicknameText}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding DashboardWorldText}" FontSize="9" FontFamily="Consolas, monospace" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{Binding DashboardWorldPulseText}" Classes="muted" VerticalAlignment="Center"/>
                  <Button Content="Copy ID" Padding="6,2" Click="CopyActiveWorldId_Click" ToolTip.Tip="Copy the full canonical World ID."/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="2" Classes="card glowAmber" Padding="8,6">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <TextBlock Text="BACKUP" Classes="muted"/>
                <Button Grid.Column="1" Content="OPEN" Padding="8,3" Command="{Binding NavigateCommand}" CommandParameter="Backups"/>
                <TextBlock Grid.Row="1" Text="{Binding DashboardBackupText}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Text="{Binding BackupTotalSizeText, StringFormat='Stored: {0}'}" Classes="muted"/>
              </Grid>
            </Border>
            <Border Grid.Column="3" Classes="card" Padding="8,6" Classes.glowGreen="{Binding IsHealthGlowGreen}" Classes.glowRed="{Binding IsHealthGlowRed}" Classes.glowAmber="{Binding IsHealthGlowAmber}" Classes.glowNeutral="{Binding IsHealthGlowNeutral}">
              <Grid RowDefinitions="Auto,Auto,Auto">
                <TextBlock Text="OVERALL HEALTH" Classes="muted"/>
                <TextBlock Grid.Row="1" Text="{Binding DashboardHealthText}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding HealthStateColorKey, Converter={x:Static converters:SemanticStatusColorConverter.Instance}}"/>
                <TextBlock Grid.Row="2" Text="{Binding DashboardHealthDetail}" Classes="muted" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <Border Classes="card glowPurple" Padding="8,6"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="PLAYERS" Classes="muted"/><TextBlock Text="{Binding OnlinePlayerCountText, StringFormat='{}{0} online'}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding PlayerRecordCountText, StringFormat='{}{0} known'}" Classes="muted"/></StackPanel><Button Grid.Column="1" Content="OPEN" Padding="7,2" VerticalAlignment="Center" Command="{Binding NavigateCommand}" CommandParameter="Players"/></Grid></Border>
            <Border Grid.Column="1" Classes="card accentHome" Padding="8,6"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="GUILDS &amp; BASES" Classes="muted"/><TextBlock Text="{Binding DashboardGuildText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SemanticStateText}" Classes="muted"/></StackPanel><Button Grid.Column="1" Content="OPEN" Padding="7,2" VerticalAlignment="Center" Command="{Binding NavigateCommand}" CommandParameter="Guilds"/></Grid></Border>
            <Border Grid.Column="2" Classes="card accentHome" Padding="8,6"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="MOD PLATFORM" Classes="muted"/><TextBlock Text="{Binding DashboardModText}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding ModHealth, StringFormat='Health: {0}'}" Classes="muted"/></StackPanel><Button Grid.Column="1" Content="OPEN" Padding="7,2" VerticalAlignment="Center" Command="{Binding NavigateCommand}" CommandParameter="ModDashboard"/></Grid></Border>
            <Border Grid.Column="3" Classes="card accentHome" Padding="8,6" ClipToBounds="True">
              <Grid ColumnDefinitions="0.8*,1.15*,1.05*" ColumnSpacing="6" ClipToBounds="True">
                <StackPanel MinWidth="0"><TextBlock Text="CPU" Classes="muted"/><TextBlock Text="{Binding CpuText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="1" MinWidth="0"><TextBlock Text="MEMORY" Classes="muted"/><TextBlock Text="{Binding MemoryText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ThreadCountText, StringFormat='Threads {0}'}" Classes="muted" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel>
                <Border Grid.Column="2" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Center" MinWidth="0">
                  <StackPanel Spacing="6" MinWidth="0">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding CpuPercentValue}" Height="6" MinWidth="0" HorizontalAlignment="Stretch" ToolTip.Tip="Current PalServer CPU utilization."/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding MemoryScaleValue}" Height="6" MinWidth="0" HorizontalAlignment="Stretch" ToolTip.Tip="Current PalServer memory relative to the recent history peak."/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>

          <Border Background="{DynamicResource CardStrongBrush}" BorderBrush="{DynamicResource BlueAccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6">
            <Grid ColumnDefinitions="1.25*,1*,1*,1.25*,1.4*" ColumnSpacing="12">
              <StackPanel><TextBlock Text="WORLD PULSE" Foreground="{DynamicResource BlueBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="{Binding DashboardWorldClockText}" FontSize="15" FontWeight="Bold"/><TextBlock Text="{Binding DashboardWorldClockDetailText}" Classes="muted" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="SERVER SESSION" Classes="muted" FontSize="9"/><TextBlock Text="{Binding UptimeText}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding DashboardSessionText}" Classes="muted" FontSize="9"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="PLAYERS THIS SESSION" Classes="muted" FontSize="9"/><TextBlock Text="{Binding DashboardPlayersSessionText}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{Binding PlayerRecordCountText, StringFormat='{}{0} known player(s)'}" Classes="muted" FontSize="9"/></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="WORLD SAVE" Classes="muted" FontSize="9"/><TextBlock Text="{Binding DashboardPulseSaveText}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{Binding DashboardPulseBackupText}" Classes="muted" FontSize="9"/></StackPanel>
              <StackPanel Grid.Column="4"><TextBlock Text="LAST ACTIVITY" Classes="muted" FontSize="9"/><TextBlock Text="{Binding DashboardLastActivityText}" TextWrapping="Wrap" MaxHeight="40" FontSize="9" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
            </Grid>
          </Border>

          <Border Classes="card accentHome" Padding="8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="12">
              <TextBlock Text="HEALTH" Classes="muted" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding DashboardHealthText}" FontWeight="Bold" Foreground="{Binding HealthStateColorKey, Converter={x:Static converters:SemanticStatusColorConverter.Instance}}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{Binding DashboardRestText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="{Binding DashboardRconText}" Foreground="{DynamicResource AmberBrush}" VerticalAlignment="Center" ToolTip.Tip="RCON state from the active PalWorldSettings.ini. Open Console for Doctor and legacy RCON commands."/>
              <TextBlock Grid.Column="4" Text="{Binding DashboardModsStripText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="5" Text="{Binding DashboardBackupStripText}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="7">
                <Button Classes="success" Content="SCAN" Padding="10,3" Command="{Binding RunDoctorCommand}" ToolTip.Tip="Run Doctor checks immediately, in place. Use the ribbon's Doctor button to open the full Doctor page."/>
                <Button Content="SAVE" Padding="10,3" Command="{Binding SaveWorldNowCommand}" ToolTip.Tip="Force-saves the world immediately, via RCON (Save) -- the same effect as the server's own periodic autosave, on demand."/>
                <Button Classes="danger" Content="CLEANUP" Padding="10,3" IsEnabled="False" ToolTip.Tip="BACKEND REQUIRED: cleanup is not enabled until a safe server-side cleanup contract exists."/>
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="1.65*,*" ColumnSpacing="10" Height="100">
            <Border Classes="card accentHome" Padding="10">
              <Grid RowDefinitions="Auto,*" RowSpacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource GreenBrush}"/>
                    <TextBlock Text="RESOURCE HISTORY" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="• LIVE" Foreground="{DynamicResource GreenBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                  </StackPanel>
                  <ComboBox Grid.Column="1" Width="104" Height="28" ItemsSource="{Binding HistoryRanges}" SelectedItem="{Binding SelectedHistoryRange}"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="190,*" ColumnSpacing="10">
                  <StackPanel VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="{Binding HistoryCpuSummary}" Foreground="{DynamicResource BlueBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding HistoryMemorySummary}" Foreground="{DynamicResource VioletBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding HistoryFpsSummary}" Foreground="{DynamicResource GreenBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="Real in-game simulation FPS from Palworld's own REST API, sampled over the same history as CPU/Memory above."/>
                    <TextBlock Text="{Binding HistorySampleSummary}" Classes="muted" FontSize="9"/>
                  </StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="5" Padding="4" ClipToBounds="True">
                    <controls:ResourceHistoryChart ItemsSource="{Binding ResourceHistory}" Height="66" MinWidth="0" ClipToBounds="True"/>
                  </Border>
                </Grid>
              </Grid>
            </Border>
            <Border Grid.Column="1" Classes="card accentHome" Padding="10">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="LIVE ACTIVITY" FontSize="15" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding LastObservedText}" Classes="muted"/></Grid>
                <ItemsControl ItemsSource="{Binding DashboardActivityLines}" MaxHeight="105"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </Border>
          </Grid>

          <!-- v0.7.33.0: removed the duplicate ONLINE PLAYERS card that stood beside this log
               card; the top-row PLAYERS summary card (with its own OPEN button to the Players
               page) already covers that. Log card now spans the full width in its place. -->
          <Border Classes="card accentHome" Padding="10">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="LIVE SERVER / MANAGER LOG" FontSize="15" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Open Console" Command="{Binding NavigateCommand}" CommandParameter="Console"/></Grid>
              <TextBlock Text="{Binding LogFileText}" Classes="muted" FontSize="10"/>
              <ListBox ItemsSource="{Binding LogLines}" MaxHeight="140" Background="#07110A" BorderBrush="#214C2A" Foreground="{DynamicResource GreenBrush}" FontFamily="Consolas, monospace" FontSize="10">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="2,1"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#12241A"/></Style>
                  <Style Selector="ListBoxItem:nth-child(2n)"><Setter Property="Background" Value="#0B1712"/></Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{Binding Converter={x:Static converters:ConsoleLineColorConverter.Instance}}"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <Border Classes="card accentHome" Padding="8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
              <StackPanel><TextBlock Text="SERVER NAME" Classes="muted" FontSize="9"/><TextBlock Text="{Binding DashboardServerNameText}" FontSize="13" FontWeight="Bold"/></StackPanel>
              <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderSoftBrush}" Margin="4,0"/>
              <StackPanel Grid.Column="2"><TextBlock Text="DESCRIPTION" Classes="muted" FontSize="9"/><TextBlock Text="{Binding DashboardServerDescriptionText}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DashboardServerDescriptionText}"/></StackPanel>
              <Border Grid.Column="3" Width="1" Background="{DynamicResource BorderSoftBrush}" Margin="4,0"/>
              <StackPanel Grid.Column="4"><TextBlock Text="CURRENT OPERATION" Classes="muted" FontSize="9"/><TextBlock Text="{Binding LifecycleStatusText}" FontSize="10" Foreground="{DynamicResource BlueBrush}" MaxWidth="300" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- SERVER SETUP — parity-oriented environment checklist -->
        <StackPanel IsVisible="{Binding IsServerSetupPage}" Spacing="10">
          <!-- v0.7.32.0: compact variant of these 4 cards, with explicit tight Padding, smaller
               FontSize, and shortened description text (the prior full-sentence descriptions were
               what actually drove card height via text wrap, more than padding did; these cards
               have no base .statuscard Padding/FontSize of their own to shrink). Also removes
               "Verify Files" here for real; v0.7.26.0 added it to the ribbon but never removed
               this original embedded copy. -->
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <Border Classes="statuscard accentServer" Padding="8,5"><StackPanel Spacing="2"><TextBlock Text="COMPONENTS" Classes="muted" FontSize="10"/><TextBlock Text="{Binding SetupComponentCountText}" FontSize="15" FontWeight="Bold"/><TextBlock Text="Steam, storage, runtime" Classes="muted" FontSize="9"/></StackPanel></Border>
            <Border Grid.Column="1" Classes="statuscard accentServer" Padding="8,5"><StackPanel Spacing="2" HorizontalAlignment="Center"><TextBlock Text="READY" Classes="muted" FontSize="10" HorizontalAlignment="Center"/><TextBlock Text="{Binding SetupReadyCountText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}" HorizontalAlignment="Center"/><TextBlock Text="Verified" Classes="muted" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Border>
            <Border Grid.Column="2" Classes="statuscard accentServer" Padding="8,5"><StackPanel Spacing="2"><TextBlock Text="ATTENTION" Classes="muted" FontSize="10"/><TextBlock Text="{Binding SetupAttentionCountText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AmberBrush}"/><TextBlock Text="See row action" Classes="muted" FontSize="9"/></StackPanel></Border>
            <Border Grid.Column="3" Classes="statuscard accentServer" Padding="8,5"><StackPanel Spacing="2"><TextBlock Text="ENVIRONMENT HEALTH" Classes="muted" FontSize="10"/><TextBlock Text="{Binding EnvironmentHealthText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}"/></StackPanel></Border>
          </Grid>
          <TextBlock Text="SERVER ENVIRONMENT" FontSize="15" FontWeight="Bold" Margin="4,2,0,0"/>
          <Border Classes="card accentServer" Padding="0" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
              <Grid Background="{DynamicResource Bg2Brush}" ColumnDefinitions="110,190,95,2*,2.35*" Height="38">
                <TextBlock Text="ACTION" Margin="12,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="COMPONENT" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="STATUS" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="LOCATION" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="4" Text="DETAILS" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
              </Grid>
              <ScrollViewer Grid.Row="1" MaxHeight="{Binding ServerSetupTableMaxHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding EnvironmentItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:EnvironmentChecklistItemDto">
                      <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="2">
                        <Grid ColumnDefinitions="110,190,95,2*,2.35*" MinHeight="39">
                          <Button Content="{Binding ActionDisplay}" Click="EnvironmentAction_Click" Margin="4,3" Padding="6,3" MinHeight="30" FontSize="9" IsEnabled="{Binding ActionSupported}" ToolTip.Tip="{Binding ActionToolTip}" Classes.inspectAction="{Binding IsInspectAction}" Classes.targetAction="{Binding IsTargetAction}"/>
                          <TextBlock Grid.Column="1" Text="{Binding Component}" Margin="10,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                          <!-- v0.7.79.0: direct live feedback ("the Ready should be in the middle
                               of the green. can we also add a gradient glassy effect"). Explicit
                               Stretch + Center (rather than relying on Border/TextBlock defaults)
                               guarantees the text sits centered in the full pill regardless of how
                               wide the STATUS column ends up; flat GreenBrush/AmberBrush/RedBrush
                               fills replaced with the app's existing glass-gradient family
                               (Success/Warning/Danger Glass, the same ones ribbon buttons already
                               use) plus a thin matching accent border for definition. -->
                          <Grid Grid.Column="2" Margin="8,6">
                            <Border Background="{DynamicResource SuccessGlassGradient}" BorderBrush="{DynamicResource GreenAccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" HorizontalAlignment="Stretch" IsVisible="{Binding IsReady}"><TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="10" FontWeight="Bold"/></Border>
                            <Border Background="{DynamicResource WarningGlassGradient}" BorderBrush="{DynamicResource AmberAccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" HorizontalAlignment="Stretch" IsVisible="{Binding IsDisabled}"><TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="10" FontWeight="Bold"/></Border>
                            <Border Background="{DynamicResource DangerGlassGradient}" BorderBrush="{DynamicResource RedAccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,3" HorizontalAlignment="Stretch" IsVisible="{Binding IsMissing}"><TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="10" FontWeight="Bold"/></Border>
                          </Grid>
                          <TextBlock Grid.Column="3" Text="{Binding Location}" Margin="10,0" VerticalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}"/>
                          <TextBlock Grid.Column="4" Text="{Binding Details}" Margin="10,0" VerticalAlignment="Center" FontSize="10" TextWrapping="Wrap" MaxHeight="34"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Classes="card accentServer" Padding="12" Background="{DynamicResource Bg1Brush}">
            <Grid ColumnDefinitions="*,260" ColumnSpacing="16">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="OPERATION MONITOR" FontWeight="Bold"/>
                  <Border Background="{DynamicResource CardStrongBrush}" CornerRadius="4" Padding="8,2"><TextBlock Text="{Binding SetupOperationState}" FontSize="10" FontWeight="Bold"/></Border>
                </StackPanel>
                <TextBlock Text="{Binding SetupOperationTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0"/>
                <TextBlock Text="{Binding SetupOperationDetail}" Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding SetupRecentActivity}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
              </StackPanel>
              <!-- v0.7.89.0 bug fix: reported live. "how is this overall progress at 100% when
                   there are missing items?" This bar only ever tracked the most recently run
                   operation's own progress (e.g. Create Default Settings finishing), never the
                   environment's actual ready/missing count, which is already shown by the
                   READY/ATTENTION cards above. "OVERALL" wrongly implied it summarized the whole
                   environment. -->
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="OPERATION PROGRESS" Classes="muted" FontSize="10" FontWeight="SemiBold"/>
                <ProgressBar Value="{Binding SetupOperationProgress}" Minimum="0" Maximum="100" Height="18" Margin="0,6,0,0"/>
                <TextBlock Text="{Binding SetupOperationProgressText}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- UPDATE CENTER -->
        <StackPanel IsVisible="{Binding IsUpdateCenterPage}" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <StackPanel IsVisible="{Binding IsUpdateCenterPage}">
                <TextBlock Text="Review Palworld dedicated-server update readiness and execute validated SteamCMD updates." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Text="{Binding DistributionState}" Foreground="{DynamicResource VioletBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <!-- v0.7.42.0: Refresh/Preview SteamCMD Plan moved to the ribbon. -->
          </Grid>

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
            <Border Classes="card accentTools">
              <StackPanel Spacing="6">
                <TextBlock Text="Platform" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding DistributionPlatform}" FontSize="20" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card accentTools">
              <StackPanel Spacing="6">
                <TextBlock Text="SteamCMD" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding SteamCmdState}" FontSize="20" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card accentTools">
              <StackPanel Spacing="6">
                <TextBlock Text="Palworld Server" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding ServerInstallState}" FontSize="20" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- v0.7.45.0: Update Center Overhaul, real installed/latest version tracking per
               component (item 51), grouped into the two labeled sections the v0.2.16.4 reference
               used. Some rows cannot report a real "latest version" (no reliable unattended source
               exists; see HeadlessComponentUpdateService); those show "Unavailable"/"Check
               manually" honestly rather than a fabricated comparison. -->
          <Border Classes="card accentTools" IsVisible="{Binding HasComponentVersions}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="CORE SERVER" Classes="muted" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="{Binding ComponentVersionsCheckedAtText, StringFormat='Checked {0}'}" Classes="muted" FontSize="11"/>
              </Grid>
              <ItemsControl ItemsSource="{Binding CoreServerComponents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ComponentVersionDto">
                    <Border Classes="statuscard accentTools" Margin="0,3">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="1.4*,*,*,*,1.4*">
                          <TextBlock Text="{Binding Component}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}" FontFamily="Consolas, monospace" FontSize="12"/>
                          <TextBlock Grid.Column="2" Text="{Binding LatestVersion}" FontFamily="Consolas, monospace" FontSize="12"/>
                          <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12"
                                     Foreground="{Binding Status, Converter={x:Static converters:ComponentStatusColorConverter.Instance}}"/>
                          <TextBlock Grid.Column="4" Text="{Binding Source}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        <!-- v0.7.82.0: direct live feedback. "Update" for the one component with a
                             real, safe in-place update (pip); "Open" (manual check) for components
                             with no reliable unattended "latest version" feed. Neither shows for a
                             row that's neither (e.g. already up to date, or fully auto-compared). -->
                        <WrapPanel>
                          <Button Classes="success" Content="Update" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).UpdatePipCommand}" IsVisible="{Binding CanUpdateInPlace}" Padding="8,3" FontSize="11"/>
                          <Button Content="Open" Click="OpenComponentSourceUrl_Click" IsVisible="{Binding HasSourceUrl}" ToolTip.Tip="Open the official page to check this manually." Padding="8,3" FontSize="11"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="SAVE &amp; RUNTIME DEPENDENCIES" Classes="muted" FontWeight="Bold" Margin="0,8,0,0"/>
              <ItemsControl ItemsSource="{Binding SaveRuntimeDependencyComponents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ComponentVersionDto">
                    <Border Classes="statuscard accentTools" Margin="0,3">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="1.4*,*,*,*,1.4*">
                          <TextBlock Text="{Binding Component}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="1" Text="{Binding InstalledVersion}" FontFamily="Consolas, monospace" FontSize="12"/>
                          <TextBlock Grid.Column="2" Text="{Binding LatestVersion}" FontFamily="Consolas, monospace" FontSize="12"/>
                          <TextBlock Grid.Column="3" Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="12"
                                     Foreground="{Binding Status, Converter={x:Static converters:ComponentStatusColorConverter.Instance}}"/>
                          <TextBlock Grid.Column="4" Text="{Binding Source}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        <WrapPanel>
                          <Button Classes="success" Content="Update" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).UpdatePipCommand}" IsVisible="{Binding CanUpdateInPlace}" Padding="8,3" FontSize="11"/>
                          <Button Content="Open" Click="OpenComponentSourceUrl_Click" IsVisible="{Binding HasSourceUrl}" ToolTip.Tip="Open the official page to check this manually." Padding="8,3" FontSize="11"/>
                        </WrapPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <TextBlock Text="Use &quot;Refresh&quot; in the ribbon to check every component's installed and latest version." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasComponentVersions}"/>

          <Border Classes="card accentTools">
            <StackPanel Spacing="12">
              <TextBlock Text="Palworld Dedicated Server" FontSize="18" FontWeight="SemiBold" />
              <CheckBox Content="Validate server files with SteamCMD" IsChecked="{Binding ValidateServerFiles}" />
              <Button Classes="primary" HorizontalAlignment="Left"
                      Content="Update Palworld Server"
                      Command="{Binding UpdatePalworldServerCommand}"/>
              <TextBlock Text="PalServer must be stopped. This action updates the Palworld Dedicated Server through the configured SteamCMD installation. It does not update the MystTiq application." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock Text="{Binding DistributionDetail}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </Border>

          <Border Classes="card accentTools">
            <StackPanel Spacing="8">
              <TextBlock Text="SteamCMD Plan" FontSize="17" FontWeight="SemiBold" />
              <TextBox Text="{Binding DistributionPlanText}" AcceptsReturn="True" IsReadOnly="True" MinHeight="130" FontFamily="Consolas, monospace" FontSize="11" />
            </StackPanel>
          </Border>

          <Border Classes="card accentTools">
            <StackPanel Spacing="8">
              <TextBlock Text="Last SteamCMD Output" FontSize="17" FontWeight="SemiBold" />
              <TextBox Text="{Binding DistributionOutputText}" AcceptsReturn="True" IsReadOnly="True" MinHeight="160" FontFamily="Consolas, monospace" FontSize="11" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- WORLD EXPLORER -->
        <StackPanel IsVisible="{Binding IsWorldExplorerPage}" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{Binding WorldExplorerState}" Foreground="{DynamicResource VioletBrush}" />
              <TextBlock Text="{Binding WorldExplorerDetail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <!-- v0.7.42.0: Refresh World moved to the ribbon; Validator & Recovery stays as an
                 in-page cross-navigation link, not a page action. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button Content="Validator &amp; Recovery" Command="{Binding NavigateCommand}" CommandParameter="WorldTransactions" ToolTip.Tip="Open protected validation, transaction and recovery workflows."/>
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
            <Border Classes="card accentWorld">
              <StackPanel Spacing="5"><TextBlock Text="ACTIVE WORLD" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding DashboardWorldNicknameText}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding ActiveWorldIdText}" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas, monospace" ToolTip.Tip="Full canonical active World ID"/><Button Content="Copy World ID" HorizontalAlignment="Left" Padding="8,3" Click="CopyActiveWorldId_Click"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card accentWorld">
              <StackPanel Spacing="5"><TextBlock Text="WORLDS" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding WorldCountText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card accentWorld">
              <StackPanel Spacing="5"><TextBlock Text="FILES" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding WorldFileCountText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Classes="card accentWorld">
              <StackPanel Spacing="5"><TextBlock Text="PLAYER SAVES" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding WorldPlayerSaveCountText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="card accentWorld">
              <StackPanel Spacing="5"><TextBlock Text="TOTAL SIZE" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding WorldSizeText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
            </Border>
          </Grid>

          <Border Classes="card accentWorld">
            <StackPanel Spacing="8">
              <TextBlock Text="World Inspector Sections" FontSize="17" FontWeight="SemiBold"/>
              <WrapPanel><TextBlock Text="Overview" Margin="0,0,16,4"/><TextBlock Text="Players" Margin="0,0,16,4"/><TextBlock Text="Guilds" Margin="0,0,16,4"/><TextBlock Text="Bases" Margin="0,0,16,4"/><TextBlock Text="Saves" Margin="0,0,16,4"/><TextBlock Text="Statistics" Margin="0,0,16,4"/><TextBlock Text="Files" Margin="0,0,16,4"/><TextBlock Text="World Explorer" Margin="0,0,16,4"/><TextBlock Text="World Health" Margin="0,0,16,4"/><TextBlock Text="Integrity" Margin="0,0,16,4"/></WrapPanel>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><Border Classes="statuscard accentWorld"><StackPanel><TextBlock Text="PLAYERS" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding WorldInspectorPlayerCountText}" FontSize="20"/></StackPanel></Border><Border Grid.Column="1" Classes="statuscard accentWorld"><StackPanel><TextBlock Text="GUILDS" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding WorldInspectorGuildCountText}" FontSize="20"/></StackPanel></Border><Border Grid.Column="2" Classes="statuscard accentWorld"><StackPanel><TextBlock Text="BASE REFERENCES" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding WorldInspectorBaseCountText}" FontSize="20"/></StackPanel></Border></Grid>
            </StackPanel>
          </Border>

          <Border Classes="card accentWorld">
            <StackPanel Spacing="6">
              <TextBlock Text="Server-authoritative SaveRoot" FontWeight="SemiBold" />
              <TextBlock Text="{Binding WorldSaveRootText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11" />
              <TextBlock Text="World Explorer is read-only in this phase. It inventories active world/save files but does not decode, modify, restore, move, or delete save data." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="2*,3*" ColumnSpacing="14">
            <Border Classes="card accentWorld">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="Discovered Worlds" FontSize="17" FontWeight="SemiBold" />
                <ListBox Grid.Row="1" ItemsSource="{Binding WorldCandidates}" MaxHeight="390">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:WorldCandidateDto">
                      <StackPanel Margin="0,6">
                        <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WorldId}" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" ToolTip.Tip="Full canonical World ID"/>
                        <TextBlock Text="{Binding UpdatedText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                        <TextBlock Text="{Binding LevelSizeText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card accentWorld">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="Active World Files" FontSize="17" FontWeight="SemiBold" />
                <ListBox Grid.Row="1" ItemsSource="{Binding WorldFiles}" SelectedItem="{Binding SelectedWorldFile}" MaxHeight="390">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:WorldFileDto">
                      <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="10" Margin="0,5">
                        <StackPanel>
                          <TextBlock Text="{Binding RelativePath}" FontFamily="Consolas, monospace" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RelativePath}" />
                          <TextBlock Text="{Binding Category}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding UpdatedText}" FontSize="11" />
                          <TextBlock Text="{Binding Status}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <Border Classes="card accentWorld">
              <StackPanel Spacing="7"><TextBlock Text="Statistics / Saves" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding WorldSaveDataCountText, StringFormat='Save-data files: {0}'}"/><TextBlock Text="{Binding WorldDiagnosticCountText, StringFormat='Decoded / diagnostic files: {0}'}"/><TextBlock Text="{Binding WorldEmptyCountText, StringFormat='Empty files: {0}'}"/><TextBlock Text="{Binding WorldAgeRangeText, StringFormat='File age range: {0}'}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card accentWorld">
              <StackPanel Spacing="7"><TextBlock Text="World Health / Integrity" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding WorldIntegrityState}" FontSize="20" Foreground="{DynamicResource VioletBrush}"/><ItemsControl ItemsSource="{Binding WorldIntegrityFindings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="Read-only structural evidence; no local GUI filesystem inspection or world mutation." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <!-- PLAYER / GUILD EXPLORER -->
        <StackPanel IsVisible="{Binding IsPlayerGuildExplorerPage}" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <StackPanel IsVisible="{Binding IsBasesPage}">
                <TextBlock Text="Review guild-owned base references and the authoritative guild evidence that ties bases to ownership." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsGuildsPage}">
                <TextBlock Text="Review guild identity, leadership, membership, and base-reference evidence." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Text="{Binding PlayerGuildState}" Foreground="{DynamicResource VioletBrush}" />
              <TextBlock Text="{Binding PlayerGuildDetail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <!-- v0.7.42.0: Refresh Evidence moved to the ribbon. -->
          </Grid>

          <Grid ColumnDefinitions="*,*,2*" ColumnSpacing="12">
            <Border Classes="card accentWorld">
              <StackPanel Spacing="5">
                <TextBlock Text="BASE REFERENCES" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="{Binding ExplorerBases.Count}" FontSize="22" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card accentWorld">
              <StackPanel Spacing="5">
                <TextBlock Text="GUILDS" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="{Binding GuildRecordCountText}" FontSize="22" FontWeight="SemiBold"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card accentWorld">
              <StackPanel Spacing="5">
                <TextBlock Text="SEMANTIC EVIDENCE" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="{Binding SemanticStateText}" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SemanticSourceText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </Grid>

          <Border Classes="card accentWorld">
            <StackPanel Spacing="7">
              <TextBlock Text="Evidence Model" FontWeight="SemiBold"/>
              <TextBlock Text="Player save identity comes from validated 32-character Players/*.sav filenames. Player names, guild membership, leadership and base counts are shown only when authoritative decoded GroupSaveDataMap evidence is available. Live REST data may enrich currently-online player name/platform evidence." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
              <TextBlock Text="This phase is read-only. Player/guild repair, migration, leadership transfer and character modification remain later administration workflows." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
          </Border>

          <StackPanel IsVisible="{Binding IsGuildsPage}" Spacing="14">
            <Border Classes="card accentWorld">
              <Grid ColumnDefinitions="2*,*,Auto,Auto" ColumnSpacing="10">
                <TextBox Watermark="Search guild, ID, leader, or player ID" Text="{Binding GuildSearchText}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding GuildStatusFilters}" SelectedItem="{Binding SelectedGuildStatusFilter}"/>
                <TextBlock Grid.Column="2" Text="{Binding GuildVisibleCountText}" Foreground="{DynamicResource VioletBrush}" VerticalAlignment="Center"/>
                <Button Grid.Column="3" Content="Export Guilds CSV" Click="ExportGuildsCsv_Click"/>
              </Grid>
            </Border>
            <Grid ColumnDefinitions="3*,2*" ColumnSpacing="14">
              <Border Classes="card accentWorld">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                  <TextBlock Text="Guild Directory" FontSize="18" FontWeight="SemiBold"/>
                  <ListBox Grid.Row="1" ItemsSource="{Binding FilteredExplorerGuilds}" SelectedItem="{Binding SelectedExplorerGuild}" MaxHeight="480" ToolTip.Tip="Right-click for guild administration actions.">
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Transfer Leadership To…" Click="TransferGuildLeadership_OnClick"/>
                        <MenuItem Header="Add Player…" Click="AddPlayerToGuild_OnClick"/>
                        <MenuItem Header="Remove Broken Member…" Click="RemoveBrokenGuildMember_OnClick"/>
                        <MenuItem Header="Claim Orphaned Guild…" Click="ClaimOrphanedGuild_OnClick"/>
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate><DataTemplate x:DataType="models:GuildExplorerItemDto"><Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="10" Margin="0,8"><StackPanel><TextBlock Text="{Binding GuildName}" FontWeight="SemiBold"/><TextBlock Text="{Binding GuildId}" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding LeaderDisplay}"/><TextBlock Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Health}" Foreground="{DynamicResource VioletBrush}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" Spacing="14">
                <Border Classes="card accentWorld"><StackPanel Spacing="7"><TextBlock Text="Guild Details" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedExplorerGuild.GuildName}" FontSize="20" Foreground="{DynamicResource VioletBrush}"/><TextBlock Text="{Binding SelectedExplorerGuild.GuildId}" FontFamily="Consolas, monospace"/><TextBlock Text="{Binding SelectedExplorerGuild.Health}"/><TextBlock Text="{Binding SelectedExplorerGuild.LeaderDisplay}"/><TextBlock Text="{Binding SelectedExplorerGuild.CountText}"/><Grid ColumnDefinitions="*,*" ColumnSpacing="8"><Button Content="Copy Guild ID" Click="CopyGuildId_Click"/><Button Grid.Column="1" Content="Open Leader Player" Command="{Binding OpenSelectedGuildLeaderCommand}"/></Grid></StackPanel></Border>
                <Border Classes="card accentWorld"><StackPanel Spacing="7"><TextBlock Text="Members" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding SelectedExplorerGuild.MemberPlayerIds}" MaxHeight="110"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="11"/></DataTemplate></ListBox.ItemTemplate></ListBox><TextBlock Text="Base IDs" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding SelectedExplorerGuild.BaseIds}" MaxHeight="90"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="11"/></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
              </StackPanel>
            </Grid>
            <Border Classes="card accentWorld"><StackPanel Spacing="8"><TextBlock Text="Guild Ownership Operations" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Applies to the selected guild above. Requires PalServer stopped. Claim is only offered for guilds showing Orphaned / Needs Review; Transfer and Add Player work on any guild; Remove Broken Member is only offered when the target player has no matching save file. Follows Preview → Safety Backup → Server-side Transaction → Validate → Journal/Audit → Refresh GUI." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><Grid ColumnDefinitions="180,2*,Auto" ColumnSpacing="10"><ComboBox ItemsSource="{Binding GuildOperationTypes}" SelectedItem="{Binding GuildOperationType}"/><TextBox Grid.Column="1" Watermark="Target player ID (32-hex)" Text="{Binding GuildOperationPlayerId}"/><Button Grid.Column="2" Content="Preview" Command="{Binding PreviewGuildOwnershipCommand}"/></Grid><TextBlock Text="{Binding GuildOperationStatusText}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/><CheckBox Content="I reviewed this plan and confirm the active Palworld server is stopped." IsChecked="{Binding GuildOperationConfirmed}"/><Button Classes="danger" Content="Apply With Fresh Safety Backup" HorizontalAlignment="Left" Command="{Binding ApplyGuildOwnershipCommand}"/></StackPanel></Border>
          </StackPanel>

          <StackPanel IsVisible="{Binding IsBasesPage}" Spacing="14">
            <Border Classes="card accentWorld"><Grid ColumnDefinitions="2*,*,Auto,Auto" ColumnSpacing="10"><TextBox Watermark="Search base ID, guild, or leader" Text="{Binding BaseSearchText}"/><ComboBox Grid.Column="1" ItemsSource="{Binding BaseStatusFilters}" SelectedItem="{Binding SelectedBaseStatusFilter}"/><TextBlock Grid.Column="2" Text="{Binding BaseVisibleCountText}" Foreground="{DynamicResource VioletBrush}" VerticalAlignment="Center"/><Button Grid.Column="3" Content="Export Bases CSV" Click="ExportBasesCsv_Click"/></Grid></Border>
            <Grid ColumnDefinitions="3*,2*" ColumnSpacing="14">
              <Border Classes="card accentWorld"><Grid RowDefinitions="Auto,*" RowSpacing="8"><TextBlock Text="Authoritative Base References" FontSize="18" FontWeight="SemiBold"/><ListBox Grid.Row="1" ItemsSource="{Binding FilteredExplorerBases}" SelectedItem="{Binding SelectedExplorerBase}" MaxHeight="480" ToolTip.Tip="Right-click for base administration actions.">
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Copy Base Info" Click="CopyBaseInfo_OnClick"/>
                    <Separator/>
                    <MenuItem Header="Transfer to Guild…" Click="TransferBase_OnClick"/>
                    <MenuItem Header="Wipe Base Completely…" Click="WipeBase_OnClick"/>
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate><DataTemplate x:DataType="models:BaseExplorerItemDto"><Grid ColumnDefinitions="2*,2*,*" ColumnSpacing="10" Margin="0,8"><StackPanel><TextBlock Text="{Binding BaseId}" FontFamily="Consolas, monospace" FontWeight="SemiBold"/><TextBlock Text="{Binding Evidence}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="{Binding GuildName}"/><TextBlock Text="{Binding GuildId}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding OwnerHealth}" Foreground="{DynamicResource VioletBrush}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
              <StackPanel Grid.Column="1" Spacing="14"><Border Classes="card accentWorld"><StackPanel Spacing="7"><TextBlock Text="Base Ownership Evidence" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedExplorerBase.BaseId}" FontFamily="Consolas, monospace" FontSize="16" Foreground="{DynamicResource VioletBrush}"/><TextBlock Text="{Binding SelectedExplorerBase.GuildName}" FontSize="18"/><TextBlock Text="{Binding SelectedExplorerBase.GuildId}"/><TextBlock Text="{Binding SelectedExplorerBase.LeaderName}"/><TextBlock Text="{Binding SelectedExplorerBase.LeaderPlayerId}" FontFamily="Consolas, monospace" FontSize="11"/><TextBlock Text="{Binding SelectedExplorerBase.OwnerHealth}"/><TextBlock Text="{Binding SelectedExplorerBase.Evidence}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><Button Content="Copy Base ID" Click="CopyBaseId_Click"/></StackPanel></Border></StackPanel>
            </Grid>
            <Border Classes="card accentWorld"><StackPanel Spacing="8"><TextBlock Text="Base Ownership Transfer" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Applies to the selected base above. Moves the base's base_ids entry between guild records and retags every structure/container/worker record placed at that base (confirmed against real save data: ~130 records per base) to the new owning guild. Requires PalServer stopped. Follows Preview → Safety Backup → Server-side Transaction → Validate → Journal/Audit → Refresh GUI." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><Grid ColumnDefinitions="2*,Auto" ColumnSpacing="10"><TextBox Watermark="Target guild ID (32-hex)" Text="{Binding BaseTransferTargetGuildId}"/><Button Grid.Column="1" Content="Preview Transfer" Command="{Binding PreviewBaseTransferCommand}"/></Grid><TextBlock Text="{Binding BaseTransferStatusText}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/><CheckBox Content="I reviewed this plan and confirm the active Palworld server is stopped." IsChecked="{Binding BaseTransferConfirmed}"/><Button Classes="danger" Content="Apply With Fresh Safety Backup" HorizontalAlignment="Left" Command="{Binding ApplyBaseTransferCommand}"/></StackPanel></Border>
            <Border Classes="card accentWorld"><StackPanel Spacing="8"><TextBlock Text="Base Recovery" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Applies to the selected base above. Permanently removes the base's base_ids entry and every structure/container/worker record tagged to it (matching the legacy app's DeleteBaseAndOwnedObjects operation) rather than reassigning them. This cannot be undone except by restoring the safety backup created during Apply. Requires PalServer stopped. Follows Preview → Safety Backup → Server-side Transaction → Validate → Journal/Audit → Refresh GUI." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><Button Content="Preview Recovery" HorizontalAlignment="Left" Command="{Binding PreviewBaseRecoveryCommand}"/><TextBlock Text="{Binding BaseRecoveryStatusText}" Foreground="{DynamicResource OrangeBrush}" TextWrapping="Wrap"/><CheckBox Content="I reviewed this plan and confirm the active Palworld server is stopped. I understand this permanently deletes the base and its owned objects." IsChecked="{Binding BaseRecoveryConfirmed}"/><Button Classes="danger" Content="Apply With Fresh Safety Backup" HorizontalAlignment="Left" Command="{Binding ApplyBaseRecoveryCommand}"/></StackPanel></Border>
          </StackPanel>

          <Border Classes="card accentWorld">
            <StackPanel Spacing="7">
              <TextBlock Text="Semantic Warnings / Limitations" FontSize="17" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding PlayerGuildWarnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,2"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- SERVER -->
        <StackPanel IsVisible="{Binding IsServerPage}" Spacing="12">
          <Border Classes="card accentServer" ClipToBounds="True">
            <!-- v0.7.82.0: flattened from a row-indexed Grid to a single StackPanel so Server
                 Identity can sit first, with the Simple/Advanced toggle, QoL preset, search and
                 file path controls relocated further down (just above World Settings) instead of
                 competing with identity/network for the top of the page. -->
            <StackPanel Spacing="10">
              <Border Classes="statuscard accentServer" BorderBrush="{DynamicResource AmberBrush}" BorderThickness="1" IsVisible="{Binding HasSimpleSettingsGap}">
                <TextBlock Text="{Binding SimpleSettingsGapText}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" FontSize="12"/>
              </Border>
              <Border Classes="statuscard accentServer" BorderBrush="{DynamicResource AmberAccentBorderBrush}" BorderThickness="2" Background="{DynamicResource CardStrongBrush}" BoxShadow="{DynamicResource AmberAccentGlowShadowLow}" Padding="16">
                <Grid ColumnDefinitions="150,*,150,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                  <TextBlock Text="SERVER IDENTITY" Grid.ColumnSpan="4" FontWeight="Bold" Foreground="{DynamicResource AmberBrush}" Margin="0,0,0,4"/>
                  <TextBlock Grid.Row="1" Text="Server name" Classes="muted" VerticalAlignment="Center"/>
                  <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding ServerNameSetting.DisplayValue, Mode=TwoWay}" Watermark="Palworld server name" Classes.dirty="{Binding ServerNameSetting.IsDirty}"/>
                    <Button Grid.Column="1" Content="🎲 Generate" Classes="inspectAction" Command="{Binding GenerateServerNameCommand}" ToolTip.Tip="Generates a random server-browser name locally; Save Changes is still required." AutomationProperties.Name="Generate a random server name" Padding="14,7" FontWeight="SemiBold"/>
                  </Grid>
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="Description" Classes="muted" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ServerDescriptionSetting.DisplayValue, Mode=TwoWay}" Watermark="Server browser description" Classes.dirty="{Binding ServerDescriptionSetting.IsDirty}"/>
                  <TextBlock Grid.Row="2" Text="Admin password" Classes="muted" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding AdminPasswordSetting.DisplayValue, Mode=TwoWay}" PasswordChar="●" Classes.dirty="{Binding AdminPasswordSetting.IsDirty}"/>
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="Server password" Classes="muted" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding ServerPasswordSetting.DisplayValue, Mode=TwoWay}" PasswordChar="●" Classes.dirty="{Binding ServerPasswordSetting.IsDirty}"/>
                </Grid>
              </Border>

              <TextBlock Text="NETWORK, ACCESS &amp; LIMITS" FontWeight="Bold" Margin="4,4,0,0"/>
              <ItemsControl ItemsSource="{Binding SimpleToggleSettings}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:PalworldSimpleToggleItem">
                    <Border Classes="statuscard accentServer" Classes.dirty="{Binding IsDirty}" Margin="0,0,10,7" Padding="10,8" Width="260">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <StackPanel><TextBlock Text="{Binding Title}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding SimpleNetworkSettings}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:PalworldSettingDto">
                    <Border Classes="statuscard accentServer" Classes.dirty="{Binding IsDirty}" Margin="0,0,10,7" Padding="10,8">
                      <StackPanel Spacing="3" Width="160">
                        <TextBlock Text="{Binding DisplayName}" Classes="muted" FontSize="10"/>
                        <TextBox Text="{Binding DisplayValue, Mode=TwoWay}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- v0.7.26.0: Import/Export/Load Active/Save Changes/Reset Unsaved moved to the
                   ribbon (Load Active removed entirely as redundant), see MainWindowViewModel's
                   BuildRibbonGroupsForActivePage. Only Simple/Advanced/QoL preset/Save As Preset
                   stay here, since they were not part of that relocation. -->
              <Grid ColumnDefinitions="Auto,Auto,Auto,200,Auto,150,Auto,*" ColumnSpacing="8">
                <Button Classes.primary="{Binding IsConfigSimpleView}" Content="Simple Settings" Command="{Binding ShowSimpleConfigCommand}"/>
                <Button Grid.Column="1" Classes.primary="{Binding IsConfigAdvancedView}" Content="Advanced Settings" Command="{Binding ShowAdvancedConfigCommand}"/>
                <TextBlock Grid.Column="2" Text="QoL preset" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding PalworldConfigPresets}" SelectedItem="{Binding SelectedConfigPreset, Mode=TwoWay}" ToolTip.Tip="Selecting a preset applies it immediately."/>
                <TextBox Grid.Column="5" Watermark="New preset name" Text="{Binding NewConfigPresetName, Mode=TwoWay}"/>
                <Button Grid.Column="6" Content="Save As Preset" Command="{Binding SaveCurrentAsPresetCommand}" ToolTip.Tip="Saves every currently-loaded setting value as a new named preset, stored locally on this machine."/>
              </Grid>

              <Grid ColumnDefinitions="*,180" ColumnSpacing="8">
                <TextBox Watermark="Search setting name, category, or description" Text="{Binding ConfigSearchText, Mode=TwoWay}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding PalworldConfigCategories}" SelectedItem="{Binding SelectedConfigCategory, Mode=TwoWay}"/>
              </Grid>

              <StackPanel Spacing="3">
                <TextBlock Text="{Binding PalworldConfigPath}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock IsVisible="{Binding IsConfigAdvancedView}" Text="Advanced Settings exposes every known and custom OptionSettings entry returned by the server. Unknown settings are preserved. Highlighted rows differ from Palworld's default." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel IsVisible="{Binding IsConfigSimpleView}" Spacing="10">
                  <!-- v0.7.38.0: preset-loaded/unsaved-changes/validation notification strip,
                       relocated here from directly under the Simple/Advanced toggle row above,
                       right next to World Settings (renamed from Gameplay Rates), the section it's
                       actually reporting the state of. -->
                  <StackPanel Spacing="3">
                    <TextBlock Text="{Binding PalworldConfigState}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <TextBlock Text="{Binding PalworldConfigDirtyText}" Foreground="{DynamicResource AmberBrush}"/>
                      <TextBlock Text="{Binding PalworldConfigValidationText}" Foreground="{DynamicResource GreenBrush}" TextWrapping="Wrap" MaxWidth="470"/>
                    </StackPanel>
                    <TextBlock Text="Simple Settings shows server identity, connectivity, and the most useful gameplay/QoL controls. Switch to Advanced Settings for the complete OptionSettings list." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                  </StackPanel>

                  <!-- v0.7.38.0: renamed from "Gameplay Rates" and split into three labeled
                       sub-sections (World / Player &amp; Pal / Items &amp; Work), matching the
                       v0.2.16.4 reference's grouping, instead of one flat 22-row list. -->
                  <TextBlock Text="WORLD SETTINGS" FontWeight="Bold" Margin="4,4,0,0"/>

                  <TextBlock Text="World" Classes="muted" FontWeight="SemiBold" Margin="4,2,0,0"/>
                  <ItemsControl ItemsSource="{Binding SimpleWorldRateSettings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:PalworldSimpleSettingItem">
                        <Border Classes="statuscard accentServer" Classes.dirty="{Binding IsDirty}" Margin="0,0,0,7" Padding="10,8">
                          <Grid ColumnDefinitions="Auto,2*,220,95,130" ColumnSpacing="10">
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" ToolTip.Tip="Clear to return this option to its default value."/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                            <Slider Grid.Column="2" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" Value="{Binding SliderValue, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Classes="badge" VerticalAlignment="Center"><TextBlock Text="{Binding ValueText}" HorizontalAlignment="Center"/></Border>
                            <TextBlock Grid.Column="4" Text="{Binding DefaultComparisonText}" Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="Player &amp; Pal" Classes="muted" FontWeight="SemiBold" Margin="4,6,0,0"/>
                  <ItemsControl ItemsSource="{Binding SimplePlayerPalRateSettings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:PalworldSimpleSettingItem">
                        <Border Classes="statuscard accentServer" Classes.dirty="{Binding IsDirty}" Margin="0,0,0,7" Padding="10,8">
                          <Grid ColumnDefinitions="Auto,2*,220,95,130" ColumnSpacing="10">
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" ToolTip.Tip="Clear to return this option to its default value."/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                            <Slider Grid.Column="2" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" Value="{Binding SliderValue, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Classes="badge" VerticalAlignment="Center"><TextBlock Text="{Binding ValueText}" HorizontalAlignment="Center"/></Border>
                            <TextBlock Grid.Column="4" Text="{Binding DefaultComparisonText}" Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="Items &amp; Work" Classes="muted" FontWeight="SemiBold" Margin="4,6,0,0"/>
                  <ItemsControl ItemsSource="{Binding SimpleItemsWorkRateSettings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:PalworldSimpleSettingItem">
                        <Border Classes="statuscard accentServer" Classes.dirty="{Binding IsDirty}" Margin="0,0,0,7" Padding="10,8">
                          <Grid ColumnDefinitions="Auto,2*,220,95,130" ColumnSpacing="10">
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" ToolTip.Tip="Clear to return this option to its default value."/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                            <Slider Grid.Column="2" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" Value="{Binding SliderValue, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Classes="badge" VerticalAlignment="Center"><TextBlock Text="{Binding ValueText}" HorizontalAlignment="Center"/></Border>
                            <TextBlock Grid.Column="4" Text="{Binding DefaultComparisonText}" Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Grid IsVisible="{Binding IsConfigAdvancedView}" RowDefinitions="Auto,*">
                  <Grid Background="{DynamicResource Bg2Brush}" ColumnDefinitions="135,210,*,150,190,95" Height="40">
                    <TextBlock Text="CATEGORY" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="SETTING" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="DESCRIPTION" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="DEFAULT VALUE" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="ACTIVE VALUE" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="5" Text="STATE" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                  </Grid>
                  <ListBox Grid.Row="1" ItemsSource="{Binding FilteredPalworldSettings}" MaxHeight="560" ClipToBounds="True">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
                      <Style Selector="Border.differsFromDefault"><Setter Property="BorderBrush" Value="#F4C542"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Background" Value="#14D4A017"/></Style>
                      <!-- v0.7.87.0: unsaved-edit highlight for Advanced Settings rows, matching Simple
                           Settings' own Border.statuscard.dirty. Flags active value against what was
                           last loaded/saved, distinct from differsFromDefault above (which flags against
                           Palworld's factory default regardless of save state). Both can apply at once. -->
                      <Style Selector="Border.rowDirty"><Setter Property="BorderBrush" Value="{DynamicResource AmberAccentBorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,3"/><Setter Property="Background" Value="{DynamicResource CardAmberGradient}"/></Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:PalworldSettingDto">
                        <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="4,7" HorizontalAlignment="Stretch" Classes.differsFromDefault="{Binding IsDifferentFromDefault}" Classes.rowDirty="{Binding IsDirty}">
                          <Grid ColumnDefinitions="135,210,*,150,190,95" ColumnSpacing="8">
                            <TextBlock Text="{Binding Category}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Name}" Classes="muted" FontSize="9"/></StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding Description}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="3" Text="{Binding DefaultValue}" FontFamily="Consolas, monospace" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBox Grid.Column="4" Text="{Binding DisplayValue, Mode=TwoWay}" VerticalAlignment="Center" Classes.dirty="{Binding IsDirty}"/>
                            <TextBlock Grid.Column="5" Text="{Binding IsModifiedDisplay}" Foreground="{DynamicResource AmberBrush}" VerticalAlignment="Center" TextAlignment="Center"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsPlayersPage}" Spacing="12">
          <Border Classes="card accentWorld">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="Player Directory" FontSize="21" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding PlayersPageState}" Foreground="{DynamicResource GreenBrush}"/>
                  <TextBlock Text="{Binding PlayersPageDetail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding PlayerVisibleCountText}" Foreground="{DynamicResource VioletBrush}" VerticalAlignment="Center"/>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="2*,*,*,Auto" ColumnSpacing="10">
                <TextBox Watermark="Search player, ID, guild, or platform" Text="{Binding PlayerSearchText}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding PlayerViewFilters}" SelectedItem="{Binding SelectedPlayerViewFilter}"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding PlayerAdminFilters}" SelectedItem="{Binding SelectedPlayerAdminFilter}"/>
                <!-- v0.7.18.0: requested directly: a selectable way to hide rows that share a
                     display name with another record (a rejoin under a different platform ID, a
                     stale entry from an old save, etc.). View-only: nothing is deleted or merged,
                     so unchecking always restores every record. -->
                <!-- v0.7.42.0: Discover Saves/Export CSV moved to the ribbon. -->
                <CheckBox Grid.Column="3" Content="Hide duplicate names" IsChecked="{Binding HideDuplicatePlayerNames}" VerticalAlignment="Center" ToolTip.Tip="Shows only one row per player name (preferring online, then a known save, then most recently updated) -- the others still exist, they're just hidden from this list."/>
              </Grid>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="3*,2*" ColumnSpacing="14">
            <Border Classes="card accentWorld">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="Live &amp; Known Players" FontSize="17" FontWeight="SemiBold"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredPlayerRecords}" SelectedItem="{Binding SelectedPlayerRecord}" MaxHeight="520" ToolTip.Tip="Select a player; right-click online records for supported administration actions.">
                  <ListBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Kick Player" Command="{Binding KickSelectedPlayerCommand}" ToolTip.Tip="Available only while the selected player is online."/>
                      <MenuItem Header="Ban Player" Command="{Binding BanSelectedPlayerCommand}" ToolTip.Tip="Available only while the selected player is online."/>
                      <Separator/>
                      <MenuItem Header="Copy Player Data From…" Click="CopyIntoPlayer_OnClick" ToolTip.Tip="Copies inventory, recipes, records, skins, and quest progress from another player onto this one. Requires PalServer stopped."/>
                      <MenuItem Header="Delete Player Completely…" Click="DeletePlayer_OnClick" ToolTip.Tip="Permanently deletes this player's save file and cleans up their guild membership. Requires PalServer stopped."/>
                      <Separator/>
                      <MenuItem Header="Whisper — BACKEND REQUIRED" Command="{Binding WhisperSelectedPlayerCommand}" IsEnabled="False"/>
                      <MenuItem Header="Promote — BACKEND REQUIRED" Command="{Binding PromoteSelectedPlayerCommand}" IsEnabled="False"/>
                      <MenuItem Header="Give Item — BACKEND REQUIRED" Command="{Binding GiveItemSelectedPlayerCommand}" IsEnabled="False"/>
                    </ContextMenu>
                  </ListBox.ContextMenu>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:PlayerExplorerItemDto">
                      <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="3,10">
                        <Grid ColumnDefinitions="2*,*,*,*" ColumnSpacing="12">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding PlayerName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PlayerId}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1"><TextBlock Text="{Binding OnlineText}" Foreground="{DynamicResource GreenBrush}"/><TextBlock Text="{Binding Platform}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel>
                          <StackPanel Grid.Column="2"><TextBlock Text="{Binding SaveStateText}"/><TextBlock Text="{Binding SaveSizeText}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel>
                          <StackPanel Grid.Column="3"><TextBlock Text="{Binding GuildName}"/><TextBlock Text="{Binding Ping}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
              <Border Classes="card accentWorld">
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Selected Player" FontSize="17" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Load Metadata" Command="{Binding LoadPlayerMetadataCommand}"/></Grid>
                  <TextBlock Text="{Binding SelectedPlayerRecord.PlayerName}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource VioletBrush}"/>
                  <TextBlock Text="{Binding SelectedPlayerRecord.PlayerId}" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock Text="{Binding SelectedPlayerRecord.OnlineText}"/>
                  <TextBlock Text="{Binding SelectedPlayerRecord.SaveStateText}"/>
                  <TextBlock Text="{Binding SelectedPlayerRecord.UpdatedText}" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock Text="{Binding SelectedPlayerRecord.GuildName}"/>
                  <TextBlock Text="{Binding SelectedPlayerRecord.Role}" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock Text="{Binding SelectedPlayerRecord.Evidence}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding PlayerRegistrySummaryText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <Border Classes="card accentWorld">
                <StackPanel Spacing="8">
                  <TextBlock Text="Notes &amp; Warnings" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding PlayerMetadataState}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                  <TextBox Watermark="Private operator notes" Text="{Binding SelectedPlayerNotes}" AcceptsReturn="True" MinHeight="78" MaxLength="4000" TextWrapping="Wrap"/>
                  <Button Content="Save Notes" Command="{Binding SavePlayerNotesCommand}"/>
                  <TextBox Watermark="Add an operator warning" Text="{Binding NewPlayerWarning}" MaxLength="1000"/>
                  <Button Content="Add Warning" Command="{Binding AddPlayerWarningCommand}" Classes="warning"/>
                  <ListBox ItemsSource="{Binding SelectedPlayerWarnings}" MaxHeight="130">
                    <ListBox.ItemTemplate><DataTemplate x:DataType="models:PlayerWarningDto"><TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <!-- WORLD MAP (v0.6.16.0). Collapsed by default since v0.7.5.0 (no-scroll pass 1):
               the fixed 480x480 canvas is the single largest content block on this page. -->
          <Border Classes="card accentWorld">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleWorldMapCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="▸" IsVisible="{Binding !IsWorldMapExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="▾" IsVisible="{Binding IsWorldMapExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="World Map — Live Player Positions" FontSize="17" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
              </Grid>
              <StackPanel Spacing="8" IsVisible="{Binding IsWorldMapExpanded}">
                <TextBlock Text="Real, live positions from Palworld's own REST API, refreshed on the normal status poll. No Pal or base positions yet — see the roadmap." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <!-- v0.7.20.0: bundled preset backgrounds (Palpagos/World Tree) alongside the
                     existing browse-your-own-image and clear options: dots still spread relative
                     to the currently-online players, not tied to real geography yet, on any of these. -->
                <WrapPanel Orientation="Horizontal">
                  <ItemsControl ItemsSource="{Binding MapPresets}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="services:MapPreset">
                        <Button Content="{Binding DisplayName}" Margin="0,0,8,8"
                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SetMapPresetCommand}"
                                CommandParameter="{Binding}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Button Content="Browse for Map Background" Click="BrowseMapBackground_Click" Margin="0,0,8,8"/>
                  <Button Content="Clear Background" Command="{Binding ClearMapBackgroundCommand}" Margin="0,0,8,8"/>
                </WrapPanel>
                <!-- v0.7.21.0: only ever shown for the Palpagos preset specifically: the sav-to-
                     map formula is numerically verified against its source project's own worked
                     example, but the Palpagos image's own origin/orientation isn't independently
                     confirmed here, so this stays an explicit opt-in rather than the default. -->
                <CheckBox Content="Experimental: real-world positions (Palpagos only)" IsChecked="{Binding UseCalibratedWorldPositions}" IsVisible="{Binding IsPalpagosMapActive}" ToolTip.Tip="Uses a reverse-engineered coordinate formula, verified numerically but not yet confirmed against a live server. If dots look wrong (mirrored or offset), leave this off and use the default relative-position view instead."/>
                <TextBlock Text="{Binding MapBackgroundStatusText}" Foreground="{DynamicResource MutedBrush}"/>
                <Border Width="480" Height="480" HorizontalAlignment="Left" ClipToBounds="True" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                  <Grid>
                    <Image Source="{Binding MapBackgroundBitmap}" Stretch="UniformToFill"/>
                    <ItemsControl ItemsSource="{Binding PlayerMapPoints}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas Width="480" Height="480"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PlayerMapPointDto">
                          <StackPanel Canvas.Left="{Binding CanvasX}" Canvas.Top="{Binding CanvasY}">
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource GreenBrush}" Stroke="#0B141B" StrokeThickness="1.5"/>
                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="10" FontWeight="SemiBold"/>
                          </StackPanel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Classes="card accentWorld">
            <StackPanel Spacing="9">
              <TextBlock Text="Player Administration" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="Kick and Ban route through the Palworld REST API first, automatically falling back to RCON if REST is disabled or misconfigured, and are enabled only for an online player. Unsupported operations remain visibly disabled and cannot report false success." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="2*,Auto,Auto" ColumnSpacing="10">
                <TextBox Watermark="Kick / ban reason" Text="{Binding PlayerActionMessage}"/>
                <Button Grid.Column="1" Content="Kick" Command="{Binding KickSelectedPlayerCommand}" Classes="warning"/>
                <Button Grid.Column="2" Content="Ban" Command="{Binding BanSelectedPlayerCommand}" Classes="danger"/>
              </Grid>
              <!-- v0.7.15.0: the "Whitelist" stub button was removed here (stale dead UI: the real
                   Whitelist feature already shipped in v0.7.10.0 with its own working card further
                   down this same page). The "Temporary Ban" stub was replaced with a real duration
                   field + button (HeadlessTemporaryBanService). The "Remove Admin" stub was removed
                   outright: Palworld has no per-player admin grant/revoke concept at all (RCON's
                   AdminPassword is a single server-wide credential, not a per-player flag), so this
                   stub had no real backend capability to ever point at. -->
              <WrapPanel Orientation="Horizontal">
                <Button Content="Unban" Command="{Binding UnbanSelectedPlayerCommand}" Margin="0,0,8,8" ToolTip.Tip="Removes the selected player's Steam/UserID from the server's RCON ban list. Works for offline (banned) players."/>
                <Button Content="Teleport to Me" Command="{Binding TeleportPlayerToMeCommand}" Margin="0,0,8,8" ToolTip.Tip="Summons the selected online player to your admin character's in-game location, via RCON. Requires an admin character actually present in the world."/>
                <Button Content="Teleport to Player" Command="{Binding TeleportToPlayerCommand}" Margin="0,0,8,8" ToolTip.Tip="Moves your admin character to the selected online player's in-game location, via RCON. Requires an admin character actually present in the world."/>
              </WrapPanel>
              <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock VerticalAlignment="Center" Text="Temp ban:" Classes="muted"/>
                <NumericUpDown Grid.Column="1" Width="120" Minimum="0.1" Maximum="720" Increment="1" FormatString="F1" Value="{Binding NewTemporaryBanDurationHours}" ToolTip.Tip="Duration in hours before this ban is automatically lifted."/>
                <Button Grid.Column="2" Content="Temp Ban" Command="{Binding CreateTemporaryBanCommand}" Classes="warning" ToolTip.Tip="Bans the selected online player immediately (same as Ban above), then automatically unbans them after the duration set here."/>
              </Grid>
              <TextBlock Text="{Binding PlayerAdminStatusText}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ModerationProviderStatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- BAN LIST (v0.7.8.0). Collapsed by default, matching the v0.7.5.0 no-scroll pattern:
               a secondary, occasional-use tool, not primary page content. -->
          <Border Classes="card accentWorld">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleBanListCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="▸" IsVisible="{Binding !IsBanListExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="▾" IsVisible="{Binding IsBanListExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="Ban List" FontSize="17" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshBanListCommand}" IsVisible="{Binding IsBanListExpanded}"/>
              </Grid>
              <StackPanel Spacing="8" IsVisible="{Binding IsBanListExpanded}">
                <TextBlock Text="Read directly from the server via RCON (BanList). Ban/Unban above use the same Steam/UserID shown here." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBox Text="{Binding BanListText}" AcceptsReturn="True" IsReadOnly="True" MinHeight="90" MaxHeight="200" FontFamily="Consolas, monospace" FontSize="12"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- TEMPORARY BANS (v0.7.15.0). Collapsed by default, matching the v0.7.5.0 no-scroll
               pattern and Ban List's placement immediately above. Lists active auto-expiring bans
               applied via the "Temp Ban" control in the Player Administration card above; each one
               can be lifted early here, or left to expire on its own via the headless service's
               poll-driven sweep. -->
          <Border Classes="card accentWorld">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleTemporaryBansCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="▸" IsVisible="{Binding !IsTemporaryBansExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="▾" IsVisible="{Binding IsTemporaryBansExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="Temporary Bans" FontSize="17" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshTemporaryBansCommand}" IsVisible="{Binding IsTemporaryBansExpanded}"/>
              </Grid>
              <StackPanel Spacing="8" IsVisible="{Binding IsTemporaryBansExpanded}">
                <TextBlock Text="{Binding TemporaryBanState}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <ListBox ItemsSource="{Binding TemporaryBans}" MaxHeight="200">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TemporaryBanEntryDto">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold" Text="{Binding PlayerName}"/>
                          <TextBlock Classes="muted" FontSize="11" Text="{Binding Reason}" TextWrapping="Wrap"/>
                          <TextBlock Classes="muted" FontSize="10" Text="{Binding RemainingText}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Lift Now" VerticalAlignment="Center"
                                Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).CancelTemporaryBanCommand}"
                                CommandParameter="{Binding PlayerId}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- WHITELIST (v0.7.10.0). Collapsed by default, matching the v0.7.5.0 no-scroll pattern.
               Named as an explicit deferred roadmap item before this release. Opt-in: when
               Enabled, any online player not on this list is automatically kicked (checked on the
               same poll cadence the player registry already uses). -->
          <Border Classes="card accentWorld" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleWhitelistCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="▸" IsVisible="{Binding !IsWhitelistExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="▾" IsVisible="{Binding IsWhitelistExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="Whitelist" FontSize="17" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshWhitelistCommand}" IsVisible="{Binding IsWhitelistExpanded}"/>
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding IsWhitelistExpanded}">
                <TextBlock Text="{Binding WhitelistState}" Classes="muted" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="220,Auto" ColumnSpacing="10">
                  <TextBlock Text="Enabled -- auto-kick anyone not listed" VerticalAlignment="Center" Classes="muted"/>
                  <CheckBox Grid.Column="1" IsChecked="{Binding WhitelistConfig.Enabled}"/>
                </Grid>
                <Grid ColumnDefinitions="*,180,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding NewWhitelistPlayerId}" Watermark="Steam/UserID"/>
                  <TextBox Grid.Column="1" Text="{Binding NewWhitelistLabel}" Watermark="Label (optional)"/>
                  <Button Grid.Column="2" Content="Add" Command="{Binding AddWhitelistEntryCommand}"/>
                </Grid>
                <ListBox ItemsSource="{Binding WhitelistEntries}" SelectedItem="{Binding SelectedWhitelistEntry}" MaxHeight="180">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:WhitelistEntryDto">
                      <Grid ColumnDefinitions="*,180"><TextBlock Text="{Binding PlayerId}"/><TextBlock Grid.Column="1" Text="{Binding Label}" Classes="muted"/></Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="danger" Content="Remove Selected" Command="{Binding RemoveWhitelistEntryCommand}"/>
                  <Button Classes="success" Content="Save Whitelist" Command="{Binding SaveWhitelistCommand}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- PAL EDITOR (v0.6.15.0 "Save-Data Edit Engine Foundation"): relocated here from the
               Guilds page in v0.7.1.0, since editing an individual Pal has no conceptual tie to
               guild ownership and belongs alongside the rest of this page's player-focused tools.
               Collapsed by default since v0.7.5.0 (no-scroll pass 1). -->
          <Button Classes="sectionToggle" Command="{Binding TogglePalEditorCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="▸" IsVisible="{Binding !IsPalEditorExpanded}" FontWeight="Bold"/>
              <TextBlock Text="▾" IsVisible="{Binding IsPalEditorExpanded}" FontWeight="Bold"/>
              <TextBlock Text="Pal Editor" FontSize="17" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>
          <Grid ColumnDefinitions="3*,2*" ColumnSpacing="14" IsVisible="{Binding IsPalEditorExpanded}">
            <Border Classes="card accentWorld">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Pal Editor" FontSize="18" FontWeight="SemiBold"/><Button Grid.Column="1" Content="Refresh Pals" Command="{Binding RefreshPalsCommand}"/></Grid>
                <TextBlock Grid.Row="1" Text="Individual Pal stat/identity editing, decoded from the active world's Level.sav. Skill lists, species, and inventory are not editable yet." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <ListBox Grid.Row="2" ItemsSource="{Binding ExplorerPals}" SelectedItem="{Binding SelectedExplorerPal}" MaxHeight="420">
                  <ListBox.ItemTemplate><DataTemplate x:DataType="models:PalInstanceDto"><Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="10" Margin="0,6"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding OwnerDisplay}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Level, StringFormat='Lv. {0}'}" VerticalAlignment="Center"/><Border Grid.Column="2" Classes="badge" IsVisible="{Binding IsRarePal}" VerticalAlignment="Center"><TextBlock Text="Lucky"/></Border></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <Border Classes="card accentWorld"><StackPanel Spacing="8">
              <TextBlock Text="Edit Selected Pal" FontSize="17" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                <TextBlock Text="Nickname" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding PalEditNickName}"/>
                <TextBlock Grid.Row="1" Text="Level" VerticalAlignment="Center"/><NumericUpDown Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="255" Value="{Binding PalEditLevel}"/>
                <TextBlock Grid.Row="2" Text="Rank" VerticalAlignment="Center"/><NumericUpDown Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding PalEditRank}"/>
                <TextBlock Grid.Row="3" Text="Talent HP" VerticalAlignment="Center"/><NumericUpDown Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PalEditTalentHp}"/>
                <TextBlock Grid.Row="4" Text="Talent Shot" VerticalAlignment="Center"/><NumericUpDown Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PalEditTalentShot}"/>
                <TextBlock Grid.Row="5" Text="Talent Def." VerticalAlignment="Center"/><NumericUpDown Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PalEditTalentDefense}"/>
                <TextBlock Grid.Row="6" Text="Gender" VerticalAlignment="Center"/><ComboBox Grid.Row="6" Grid.Column="1" ItemsSource="{Binding PalGenderOptions}" SelectedItem="{Binding PalEditGender}"/>
              </Grid>
              <CheckBox Content="Lucky (IsRarePal)" IsChecked="{Binding PalEditIsRarePal}"/>
              <Button Classes="primary" Content="Preview" Command="{Binding PreviewPalEditCommand}"/>
              <TextBlock Text="{Binding PalEditStatusText}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
              <CheckBox Content="I reviewed this plan and confirm the active Palworld server is stopped." IsChecked="{Binding PalEditConfirmed}"/>
              <Button Classes="danger" Content="Apply With Fresh Safety Backup" HorizontalAlignment="Left" Command="{Binding ApplyPalEditCommand}"/>
            </StackPanel></Border>
          </Grid>

          <Border Classes="card accentWorld" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="9">
              <TextBlock Text="Character / Account Migration" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="Migrate a source player's guild membership to an already-existing destination player identity (e.g. Xbox → Steam). Level/inventory/Pal transfer is not yet supported — only guild references migrate." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Spacing="4">
                  <TextBlock Text="Source player" Classes="muted"/>
                  <ComboBox ItemsSource="{Binding PlayerRecords}" SelectedItem="{Binding MigrationSourcePlayer}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="models:PlayerExplorerItemDto"><TextBlock Text="{Binding PlayerName}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="Destination player" Classes="muted"/>
                  <ComboBox ItemsSource="{Binding PlayerRecords}" SelectedItem="{Binding MigrationDestinationPlayer}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="models:PlayerExplorerItemDto"><TextBlock Text="{Binding PlayerName}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <Button Content="Preview Migration" Command="{Binding PreviewCharacterMigrationCommand}"/>
              <TextBlock Text="{Binding MigrationState}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding MigrationPreview.CanApply}">
                <ComboBox ItemsSource="{Binding CharacterDispositionOptions}" SelectedItem="{Binding MigrationDisposition}"/>
                <Button Grid.Column="1" Content="Apply Migration" Command="{Binding ApplyCharacterMigrationCommand}" Classes="danger"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsMonitoringPage}" Spacing="12">
          <Border Classes="card accentServer" IsVisible="{Binding IsConsolePage}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="5">
                <TextBlock Text="Filter, search, pause and export the combined PalServer/MystTiq log view. Server logging continues while the view is paused." Foreground="{DynamicResource MutedBrush}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding ConsoleViewState}" Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Classes="card accentSystem" IsVisible="{Binding IsActivityAuditPage}">
            <StackPanel Spacing="5"><TextBlock Text="Review persistent MystTiq management/API activity and audit events. Console output remains on the Live Console page." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="14" IsVisible="{Binding IsActivityAuditPage}">
            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Text="CPU" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding CpuText}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource VioletBrush}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Text="PalServer RAM" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding MemoryText}" FontSize="24" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Text="Threads" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding ThreadCountText}" FontSize="24" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Classes="card" ToolTip.Tip="Real in-game simulation FPS from Palworld's own REST API (/v1/api/metrics) -- degrades with base/Pal count independent of host CPU%. Requires the Palworld REST API to be enabled.">
              <StackPanel Spacing="6">
                <TextBlock Text="Server FPS" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding ServerFpsText}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="card" ToolTip.Tip="Real in-game frame time from Palworld's own REST API (/v1/api/metrics). Requires the Palworld REST API to be enabled.">
              <StackPanel Spacing="6">
                <TextBlock Text="Frame Time" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding ServerFrameTimeText}" FontSize="24" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Classes="card accentSystem" IsVisible="{Binding IsActivityAuditPage}">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="MystTiq Activity / Audit Log" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding ActivityFileText}" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Refresh Audit" Command="{Binding RefreshActivityCommand}" ToolTip.Tip="Reload persistent MystTiq management and API activity."/><Button Content="Export Visible" Click="ExportActivity_Click"/><Button Content="Clear Persistent Audit — POLICY LOCKED" IsEnabled="False"/></StackPanel>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="2*,*,*" ColumnSpacing="8"><TextBox Text="{Binding ActivitySearchText}" Watermark="Search activity"/><ComboBox Grid.Column="1" ItemsSource="{Binding ActivitySeverityOptions}" SelectedItem="{Binding ActivitySeverityFilter}"/><ComboBox Grid.Column="2" ItemsSource="{Binding ActivityCategoryOptions}" SelectedItem="{Binding ActivityCategoryFilter}"/></Grid>
              <TextBlock Grid.Row="2" Text="{Binding ActivityDetail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <ListBox Grid.Row="3" ItemsSource="{Binding ActivityLines}" MaxHeight="360" ToolTip.Tip="Persistent management events written by the headless backend.">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="11" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <TextBlock IsVisible="{Binding IsActivityAuditPage}" Text="Audit retention is append-only from the GUI. Persistent clear is intentionally policy-locked so management evidence cannot be silently erased." Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap"/>

          <!-- v0.7.26.0: RCON moved above Console Log (was below); Refresh View/Pause/Clear/Export
               moved from this card's own header into the ribbon (BuildRibbonGroupsForActivePage). -->
          <Border Classes="card accentServer" IsVisible="{Binding IsConsolePage}">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="RCON" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="Palworld RCON is a legacy/deprecated administration interface. MystTiq keeps the AdminPassword server-side and never sends it to the GUI." Foreground="{DynamicResource AmberBrush}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding RconState}" Foreground="{DynamicResource BlueBrush}" VerticalAlignment="Center"/>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button Content="⚕ RCON Doctor" Command="{Binding RconDoctorCommand}"/>
                <Button Grid.Column="1" Content="● Connect" Command="{Binding RconConnectCommand}"/>
                <Button Grid.Column="2" Content="■ Disconnect" Command="{Binding RconDisconnectCommand}"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding RconPresetOptions}" SelectedItem="{Binding SelectedRconPreset, Mode=TwoWay}"/>
                <TextBlock Grid.Column="4" Text="{Binding RconDetail}" MaxWidth="360" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding RconCommandText, Mode=TwoWay}" Watermark="RCON command (for example: Info, ShowPlayers, Save)"/>
                <Button Grid.Column="1" Classes="primary" Content="➤ Send Command" Command="{Binding RconSendCommand}"/>
              </Grid>
              <ListBox Grid.Row="3" ItemsSource="{Binding RconOutputLines}" MaxHeight="220" Background="#0A1118" FontFamily="Consolas, monospace" FontSize="11" ClipToBounds="True">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Classes="card accentServer" IsVisible="{Binding IsConsolePage}">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
              <StackPanel>
                <TextBlock Text="CONSOLE LOG" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding LogFileText}" Foreground="{DynamicResource MutedBrush}"/>
              </StackPanel>
              <Grid Grid.Row="1" ColumnDefinitions="150,150,*,Auto" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding ConsoleSeverityOptions}" SelectedItem="{Binding ConsoleSeverityFilter, Mode=TwoWay}" ToolTip.Tip="Filter the console by severity."/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding ConsoleCategoryOptions}" SelectedItem="{Binding ConsoleCategoryFilter, Mode=TwoWay}" ToolTip.Tip="Filter the console by source/category."/>
                <TextBox Grid.Column="2" Watermark="Search console" Text="{Binding ConsoleSearchText, Mode=TwoWay}"/>
                <CheckBox Grid.Column="3" Content="Hide routine REST" IsChecked="{Binding HideRoutineRest, Mode=TwoWay}" VerticalAlignment="Center"/>
              </Grid>
              <ListBox Grid.Row="2" ItemsSource="{Binding FilteredLogLines}" MaxHeight="390" Background="#07110A" BorderBrush="#214C2A" Foreground="{DynamicResource GreenBrush}"
                       FontFamily="Consolas, monospace" FontSize="11" ClipToBounds="True">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="2,1"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="#12241A"/></Style>
                  <Style Selector="ListBoxItem:nth-child(2n)"><Setter Property="Background" Value="#0B1712"/></Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{Binding Converter={x:Static converters:ConsoleLineColorConverter.Instance}}"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Classes="card accentSystem" IsVisible="{Binding IsActivityAuditPage}">
            <StackPanel Spacing="10">
              <TextBlock Text="Recent Metrics" FontSize="18" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding MetricHistory}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:MetricHistoryPoint">
                    <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas, monospace" FontSize="11" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <TextBlock Text="{Binding MonitoringDetail}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsBackupsPage}" Spacing="12">
          <!-- v0.7.27.0: Create Backup/Verify All/Refresh/Open Backup Root moved to the ribbon
               (see MainWindowViewModel's BuildRibbonGroupsForActivePage). -->
          <!-- v0.7.37.0: removed the "N backup(s) / total size" header text that stood here,
               fully redundant with the TOTAL ARCHIVES card's own count and size directly below. -->

          <!-- v0.7.32.0: compact variant, same treatment as Server Setup's cards. -->
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <Border Classes="statuscard accentBackups" Padding="8,5"><StackPanel Spacing="2"><TextBlock Text="TOTAL ARCHIVES" Classes="muted" FontSize="10"/><TextBlock Text="{Binding BackupArchiveCountText}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding BackupTotalSizeText}" Classes="muted" FontSize="9"/></StackPanel></Border>
            <Border Grid.Column="1" Classes="statuscard accentBackups" Padding="8,5"><StackPanel Spacing="2"><TextBlock Text="VERIFIED" Classes="muted" FontSize="10"/><TextBlock Text="{Binding BackupVerifiedCountText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}"/><TextBlock Text="Deep verification" Classes="muted" FontSize="9"/></StackPanel></Border>
            <Border Grid.Column="2" Classes="statuscard accentBackups" Padding="8,5"><StackPanel Spacing="2"><TextBlock Text="PENDING / REVIEW" Classes="muted" FontSize="10"/><TextBlock Text="{Binding BackupPendingCountText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AmberBrush}"/><TextBlock Text="Not yet verified" Classes="muted" FontSize="9"/></StackPanel></Border>
            <Border Grid.Column="3" Classes="statuscard accentBackups" Padding="8,5"><StackPanel Spacing="2"><TextBlock Text="RETENTION" Classes="muted" FontSize="10"/><TextBlock Text="{Binding BackupRetentionKeepLatest, StringFormat='Keep {0}'}" FontSize="16" FontWeight="Bold"/><TextBlock Text="Preview required" Classes="muted" FontSize="9"/></StackPanel></Border>
          </Grid>

          <!-- v0.7.37.0: two-column layout mirroring the v0.2.16.4 reference, the table (wider,
               left) beside a narrower right-hand column stacking the selection/retention action
               cards, instead of one long full-width vertical stack. The reference's own third
               right-column card ("Backup Locations") has no equivalent here anymore: its one
               action (Open Backup Root) already moved into the ribbon in v0.7.27.0. Created also
               now leads the table's columns instead of the filename, per direct request. -->
          <Grid ColumnDefinitions="2.2*,*" ColumnSpacing="12">
            <Border Classes="card accentBackups">
              <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <Grid ColumnDefinitions="*,2*,*,*" ColumnSpacing="12">
                  <TextBlock Text="Created" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Grid.Column="1" Text="Backup" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Grid.Column="2" Text="Size" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Grid.Column="3" Text="Status" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding BackupItems}" SelectedItem="{Binding SelectedBackup}" MaxHeight="480">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:BackupItemDto">
                      <Grid ColumnDefinitions="*,2*,*,*" ColumnSpacing="12" Margin="0,5">
                        <TextBlock Text="{Binding CreatedText}" />
                        <TextBlock Grid.Column="1" Text="{Binding FileName}" />
                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" />
                        <TextBlock Grid.Column="3" Text="{Binding VerificationText}" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="12">
              <Border Classes="card accentBackups">
                <StackPanel Spacing="10">
                  <TextBlock Text="Selected Backup" FontSize="17" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Verify Selected" Command="{Binding VerifySelectedBackupCommand}"/>
                    <Button Content="Restore Selected" Command="{Binding RestoreBackupCommand}"/>
                    <Button Content="Delete Selected" Command="{Binding DeleteBackupCommand}"/>
                  </StackPanel>
                  <CheckBox Content="I understand restore replaces the active save" IsChecked="{Binding BackupRestoreConfirmed}"/>
                  <TextBlock Text="Restore requires PalServer to be stopped. MystTiq creates a safety backup of the current save before replacing it." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
              </Border>

              <Border Classes="card accentBackups">
                <StackPanel Spacing="10">
                  <TextBlock Text="Retention Cleanup" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="Preview is immutable and short-lived. Apply deletes exactly that preview; any inventory change requires a new preview." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="Keep latest" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Value="{Binding BackupRetentionKeepLatest}" Minimum="1" Maximum="1000" Width="90" Margin="0,0,16,0"/>
                    <TextBlock Text="Maximum age (days)" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown Value="{Binding BackupRetentionMaxAgeDays}" Minimum="1" Maximum="3650" Width="100" Margin="0,0,16,0"/>
                    <Button Content="Preview Cleanup" Command="{Binding PreviewBackupRetentionCommand}" Margin="0,0,8,0"/>
                    <Button Classes="danger" Content="Apply Exact Preview" Command="{Binding ApplyBackupRetentionCommand}"/>
                  </WrapPanel>
                  <ItemsControl ItemsSource="{Binding BackupRetentionItems}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:BackupRetentionItemDto"><TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding BackupRetentionState}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <TextBlock Text="{Binding BackupDetail}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsModsPage}" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <!-- v0.7.78.0: the MOD Library variant of this header text moved into its own card
                   above "Install Validated ZIP" (direct request: "the top comments could be moved
                   to its own card and then added above install validated zip"), so it's gated out
                   here now. MOD Dashboard's own description/state/summary text moved into the new
                   hero banner below instead of sitting here as plain text, part of the same
                   request's follow-up: "help with the MOD dashboard to change the look and feel of
                   it so it doesn't feel like it is essentially the same as the MOD library." -->
              <StackPanel IsVisible="{Binding IsUe4ssPage}">
                <TextBlock Text="Inspect the active runtime resolver, Mods roots, runtime evidence, and compatibility warnings." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Grid>
          <!-- v0.7.27.0: "Refresh MODs"/"Verify & Scan" (MOD Dashboard + MOD Library) and "Refresh
               Runtime" (UE4SS) moved to the ribbon (BuildRibbonGroupsForActivePage). -->

          <!-- v0.7.78.0: hero health banner, new. Dashboard previously opened with the exact same
               plain description-text pattern every other page uses, then went straight into 6
               flat, identically-styled stat cards matching Library's own card look almost exactly.
               This leads with one big, color-coded status statement (green=Healthy,
               amber=Degraded) the way an actual monitoring dashboard would, distinct from Library's
               working/management framing. -->
          <Border Classes="card" Classes.glowGreen="{Binding IsModHealthGood}" IsVisible="{Binding IsModDashboardPage}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="{Binding ModHealth}" FontSize="28" FontWeight="Bold"/>
              <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="At-a-glance operational health and confirmed issues. Open MOD Library to browse, install, or change enabled state." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ModSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ModState}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- v0.7.32.0: gated to IsModDashboardPage only (was IsModInventoryPage, shared with MOD
               Library); these 6 cards duplicated MOD Dashboard on the Library page, per direct
               request; Dashboard keeps its own copy. v0.7.78.0: recolored by what each card means
               instead of all six sharing the same flat accentMods look, part of the same
               look-and-feel differentiation as the hero banner above. -->
          <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="10" IsVisible="{Binding IsModDashboardPage}">
            <Border Classes="card" Classes.glowGreen="{Binding IsModHealthGood}"><StackPanel><TextBlock Text="HEALTH" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding ModHealth}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Grid.Column="1" Classes="card glowCyan"><StackPanel><TextBlock Text="INSTALLED" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding ModInstalledText}" FontSize="22"/></StackPanel></Border>
            <Border Grid.Column="2" Classes="card glowGreen"><StackPanel><TextBlock Text="CONFIRMED" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding ModConfirmedText}" FontSize="22"/></StackPanel></Border>
            <Border Grid.Column="3" Classes="card accentMods" BorderBrush="{DynamicResource AmberBrush}"><StackPanel><TextBlock Text="UNVERIFIED" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding ModUnverifiedText}" FontSize="22"/></StackPanel></Border>
            <Border Grid.Column="4" Classes="card accentMods"><StackPanel><TextBlock Text="DISABLED" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding ModDisabledText}" FontSize="22"/></StackPanel></Border>
            <Border Grid.Column="5" Classes="card accentMods" BorderBrush="{DynamicResource RedBrush}"><StackPanel><TextBlock Text="ISSUES" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding ModIssuesText}" FontSize="22"/></StackPanel></Border>
          </Grid>

          <Border Classes="card accentMods" IsVisible="{Binding IsUe4ssPage}">
            <StackPanel Spacing="12">
              <TextBlock Text="UE4SS Runtime" FontSize="18" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Classes="statuscard accentMods"><StackPanel Spacing="4"><TextBlock Text="INSTALLED VERSION" Classes="muted"/><TextBlock Text="{Binding Ue4ssInstalledVersion}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="1" Classes="statuscard accentMods"><StackPanel Spacing="4"><TextBlock Text="RUNTIME HEALTH" Classes="muted"/><TextBlock Text="{Binding Ue4ssHealth}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding Ue4ssDetection}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="2" Classes="statuscard accentMods"><StackPanel Spacing="4"><TextBlock Text="ACTIVE FORK" Classes="muted"/><TextBlock Text="{Binding SelectedUe4ssFork}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
              </Grid>
              <Border Classes="statuscard accentMods">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,220,*">
                    <TextBlock Text="Release source" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Ue4ssForkOptions}" SelectedItem="{Binding SelectedUe4ssFork}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Ue4ssReleaseCatalogStatusText}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </Grid>
                  <!-- v0.7.48.0: UE4SS Release Catalog, real release data. "Refresh Runtime" in the
                       ribbon populates this. v0.7.49.0: install/rollback. Select a release here,
                       then use Preview Install, Confirm Install, and Rollback in the ribbon. -->
                  <ListBox ItemsSource="{Binding Ue4ssVisibleReleases}" SelectedItem="{Binding SelectedUe4ssRelease}" IsVisible="{Binding HasUe4ssReleases}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:Ue4ssReleaseDto">
                        <Border Classes="statuscard accentMods" Margin="0,3">
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding AssetText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding ChannelText}" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBlock Grid.Column="2" Text="{Binding PublishedAtText}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="{Binding Ue4ssInstallState}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasUe4ssReleases}"/>
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border Classes="statuscard accentMods"><StackPanel Spacing="4"><TextBlock Text="Active Mods Root" Classes="muted"/><TextBlock Text="{Binding Ue4ssActiveRoot}" FontFamily="Consolas, monospace" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="1" Classes="statuscard accentMods"><StackPanel Spacing="4"><TextBlock Text="Runtime Mods Root" Classes="muted"/><TextBlock Text="{Binding Ue4ssRuntimeRoot}" FontFamily="Consolas, monospace" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
              </Grid>
              <TextBlock Text="{Binding Ue4ssWarning}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap"/>
              <Button Content="Repair UE4SS MOD State" Command="{Binding RepairModsCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>

          <Border Classes="card accentMods" IsVisible="{Binding IsModDashboardPage}">
            <StackPanel Spacing="8">
              <TextBlock Text="Needs Attention" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="MODs whose confirmed health is neither Healthy, Disabled, nor Active / Unverified." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="All MODs are healthy, disabled, or active/unverified — nothing needs attention." Foreground="{DynamicResource GreenBrush}" IsVisible="{Binding !HasModsNeedingAttention}"/>
              <ItemsControl ItemsSource="{Binding ModsNeedingAttention}" IsVisible="{Binding HasModsNeedingAttention}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ModItemDto">
                    <Border Classes="dataRow" Padding="8,6">
                      <Grid ColumnDefinitions="90,2*,*,2*" ColumnSpacing="10">
                        <TextBlock Text="{Binding Type}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="{Binding Health}" Foreground="{DynamicResource OrangeBrush}"/>
                        <TextBlock Grid.Column="3" Text="{Binding Evidence}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="Open MOD Library →" Command="{Binding NavigateCommand}" CommandParameter="ModLibrary" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>

          <!-- v0.7.43.0: findings-completeness fix. Items 21 and 40 both asked for "the running
               MODs listed here [on MOD Dashboard], the Mod on the left and the description on the
               right"; v0.7.40.0 only ever built this for MOD Library, leaving Dashboard with no
               MODs list at all (a real gap, not a deliberate scope cut). Read-only here (no
               Enable/Disable/Delete/Rollback/Update actions, no Install Validated ZIP), matching
               this page's own existing framing ("Open MOD Library to browse, install, or change
               enabled state"); Dashboard stays at-a-glance, mutation stays on MOD Library. The
               website-sourced description part of the original ask is being designed for multiple
               sources as its own scoped follow-up version; this pass ships the list/details
               infrastructure that work will build on. Evidence surfaces MystTiq's own real
               evidence in the meantime, same as MOD Library's details panel. -->
          <Grid ColumnDefinitions="1.6*,*" ColumnSpacing="12" IsVisible="{Binding IsModDashboardPage}">
            <Border Classes="card accentMods">
              <StackPanel Spacing="10">
                <!-- v0.7.78.0: renamed from "Installed MODs" (identical to Library's own card
                     title) to something distinct, direct follow-up to the look-and-feel ask. -->
                <TextBlock Text="MOD Overview" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Read-only here. Open MOD Library to change enabled state, install, delete, or update a MOD." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                <!-- v0.7.78.0: intentionally more compact than Library's own row (no install path,
                     no version, no update badge); Dashboard is a glance view, Library is where
                     that detail actually matters and where you can act on it. Part of the same
                     look-and-feel differentiation as the hero banner and recolored stat cards. -->
                <ListBox ItemsSource="{Binding ModItems}" SelectedItem="{Binding SelectedMod}" MaxHeight="360">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ModItemDto">
                      <Grid ColumnDefinitions="60,2*,*" ColumnSpacing="8" Margin="0,4">
                        <TextBlock Text="{Binding Type}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2"><TextBlock Text="{Binding EnabledText}" FontSize="11"/><TextBlock Text="{Binding Health}" FontSize="11" Foreground="{DynamicResource VioletBrush}"/></StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card accentMods">
              <Grid>
              <StackPanel Spacing="10" IsVisible="{Binding HasSelectedMod}">
                <TextBlock Text="MOD DETAILS" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedMod.Name}" FontWeight="Bold" TextWrapping="Wrap"/>
                <StackPanel Spacing="3">
                  <TextBlock Text="OVERALL HEALTH" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{Binding SelectedMod.Health}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="INSTALLATION" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{Binding SelectedMod.Type}"/>
                  <TextBlock Text="{Binding SelectedMod.Package}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock Text="{Binding SelectedMod.EnabledText}"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="RUNTIME" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{Binding SelectedMod.RuntimeState}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="EVIDENCE" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{Binding SelectedMod.Evidence}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Text="Select a MOD from the list to see its details here." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" IsVisible="{Binding !HasSelectedMod}"/>
              </Grid>
            </Border>
          </Grid>

          <!-- v0.7.78.0: Install Validated ZIP and Available Local Steam Workshop Mods placed
               side by side at the top of the page (direct request: "put install zip and available
               local steam mods in cards side by side at the top"), replacing v0.7.40.0's stacked
               ZIP-card-above-3-column-grid layout. The left column is a StackPanel of two cards
               (page info, then Install Validated ZIP); Available Workshop Mods on the right sits in
               the same Grid row and naturally stretches to their combined height (direct request:
               "the available steam mods would still be on the right but the height of those 2
               combined"). -->
          <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="12" IsVisible="{Binding IsModLibraryPage}">
            <StackPanel Spacing="12">
              <Border Classes="card accentMods">
                <StackPanel Spacing="6">
                  <TextBlock Text="Inspect installed server MOD packages, install new ones, and control enabled state through the managed backend." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding ModState}" Foreground="{DynamicResource VioletBrush}"/>
                  <TextBlock Text="{Binding ModSummary}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Classes="card accentMods">
              <StackPanel Spacing="10">
                <TextBlock Text="Install Validated ZIP" FontSize="18" FontWeight="SemiBold"/>
                <!-- v0.7.39.0: PAK vs. UE4SS is now detected from the archive's own contents
                     server-side (any .pak/.ucas/.utoc file anywhere in it means PAK, otherwise
                     UE4SS), so the manual type picker that used to sit here is gone; a wrong guess
                     there used to silently install a mod under the wrong type. -->
                <TextBlock Text="The GUI uploads the archive to the headless server. Extraction is size-bounded, staged, and rejects absolute or traversal paths. PAK vs. UE4SS is detected automatically from the archive's own contents." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <!-- v0.7.78.0: direct feedback removed the manual "Package name (optional)" box
                     (package name now always comes from the ZIP's own filename, matching PAK/UE4SS
                     type auto-detection) and the two permanently-disabled "BACKEND REQUIRED"
                     buttons (no backend exists for either and none is planned near-term, so they
                     were removed rather than left as dead clutter). Added a drag-and-drop zone
                     (direct request)
                     wired to the exact same InstallModZipAsync path the picker button already uses;
                     ZipInstallDropZone_OnDragOver/_OnDrop in MainWindow.axaml.cs only accept a
                     single real, existing .zip file, matching the Choose ZIP dialog's own filter. -->
                <Border x:Name="ZipInstallDropZone" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="6" Padding="16" DragDrop.AllowDrop="True">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Button Classes="primary" Content="Choose ZIP &amp; Install" Click="InstallModZip_Click" HorizontalAlignment="Center"/>
                    <TextBlock Text="or drag a ZIP file here" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              </Border>
            </StackPanel>

            <Border Grid.Column="1" Classes="card accentMods">
              <StackPanel Spacing="10">
                <TextBlock Text="Available Local Steam Workshop Mods" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Scans locally installed Steam Workshop content for Palworld (App ID 1623730) across all detected Steam libraries. Windows only — Workshop subscriptions live on the local Steam client." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button Content="↻ Refresh" Command="{Binding ScanWorkshopModsCommand}" Margin="0,0,6,6"/>
                  <Button Classes="primary" Content="Import Selected" Command="{Binding ImportSelectedWorkshopModCommand}" Margin="0,0,6,6"/>
                </WrapPanel>
                <TextBlock Text="{Binding WorkshopScanState}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
                <ListBox ItemsSource="{Binding WorkshopItems}" SelectedItem="{Binding SelectedWorkshopItem}" MaxHeight="320">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:WorkshopItemDto">
                      <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="8" Margin="0,6">
                        <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding WorkshopId}" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas, monospace"/></StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding SuggestedPackage}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"/>
                        <Border Grid.Column="2" Classes="badge" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center"/></Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
          </Grid>

          <!-- v0.7.78.0: Installed MODs widened to 2/3 of the row, MOD DETAILS to the right at 1/3
               (direct request), replacing v0.7.40.0's equal 1.3*/1.3*/* three-column split now that
               Available Workshop Mods moved to its own row above. The selected-MOD button cluster
               (Enable/Disable/Rollback/Repair/Delete Selected) that used to sit above this list is
               gone entirely; those actions are now a right-click context menu on the list itself
               (matching how Bases/Guilds/Players already expose per-row mutations), and the
               page-level all-MODs/maintenance actions (Enable All, Disable All, Repair, Safe-Start)
               moved to the ribbon's new "MOD Maintenance" group. Direct follow-up to the
               button-row-redesign request: "should we move the buttons to the ribbon? can we add a
               right click as well." -->
          <Grid ColumnDefinitions="2*,*" ColumnSpacing="12" IsVisible="{Binding IsModLibraryPage}">
            <Border Classes="card accentMods">
              <StackPanel Spacing="10">
                <TextBlock Text="Installed MODs" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Disabled and Active / Unverified are informational states; only explicit enabled-MOD failures degrade health. Right-click a MOD for actions; Enable All/Disable All/Repair/Safe-Start Diagnostic are in the ribbon above." Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                <ListBox ItemsSource="{Binding ModItems}" SelectedItem="{Binding SelectedMod}" MaxHeight="560" ToolTip.Tip="Right-click a MOD for Enable/Disable/Rollback/Repair/Delete.">
                  <ListBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Enable Selected" Command="{Binding EnableSelectedModCommand}"/>
                      <MenuItem Header="Disable Selected" Command="{Binding DisableSelectedModCommand}"/>
                      <Separator/>
                      <MenuItem Header="Rollback Selected" Command="{Binding RollbackSelectedModCommand}" ToolTip.Tip="Restores this MOD to its state before the last Install or Delete. A snapshot is captured automatically on every install/delete."/>
                      <MenuItem Header="Repair Selected" Command="{Binding RepairSelectedModCommand}" ToolTip.Tip="Re-imports this MOD fresh from its matched local Steam Workshop copy, fixing missing or incomplete files. Fails honestly if no local Workshop source is known for it."/>
                      <Separator/>
                      <MenuItem Header="Delete Selected" Command="{Binding DeleteSelectedModCommand}"/>
                    </ContextMenu>
                  </ListBox.ContextMenu>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ModItemDto">
                      <Grid ColumnDefinitions="60,2*,*" ColumnSpacing="8" Margin="0,6">
                        <TextBlock Text="{Binding Type}" FontWeight="SemiBold" FontSize="11"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding InstallPath}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                          <!-- v0.7.78.0: per-row update availability, direct request ("under
                               installed MODs card it should have the info if there is an updated
                               version"). Reuses the same local Steam Workshop content-cache
                               comparison the MOD DETAILS panel's on-demand Check for Update already
                               used; here it's computed once per mod during the regular inventory
                               scan instead of needing a manual click per selection. -->
                          <TextBlock Text="{Binding InstalledVersionText}" FontSize="10" Foreground="{DynamicResource CyanBrush}" Margin="0,2,0,0"/>
                          <Border Classes="badge" Background="{DynamicResource AmberBrush}" HorizontalAlignment="Left" Margin="0,2,0,0" IsVisible="{Binding UpdateAvailable}" ToolTip.Tip="{Binding UpdateHint}"><TextBlock Text="UPDATE AVAILABLE" FontSize="9"/></Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{Binding EnabledText}" FontSize="11"/><TextBlock Text="{Binding Health}" FontSize="11" Foreground="{DynamicResource VioletBrush}"/></StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card accentMods">
              <Grid>
              <StackPanel Spacing="10" IsVisible="{Binding HasSelectedMod}">
                <TextBlock Text="MOD DETAILS" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedMod.Name}" FontWeight="Bold" TextWrapping="Wrap"/>
                <StackPanel Spacing="3">
                  <TextBlock Text="OVERALL HEALTH" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{Binding SelectedMod.Health}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="INSTALLATION" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{Binding SelectedMod.Type}"/>
                  <TextBlock Text="{Binding SelectedMod.Package}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock Text="{Binding SelectedMod.InstallPath}" FontSize="10" FontFamily="Consolas, monospace" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SelectedMod.EnabledText}"/>
                  <TextBlock Text="{Binding SelectedMod.InstalledVersionText}" Foreground="{DynamicResource CyanBrush}"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="RUNTIME" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{Binding SelectedMod.RuntimeState}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="COMPATIBILITY" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{Binding SelectedMod.RuntimeConfirmed, StringFormat='Runtime confirmed: {0}'}"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="EVIDENCE" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{Binding SelectedMod.Evidence}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- v0.7.41.0: MOD update detection (item 52). Check compares the installed MOD
                     against a matching local Steam Workshop item's own content cache, real,
                     locally-verifiable evidence, not a live network lookup or a fabricated "latest
                     version" claim. Update only enables once a real newer local copy was found. -->
                <StackPanel Spacing="3">
                  <TextBlock Text="UPDATE" Classes="muted" FontSize="10"/>
                  <WrapPanel>
                    <Button Content="Check for Update" Classes="inspectAction" Command="{Binding CheckSelectedModUpdateCommand}" Margin="0,0,6,6"/>
                    <Button Content="Update" Classes="targetAction" Command="{Binding UpdateSelectedModCommand}" Margin="0,0,6,6"/>
                  </WrapPanel>
                  <TextBlock Text="{Binding SelectedModUpdateText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- v0.7.55.0: website-sourced MOD descriptions (item 40's deferred half),
                     designed for multiple sources: an automatic Steam Workshop match (reusing the
                     same local-content match the UPDATE section above already uses), or a manually
                     set Source URL (e.g. a GitHub repo) for MODs with no Workshop match. Fetching
                     only ever happens on this button's own click, never on selection or on page
                     load, so browsing the MOD list never triggers a network call by itself. -->
                <StackPanel Spacing="3">
                  <TextBlock Text="DESCRIPTION" Classes="muted" FontSize="10"/>
                  <WrapPanel>
                    <Button Content="Fetch / Refresh Description" Classes="inspectAction" Command="{Binding FetchSelectedModDescriptionCommand}" Margin="0,0,6,6" ToolTip.Tip="Only fetches when clicked -- never automatic."/>
                  </WrapPanel>
                  <StackPanel Spacing="3" IsVisible="{Binding HasSelectedModDescription}">
                    <TextBlock Text="{Binding SelectedModDescription.Source, StringFormat='Source: {0}'}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{Binding SelectedModDescription.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <!-- Long Steam Workshop descriptions routinely exceed a fixed height, so this
                         scrolls rather than silently clipping past MaxHeight. -->
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                      <TextBlock Text="{Binding SelectedModDescription.Description}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <TextBlock Text="{Binding SelectedModDescription.SourceUrl}" FontSize="10" Foreground="{DynamicResource CyanBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      <Button Grid.Column="1" Content="Open" FontSize="11" Padding="8,2" Click="OpenModDescriptionSource_Click" ToolTip.Tip="Open this link in your default browser."/>
                    </Grid>
                  </StackPanel>
                  <TextBlock Text="{Binding SelectedModDescription.Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasModDescriptionResult}"/>
                  <!-- Only shown after an actual fetch attempt found nothing, so it doesn't
                       presumptuously claim "no match" before Fetch has ever been clicked for this
                       selection. -->
                  <TextBlock Text="No known Workshop match -- set a Source URL (e.g. a GitHub repository) below, then Fetch again:" Classes="muted" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding ShowNoModDescriptionMatchMessage}"/>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding SelectedModDescriptionSourceInput}" Watermark="https://github.com/owner/repo"/>
                    <Button Grid.Column="1" Content="Set Source" Command="{Binding SetSelectedModDescriptionSourceCommand}"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
              <TextBlock Text="Select a MOD from the Installed MODs list to see its details here." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" IsVisible="{Binding !HasSelectedMod}"/>
              </Grid>
            </Border>
          </Grid>

          <!-- v0.7.59.0: Safe-Start MOD Diagnostic live status. Polled independently of IsBusy over
               a DispatcherTimer since the diagnostic itself runs server-side over several minutes
               (a full start/stop cycle per candidate MOD), so this card shows real progress rather
               than a spinner with no detail for that whole duration. -->
          <Border Classes="card accentMods" IsVisible="{Binding HasModSafeStartStatus}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="SAFE-START DIAGNOSTIC" FontSize="14" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="Cancel" Classes="danger" Command="{Binding CancelModSafeStartCommand}" IsVisible="{Binding ModSafeStartStatus.IsRunning}"/>
              </Grid>
              <TextBlock Text="{Binding ModSafeStartStatus.Phase}" TextWrapping="Wrap" IsVisible="{Binding ModSafeStartStatus.IsRunning}"/>
              <TextBlock Text="{Binding ModSafeStartStatus.ProgressText}" Classes="muted" FontSize="11" IsVisible="{Binding ModSafeStartStatus.IsRunning}"/>
              <ItemsControl ItemsSource="{Binding ModSafeStartStatus.Results}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:SafeStartModResultDto">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                      <Border Classes="badge" Background="{DynamicResource GreenBrush}" IsVisible="{Binding Ok}"><TextBlock Text="OK"/></Border>
                      <Border Classes="badge" Background="{DynamicResource RedBrush}" IsVisible="{Binding !Ok}"><TextBlock Text="DISABLED"/></Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Package}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding ModSafeStartStatus.FinalMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}"
                         IsVisible="{Binding ModSafeStartStatus.Success}"/>
              <TextBlock Text="{Binding ModSafeStartStatus.FinalMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource AmberBrush}"
                         IsVisible="{Binding ModSafeStartStatus.CompletedUnsuccessfully}"/>
            </StackPanel>
          </Border>

          <Border Classes="card accentMods">
            <TextBlock Text="Enable/disable requires PalServer to be stopped. PAK state is managed through ~mods files. UE4SS state uses the resolver-selected active Mods root and mods.txt; enabled.txt overrides are neutralized." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
          </Border>
        </StackPanel>

        <!-- NETWORK DIAGNOSTICS -->
        <StackPanel IsVisible="{Binding IsDiagnosticsPage}" Spacing="12">
          <!-- v0.7.42.0: Run Diagnostics/Add-Repair Firewall Rule/Restart Server moved to the
               ribbon. "Re-run Network Tests" was a literal duplicate of Run Diagnostics (same
               command), removed rather than relocated. "Open Server Log" was redundant with the
               always-present global ribbon Quick Actions "Console" button, removed too. -->
          <Grid ColumnDefinitions="*">
            <StackPanel><TextBlock Text="Runtime and network health are evaluated independently." Foreground="{DynamicResource MutedBrush}"/></StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
            <Border Classes="card accentTools"><StackPanel><TextBlock Text="RUNTIME" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding NetworkRuntime}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Grid.Column="1" Classes="card accentTools"><StackPanel><TextBlock Text="NETWORK" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding NetworkHealth}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource VioletBrush}"/></StackPanel></Border>
            <Border Grid.Column="2" Classes="card accentTools"><StackPanel><TextBlock Text="GAME PORT" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding NetworkPort}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Grid.Column="3" Classes="card accentTools"><StackPanel><TextBlock Text="LAN ENDPOINT" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding NetworkLanEndpoint}" FontSize="16" FontWeight="SemiBold"/></StackPanel></Border>
          </Grid>
          <Border Classes="card accentTools"><StackPanel Spacing="6"><TextBlock Text="Binding" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding NetworkBinding}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding NetworkRecommendation, StringFormat='Recommended action: {0}'}" TextWrapping="Wrap"/></StackPanel></Border>
          <ItemsControl ItemsSource="{Binding NetworkDiagnosticChecks}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:NetworkDiagnosticCheckDto">
              <Border Classes="card accentTools" Margin="0,0,0,8"><Grid ColumnDefinitions="180,100,*,220" ColumnSpacing="12">
                <TextBlock Text="{Binding Test}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{DynamicResource VioletBrush}"/>
                <TextBlock Grid.Column="2" Text="{Binding Details}" TextWrapping="Wrap"/><TextBlock Grid.Column="3" Text="{Binding Recommendation}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              </Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="card accentTools"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="Support Diagnostic Report" FontSize="17" FontWeight="SemiBold"/><WrapPanel Grid.Column="1"><Button Content="Copy Report" Click="CopyNetworkDiagnosticReport_Click" Margin="0,0,8,0"/><Button Content="Export Report" Click="ExportNetworkDiagnosticReport_Click" Margin="0,0,8,0"/><Button Classes="primary" Content="Create Support Package" Click="CreateSupportPackage_Click" Margin="0,0,8,0"/><Button Content="Open Local Diagnostics" Tag="runtime" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/></WrapPanel></Grid><TextBlock Text="Support output excludes passwords, bearer tokens, certificate pins, URL credentials, query strings and fragments." Foreground="{DynamicResource MutedBrush}"/><TextBox Text="{Binding NetworkReportText}" AcceptsReturn="True" IsReadOnly="True" MinHeight="180" FontFamily="Consolas, monospace" FontSize="11"/></StackPanel></Border>

          <!-- WAN / EXTERNAL REACHABILITY (v0.6.11.0). Collapsed by default since v0.7.5.0
               (no-scroll pass 1) — a secondary deep-dive tool, not the primary diagnostic view. -->
          <Border Classes="card accentTools">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleWanDiagnosticsCommand}" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="▸" IsVisible="{Binding !IsWanDiagnosticsExpanded}" FontWeight="Bold"/><TextBlock Text="▾" IsVisible="{Binding IsWanDiagnosticsExpanded}" FontWeight="Bold"/><TextBlock Text="WAN / External Reachability" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                </Button>
                <WrapPanel Grid.Column="1" IsVisible="{Binding IsWanDiagnosticsExpanded}">
                  <Button Classes="primary" Content="Run Reachability Check" Command="{Binding RunWanReachabilityCommand}" Margin="0,0,8,0"/>
                  <Button Content="Add UPnP Port Mapping" Command="{Binding RepairUpnpMappingCommand}" ToolTip.Tip="Adds a port-forward mapping on your router via UPnP for the configured game port." Margin="0,0,8,0"/>
                </WrapPanel>
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding IsWanDiagnosticsExpanded}">
              <TextBlock Text="Public IP and router UPnP port-forward mapping are checked automatically. True internet-side reachability needs a third party we don't control, so use Open Port Checker for that final confirmation." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Classes="card accentTools"><StackPanel><TextBlock Text="PUBLIC IP : PORT" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding WanPublicIpPort}" FontSize="16" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="1" Classes="card accentTools"><StackPanel><TextBlock Text="ROUTER UPNP MAPPING" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding WanUpnpState}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource VioletBrush}"/></StackPanel></Border>
                <Border Grid.Column="2" Classes="card accentTools"><StackPanel><TextBlock Text="ROUTER" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding WanRouterDescription}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
              </Grid>
              <ItemsControl ItemsSource="{Binding WanReachabilityChecks}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:WanReachabilityCheckDto">
                  <Border Classes="card accentTools" Margin="0,0,0,8"><Grid ColumnDefinitions="180,100,*,220" ColumnSpacing="12">
                    <TextBlock Text="{Binding Test}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding StateText}" Foreground="{DynamicResource VioletBrush}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Details}" TextWrapping="Wrap"/><TextBlock Grid.Column="3" Text="{Binding Recommendation}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                  </Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding WanStatus}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <WrapPanel Grid.Column="1">
                  <Button Content="Copy IP:Port" Click="CopyWanPublicIpPort_Click" Margin="0,0,8,0"/>
                  <Button Content="Open Port Checker" Command="{Binding OpenExternalPortCheckerCommand}" ToolTip.Tip="Opens a well-known external port-checker website in your browser."/>
                </WrapPanel>
              </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- LOCAL MACHINE DIAGNOSTICS (v0.6.4.0). Collapsed by default since v0.7.5.0
               (no-scroll pass 1) — a secondary deep-dive tool, not the primary diagnostic view. -->
          <Border Classes="card accentTools">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleLocalDiagnosticsCommand}" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="▸" IsVisible="{Binding !IsLocalDiagnosticsExpanded}" FontWeight="Bold"/><TextBlock Text="▾" IsVisible="{Binding IsLocalDiagnosticsExpanded}" FontWeight="Bold"/><TextBlock Text="Local Machine Diagnostics" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="primary" Content="Diagnose Connection" Command="{Binding DiagnoseConnectionCommand}" VerticalAlignment="Top" IsVisible="{Binding IsLocalDiagnosticsExpanded}"/>
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding IsLocalDiagnosticsExpanded}">
              <TextBlock Text="Diagnoses the selected connection profile from THIS machine -- DNS, TCP, TLS, then HTTP -- works even when the server is fully unreachable." Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding LocalDiagnosticsState}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding LocalConnectionFindings}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:DiagnosticFindingDto">
                  <Border Classes="statuscard accentTools" Margin="0,0,0,6"><Grid ColumnDefinitions="120,140,*" ColumnSpacing="12">
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Component}"/><TextBlock Grid.Column="2" Text="{Binding Evidence}" TextWrapping="Wrap"/>
                  </Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="This Machine" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
              <ItemsControl ItemsSource="{Binding LocalMachineFindings}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:DiagnosticFindingDto">
                  <Border Classes="statuscard accentTools" Margin="0,0,0,6"><Grid ColumnDefinitions="120,140,*" ColumnSpacing="12">
                    <TextBlock Text="{Binding StateText}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Component}"/><TextBlock Grid.Column="2" Text="{Binding Evidence}" TextWrapping="Wrap"/>
                  </Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsDoctorPage}" Spacing="12">
          <Border Classes="card accentTools">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <!-- v0.7.27.0: Run Doctor/Refresh and Export Diagnostic Report moved to the ribbon
                   (BuildRibbonGroupsForActivePage). -->
              <StackPanel Spacing="10">
                <TextBlock Text="{Binding DoctorStatus}" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{Binding DoctorSummary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DoctorCheckedAt, StringFormat='Last checked: {0}'}" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{Binding DoctorExportPath}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
              <!-- v0.7.28.0: managed process list, sourced from ServerStatusDto.Processes; that
                   data already flowed end-to-end from the headless host's FindManagedServerProcesses
                   before this, just never read on the Desktop side. "Kill Processes" in the ribbon's
                   Doctor group reuses ForceStopServerCommand. -->
              <StackPanel Grid.Column="1" Spacing="6" MinWidth="220" IsVisible="{Binding HasManagedProcesses}">
                <TextBlock Text="MANAGED PROCESSES" Classes="muted" FontWeight="Bold"/>
                <ItemsControl ItemsSource="{Binding ManagedProcesses}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ServerProcessDto">
                      <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas, monospace" FontSize="11" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </Border>

          <!-- v0.7.44.0: Palworld Instance Detection & Termination Tool. Machine-wide scan, not just
               this tab's own managed processes (the MANAGED PROCESSES panel above); motivated by a
               real collision hit during this app's own release verification, where an unrelated
               PalServer process had no in-app way to be identified or stopped. Reuses the same
               list-plus-details-panel pattern established for MOD Dashboard/MOD Library
               (v0.7.40.0/v0.7.43.0). -->
          <Border Classes="card accentTools" IsVisible="{Binding HasAllInstances}">
            <Grid ColumnDefinitions="1.6*,*" ColumnSpacing="12">
              <StackPanel Spacing="8">
                <TextBlock Text="ALL PALWORLD INSTANCES ON THIS MACHINE" Classes="muted" FontWeight="Bold"/>
                <TextBlock Text="Every Palworld process on this machine, not just the one this tab manages. Select an instance to see details and available actions." Classes="muted" TextWrapping="Wrap" FontSize="11"/>
                <ListBox ItemsSource="{Binding AllInstances}" SelectedItem="{Binding SelectedInstance}" MaxHeight="240">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ServerInstanceDto">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{Binding DisplayText}" FontFamily="Consolas, monospace" FontSize="12"/>
                          <TextBlock Text="{Binding PathText}" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding ManagedText}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource GreenBrush}" IsVisible="{Binding ManagedByThisProfile}"/>
                        <TextBlock Grid.Column="1" Text="{Binding ManagedText}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource AmberBrush}" IsVisible="{Binding !ManagedByThisProfile}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              <Grid Grid.Column="1">
                <StackPanel Spacing="8" IsVisible="{Binding HasSelectedInstance}">
                  <TextBlock Text="INSTANCE DETAILS" Classes="muted" FontWeight="Bold"/>
                  <TextBlock Text="{Binding SelectedInstance.DisplayText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SelectedInstance.PathText}" Classes="muted" TextWrapping="Wrap" FontSize="11"/>
                  <StackPanel Spacing="6" IsVisible="{Binding IsSelectedInstanceManaged}">
                    <TextBlock Text="Managed by this tab. Use the safe, crash-recovery-aware stop path instead of a raw kill." Classes="muted" TextWrapping="Wrap" FontSize="11"/>
                    <Button Content="Stop via MystTiq" Classes="danger" Command="{Binding ForceStopServerCommand}"/>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding !IsSelectedInstanceManaged}">
                    <TextBlock Text="Not confirmed as this tab's own managed process. MystTiq cannot know whether this PID is tracked by a different local MystTiq session's own crash-recovery — killing it directly may look like an unexpected crash to that session and trigger an auto-restart there, instead of a clean stop." Classes="muted" TextWrapping="Wrap" Foreground="{DynamicResource AmberBrush}" FontSize="11"/>
                    <Button Content="Force Kill (Unmanaged)" Classes="danger" Command="{Binding TerminateSelectedInstanceCommand}"/>
                  </StackPanel>
                  <TextBlock Text="{Binding InstanceTerminationResultText}" TextWrapping="Wrap" FontSize="11" IsVisible="{Binding HasInstanceTerminationResult}"/>
                </StackPanel>
                <TextBlock Text="Select an instance above to see details and available actions." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasSelectedInstance}"/>
              </Grid>
            </Grid>
          </Border>
          <TextBlock Text="No Palworld instances detected on this machine yet. Use &quot;Detect Instances&quot; in the ribbon or run the Doctor to scan." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasAllInstances}"/>

          <TextBlock Text="{Binding DiagnosticsReportDetail}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
          <!-- v0.7.79.0: denser than v0.7.32.0's own compact pass. Direct live feedback ("these
               items listed should be compacted and make use of the spacing a bit more. Perhaps
               Pass can be highlighted in green or red"). State is now a colored badge (green
               Pass/red Fail/amber Warning/neutral for anything else) instead of plain bold text, so
               status reads at a glance without scanning the word itself. Evidence and Recommendation
               collapse onto one row of columns instead of two full-width stacked lines, and
               Recommendation is hidden entirely when it's identical to Evidence (common for a
               passing check, e.g. both saying "Steam installation detected."), real redundant
               text this feedback was also about, not just visual density. -->
          <ItemsControl ItemsSource="{Binding DiagnosticFindings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:DiagnosticFindingDto">
                <Border Classes="card accentTools" Padding="8,5" Margin="0,0,0,4">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                    <Border Classes="badge" Background="{DynamicResource GreenBrush}" IsVisible="{Binding IsPass}"><TextBlock Classes="badgeText" Text="{Binding StateText}" FontWeight="Bold" FontSize="10"/></Border>
                    <Border Classes="badge" Background="{DynamicResource AmberBrush}" IsVisible="{Binding IsWarning}"><TextBlock Classes="badgeText" Text="{Binding StateText}" FontWeight="Bold" FontSize="10"/></Border>
                    <Border Classes="badge" Background="{DynamicResource RedBrush}" IsVisible="{Binding IsFail}"><TextBlock Classes="badgeText" Text="{Binding StateText}" FontWeight="Bold" FontSize="10"/></Border>
                    <Border Classes="badge" IsVisible="{Binding IsOtherState}"><TextBlock Text="{Binding StateText}" FontWeight="Bold" FontSize="10"/></Border>
                    <StackPanel Grid.Column="1" MinWidth="150" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Component}" FontSize="13" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Category}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Evidence}" TextWrapping="Wrap" FontSize="11"/>
                      <TextBlock Text="{Binding Recommendation}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" IsVisible="{Binding ShowRecommendation}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                      <Button Content="Recheck" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RecheckDiagnosticCommand}" CommandParameter="{Binding}"/>
                      <Button Content="Fix Automatically" Classes="success" IsVisible="{Binding CanFix}" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).FixDiagnosticCommand}" CommandParameter="{Binding}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- WORKSPACE -->
        <StackPanel IsVisible="{Binding IsWorkspacePage}" Spacing="12">
          <Border Classes="card accentServer">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel><TextBlock Text="Review, validate, and open every MystTiq working location. Managed server paths remain authoritative on the headless host." Classes="muted" TextWrapping="Wrap"/></StackPanel>
              <!-- v0.7.27.0: "Refresh" moved to the ribbon (BuildRibbonGroupsForActivePage); "Validate All" stays here, not part of that relocation. -->
              <WrapPanel Grid.Column="1"><Button Classes="success" Content="Validate All" Command="{Binding ValidateWorkspaceCommand}"/></WrapPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border Classes="statuscard accentServer"><StackPanel><TextBlock Text="DEPLOYMENT MODE" Classes="muted"/><TextBlock Text="{Binding WorkspaceDeploymentMode}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/><TextBlock Text="Local paths are enabled only for the local profile." Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Grid.Column="1" Classes="statuscard accentServer"><StackPanel><TextBlock Text="WORKSPACE HEALTH" Classes="muted"/><TextBlock Text="{Binding WorkspaceHealthText}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AmberBrush}"/><TextBlock Text="{Binding WorkspaceState}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Grid.Column="2" Classes="statuscard accentServer"><StackPanel><TextBlock Text="SERVER DISCOVERY" Classes="muted"/><TextBlock Text="{Binding WorkspaceDiscoveryText}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}"/><TextBlock Text="Environment checks come from the managed server." Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          </Grid>

          <Border Classes="card accentServer">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="WORKSPACE LOCATIONS" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/><Button Grid.Column="1" Classes="success" Content="Save Paths" Command="{Binding SaveConfigurationCommand}"/></Grid>
              <Grid ColumnDefinitions="170,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="7">
                <TextBlock Text="Executable root" Classes="muted" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding WorkspaceExecutableRoot}" IsReadOnly="True"/><Button Grid.Column="3" Content="Open" Classes="targetAction" Tag="executable" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="1" Text="Workspace root" Classes="muted" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding WorkspaceRoot}" IsReadOnly="True"/><Button Grid.Row="1" Grid.Column="3" Content="Open" Classes="targetAction" Tag="workspace" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="2" Text="Application data" Classes="muted" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding WorkspaceApplicationData}" IsReadOnly="True"/><Button Grid.Row="2" Grid.Column="3" Content="Open" Classes="targetAction" Tag="appdata" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="3" Text="Palworld server" Classes="muted" VerticalAlignment="Center"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ConfigServerRoot}"/><Button Grid.Row="3" Grid.Column="2" Content="Browse" Classes="inspectAction" Tag="server" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceBrowse_Click"/><Button Grid.Row="3" Grid.Column="3" Content="Open" Classes="targetAction" Tag="server" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="4" Text="SteamCMD" Classes="muted" VerticalAlignment="Center"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ConfigSteamCmdPath}"/><Button Grid.Row="4" Grid.Column="2" Content="Browse" Classes="inspectAction" Tag="steamcmd" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceBrowse_Click"/><Button Grid.Row="4" Grid.Column="3" Content="Open" Classes="targetAction" Tag="steamcmd" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="5" Text="Backups" Classes="muted" VerticalAlignment="Center"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ConfigBackupRoot}"/><Button Grid.Row="5" Grid.Column="2" Content="Browse" Classes="inspectAction" Tag="backup" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceBrowse_Click"/><Button Grid.Row="5" Grid.Column="3" Content="Open" Classes="targetAction" Tag="backup" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="6" Text="Runtime" Classes="muted" VerticalAlignment="Center"/><TextBox Grid.Row="6" Grid.Column="1" Text="{Binding ConfigRuntimeRoot}"/><Button Grid.Row="6" Grid.Column="2" Content="Browse" Classes="inspectAction" Tag="runtime" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceBrowse_Click"/><Button Grid.Row="6" Grid.Column="3" Content="Open" Classes="targetAction" Tag="runtime" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="7" Text="Downloads" Classes="muted" VerticalAlignment="Center"/><TextBox Grid.Row="7" Grid.Column="1" Text="{Binding WorkspaceDownloadsRoot}" IsReadOnly="True"/><Button Grid.Row="7" Grid.Column="3" Content="Open" Classes="targetAction" Tag="downloads" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="8" Text="Exports" Classes="muted" VerticalAlignment="Center"/><TextBox Grid.Row="8" Grid.Column="1" Text="{Binding WorkspaceExportsRoot}" IsReadOnly="True"/><Button Grid.Row="8" Grid.Column="3" Content="Open" Classes="targetAction" Tag="exports" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="9" Text="Logs" Classes="muted" VerticalAlignment="Center"/><TextBox Grid.Row="9" Grid.Column="1" Text="{Binding WorkspaceLogsRoot}" IsReadOnly="True"/><Button Grid.Row="9" Grid.Column="3" Content="Open" Classes="targetAction" Tag="logs" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
              </Grid>
              <TextBlock Text="Browse/Open are local-profile-only. Remote paths are validated and saved by the authenticated headless configuration service." Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- WORLD VALIDATOR / REPAIR / RECOVERY / TRANSACTION CENTER -->
        <StackPanel IsVisible="{Binding IsWorldTransactionsPage}" Spacing="12">
          <Border Classes="card accentWorld">
            <StackPanel Spacing="12">
              <!-- v0.7.42.0: Validate Active World/Export Report moved to the ribbon. -->
              <StackPanel Spacing="4"><TextBlock Text="World Validator" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding WorldValidationState}" Classes="muted" TextWrapping="Wrap"/></StackPanel>
              <ItemsControl ItemsSource="{Binding WorldValidationFindings}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:WorldValidationFindingDto"><Border Classes="statuscard accentWorld" Margin="0,3"><Grid ColumnDefinitions="100,130,*" ColumnSpacing="10"><TextBlock Text="{Binding Severity}" Foreground="{DynamicResource AmberBrush}"/><TextBlock Grid.Column="1" Text="{Binding Category}"/><TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" Classes="muted"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card accentWorld">
            <StackPanel Spacing="12">
              <TextBlock Text="Repair Center / Recovery" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="Import archive workflow: Analyze → Accept Options → Review Plan → Apply. World Import replaces the active world; Player Recovery overlays only canonical Players/&lt;32-hex&gt;.sav files. Guild ownership repair (Claim/Transfer/Add Player) is live from the Guilds page; Base ownership transfer and recovery (v0.5.3.0/v0.5.4.0) are live from the Bases page." Classes="muted" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="190,Auto,*" ColumnSpacing="10"><ComboBox ItemsSource="{Binding WorldTransactionModes}" SelectedItem="{Binding WorldTransactionMode}"/><Button Grid.Column="1" Content="Analyze ZIP Archive" Click="AnalyzeWorldArchive_Click"/><TextBlock Grid.Column="2" Text="{Binding WorldTransactionState}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid>
              <Border Classes="statuscard accentWorld"><StackPanel Spacing="6"><TextBlock Text="Transaction Plan" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding WorldTransactionPlanSteps}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
              <CheckBox Content="I reviewed this plan and confirm the active Palworld server is stopped." IsChecked="{Binding WorldTransactionConfirmed}"/>
              <Button Classes="danger" Content="Apply With Fresh Safety Backup" HorizontalAlignment="Left" Command="{Binding ApplyWorldTransactionCommand}"/>
            </StackPanel>
          </Border>
          <Border Classes="card accentWorld">
            <StackPanel Spacing="10"><TextBlock Text="Transaction Center / Durable Journal" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Every accepted mutation records preview acceptance, fresh backup, staging, atomic swap, post-validation, completion or rollback." Classes="muted" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding WorldTransactionHistory}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:WorldTransactionJournalDto"><Border Classes="statuscard accentWorld" Margin="0,3"><StackPanel Spacing="3"><TextBlock Text="{Binding Summary}" FontWeight="SemiBold"/><TextBlock Text="{Binding TransactionId}" FontFamily="Consolas, monospace" FontSize="10"/><TextBlock Text="{Binding SafetyBackup, StringFormat='Safety backup: {0}'}" Classes="muted"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card accentWorld">
            <StackPanel Spacing="10">
              <!-- v0.7.42.0: Refresh moved to the ribbon. -->
              <StackPanel Spacing="4"><TextBlock Text="Operation Platform" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Cross-feature view of the shared operation coordinator — World Transactions, Guild Ownership and Base Ownership/Recovery all run through it and are rejected from running concurrently against the same world." Classes="muted" TextWrapping="Wrap"/></StackPanel>
              <ItemsControl ItemsSource="{Binding RecentOperations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:OperationRecordDto"><Border Classes="statuscard accentWorld" Margin="0,3"><Grid ColumnDefinitions="150,180,100,100,*" ColumnSpacing="10"><TextBlock Text="{Binding Kind}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Source}" Classes="muted"/><TextBlock Grid.Column="2" Text="{Binding Phase}"/><TextBlock Grid.Column="3" Text="{Binding TransactionState}" Classes="muted"/><TextBlock Grid.Column="4" Text="{Binding UpdatedUtc}" Classes="muted"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- CRASH ANALYZER -->
        <StackPanel IsVisible="{Binding IsCrashAnalyzerPage}" Spacing="12">
          <Border Classes="card accentTools"><StackPanel Spacing="10">
            <!-- v0.7.42.0: Refresh History/Run Analysis moved to the ribbon. -->
            <TextBlock Text="{Binding CrashAnalyzerState}" TextWrapping="Wrap" Classes="muted"/>
            <TextBlock Text="MystTiq reports explicit signatures and correlation only. It never promotes a successful-load line or last-message proximity into an invented cause." TextWrapping="Wrap"/>
          </StackPanel></Border>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Classes="card accentTools"><StackPanel Spacing="8"><TextBlock Text="Findings" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding CrashFindings}" MinHeight="160"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
            <Border Grid.Column="1" Classes="card accentTools"><StackPanel Spacing="8"><TextBlock Text="Safe Isolation Plan" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding CrashIsolationPlan}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='•  {0}'}" Margin="0,3" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          </Grid>
          <Border Classes="card accentTools"><StackPanel Spacing="8"><TextBlock Text="Persisted Analysis History" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding CrashHistory}" MaxHeight="220"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
        </StackPanel>

        <!-- PALWORLD SAVE TOOLS -->
        <StackPanel IsVisible="{Binding IsSaveToolsPage}" Spacing="12">
          <Border Classes="card accentTools"><StackPanel Spacing="10">
            <!-- v0.7.42.0: Refresh/Run Self-Tests moved to the ribbon. -->
            <TextBlock Text="{Binding SaveToolsState}" TextWrapping="Wrap" Classes="muted"/>
            <TextBlock Text="{Binding SaveToolsPaths}" TextWrapping="Wrap" FontFamily="Consolas"/>
            <TextBlock Text="Inspection is read-only. Save mutation remains behind the reviewed World Transaction workflow and its backup, confirmation, staging and rollback protections." TextWrapping="Wrap"/>
          </StackPanel></Border>
          <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12">
            <Border Classes="card accentTools"><StackPanel Spacing="8"><TextBlock Text="Self-Test Results" FontWeight="SemiBold"/><ListBox ItemsSource="{Binding SaveToolsTests}" MinHeight="180" MaxHeight="420"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Display}"/><TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" MaxHeight="72"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
            <Border Grid.Column="1" Classes="card accentTools"><Grid RowDefinitions="Auto,*" RowSpacing="8"><TextBlock Text="Server-Side Save Inventory" FontWeight="SemiBold"/><ListBox Grid.Row="1" ItemsSource="{Binding SaveFiles}" SelectedItem="{Binding SelectedSaveFile}" MinHeight="180" MaxHeight="420"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
          </Grid>
        </StackPanel>

        <!-- NOTIFICATIONS -->
        <StackPanel IsVisible="{Binding IsNotificationsPage}" Spacing="12">
          <!-- v0.7.42.0: Refresh/Self-Test/Mark All Read/Export Visible moved to the ribbon. -->
          <Border Classes="card accentSystem"><Grid ColumnDefinitions="*"><StackPanel><TextBlock Text="{Binding NotificationState}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Grid></Border>
          <Border Classes="card accentSystem"><StackPanel Spacing="10"><Grid ColumnDefinitions="2*,*" ColumnSpacing="8"><TextBox Text="{Binding NotificationSearchText}" Watermark="Search notifications"/><ComboBox Grid.Column="1" ItemsSource="{Binding NotificationSeverityOptions}" SelectedItem="{Binding NotificationSeverityFilter}"/></Grid>
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
              <ListBox ItemsSource="{Binding FilteredNotifications}" SelectedItem="{Binding SelectedNotification}" MaxHeight="470"><ListBox.ItemTemplate><DataTemplate x:DataType="models:NotificationItemDto"><Border Classes="statuscard accentSystem" Margin="0,3"><StackPanel Spacing="3"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding Severity}" Foreground="{DynamicResource VioletBrush}"/><TextBlock Text="{Binding StateText}" Classes="muted" FontSize="10"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
              <Border Grid.Column="1" Classes="statuscard accentSystem"><StackPanel Spacing="8"><TextBlock Text="Selected Notification" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedNotification.Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedNotification.Message}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedNotification.StateText}" Classes="muted"/><Button Content="Toggle Read / Unread" Command="{Binding ToggleNotificationReadCommand}"/><Button Content="Pin / Unpin" Command="{Binding ToggleNotificationPinCommand}"/><Button Classes="danger" Content="Dismiss" Command="{Binding DismissNotificationCommand}"/></StackPanel></Border>
            </Grid>
          </StackPanel></Border>
        </StackPanel>

        <!-- AUTOMATION -->
        <StackPanel IsVisible="{Binding IsAutomationPage}" Spacing="12">
          <!-- v0.7.42.0: Refresh moved to the ribbon. -->
          <Border Classes="card accentSystem"><StackPanel Spacing="4"><TextBlock Text="Scheduled Automation" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding AutomationState}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
            <Border Classes="card accentSystem"><StackPanel Spacing="8"><TextBlock Text="Rules" FontSize="17" FontWeight="SemiBold"/>
              <ListBox ItemsSource="{Binding AutomationRules}" SelectedItem="{Binding SelectedAutomationRule}" MaxHeight="420"><ListBox.ItemTemplate><DataTemplate x:DataType="models:AutomationRuleDto"><Border Classes="statuscard accentSystem" Margin="0,3"><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding ScheduleText}" Classes="muted"/><TextBlock Text="{Binding Action.Kind}" Foreground="{DynamicResource VioletBrush}"/><TextBlock><Run Text="Enabled:"/><Run Text="{Binding Enabled}"/></TextBlock></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            </StackPanel></Border>
            <Border Grid.Column="1" Classes="statuscard accentSystem" IsEnabled="{Binding CanManageAdmin}"><StackPanel Spacing="8"><TextBlock Text="Selected Rule" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedAutomationRule.Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedAutomationRule.ScheduleText}" Classes="muted" TextWrapping="Wrap"/><Button Content="Run Now" Command="{Binding RunAutomationRuleNowCommand}"/><Button Content="Enable / Disable" Command="{Binding ToggleAutomationRuleEnabledCommand}"/><Button Classes="danger" Content="Delete" Command="{Binding DeleteAutomationRuleCommand}"/></StackPanel></Border>
          </Grid>
          <Border Classes="card accentSystem" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="10">
              <TextBlock Text="New Rule" FontSize="17" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                <TextBlock Text="Name" VerticalAlignment="Center" Classes="muted"/><TextBox Grid.Column="1" Text="{Binding NewAutomationRuleName}" Watermark="Nightly backup"/>
                <TextBlock Grid.Row="1" Text="Trigger" VerticalAlignment="Center" Classes="muted"/><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AutomationTriggerKinds}" SelectedItem="{Binding NewAutomationTriggerKind}"/>
                <TextBlock Grid.Row="2" Text="Time (UTC, HH:mm) / Interval (min) / Idle threshold (min)" VerticalAlignment="Center" Classes="muted"/>
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,*,*" ColumnSpacing="10"><TextBox Text="{Binding NewAutomationTimeOfDayUtc}" Watermark="03:00"/><NumericUpDown Grid.Column="1" Value="{Binding NewAutomationIntervalMinutes}" Minimum="1"/><NumericUpDown Grid.Column="2" Value="{Binding NewAutomationIdleThresholdMinutes}" Minimum="1" ToolTip.Tip="Used only when Trigger is IdleEmpty: stop after this many minutes with 0 online players."/></Grid>
                <TextBlock Grid.Row="3" Text="Action" VerticalAlignment="Center" Classes="muted"/><ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AutomationActionKinds}" SelectedItem="{Binding NewAutomationActionKind}"/>
                <TextBlock Grid.Row="4" Text="Notification title / message" VerticalAlignment="Center" Classes="muted"/>
                <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="10"><TextBox Text="{Binding NewAutomationNotificationTitle}" Watermark="Title"/><TextBox Grid.Column="1" Text="{Binding NewAutomationNotificationMessage}" Watermark="Message"/></Grid>
                <TextBlock Grid.Row="5" Text="RCON command" VerticalAlignment="Center" Classes="muted"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding NewAutomationRconCommand}" Watermark="Broadcast Hello"/>
              </Grid>
              <Button Classes="success" Content="Create Rule" HorizontalAlignment="Left" Command="{Binding CreateAutomationRuleCommand}"/>
            </StackPanel>
          </Border>
          <Border Classes="card accentSystem"><StackPanel Spacing="8"><TextBlock Text="Recent Runs" FontSize="17" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding AutomationRuns}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:AutomationRunRecordDto"><Border Classes="statuscard accentSystem" Margin="0,3"><Grid ColumnDefinitions="150,100,*" ColumnSpacing="10"><TextBlock Text="{Binding RuleName}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding State}"/><TextBlock Grid.Column="2" Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></Border>
        </StackPanel>

        <!-- ALERT CENTER -->
        <StackPanel IsVisible="{Binding IsAlertCenterPage}" Spacing="12">
          <!-- v0.7.42.0: Refresh moved to the ribbon (Discord Bot/Anti-Cheat's own per-section
               refresh buttons below stay in-page, tied to their own collapsible sections). -->
          <Border Classes="card accentSystem"><StackPanel Spacing="4"><TextBlock Text="Alert Center" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding AlertCenterState}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Classes="statuscard accentSystem"><StackPanel Spacing="4"><TextBlock Text="DISK SPACE PREDICTION" Classes="muted"/><TextBlock Text="{Binding DiskSpacePrediction.FreeGb}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/><TextBlock Text="{Binding DiskSpacePrediction.Detail}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Classes="card accentSystem" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="10">
              <TextBlock Text="Threshold Rules" FontSize="17" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="220,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                <TextBlock Text="Sustained high CPU %" VerticalAlignment="Center" Classes="muted"/><CheckBox Grid.Column="1" IsChecked="{Binding AlertRules.HighCpuSustained.Enabled}"/><NumericUpDown Grid.Column="2" Value="{Binding AlertRules.HighCpuSustained.ThresholdPercent}" Minimum="1" Maximum="100"/>
                <TextBlock Grid.Row="1" Text="Sustained high memory (MB)" VerticalAlignment="Center" Classes="muted"/><CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding AlertRules.HighMemorySustained.Enabled}"/><NumericUpDown Grid.Row="1" Grid.Column="2" Value="{Binding AlertRules.HighMemorySustained.ThresholdMb}" Minimum="1"/>
                <TextBlock Grid.Row="2" Text="Low disk space %" VerticalAlignment="Center" Classes="muted"/><CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding AlertRules.LowDiskSpace.Enabled}"/><NumericUpDown Grid.Row="2" Grid.Column="2" Value="{Binding AlertRules.LowDiskSpace.ThresholdPercent}" Minimum="1" Maximum="100"/>
                <TextBlock Grid.Row="3" Text="Disk exhaustion predicted within (days)" VerticalAlignment="Center" Classes="muted"/><CheckBox Grid.Row="3" Grid.Column="1" IsChecked="{Binding AlertRules.DiskSpaceExhaustionPredicted.Enabled}"/><NumericUpDown Grid.Row="3" Grid.Column="2" Value="{Binding AlertRules.DiskSpaceExhaustionPredicted.ThresholdDays}" Minimum="1"/>
                <TextBlock Grid.Row="4" Text="MOD/UE4SS health needs attention" VerticalAlignment="Center" Classes="muted"/><CheckBox Grid.Row="4" Grid.Column="1" IsChecked="{Binding AlertRules.ModHealthDegraded.Enabled}"/><TextBlock Grid.Row="4" Grid.Column="2" Text="Fires when an enabled MOD reports Failed/Missing/Misconfigured/Attention" Classes="muted" VerticalAlignment="Center" FontSize="11"/>
              </Grid>
              <Button Classes="success" Content="Save Rules" HorizontalAlignment="Left" Command="{Binding SaveAlertRulesCommand}"/>
            </StackPanel>
          </Border>
          <!-- v0.7.5.0 (no-scroll pass 1): Discord Bot and Anti-Cheat are large, independent
               features unrelated to Threshold Rules above; both collapse by default. -->
          <Border Classes="card accentSystem" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleDiscordBotCommand}" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="▸" IsVisible="{Binding !IsDiscordBotExpanded}" FontWeight="Bold"/><TextBlock Text="▾" IsVisible="{Binding IsDiscordBotExpanded}" FontWeight="Bold"/><TextBlock Text="Discord Bot" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                </Button>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshDiscordBotConfigCommand}" VerticalAlignment="Top" IsVisible="{Binding IsDiscordBotExpanded}"/>
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding IsDiscordBotExpanded}">
              <TextBlock Text="{Binding DiscordBotState}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="Guild-scoped slash commands (/mysttiq-status, /mysttiq-players, /mysttiq-start, /mysttiq-stop, /mysttiq-restart, /mysttiq-broadcast, /mysttiq-kick, /mysttiq-ban) run against this server from Discord, gated by the role mapping below. Connects outbound to Discord's gateway -- no public endpoint is exposed." Classes="muted" TextWrapping="Wrap" FontSize="11"/>
              <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                <TextBlock Text="Enabled" VerticalAlignment="Center" Classes="muted"/><CheckBox Grid.Column="1" IsChecked="{Binding DiscordBotConfig.Enabled}"/>
                <TextBlock Grid.Row="1" Text="Bot token" VerticalAlignment="Center" Classes="muted"/>
                <TextBox Grid.Row="1" Grid.Column="1" Width="320" HorizontalAlignment="Left" Text="{Binding DiscordBotConfig.BotToken}" PasswordChar="•" Watermark="{Binding DiscordBotTokenWatermark}"/>
                <TextBlock Grid.Row="2" Text="Guild (server) ID" VerticalAlignment="Center" Classes="muted"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DiscordBotConfig.GuildId}"/>
                <TextBlock Grid.Row="3" Text="Owner Discord user ID (optional)" VerticalAlignment="Center" Classes="muted"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DiscordBotConfig.OwnerDiscordUserId}" Watermark="Always granted the Owner role, bypassing role mapping"/>
              </Grid>
              <TextBlock Text="Role mapping (Discord role ID → MystTiq role)" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="*,140,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding NewRoleMappingDiscordRoleId}" Watermark="Discord role ID"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding MystTiqRoles}" SelectedItem="{Binding NewRoleMappingRole}"/>
                <Button Grid.Column="2" Content="Add" Command="{Binding AddDiscordRoleMappingCommand}"/>
              </Grid>
              <ListBox ItemsSource="{Binding DiscordRoleMappings}" SelectedItem="{Binding SelectedRoleMapping}" MaxHeight="180">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:DiscordRoleMappingDto">
                    <Grid ColumnDefinitions="*,140"><TextBlock Text="{Binding DiscordRoleId}"/><TextBlock Grid.Column="1" Text="{Binding Role}"/></Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="danger" Content="Remove Selected Mapping" Command="{Binding RemoveDiscordRoleMappingCommand}"/>
                <Button Classes="success" Content="Save Discord Bot Config" Command="{Binding SaveDiscordBotConfigCommand}"/>
              </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card accentSystem" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleAntiCheatCommand}" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="▸" IsVisible="{Binding !IsAntiCheatExpanded}" FontWeight="Bold"/><TextBlock Text="▾" IsVisible="{Binding IsAntiCheatExpanded}" FontWeight="Bold"/><TextBlock Text="Anti-Cheat &amp; Save-Integrity Scanning" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                </Button>
                <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshAntiCheatCommand}" VerticalAlignment="Top" IsVisible="{Binding IsAntiCheatExpanded}"/>
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding IsAntiCheatExpanded}">
              <TextBlock Text="{Binding AntiCheatState}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="Every rule defaults to Flag (notify + log only). Switch a rule to Kick or Ban to have MystTiq act automatically through the same moderation path the Discord bot and REST API already use." Classes="muted" TextWrapping="Wrap" FontSize="11"/>
              <Grid ColumnDefinitions="220,120,140" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                <TextBlock Text="Invalid Steam ID on join" VerticalAlignment="Center" Classes="muted"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding AntiCheatRules.InvalidSteamId.Enabled}"/>
                <ComboBox Grid.Column="2" ItemsSource="{Binding AntiCheatResponses}" SelectedItem="{Binding AntiCheatRules.InvalidSteamId.Response}"/>
                <TextBlock Grid.Row="1" Text="Impossible level (max allowed)" VerticalAlignment="Center" Classes="muted"/>
                <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding AntiCheatRules.ImpossibleLevel.Enabled}"/>
                <ComboBox Grid.Row="1" Grid.Column="2" ItemsSource="{Binding AntiCheatResponses}" SelectedItem="{Binding AntiCheatRules.ImpossibleLevel.Response}"/>
                <TextBlock Grid.Row="2" Text="Pal stat anomaly (periodic scan)" VerticalAlignment="Center" Classes="muted"/>
                <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding AntiCheatRules.PalStatAnomaly.Enabled}"/>
                <ComboBox Grid.Row="2" Grid.Column="2" ItemsSource="{Binding AntiCheatResponses}" SelectedItem="{Binding AntiCheatRules.PalStatAnomaly.Response}"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Max allowed level" VerticalAlignment="Center" Classes="muted"/>
                <NumericUpDown Value="{Binding AntiCheatRules.ImpossibleLevel.MaxAllowedLevel}" Minimum="1" Maximum="9999" Width="140"/>
              </StackPanel>
              <Button Classes="success" Content="Save Anti-Cheat Rules" HorizontalAlignment="Left" Command="{Binding SaveAntiCheatRulesCommand}"/>
              <TextBlock Text="Recent Findings" FontWeight="SemiBold"/>
              <ListBox ItemsSource="{Binding AntiCheatFindings}" MaxHeight="220">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:AntiCheatFindingDto">
                    <Border Classes="statuscard accentSystem" Margin="0,3"><StackPanel Spacing="2">
                      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding RuleKey}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding ResponseTaken}"/></Grid>
                      <TextBlock Text="{Binding Detail}" Classes="muted" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel></Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- SECURITY -->
        <StackPanel IsVisible="{Binding IsSecurityPage}" Spacing="12">
          <!-- v0.7.42.0: Refresh moved to the ribbon. -->
          <Border Classes="card accentSystem"><StackPanel Spacing="4"><TextBlock Text="Security" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding SecurityState}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Classes="card accentSystem" IsVisible="{Binding HasLastCreatedPrincipalToken}"><StackPanel Spacing="6"><TextBlock Text="New token (shown once — copy it now)" FontWeight="SemiBold" Foreground="{DynamicResource AmberBrush}"/><SelectableTextBlock Text="{Binding LastCreatedPrincipalToken}" FontFamily="Consolas, monospace"/></StackPanel></Border>
          <Border Classes="card accentSystem" IsEnabled="{Binding CanManagePrincipals}">
            <StackPanel Spacing="10">
              <TextBlock Text="Create Principal" FontSize="17" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="150,*" ColumnSpacing="10"><TextBox Text="{Binding NewPrincipalName}" Watermark="Name"/><ComboBox Grid.Column="1" ItemsSource="{Binding MystTiqRoles}" SelectedItem="{Binding NewPrincipalRole}"/></Grid>
              <Button Classes="success" Content="Create" HorizontalAlignment="Left" Command="{Binding CreatePrincipalCommand}"/>
            </StackPanel>
          </Border>
          <Border Classes="card accentSystem"><StackPanel Spacing="8"><TextBlock Text="Principals" FontSize="17" FontWeight="SemiBold"/>
            <ListBox ItemsSource="{Binding Principals}" SelectedItem="{Binding SelectedPrincipal}" MaxHeight="360"><ListBox.ItemTemplate><DataTemplate x:DataType="models:MystTiqPrincipalDto"><Border Classes="statuscard accentSystem" Margin="0,3"><Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Role}"/><TextBlock Grid.Column="2" Text="{Binding IsExpired}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <Button Classes="danger" Content="Revoke Selected" HorizontalAlignment="Left" Command="{Binding RevokePrincipalCommand}" IsEnabled="{Binding CanManagePrincipals}"/>
          </StackPanel></Border>
        </StackPanel>

        <!-- FLEET -->
        <StackPanel IsVisible="{Binding IsFleetPage}" Spacing="12">
          <!-- v0.7.42.0: Refresh moved to the ribbon. -->
          <Border Classes="card accentSystem"><StackPanel Spacing="4"><TextBlock Text="Fleet" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{Binding FleetState}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Classes="card accentSystem" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="10">
              <TextBlock Text="Fleet Actions" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="Runs across every configured server profile, staggered so they don't all fire at once." Classes="muted" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="success" Content="Backup All" Command="{Binding BackupAllCommand}"/>
                <Button Content="Doctor All" Command="{Binding DoctorAllCommand}"/>
                <Button Content="Update All" Command="{Binding UpdateAllCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card accentSystem"><StackPanel Spacing="8"><TextBlock Text="Server Profiles" FontSize="17" FontWeight="SemiBold"/>
            <ListBox ItemsSource="{Binding FleetServers}" MaxHeight="360"><ListBox.ItemTemplate><DataTemplate x:DataType="models:ServerProfileSummaryDto"><Border Classes="statuscard accentSystem" Margin="0,3"><Grid ColumnDefinitions="12,*,140,Auto" ColumnSpacing="10"><Ellipse Width="8" Height="8" Fill="{Binding StatusDotColorKey, Converter={x:Static converters:SemanticStatusColorConverter.Instance}}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{Binding Runtime}" Classes="muted"/><TextBlock Grid.Column="3" Text="{Binding StatusText}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          </StackPanel></Border>
          <!-- v0.7.81.0: turned into an explicit step-by-step workflow, direct request: "the clone
               world option in fleet should be a workflow with drop down options to clarify what it
               is doing." Was a single row of two textboxes and a Clone button with no confirmation
               gate, for an operation that copies an entire server installation. Now: an explicit
               SOURCE label (previously only implicit, always "whichever profile this tab is
               connected to"), a real PORT OFFSET dropdown (WorldCloneRequestDto already had this
               field; it was never exposed in the UI at all before, the server just used its own
               default), and a confirmation checkbox gating the Clone button, matching the same
               Preview-adjacent safety-gate pattern already used for Guild/Base Ownership operations
               elsewhere on this page. No server-side Preview endpoint exists for cloning yet, so
               this doesn't claim to have one; the checkbox is the safety gate here, not a preview
               step. -->
          <Border Classes="card accentSystem" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="10">
              <TextBlock Text="Clone World" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="Duplicates the currently connected profile's entire installation (game binaries + world/config) into a brand-new profile, with ports offset so both can run together. The source server must be stopped first. The new profile requires a MystTiq service restart to come online." Classes="muted" TextWrapping="Wrap"/>

              <!-- v0.7.81.0 follow-up: direct request ("it should indicate better what server is
                   being cloned (server name - description)"). Name alone doesn't distinguish two
                   profiles that happen to share a display name, or say anything about where this
                   server actually lives. BaseAddress (the profile's own connection URL, always
                   accurate since it's what this tab is actually talking to) is added as the
                   description line, matching the "name - description" ask as two lines rather than
                   forcing both into one combined string. -->
              <StackPanel Spacing="3">
                <TextBlock Text="SOURCE (the connection this tab currently uses)" Classes="muted" FontSize="10"/>
                <TextBlock Text="{Binding SelectedProfile.Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedProfile.BaseAddress}" Classes="muted" FontSize="11" FontFamily="Consolas, monospace"/>
              </StackPanel>

              <StackPanel Spacing="3">
                <TextBlock Text="NEW PROFILE" Classes="muted" FontSize="10"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <TextBox Watermark="New profile ID (e.g. world-2)" Text="{Binding CloneNewProfileId}"/>
                  <TextBox Grid.Column="1" Watermark="Display name (optional)" Text="{Binding CloneNewProfileName}"/>
                </Grid>
              </StackPanel>

              <StackPanel Spacing="3">
                <TextBlock Text="PORT OFFSET" Classes="muted" FontSize="10"/>
                <TextBlock Text="Added to the source server's own ports (game, query, REST API) so both installations can run at the same time without colliding." Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                <ComboBox ItemsSource="{Binding CloneWorldPortOffsetOptions}" SelectedItem="{Binding CloneWorldPortOffset}" HorizontalAlignment="Left" MinWidth="140"/>
              </StackPanel>

              <CheckBox Content="I understand this copies the entire server installation and can take a while." IsChecked="{Binding CloneWorldConfirmed}"/>
              <Button Classes="primary" Content="Clone" Command="{Binding CloneWorldCommand}" HorizontalAlignment="Left"/>
              <TextBlock Text="{Binding CloneWorldStatusText}" Classes="muted" TextWrapping="Wrap"/>
              <!-- v0.7.84.0: closes the previously-undisclosed "needs a restart to come online" gap
                   the wizard's own Clone path already fixed in v0.7.83.0, offered here as an
                   explicit button rather than fired automatically, since this page's connection is
                   already actively in use. -->
              <Button Classes="success" Content="Restart MystTiq Now to Bring It Online" Command="{Binding RestartAfterCloneCommand}" HorizontalAlignment="Left" IsVisible="{Binding CloneWorldNeedsRestart}"/>
            </StackPanel>
          </Border>
          <Border Classes="card accentSystem"><StackPanel Spacing="8"><TextBlock Text="Last Fleet Action Results" FontSize="17" FontWeight="SemiBold"/>
            <ListBox ItemsSource="{Binding FleetActionResults}" MaxHeight="240"><ListBox.ItemTemplate><DataTemplate x:DataType="models:FleetActionResultDto"><Border Classes="statuscard accentSystem" Margin="0,3"><StackPanel Spacing="2"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="{Binding ServerProfileId}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{Binding Success}"/></Grid><TextBlock Text="{Binding Error}" Classes="muted" Foreground="{DynamicResource RedBrush}" TextWrapping="Wrap" IsVisible="{Binding !Success}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          </StackPanel></Border>
        </StackPanel>

        <!-- SETTINGS -->
        <StackPanel IsVisible="{Binding IsSettingsPage}" Spacing="12">
          <Border Classes="card accentSystem">
            <StackPanel Spacing="12">
              <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="Accent theme and light/dark mode. Applies immediately and is remembered for next time." Classes="muted" TextWrapping="Wrap"/>
              <CheckBox Content="Light mode" IsChecked="{Binding IsLightMode}"/>
              <ItemsControl ItemsSource="{Binding AccentThemeOptions}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Margin="0,0,8,8" Padding="12,7"
                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SetAccentThemeCommand}"
                            CommandParameter="{Binding}">
                      <TextBlock Text="{Binding}"/>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <!-- v0.7.13.0: this card now only ever handles EDITING an already-saved profile: the
               "Set Up New Server" wizard (Local/Remote choice, Connection Details, In-Game Server
               Defaults, Confirm & Finish) moved to its own dedicated host, shown in place of the
               whole nav sidebar/ribbon/page-content area while IsCreatingNewProfile is true (see
               the Grid.Row="3" wizard host near the end of this file). IsCreatingNewProfile is
               therefore never true while this Settings-page content is even visible, so every
               wizard-only IsVisible branch that used to live in this card was removed rather than
               left as dead, always-false conditions. -->
          <Border Classes="card accentSystem">
            <StackPanel Spacing="12">
              <TextBlock Text="Connection profiles" FontSize="18" FontWeight="SemiBold"/>

              <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinWidth="400">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:ConnectionProfile">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Content="Discover LAN Services" Command="{Binding DiscoverServicesCommand}"/>
                <Button Content="Bootstrap Local Service" Command="{Binding BootstrapLocalCommand}" IsEnabled="{Binding IsLocalProfile}"/>
                <TextBlock Text="{Binding DiscoveryStateText}" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>

              <ComboBox ItemsSource="{Binding DiscoveredServices}" SelectedItem="{Binding SelectedDiscoveredService}" MinWidth="400">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="services:DiscoveredMystTiqService">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                <TextBlock Text="Name" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" Text="{Binding ProfileName}" />

                <TextBlock Grid.Row="1" Text="Service URL" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ServerUrl}" Watermark="https://192.168.1.248:8213" />

                <!-- v0.7.63.0: two profiles CAN legitimately share the same Service URL; a
                     multi-server fleet host (see LocalManagementApiHost's "Multi-Server Fleet"
                     comment) serves several distinct PalServer instances behind one address, one
                     per server ID. This field is what actually tells them apart; leaving it blank
                     targets the host's default server. Saving a profile whose URL AND this field
                     both match an existing profile is rejected (see BuildProfileFromEditor);
                     that combination is a genuine duplicate, not a second server. -->
                <TextBlock Grid.Row="2" Text="Target server ID" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TargetServerId}" Watermark="Blank = this host's default server" />

                <TextBlock Grid.Row="3" Text="Bearer token" VerticalAlignment="Center" />
                <!-- v0.7.71.0: watermark updated; tokens are now remembered (CredentialStore,
                     Windows DPAPI-encrypted) after a successful Connect, not process-memory-only
                     as before. "Forget" clears just the saved copy, leaving the typed value alone. -->
                <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                  <TextBox Text="{Binding BearerToken}" PasswordChar="●" RevealPassword="{Binding ShowBearerToken}" Watermark="Saved encrypted after connecting" />
                  <ToggleButton Grid.Column="1" IsChecked="{Binding ShowBearerToken}" Content="{Binding ShowBearerToken, Converter={x:Static converters:BoolToEyeGlyphConverter.Instance}}" ToolTip.Tip="Show/hide the bearer token" Padding="8,4"/>
                  <Button Grid.Column="2" Content="Forget" Command="{Binding ForgetSavedTokenCommand}" ToolTip.Tip="Remove the saved encrypted token for this profile (does not clear what's typed above)" Padding="8,4"/>
                </Grid>

                <TextBlock Grid.Row="4" Text="TLS SHA-256 pin" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CertificateSha256}" Watermark="Optional 64-hex certificate fingerprint" />

                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <Button Classes="primary" Content="Connect" Command="{Binding ConnectCommand}"/>
                  <Button Content="Save Profile" Command="{Binding SaveProfileCommand}"/>
                  <Button Content="Delete Profile" Command="{Binding DeleteProfileCommand}"/>
                </StackPanel>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card accentSystem" IsVisible="{Binding !IsCreatingNewProfile}">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="Managed Server / Headless Configuration" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding ConfigState}" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Text="{Binding ConfigSecurityText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <Button Content="Load" Command="{Binding LoadConfigurationCommand}"/>
                  <Button Classes="primary" Content="Save" Command="{Binding SaveConfigurationCommand}"/>
                </StackPanel>
              </Grid>

              <TextBlock Text="Management API" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                <TextBlock Text="Enabled" VerticalAlignment="Center" />
                <CheckBox Grid.Column="1" IsChecked="{Binding ConfigApiEnabled}" />
                <TextBlock Grid.Row="1" Text="Bind address" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ConfigBindAddress}" />
                <TextBlock Grid.Row="2" Text="Port" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding ConfigPort}" Minimum="1024" Maximum="65535" />
              </Grid>

              <TextBlock Text="Lifecycle" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="180,*,180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                <TextBlock Text="Startup timeout" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="1" Value="{Binding StartupTimeoutSeconds}" Minimum="1" Maximum="3600" />
                <TextBlock Grid.Column="2" Text="Stop timeout" VerticalAlignment="Center" />
                <NumericUpDown Grid.Column="3" Value="{Binding StopTimeoutSeconds}" Minimum="1" Maximum="3600" />

                <TextBlock Grid.Row="1" Text="Service poll" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding ServicePollSeconds}" Minimum="1" Maximum="300" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Recovery backoff" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding RecoveryBackoffSeconds}" Minimum="1" Maximum="3600" />

                <TextBlock Grid.Row="2" Text="Recovery attempts" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MaximumRecoveryAttempts}" Minimum="1" Maximum="100" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Recovery window" VerticalAlignment="Center" />
                <NumericUpDown Grid.Row="2" Grid.Column="3" Value="{Binding RecoveryWindowSeconds}" Minimum="1" Maximum="86400" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="Server Paths" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="Manage in Workspace →" Command="{Binding NavigateCommand}" CommandParameter="Workspace"/>
              </Grid>
              <TextBlock Text="{Binding ConfigServerRoot, StringFormat='Server root: {0}'}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ConfigSteamCmdPath, StringFormat='SteamCMD: {0}'}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ConfigBackupRoot, StringFormat='Backup root: {0}'}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ConfigRuntimeRoot, StringFormat='Runtime root: {0}'}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="Editable on the Workspace page, which is the one authoritative place for these paths." Classes="muted" FontSize="11" TextWrapping="Wrap"/>

              <TextBlock Text="Launch arguments (one per line)" FontWeight="SemiBold" />
              <TextBox Text="{Binding ConfigLaunchArguments}" AcceptsReturn="True" MinHeight="110" />

              <TextBlock Text="Configuration is validated before writing and a rollback .bak is created. Changes apply after the MystTiq system service is restarted. Authentication/TLS security settings are displayed but are not weakened by this editor." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </Border>

          <Border Classes="card accentSystem" IsVisible="{Binding !IsCreatingNewProfile}">
            <StackPanel Spacing="7">
              <TextBlock Text="Security" FontWeight="SemiBold" />
              <TextBlock Text="{Binding SecretPolicyText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock Text="HTTPS uses normal OS certificate validation unless an explicit SHA-256 certificate pin is configured." TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock Text="{Binding ProfileStorageText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
            </StackPanel>
          </Border>
        </StackPanel>
</StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- v0.7.13.0: dedicated wizard host, shown in place of the normal nav sidebar/ribbon/page
         content while a tab is mid-setup (IsCreatingNewProfile). Previously the whole "Set Up New
         Server" flow was embedded inside the Settings page's card stack, indistinguishable from
         regular app chrome and reachable/escapable via ordinary navigation. Modeled instead on how
         connection-manager apps (SSH/database/remote-desktop clients) keep "New Connection" a
         focused, separate sequence with its own steps, not a page among many. -->
    <Grid Grid.Row="3" ClipToBounds="True" IsVisible="{Binding IsCreatingNewProfile}">
      <Image Source="/Assets/dashboard-atmosphere-v3.png" Stretch="UniformToFill" Opacity="0.94"/>
      <Border Background="{DynamicResource Bg0ScrimBrush}"/>
      <!-- v0.7.79.0: same theme-color wash as the main Dashboard's own copy of this image. -->
      <Border Background="{DynamicResource BlueAccentBorderBrush}" Opacity="0.14"/>
      <ScrollViewer Margin="4,8,8,8">
        <!-- v0.7.64.0: widened 680 to 860. At 680, Step 2's field grid (already split into two
             columns) had to share space with a same-row Auto-width button column, leaving each
             field only about 180px; not enough for its own content (watermarks and typed values
             were clipping, not just wrapping). -->
        <StackPanel Margin="22" Spacing="20" MaxWidth="860" HorizontalAlignment="Center" VerticalAlignment="Center">

          <!-- v0.7.81.0: the old STEP 0 (Local/Remote choice cards) was removed. Direct live
               feedback ("it should not be trying to connect to a previously installed version as we
               already have an option to connect to a local server or remote server from the plus").
               Every "+"-menu entry point now resolves Local vs. Remote itself before ever reaching
               step 1 (ChooseLocalConnection/ChooseRemoteConnection called immediately in
               OpenNewServerTab/OpenConnectLocalServerTab/OpenConnectRemoteServerTab), so this
               screen had become dead, unreachable UI. -->

          <!-- STEP 1: CONNECTION DETAILS (Local or Remote sub-view, per which "+" entry was used) -->
          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStep1}">
            <StackPanel Spacing="12">
              <TextBlock Text="{Binding WizardStep1HeaderText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>

              <StackPanel IsVisible="{Binding IsLocalConnectionChoice}" Spacing="10">
                <TextBlock Text="{Binding WizardStep1InstructionText}" Classes="muted" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Classes="primary" Content="Auto-Detect Local Service" Command="{Binding DetectLocalServiceCommand}"/>
                  <TextBlock Text="{Binding Detail}" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                  <TextBlock Text="Name" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" Text="{Binding ProfileName}"/>
                  <TextBlock Grid.Row="1" Text="Service URL" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ServerUrl}" Watermark="http://127.0.0.1:8213"/>
                </Grid>
              </StackPanel>

              <StackPanel IsVisible="{Binding IsRemoteConnectionChoice}" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Scan Network" Command="{Binding DiscoverServicesCommand}"/>
                  <TextBlock Text="{Binding DiscoveryStateText}" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
                <ComboBox ItemsSource="{Binding DiscoveredServices}" SelectedItem="{Binding SelectedDiscoveredService}" MinWidth="400">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="services:DiscoveredMystTiqService">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                  <TextBlock Text="Name" VerticalAlignment="Center"/>
                  <TextBox Grid.Column="1" Text="{Binding ProfileName}"/>
                  <TextBlock Grid.Row="1" Text="Service URL" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ServerUrl}" Watermark="https://192.168.1.248:8213"/>
                  <TextBlock Grid.Row="2" Text="Bearer token" VerticalAlignment="Center"/>
                  <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding BearerToken}" PasswordChar="●" RevealPassword="{Binding ShowBearerToken}" Watermark="Saved encrypted after connecting"/>
                    <ToggleButton Grid.Column="1" IsChecked="{Binding ShowBearerToken}" Content="{Binding ShowBearerToken, Converter={x:Static converters:BoolToEyeGlyphConverter.Instance}}" ToolTip.Tip="Show/hide the bearer token" Padding="8,4"/>
                    <Button Grid.Column="2" Content="Forget" Command="{Binding ForgetSavedTokenCommand}" ToolTip.Tip="Remove the saved encrypted token for this profile (does not clear what's typed above)" Padding="8,4"/>
                  </Grid>
                  <TextBlock Grid.Row="3" Text="TLS SHA-256 pin" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CertificateSha256}" Watermark="Optional 64-hex certificate fingerprint"/>
                </Grid>
              </StackPanel>

              <!-- v0.7.81.0: "← Back" removed, since there's no earlier step to return to now that
                   step 0 is gone; this cancels the wizard (closes the tab) instead. -->
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Content="Cancel" Command="{Binding CloseActiveTabCommand}" ToolTip.Tip="Closes this tab. Disabled if it's the only open tab."/>
                <Button Grid.Column="1" Classes="primary" Content="Connect" Command="{Binding ConnectCommand}"/>
                <Button Grid.Column="2" Classes="success" Content="{Binding WizardStep1NextButtonLabel}" HorizontalAlignment="Right" Command="{Binding WizardAdvanceCommand}" IsEnabled="{Binding ManagementApiConnected}" ToolTip.Tip="Connect first, then continue."/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- v0.7.82.0: World Source choice, install-wizard only. Cards reordered to New World /
               Import / Clone to match direct feedback's own stated order. -->
          <StackPanel IsVisible="{Binding IsWizardStepWorldSource}" Spacing="18">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="Step 2 of 8 — World Source" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="How should this new server's world start out?" Classes="muted" HorizontalAlignment="Center"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
              <Button Classes="ghost" Padding="0" Command="{Binding ChooseNewWorldSourceCommand}">
                <Border Classes="card accentHome" Padding="20">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="🌱" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="Set Up a New World" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="Installs the Palworld dedicated server fresh and creates a brand-new default world." Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Button>
              <Button Grid.Column="1" Classes="ghost" Padding="0" Command="{Binding ChooseImportWorldSourceCommand}">
                <Border Classes="card accentWorld" Padding="20">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="Import a World" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="Installs fresh, then brings in a world archive from a backup or another server." Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Button>
              <Button Grid.Column="2" Classes="ghost" Padding="0" Command="{Binding ChooseCloneWorldSourceCommand}">
                <Border Classes="card accentMods" Padding="20">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="🧬" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="Clone an Existing Server" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="Copies an already-configured server's binaries, world, and settings into this new one, with ports offset automatically." Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Button>
            </Grid>
          </StackPanel>

          <!-- v0.7.82.0: Clone source picker, unchanged content from the old combined step 3, just
               its own gate/label changed (no longer paired with Install in the same step). -->
          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStepCloneSource}">
            <StackPanel Spacing="12">
              <TextBlock Text="Step 3 of 8 — Clone an Existing Server" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock Text="Pick a server you've already set up to copy from. It must be stopped first -- files can't be safely copied while PalServer has them open." Classes="muted" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                <TextBlock Text="Clone From" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding CloneableSourceProfiles}" SelectedItem="{Binding NewServerCloneSourceProfile}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ConnectionProfile">
                      <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="1" Text="New Server ID" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewServerCloneTargetId}" Watermark="e.g. world-2"/>
                <TextBlock Grid.Row="2" Text="Port Offset" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CloneWorldPortOffsetOptions}" SelectedItem="{Binding CloneWorldPortOffset}" HorizontalAlignment="Left" MinWidth="140"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Content="← Back" Command="{Binding WizardBackCommand}"/>
                <Button Grid.Column="1" Classes="success" Content="Clone Now" Command="{Binding CloneIntoNewServerCommand}"/>
              </Grid>
              <TextBlock Text="{Binding NewServerCloneStatusText}" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- v0.7.82.0: Identity & Ports, moved out of the old combined Settings step so it's
               collected right after World Source instead of after Install. The values are only
               staged here (Setup* fields); FinishInstallAndAdvanceCommand actually applies them
               (CreateDefaultServerSettingsAsync) once Install (step 6) has produced a real
               PalWorldSettings.ini to write into; that constraint is genuine, not arbitrary
               sequencing, see PalworldSettingsConfigurationService.CreateDefault. -->
          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStepIdentityPorts}">
            <StackPanel Spacing="10">
              <StackPanel>
                <TextBlock Text="Step 3 of 8 — Server Identity &amp; Ports" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>
                <TextBlock Text="These values are applied automatically right after Install (step 6) creates PalWorldSettings.ini -- nothing here is saved yet. This is the Palworld dedicated server's own name/settings -- separate from the Profile Name above, which only labels this MystTiq connection." Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                <StackPanel><TextBlock Text="Server Name" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox Text="{Binding SetupServerName, Mode=TwoWay}" MaxLength="128"/><Button Grid.Column="1" Content="🎲" Command="{Binding GenerateSetupServerNameCommand}" ToolTip.Tip="Generate a random server name" AutomationProperties.Name="Generate a random server name" Padding="10,7"/></Grid></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="Description" Classes="muted"/><TextBox Text="{Binding SetupServerDescription, Mode=TwoWay}" MaxLength="512"/></StackPanel>
                <StackPanel Grid.Row="1"><TextBlock Text="Admin Password" Classes="muted"/><TextBox Text="{Binding SetupAdminPassword, Mode=TwoWay}" PasswordChar="●" Watermark="Optional; sent only to the authenticated headless service"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Server Password (optional)" Classes="muted"/><TextBox Text="{Binding SetupServerPassword, Mode=TwoWay}" PasswordChar="●"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
                  <StackPanel><TextBlock Text="Players" Classes="muted"/><TextBox Text="{Binding SetupMaximumPlayers, Mode=TwoWay}" Width="72"/></StackPanel>
                  <!-- v0.7.88.0: direct live feedback. Game Port should draw attention and explain
                       when it needs to change, since the default is correct for the common
                       single-server case and only needs changing to avoid colliding with another
                       server already running on the same machine. -->
                  <Border Classes="statuscard accentSystem" Padding="8" BorderBrush="{DynamicResource AmberAccentBorderBrush}" BorderThickness="2">
                    <StackPanel><TextBlock Text="Game Port" Classes="muted"/><TextBox Text="{Binding SetupGamePort, Mode=TwoWay}" Width="82"/></StackPanel>
                  </Border>
                  <StackPanel><TextBlock Text="REST Port" Classes="muted"/><TextBox Text="{Binding SetupRestPort, Mode=TwoWay}" Width="82"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="2">
                  <TextBlock Text="Only change Game Port if you're running multiple Palworld servers on this same machine at the same time -- each needs its own port. Otherwise the default is fine." Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SetupGamePortWarningText}" IsVisible="{Binding HasSetupGamePortWarning}" Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SetupRestPortWarningText}" IsVisible="{Binding HasSetupRestPortWarning}" Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Content="← Back" Command="{Binding WizardBackCommand}"/>
                <Button Grid.Column="2" Classes="primary" Content="Next: World Settings →" HorizontalAlignment="Right" Command="{Binding WizardAdvanceCommand}"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- v0.7.82.0: World Settings choice. A preset applies automatically right after Install;
               "Customize" can't show real slider values before a real PalWorldSettings.ini exists, so
               it defers to the existing, fully-live Configuration page after Finish instead of faking
               pre-install values (see NewServerWorldSettingsChoice's own comment). -->
          <StackPanel IsVisible="{Binding IsWizardStepWorldSettingsChoice}" Spacing="18">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="Step 4 of 8 — World Settings" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="Apply a starter preset automatically after install, or customize your own once the server's real settings file exists." Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <Button Classes="ghost" Padding="0" Command="{Binding ChooseWorldSettingsPresetCommand}">
                <Border Classes="card accentBackups" Padding="20">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="Use a Starter Preset" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="Pick a preset (Vanilla, Quality of Life, etc.) below -- applied automatically right after install." Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Button>
              <Button Grid.Column="1" Classes="ghost" Padding="0" Command="{Binding ChooseWorldSettingsCustomizeCommand}">
                <Border Classes="card accentWorld" Padding="20">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="🎛️" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="Customize After Install" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="Finish setup with defaults, then fine-tune every World Setting on the Configuration page." Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Button>
            </Grid>
            <StackPanel IsVisible="{Binding IsWorldSettingsChoicePreset}" Spacing="6" HorizontalAlignment="Center">
              <TextBlock Text="Starter Preset" Classes="muted" FontSize="11" HorizontalAlignment="Center"/>
              <ComboBox ItemsSource="{Binding PalworldConfigPresets}" SelectedItem="{Binding SelectedConfigPreset}" MinWidth="240"/>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Button Content="← Back" Command="{Binding WizardBackCommand}"/>
            </Grid>
          </StackPanel>

          <!-- v0.7.82.0: Install Directory. See ContinueFromInstallDirectoryAsync's own comment for
               the full registration/restart/reconnect story. It always registers a new, genuinely
               distinct server profile now, since the "typical" default location is permanently owned
               by the always-present "Local MystTiq" profile (confirmed live: reusing it collided with
               BuildProfileFromEditor's own duplicate-connection guard). Only the target directory
               varies by occupancy, not whether registration happens. -->
          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStepInstallDirectory}">
            <StackPanel Spacing="12">
              <TextBlock Text="Step 5 of 8 — Install Directory" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock Text="{Binding NewServerInstallDirectoryStatusText}" Classes="muted" TextWrapping="Wrap"/>
              <!-- v0.7.88.0 bug fix: reported live. This step previously showed no field at all to
                   see or change the target directory, just the warning box below. -->
              <StackPanel Spacing="3">
                <TextBlock Text="Target directory" Classes="muted" FontSize="11"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding NewServerInstallDirectoryEffectivePath, Mode=TwoWay}" FontFamily="Consolas, monospace"/>
                  <Button Grid.Column="1" Content="Browse" Tag="installDirectory" Click="WorkspaceBrowse_Click"/>
                </Grid>
              </StackPanel>
              <Border Classes="statuscard accentSystem" BorderBrush="{DynamicResource AmberAccentBorderBrush}" BorderThickness="1">
                <TextBlock Text="Continuing registers this as a new server profile and restarts the local MystTiq service automatically to bring it online, then reconnects this wizard to it. Only available for local, non-Windows-Service MystTiq installs." Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
              </Border>
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Content="← Back" Command="{Binding WizardBackCommand}"/>
                <Button Grid.Column="1" Classes="success" Content="Continue →" Command="{Binding ContinueFromInstallDirectoryCommand}"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- v0.7.82.0: Download &amp; Install, moved from the old combined step 3. Content is
               unchanged, only its own gate/label/step-count and final button changed (now finishes
               into the auto-apply step instead of the old Settings step). -->
          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStepInstall}">
            <StackPanel Spacing="12">
              <TextBlock Text="Step 6 of 8 — Install Palworld Dedicated Server" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock Text="Downloads and installs the Palworld dedicated server via SteamCMD (also installs SteamCMD itself if it's missing). Safe to run again later -- it validates rather than reinstalling if the files already exist." Classes="muted" TextWrapping="Wrap"/>
              <!-- v0.7.85.0: real inline world import, not a placeholder anymore. PalServer.exe
                   generates its own real initial world within a few minutes of its first start
                   (confirmed live), so this starts the server once, stops it, then embeds the
                   already-existing World Transactions "world-import" Analyze/Apply flow to replace
                   that placeholder world, the same bindings the World Transactions page itself uses. -->
              <StackPanel IsVisible="{Binding IsWorldSourceImport}" Spacing="10">
                <Border Classes="statuscard accentWorld">
                  <StackPanel Spacing="8">
                    <TextBlock Text="Import Your World" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding NewServerImportPrepareStatusText}" Classes="muted" TextWrapping="Wrap"/>
                    <Button Classes="primary" Content="Prepare for Import" Command="{Binding PrepareForWorldImportCommand}" HorizontalAlignment="Left" IsVisible="{Binding !NewServerImportReady}"/>
                    <StackPanel IsVisible="{Binding NewServerImportReady}" Spacing="8">
                      <Grid ColumnDefinitions="190,Auto,*" ColumnSpacing="10">
                        <ComboBox ItemsSource="{Binding WorldTransactionModes}" SelectedItem="{Binding WorldTransactionMode}"/>
                        <Button Grid.Column="1" Content="Analyze ZIP Archive" Click="AnalyzeWorldArchive_Click"/>
                        <TextBlock Grid.Column="2" Text="{Binding WorldTransactionState}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      </Grid>
                      <Border Classes="statuscard accentWorld"><StackPanel Spacing="6"><TextBlock Text="Transaction Plan" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding WorldTransactionPlanSteps}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                      <CheckBox Content="I reviewed this plan and confirm the server is stopped." IsChecked="{Binding WorldTransactionConfirmed}"/>
                      <Button Classes="danger" Content="Apply With Fresh Safety Backup" HorizontalAlignment="Left" Command="{Binding ApplyWorldTransactionCommand}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
              <!-- v0.7.89.0 bug fix: reported live. The checklist below used to keep showing the
                   pre-install "MISSING" row after a successful install, requiring a manual Refresh
                   click. Now wired to a command that auto-refreshes the checklist right after
                   install completes; direct live feedback also asked for more visibility into what
                   the install is actually doing, so SteamCMD's own captured output tail is now shown
                   here too, not just a flat state word. -->
              <!-- v0.7.90.0: direct live feedback. "option to install just the server without
                   mods and then the option of installing it with the extras." The second button
                   chains in UE4SS (the only checklist item that both has a real install path today
                   and isn't behind "BACKEND REQUIRED"), auto-picking the newest stable Palworld Fork
                   release instead of the UE4SS page's own manual Preview/Confirm picker: an explicit
                   tradeoff of that review step for one-click convenience, only taken when this
                   button is deliberately chosen over the plain install. -->
              <WrapPanel>
                <Button Classes="success" Content="Install Palworld Dedicated Server" Command="{Binding InstallPalworldServerFromWizardCommand}" Margin="0,0,6,6"/>
                <Button Classes="success" Content="Install with Extras (+ UE4SS)" Command="{Binding InstallPalworldServerWithExtrasCommand}" Margin="0,0,6,6" ToolTip.Tip="Installs the server, then automatically installs the newest stable UE4SS release. Palworld Save Tools and PIM/Oodle Decoder have no install capability anywhere in the app yet."/>
                <TextBlock Text="{Binding DistributionState}" VerticalAlignment="Center" Classes="muted"/>
              </WrapPanel>
              <TextBlock Text="{Binding DistributionDetail}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding Ue4ssInstallState}" Classes="muted" TextWrapping="Wrap"/>
              <TextBox Text="{Binding DistributionOutputText}" IsVisible="{Binding HasDistributionOutput}" AcceptsReturn="True" IsReadOnly="True" MaxHeight="140" FontFamily="Consolas, monospace" FontSize="11"/>

              <!-- v0.7.81.0: read-only environment checklist, direct follow-up request ("it should
                   start a new server installation, like folder paths, steamcmd server, dependencies,
                   UE4SS, etc."). Reuses EnvironmentItems/RefreshEnvironmentCommand unchanged (the
                   exact same data the Server Setup page's own checklist shows), auto-loaded on
                   arrival here (ContinueFromInstallDirectoryAsync). Deliberately read-only here, no
                   per-row Verify/Manage buttons, since several of those navigate to other pages
                   (Configuration/UE4SS/Update Center), which the wizard's full-screen overlay hides
                   while IsCreatingNewProfile is true; those actions stay reachable from the real
                   Server Setup page after finishing setup. -->
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="SERVER ENVIRONMENT" FontSize="13" FontWeight="Bold"/>
                <Button Grid.Column="1" Content="↻ Refresh" Command="{Binding RefreshEnvironmentCommand}" Padding="8,3" FontSize="11"/>
              </Grid>
              <Border Classes="card accentServer" Padding="0" ClipToBounds="True" MaxHeight="260">
                <Grid RowDefinitions="Auto,*">
                  <Grid Background="{DynamicResource Bg2Brush}" ColumnDefinitions="150,95,2*,2.35*" Height="32">
                    <TextBlock Text="COMPONENT" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="STATUS" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Grid.Column="2" Text="LOCATION" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Grid.Column="3" Text="DETAILS" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                  </Grid>
                  <ScrollViewer Grid.Row="1" MaxHeight="228" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding EnvironmentItems}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:EnvironmentChecklistItemDto">
                          <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="2">
                            <Grid ColumnDefinitions="150,95,2*,2.35*" MinHeight="34">
                              <TextBlock Text="{Binding Component}" Margin="10,0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"/>
                              <Grid Grid.Column="1" Margin="8,4">
                                <Border Background="{DynamicResource SuccessGlassGradient}" BorderBrush="{DynamicResource GreenAccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Stretch" IsVisible="{Binding IsReady}"><TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="9" FontWeight="Bold"/></Border>
                                <Border Background="{DynamicResource WarningGlassGradient}" BorderBrush="{DynamicResource AmberAccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Stretch" IsVisible="{Binding IsDisabled}"><TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="9" FontWeight="Bold"/></Border>
                                <Border Background="{DynamicResource DangerGlassGradient}" BorderBrush="{DynamicResource RedAccentBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="6,2" HorizontalAlignment="Stretch" IsVisible="{Binding IsMissing}"><TextBlock Text="{Binding Status}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="9" FontWeight="Bold"/></Border>
                              </Grid>
                              <TextBlock Grid.Column="2" Text="{Binding Location}" Margin="10,0" VerticalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Location}"/>
                              <TextBlock Grid.Column="3" Text="{Binding Details}" Margin="10,0" VerticalAlignment="Center" FontSize="10" TextWrapping="Wrap" MaxHeight="30"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>

              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Content="← Back" Command="{Binding WizardBackCommand}"/>
                <Button Grid.Column="2" Classes="primary" Content="Next: MODs →" HorizontalAlignment="Right" Command="{Binding FinishInstallAndAdvanceCommand}" ToolTip.Tip="Installing is optional here if the files already exist at this location. Applies Identity &amp; Ports and any chosen preset automatically."/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- v0.7.86.0: MODs step, install-wizard only, New World/Import only. Reuses the exact same
               Workshop-scan machinery already built for the MOD Library page
               (ScanWorkshopModsCommand/WorkshopItems/ImportSelectedWorkshopModCommand), verbatim.
               Both already correctly resolved the in-progress wizard connection, so no fix was needed
               here (unlike a couple of other reused commands found this session). Entirely optional:
               Next advances whether or not anything was imported. -->
          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStepMods}">
            <StackPanel Spacing="12">
              <TextBlock Text="Step 7 of 8 — MODs" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock Text="Optional. Scans locally installed Steam Workshop content for Palworld and imports any you pick before finishing setup. You can always add more later from MOD Library." Classes="muted" TextWrapping="Wrap"/>
              <WrapPanel>
                <Button Content="↻ Scan Workshop Mods" Command="{Binding ScanWorkshopModsCommand}" Margin="0,0,6,6"/>
                <Button Classes="primary" Content="Import Selected" Command="{Binding ImportSelectedWorkshopModCommand}" Margin="0,0,6,6"/>
                <!-- v0.7.89.0: direct live feedback. A distinctly-colored button (green, matching
                     the other install-type actions in this wizard) for installing a MOD from a local
                     ZIP file directly, separate from the Workshop scan/import flow above. Reuses
                     InstallModZip_Click verbatim, the exact same picker plus InstallModZipAsync path
                     the MOD Library page's own "Choose ZIP and Install" button already uses. ZIP
                     only, same as MOD Library: a bare .pak file has no install path anywhere in this
                     app today and would need its own separate backend capability, not just wiring up
                     a button. -->
                <Button Classes="success" Content="📦 Install MOD ZIP…" Click="InstallModZip_Click" Margin="0,0,6,6"/>
              </WrapPanel>
              <TextBlock Text="{Binding WorkshopScanState}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
              <ListBox ItemsSource="{Binding WorkshopItems}" SelectedItem="{Binding SelectedWorkshopItem}" MaxHeight="300">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:WorkshopItemDto">
                    <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="8" Margin="0,6">
                      <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding WorkshopId}" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas, monospace"/></StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding SuggestedPackage}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"/>
                      <Border Grid.Column="2" Classes="badge" VerticalAlignment="Center"><TextBlock Text="{Binding StatusText}" HorizontalAlignment="Center"/></Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Content="← Back" Command="{Binding WizardBackCommand}"/>
                <Button Grid.Column="2" Classes="primary" Content="Next: Confirm &amp; Finish →" HorizontalAlignment="Right" Command="{Binding WizardAdvanceCommand}"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStepSettings}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="10">
                <StackPanel>
                  <TextBlock Text="{Binding WizardStepSettingsLabel}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/>
                  <TextBlock Text="Once connected, create PalWorldSettings.ini from the server's official default file. Existing active settings are never overwritten. This is the Palworld dedicated server's own name/settings -- separate from the Profile Name above, which only labels this MystTiq connection." Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                  <StackPanel><TextBlock Text="Server Name" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox Text="{Binding SetupServerName, Mode=TwoWay}" MaxLength="128"/><Button Grid.Column="1" Content="🎲" Command="{Binding GenerateSetupServerNameCommand}" ToolTip.Tip="Generate a random server name" AutomationProperties.Name="Generate a random server name" Padding="10,7"/></Grid></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="Description" Classes="muted"/><TextBox Text="{Binding SetupServerDescription, Mode=TwoWay}" MaxLength="512"/></StackPanel>
                  <StackPanel Grid.Row="1"><TextBlock Text="Admin Password" Classes="muted"/><TextBox Text="{Binding SetupAdminPassword, Mode=TwoWay}" PasswordChar="●" Watermark="Optional; sent only to the authenticated headless service"/></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="Server Password (optional)" Classes="muted"/><TextBox Text="{Binding SetupServerPassword, Mode=TwoWay}" PasswordChar="●"/></StackPanel>
                  <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
                    <StackPanel><TextBlock Text="Players" Classes="muted"/><TextBox Text="{Binding SetupMaximumPlayers, Mode=TwoWay}" Width="72"/></StackPanel>
                    <StackPanel><TextBlock Text="Game Port" Classes="muted"/><TextBox Text="{Binding SetupGamePort, Mode=TwoWay}" Width="82"/></StackPanel>
                    <StackPanel><TextBlock Text="REST Port" Classes="muted"/><TextBox Text="{Binding SetupRestPort, Mode=TwoWay}" Width="82"/></StackPanel>
                  </StackPanel>
                  <!-- v0.7.64.0: moved to its own full-width row; crammed into the Players/Game
                       Port/REST Port row above, its label routinely clipped ("I confirm creation
                       o..."). -->
                  <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="I confirm creation of a new settings file" IsChecked="{Binding SetupCreateConfirmed, Mode=TwoWay}"/>
                  <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="2">
                    <TextBlock Text="{Binding SetupGamePortWarningText}" IsVisible="{Binding HasSetupGamePortWarning}" Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding SetupRestPortWarningText}" IsVisible="{Binding HasSetupRestPortWarning}" Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
                  <!-- v0.7.81.0: starter preset picker, direct request ("choose one of the preset
                       settings like vanilla or quality of life"). Reuses the exact same preset list
                       (PalworldConfigPresets/SelectedConfigPreset, Official/Balanced/Relaxed/custom)
                       already built for the Configuration page, chained through Load -> Apply -> Save
                       in one action (ApplyStarterPresetCommand). Only meaningful after Create Default
                       Settings has created the file this loads/overwrites. -->
                  <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Spacing="4">
                    <TextBlock Text="Starter Preset (optional, applied after Create Default Settings above)" Classes="muted" FontSize="11"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <ComboBox ItemsSource="{Binding PalworldConfigPresets}" SelectedItem="{Binding SelectedConfigPreset}"/>
                      <Button Grid.Column="1" Content="Apply Preset" Command="{Binding ApplyStarterPresetCommand}"/>
                    </Grid>
                  </StackPanel>
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <Button Classes="success" Content="+ CREATE DEFAULT SETTINGS" FontWeight="Bold" Command="{Binding CreateDefaultServerSettingsCommand}" Padding="18,12" ToolTip.Tip="Requires confirmation. The headless service validates the values and refuses to overwrite an existing PalWorldSettings.ini. Connect first -- this writes to the server you just connected to."/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Content="← Back" Command="{Binding WizardBackCommand}"/>
                  <Button Grid.Column="1" Classes="primary" Content="Next →" Command="{Binding WizardAdvanceCommand}" ToolTip.Tip="Creating default settings here is optional -- skip ahead if this server already has its own PalWorldSettings.ini."/>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <!-- v0.7.3.0 wizard's confirm/finish step, additive only. Save Profile/Delete Profile
               remain exactly where they always were in the editing card for editing an existing
               profile; this is just a second, wizard-scoped path to the same SaveProfileCommand for
               a brand-new profile's natural "last step." -->
          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStepConfirm}">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding WizardStepConfirmLabel}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/>
              <Border Classes="statuscard accentSystem">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding ProfileName, StringFormat='Server: {0}'}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding ServerUrl, StringFormat='Address: {0}'}" Classes="muted"/>
                  <TextBlock Text="{Binding ConnectionState, StringFormat='Connection: {0}'}" Classes="muted"/>
                </StackPanel>
              </Border>
              <TextBlock Text="Save this profile to add it to your server list. You can always come back and finish the in-game defaults later from Settings." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !IsNewServerSetupFlow}"/>
              <!-- v0.7.82.0: install wizard's own Confirm messaging. Identity &amp; Ports and any
                   chosen preset were already applied automatically by FinishInstallAndAdvanceCommand
                   (Clone needs none of this, it already has both). "Customize" points to the
                   Configuration page rather than embedding a duplicate live settings editor here. -->
              <StackPanel IsVisible="{Binding IsNewServerSetupFlow}" Spacing="4">
                <TextBlock Text="Server identity, description, and ports were applied automatically after install." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !IsWorldSourceClone}"/>
                <TextBlock Text="{Binding SetupOperationDetail}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !IsWorldSourceClone}"/>
                <TextBlock Text="Your chosen starter preset was applied automatically." Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsWorldSettingsChoicePreset}"/>
                <TextBlock Text="Customize World Settings any time from Server → Configuration on this server." Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" IsVisible="{Binding IsWorldSettingsChoiceCustomize}"/>
                <TextBlock Text="Save this profile to add it to your server list." Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
              <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                <Button Content="← Back" Command="{Binding WizardBackCommand}"/>
                <Button Grid.Column="1" Classes="success" Content="Save Profile" FontWeight="Bold" Command="{Binding SaveProfileCommand}"/>
              </Grid>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- v0.7.43.0: findings-completeness fix (item 6). Elapsed time next to the busy reason,
         updated live while IsBusy (MainWindowViewModel.BusyElapsedText/_busyElapsedTimer). The
         reason text itself (StatusBarText) already includes which server the operation belongs to
         when known, set alongside BusyReason in RaiseIsBusyDependents. Real sub-step/percent
         progress stays a disclosed gap, not attempted here (see the property's own comment). -->
    <!-- v0.7.74.0: top border now follows ActiveTab.AccentBrush too, matching the title-bar strip,
         page-header border, and nav pane border; a consistent identity color framing the window
         on every edge, not just the top. -->
    <Border Grid.Row="4" Background="{DynamicResource StatusSurfaceGradient}" BorderBrush="{Binding ActiveTabAccentBrush}" BorderThickness="0,1,0,0" Padding="14,7">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
        <ProgressBar Width="84" Height="5" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{Binding StatusBarText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{Binding BusyElapsedText}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" ToolTip.Tip="Elapsed time since this operation started."/>
        <TextBlock Grid.Column="3" Text="{Binding StatusBarObservedText}" Classes="muted" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
