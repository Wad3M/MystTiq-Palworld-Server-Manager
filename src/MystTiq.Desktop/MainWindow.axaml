<!-- MystTiq v1.0.6.0: file reviewed for this release (2026-10-06). -->
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MystTiq.Desktop.ViewModels"
        xmlns:models="using:MystTiq.Desktop.Models"
        xmlns:services="using:MystTiq.Desktop.Services"
        xmlns:controls="using:MystTiq.Desktop.Controls"
        xmlns:converters="using:MystTiq.Desktop.Converters"
        x:Class="MystTiq.Desktop.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{services:Tr ui.mysttiq_palworld_server_manager}"
        Width="1440" Height="880" MinWidth="950" MinHeight="650"
        WindowDecorations="None" ExtendClientAreaToDecorationsHint="True"
        WindowStartupLocation="CenterScreen" SizeChanged="Window_OnSizeChanged"
        Icon="/Assets/PalworldServerManager.ico">
  <Grid RowDefinitions="66,42,Auto,*,44">
    <!-- v0.7.63.0: per-tab identity color (item 2, v0.7.52.0) previously only showed as a small
         dot in the tab strip; reported as too subtle to tell at a glance which server is active.
         This bottom border is the same ActiveTab.AccentBrush already used for that dot, now also
         drawn as a persistent 3px strip under the title bar, visible above every page regardless
         of scroll position. See also the page-header Border's BorderBrush below, tinted the same
         way, for a second, larger reinforcement of the same signal. -->
    <Border Grid.Row="0" Background="{DynamicResource StatusSurfaceGradient}" BorderBrush="{Binding ActiveTabAccentBrush}" BorderThickness="0,0,0,3" PointerPressed="TitleBar_OnPointerPressed">
      <!-- v0.9.8.0: the brand column was a fixed 430 px; at the minimum window width that left the tab strip about 70 px,
           not even one tab, and the "+" was pushed off (reported). Below 1200 px it narrows to the logo and wordmark. -->
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Grid Grid.Column="0" Margin="14,7,10,7" ColumnDefinitions="52,Auto,Auto" MinWidth="{Binding BrandMinWidth}">
          <Border Classes="appIcon" Width="48" Height="48"><Image Source="/Assets/PalworldServerManager.png" Stretch="UniformToFill"/></Border>
          <StackPanel Grid.Column="1" Margin="10,1,0,0" VerticalAlignment="Center" Spacing="1">
            <Image Source="/Assets/mysttiq-wordmark-v5.png" Width="145" Height="27" HorizontalAlignment="Left" Stretch="Uniform"/>
            <TextBlock Classes="brandVersion" Text="{services:TrText Version}"/>
          </StackPanel>
          <TextBlock Grid.Column="2" Text="{services:Tr ui.palworld_server_manager}" Foreground="{DynamicResource MutedBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="14,1,0,0" IsVisible="{Binding ShowBrandSubtitle}"/>
        </Grid>
        <!-- v0.7.16.0: was hardcoded MaxWidth="720" regardless of actual available window width,
             and tabs past whatever fit were silently clipped with no way to reach them. Now sized
             from TabStripHost_OnSizeChanged (code-behind) via MainWindowViewModel.UpdateTabStripWidth,
             which splits Tabs into VisibleTabs/OverflowTabs: the ListBox below only ever shows
             VisibleTabs, and the chevron button after it opens a flyout for the rest. -->
        <!-- v0.9.8.0: the tabs, the "»" and the "+" were one clipped horizontal panel, so whatever did not fit was cut at its
             right edge, the "+" first. The tabs are now capped at the width left after the two buttons (TabListMaxWidth) and clipped there,
             so the "»" and "+" always follow them inside the strip. -->
        <Grid x:Name="TabStripHost" Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto,*" ClipToBounds="True" SizeChanged="TabStripHost_OnSizeChanged">
        <ListBox Grid.Column="0" HorizontalAlignment="Left" ClipToBounds="True" MaxWidth="{Binding TabListMaxWidth}" AutomationProperties.Name="{services:Tr ui.a11y_server_tabs}" ItemsSource="{Binding VisibleTabs}" SelectedItem="{Binding ActiveTab}" Background="Transparent" BorderThickness="0" Margin="0,6">
          <ListBox.Styles>
            <Style Selector="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CornerRadius" Value="6"/></Style>
            <Style Selector="ListBoxItem:nth-child(2n)"><Setter Property="Background" Value="Transparent"/></Style>
            <Style Selector="ListBoxItem:pointerover"><Setter Property="Background" Value="Transparent"/></Style>
            <Style Selector="ListBoxItem:selected"><Setter Property="Background" Value="Transparent"/></Style>
            <Style Selector="ListBoxItem:selected Border.serverTabSurface"><Setter Property="Background" Value="{DynamicResource ServerTabActiveGradient}"/><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_62D8FF}"/><Setter Property="BorderThickness" Value="1,1,1,3"/><Setter Property="BoxShadow" Value="{DynamicResource DecoShadow_21}"/></Style>
          </ListBox.Styles>
          <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:TabSession">
              <!-- v0.7.74.0: BorderBrush bound directly here (this DataTemplate's x:DataType is the
                   TabSession itself, unlike the ListBox.Styles selector above which can't reliably
                   data-bind against the item). A local binding takes precedence over the
                   ":selected Border.serverTabSurface" style Setter's own BorderBrush, so every tab,
                   selected or not, now shows its own identity color as its border, while that
                   style's other selected-state properties (Background, thicker bottom edge,
                   BoxShadow glow) are untouched and still apply normally when selected. -->
              <Border Classes="serverTabSurface" BorderBrush="{Binding AccentBrush}" MinWidth="200" Margin="2,0" Padding="12,7">
                <!-- v0.7.52.0: Per-Tab Color Coding, item 2. A per-server identity stripe (column
                     0), independent from the status dot (column 1, a live health signal). The
                     selected-tab highlight's border also now follows this same identity color as
                     of v0.7.74.0 (see the Border above); its Background/BoxShadow glow stay a fixed
                     app-wide look regardless of tab, so the three signals stay visually distinct
                     rather than merging into one. -->
                <Grid ColumnDefinitions="4,10,*,Auto" RowDefinitions="Auto,Auto">
                  <Rectangle Grid.RowSpan="2" Width="3" Height="22" RadiusX="1.5" RadiusY="1.5" Fill="{Binding AccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                  <Ellipse Grid.Column="1" Grid.RowSpan="2" Width="8" Height="8" Fill="{Binding StatusDotColorKey, Converter={x:Static converters:SemanticStatusColorConverter.Instance}}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" FontWeight="SemiBold" FontSize="12" Text="{Binding ProfileName}" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Row="1" Grid.Column="2" Foreground="{DynamicResource BlueBrush}" Text="{services:TrText ConnectionKindText}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                  <!-- v0.7.11.0: Click + Tag instead of Command/CommandParameter, since closing a
                       running server's tab now needs to show a confirmation dialog first (see
                       CloseTabButton_OnClick), which a plain ICommand can't do without either
                       giving the ViewModel a reference to a View or a more elaborate
                       request/response event, neither of which fits this codebase's existing
                       pattern of code-behind handling anything that needs a native window/dialog. -->
                  <!-- v0.7.14.0: was 20x20; Fluent's minimum recommended pointer target is ~32-40px,
                       and this sat inside a dense horizontal tab strip where mis-clicks were likely
                       once several servers were open. Bumped to 28x28, the smallest step that
                       materially helps without the tab row growing too tall. -->
                  <Button Grid.RowSpan="2" Grid.Column="3" Classes="ghost" Width="28" Height="28" Padding="0" Margin="6,0,0,0"
                          Click="CloseTabButton_OnClick" Tag="{Binding}"
                          ToolTip.Tip="{services:Tr ui.close_tab}" AutomationProperties.Name="{services:Tr ui.close_tab}">
                    <PathIcon Width="9" Height="9" Data="M0.7,0 L5,4.3 L9.3,0 L10,0.7 L5.7,5 L10,9.3 L9.3,10 L5,5.7 L0.7,10 L0,9.3 L4.3,5 L0,0.7 Z"/>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <!-- v0.7.16.0: appears only once VisibleTabs no longer holds every open tab. Opens a flyout
             listing the hidden ones (click to switch) plus "Set Up New Server", the same entry the
             "+" button's own flyout offers, so creating a new tab is reachable from here too without
             needing to first free up strip space. -->
        <Button x:Name="TabOverflowButton" Grid.Column="1" Width="36" Height="44" Margin="2,10" Padding="0" Classes="ghost"
                IsVisible="{Binding HasOverflowTabs}" Click="TabOverflowButton_OnClick"
                ToolTip.Tip="{services:Tr ui.show_hidden_tabs}" AutomationProperties.Name="{services:Tr ui.show_hidden_tabs}">
          <TextBlock FontSize="16" Text="»" Foreground="{DynamicResource TextBrush}"/>
        </Button>
        <Button x:Name="AddTabButton" Grid.Column="2" Width="44" Height="44" Margin="4,10" Classes="ghost"
                Click="AddTabButton_OnClick" ToolTip.Tip="{services:Tr ui.open_a_new_tab}" AutomationProperties.Name="{services:Tr ui.open_a_new_tab}">
          <Path Data="{StaticResource IconAddTab}" Fill="{DynamicResource TextBrush}" Width="20" Height="20" Stretch="Uniform"/>
        </Button>
        </Grid>
        <!-- v0.7.14.0: window-chrome buttons had ToolTip coverage everywhere else in the app except
             here (Minimize/Maximize/Close had none), and none of these six icon-only buttons had an
             AutomationProperties.Name: a ToolTip.Tip is not exposed as the accessible name to
             screen readers, so without this these were silent to Narrator/NVDA/UIA. -->
        <!-- v0.9.0.0: the notifications button is a bell (it was a dot). v0.8.22.0: the window controls, settings and tab close icons are drawn (PathIcon), not taken from the
             Segoe Fluent Icons font: Linux and Windows 10 do not have it, and showed empty boxes (found by the Desktop's
             first run on Linux). -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,6,0">
          <Button Classes="ghost" Width="42" Height="38" Padding="0" Command="{Binding NavigateCommand}" CommandParameter="Notifications" ToolTip.Tip="{services:Tr ui.open_notifications}" AutomationProperties.Name="{services:Tr ui.open_notifications}"><PathIcon Width="16" Height="16" Data="M10,1.5 C10.7,1.5 11.2,2 11.2,2.7 L11.2,3.2 C13.9,3.8 15.6,6 15.6,8.8 L15.6,12.6 L17.4,14.8 L17.4,15.8 L2.6,15.8 L2.6,14.8 L4.4,12.6 L4.4,8.8 C4.4,6 6.1,3.8 8.8,3.2 L8.8,2.7 C8.8,2 9.3,1.5 10,1.5 Z M7.8,16.8 L12.2,16.8 C12.2,18 11.2,18.9 10,18.9 C8.8,18.9 7.8,18 7.8,16.8 Z"/></Button>
          <Button Classes="ghost" Width="42" Height="38" Padding="0" Command="{Binding NavigateCommand}" CommandParameter="Settings" ToolTip.Tip="{services:Tr ui.open_settings}" AutomationProperties.Name="{services:Tr ui.open_settings}"><PathIcon Width="16" Height="16" Data="M17.39,8.23 L19.91,8.67 19.91,11.33 17.39,11.77 17.02,12.91 16.48,13.97 17.95,16.07 16.07,17.95 13.97,16.48 12.91,17.02 11.77,17.39 11.33,19.91 8.67,19.91 8.23,17.39 7.09,17.02 6.03,16.48 3.93,17.95 2.05,16.07 3.52,13.97 2.98,12.91 2.61,11.77 0.09,11.33 0.09,8.67 2.61,8.23 2.98,7.09 3.52,6.03 2.05,3.93 3.93,2.05 6.03,3.52 7.09,2.98 8.23,2.61 8.67,0.09 11.33,0.09 11.77,2.61 12.91,2.98 13.97,3.52 16.07,2.05 17.95,3.93 16.48,6.03 17.02,7.09 Z M14.3,10 A4.3,4.3 0 1 0 5.7,10 A4.3,4.3 0 1 0 14.3,10 Z"/></Button>
          <!-- v0.9.0.0 (user, 2026-09-27): the display language, next to Settings, so it can be changed from any page (the
               same choice as Settings > Language). -->
          <ComboBox x:Name="TitleLanguagePicker" Width="150" Height="32" Margin="4,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding UiLanguages}" SelectedItem="{Binding SelectedUiLanguage}" ToolTip.Tip="{services:Tr settings.language.label}" AutomationProperties.Name="{services:Tr settings.language.label}"/>
          <Border Width="1" Height="24" Background="{DynamicResource BorderBrush}" Margin="7,0"/>
          <Button Classes="ghost" Width="42" Height="38" Click="Minimize_OnClick" ToolTip.Tip="{services:Tr ui.minimize}" AutomationProperties.Name="{services:Tr ui.minimize}"><PathIcon Width="10" Height="10" Data="M0,4.5 H10 V5.5 H0 Z"/></Button>
          <Button Classes="ghost" Width="42" Height="38" Padding="0" Click="Maximize_OnClick" ToolTip.Tip="{services:Tr ui.maximize}" AutomationProperties.Name="{services:Tr ui.maximize}"><PathIcon x:Name="MaximizeGlyph" Width="10" Height="10" Data="M0,0 H10 V10 H0 Z M1,1 V9 H9 V1 Z"/></Button>
          <Button Classes="ghost" Width="42" Height="38" Click="Close_OnClick" ToolTip.Tip="{services:Tr ui.close}" AutomationProperties.Name="{services:Tr ui.close_window}"><PathIcon Width="10" Height="10" Data="M0.7,0 L5,4.3 L9.3,0 L10,0.7 L5.7,5 L10,9.3 L9.3,10 L5,5.7 L0.7,10 L0,9.3 L4.3,5 L0,0.7 Z"/></Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- v0.7.77.0: BorderBrush/BoxShadow now follow the active tab's identity color, matching the
         page-header/nav-pane/footer elsewhere on this same row band. -->
    <Border Grid.Row="1" Grid.RowSpan="2" Margin="8,4" CornerRadius="8" Background="{DynamicResource CommandSurfaceGradient}" BorderBrush="{Binding ActiveTabAccentBrush}" BorderThickness="1" BoxShadow="{Binding ActiveTabAccentGlowShadow}" ClipToBounds="True" IsVisible="{Binding !IsCreatingNewProfile}"/>
    <!-- v0.7.13.0: hidden while a tab is mid-setup (IsCreatingNewProfile): category tabs, ribbon,
         and nav sidebar have no meaning for a connection that doesn't exist yet, matching how
         comparable apps keep a "new connection" flow a focused, separate sequence rather than the
         regular chrome with some buttons disabled. -->
    <Border x:Name="CategoryBar" Grid.Row="1" Margin="9,5,9,0" Background="Transparent" IsVisible="{Binding !IsCreatingNewProfile}">
      <StackPanel Orientation="Horizontal" Margin="16,0,0,0">
        <ToggleButton Classes="categoryTab home" IsChecked="{Binding IsV5HomeCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"><Border Classes="categoryTabGlow"><TextBlock Text="{services:Tr category.home}"/></Border></ToggleButton>
        <ToggleButton Classes="categoryTab server" IsChecked="{Binding IsV5ServerCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="ServerSetup"><Border Classes="categoryTabGlow"><TextBlock Text="{services:Tr category.server}"/></Border></ToggleButton>
        <ToggleButton Classes="categoryTab world" IsChecked="{Binding IsV5WorldCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Inspector"><Border Classes="categoryTabGlow"><TextBlock Text="{services:Tr category.world}"/></Border></ToggleButton>
        <ToggleButton Classes="categoryTab backups" IsChecked="{Binding IsV5BackupsCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Backups"><Border Classes="categoryTabGlow"><TextBlock Text="{services:Tr category.backups}"/></Border></ToggleButton>
        <ToggleButton Classes="categoryTab mods" IsChecked="{Binding IsV5ModsCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="ModDashboard"><Border Classes="categoryTabGlow"><TextBlock Text="{services:Tr category.mods}"/></Border></ToggleButton>
        <ToggleButton Classes="categoryTab tools" IsChecked="{Binding IsV5ToolsCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="UpdateCenter"><Border Classes="categoryTabGlow"><TextBlock Text="{services:Tr category.tools}"/></Border></ToggleButton>
        <!-- v0.8.17.0: the HOST tab (the machine a server runs on, and its priority and eco mode). -->
        <ToggleButton Classes="categoryTab host" IsChecked="{Binding IsV5HostCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Host"><Border Classes="categoryTabGlow"><TextBlock Text="{services:Tr category.host}"/></Border></ToggleButton>
        <ToggleButton Classes="categoryTab system" IsChecked="{Binding IsV5SystemCategory, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Settings"><Border Classes="categoryTabGlow"><TextBlock Text="{services:Tr category.system}"/></Border></ToggleButton>
      </StackPanel>
    </Border>

    <!-- Reserve header space in layout, so art never covers categories or ribbon commands. -->
    <Grid Grid.Row="2" ColumnDefinitions="*,478" IsVisible="{Binding !IsCreatingNewProfile}">
    <Border Grid.Column="0" Margin="9,0,9,5" Background="Transparent" Padding="10,7,10,6" ClipToBounds="True" IsVisible="{Binding !IsCreatingNewProfile}">
      <!-- v0.7.25.0: ribbon groups/buttons are now data-bound (RibbonGroupViewModel/RibbonActionViewModel,
           MainWindowViewModel.VisibleRibbonGroups) instead of hand-authored per group, so the ribbon can
           shrink to fit. RibbonHost_OnSizeChanged feeds the measured width to
           MainWindowViewModel.UpdateRibbonWidth, which moves whichever trailing groups don't fit into
           OverflowRibbonGroups (reachable via the "»" button's flyout), the same way the tab strip's own
           VisibleTabs/OverflowTabs already work (v0.7.16.0). -->
      <StackPanel x:Name="RibbonHost" Orientation="Horizontal" SizeChanged="RibbonHost_OnSizeChanged">
        <ItemsControl ItemsSource="{Binding VisibleRibbonGroups}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:RibbonGroupViewModel">
              <Border Classes="ribbonGroup">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding Actions}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="5"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <!-- v0.7.14.0's accessibility fix carries forward: Content is a StackPanel (icon
                           glyph + label), not plain text, so AutomationProperties.Name is bound
                           explicitly rather than left to fall back to Content.ToString(). -->
                      <DataTemplate x:DataType="models:RibbonActionViewModel">
                        <Button Classes="ribbon" Classes.success="{Binding IsSuccessButton}" Classes.danger="{Binding IsDangerButton}"
                                Command="{Binding Command}" CommandParameter="{Binding CommandParameter}"
                                Click="RibbonAction_OnClick" AutomationProperties.Name="{Binding AutomationName}" IsEnabled="{Binding RoleAllowed}" ToolTip.Tip="{services:TrText ToolTipText}">
                          <StackPanel>
                            <Border Classes="iconTile">
                              <!-- v0.8.1.0: the user's vector Ribbon icons where one exists (RibbonIcons), in the same
                                   theme colour classes as the glyphs; every other button keeps its text glyph. -->
                              <Panel>
                                <!-- v0.8.8.0: the user's colour image icons fill the 34x34 tile (their own framed background). -->
                                <Image Classes="ribbonImage" Source="{Binding ImageIcon}" IsVisible="{Binding HasImageIcon}" Width="34" Height="34" Stretch="UniformToFill"/>
                                <Path Classes="ribbonIcon" Data="{Binding VectorIcon}" IsVisible="{Binding HasVectorIcon}"
                                      Classes.amber="{Binding IsAmberIcon}" Classes.green="{Binding IsGreenIcon}"
                                      Classes.blue="{Binding IsBlueIcon}" Classes.red="{Binding IsRedIcon}" Classes.cyan="{Binding IsCyanIcon}"/>
                                <TextBlock Classes="flatIcon" Text="{services:TrText Glyph}" IsVisible="{Binding ShowGlyph}"
                                           Classes.amber="{Binding IsAmberIcon}" Classes.green="{Binding IsGreenIcon}"
                                           Classes.blue="{Binding IsBlueIcon}" Classes.red="{Binding IsRedIcon}" Classes.cyan="{Binding IsCyanIcon}"/>
                              </Panel>
                            </Border>
                            <TextBlock Text="{services:TrText DisplayLabel}"/>
                          </StackPanel>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Classes="muted" FontSize="10" Text="{services:TrText DisplayTitle}" HorizontalAlignment="Center"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="RibbonOverflowButton" Width="36" Height="64" Margin="2,0" Padding="0" Classes="ghost"
                IsVisible="{Binding HasOverflowRibbonGroups}" Click="RibbonOverflowButton_OnClick"
                ToolTip.Tip="{services:Tr ui.show_hidden_ribbon_actions}" AutomationProperties.Name="{services:Tr ui.show_hidden_ribbon_actions}">
          <TextBlock FontSize="16" Text="»" Foreground="{DynamicResource TextBrush}"/>
        </Button>
      </StackPanel>
    </Border>

    <!-- v0.7.62.0 bug fix: MinWidth with no MaxWidth, relying solely on HorizontalAlignment="Right"
         to stay confined to the right portion of this single-column Grid (no Grid.ColumnDefinitions
         exist; every row-1/2 child shares one column and only alignment keeps them visually apart).
         Reported live: after a reconnect, this panel's own opaque CardGradient background was
         covering the category tabs and ribbon underneath ("looks like it's in the background"),
         on every page, not just Dashboard; consistent with an Arrange pass that stops respecting
         HorizontalAlignment="Right" and expands this Border across the full row width instead of
         its intended ~460-600px. A MaxWidth bounds the damage regardless of the exact Avalonia
         layout mechanism at fault, without a larger, riskier restructuring into real Grid columns. -->
    <!-- v0.7.63.0: fixed Height replaces the previous Auto-content sizing. Before this, the row
         housing this header (the outer Grid's ribbon row, RowDefinitions="66,42,Auto,*,44") sized
         itself independently per page; Dashboard carried an extra help line + background artwork
         no other page had, so its row came out visibly taller than e.g. Server Setup's. A fixed
         Height guarantees every page's header (and therefore the shared ribbon row) renders at the
         same size regardless of content; ClipToBounds remains as a safety net for any subtitle long
         enough to wrap past two lines. -->
    <!-- v0.8.0.0 (requested live): the artwork fills the whole card, edge to edge and into the rounded
         corners. It used to sit inside the card's Padding="20,10", leaving a plain band around it. The card
         has no padding now; the art, fade and wash layers fill it and are clipped to its curve, and only
         the text layer below carries the old 20,10 inset. -->
    <Border x:Name="PageArtHeader" Grid.Column="1" Height="112" Margin="9,0,9,5" CornerRadius="6" Background="{DynamicResource CardGradient}" BorderBrush="{Binding ActiveTabAccentBrush}" BorderThickness="2" BoxShadow="{Binding ActiveTabAccentGlowShadow}" Padding="0" ClipToBounds="True" IsVisible="{Binding !IsCreatingNewProfile}">
      <Grid>
        <!-- v0.7.110.1: all seven categories have night/day artwork. The 112px cap preserves header measurement. -->
        <!-- v0.7.62.0 bug fix: these images had no height constraint. The outer ribbon row is
             Auto-sized, so Avalonia measures this inner Grid's "*" row as unconstrained; an
             unconstrained Image with Stretch="UniformToFill" reports its own native pixel
             dimensions as desired size, inflating this Border's measured height and, through it,
             the whole Auto ribbon row well past its intended content height. ClipToBounds on the
             outer Border only clips rendering, not measurement, so it never prevented this.
             MaxHeight caps the image's desired size directly, fixing the measure-phase cause; now
             matched to the Border's own fixed Height above. -->
        <Image MaxHeight="112" Source="{Binding PageArtwork}" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Opacity="0.48" IsHitTestVisible="False"/>
        <Border CornerRadius="4" Background="{DynamicResource PageArtReadabilityGradient}" IsHitTestVisible="False"/>
        <!-- A restrained accent wash ties the category artwork to the selected server theme. -->
        <Border CornerRadius="4" Background="{DynamicResource BlueAccentBorderBrush}" Opacity="0.08" IsHitTestVisible="False" IsVisible="{Binding !IsCreatingNewProfile}"/>
        <!-- v0.8.0.0: one layer instead of two rows. The title block sits at the bottom of the card and the
             Auto refresh/Connected pill at the top right, so a two-line subtitle (e.g. Server Setup's) has
             the full height and is no longer cut off at the bottom edge. -->
        <Grid Margin="20,8,20,9">
          <!-- v0.7.76.0: BorderBrush bound here (a local value on Border.badge, same technique as the
               tab strip's own selected-border fix) so this pill's outline also follows the active
               tab's identity color, extending the same signal already on the header box around it. -->
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top" IsVisible="{Binding ShowGlobalPageHeader}"><CheckBox Content="{services:Tr ui.auto_refresh}" IsChecked="{Binding AutoRefreshEnabled}"/><Border Classes="tag" services:StatusTag.Status="{Binding ConnectionState}"><TextBlock Text="{services:TrText ConnectionState}"/></Border></StackPanel>
          <StackPanel VerticalAlignment="Bottom" Spacing="2">
            <TextBlock FontSize="24" FontWeight="Bold" Text="{services:TrText PageTitle}"/>
            <TextBlock Text="{services:TrText PageSubtitle}" Classes="muted" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"/>
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="260,*" ClipToBounds="True" IsVisible="{Binding !IsCreatingNewProfile}">
      <!-- v0.7.34.0: darker glass-hover gradient (the same one used on hover across ribbon
           buttons, category tabs, and nav buttons), was the flatter NavGlassSurfaceGradient. -->
      <!-- v0.7.74.0: BorderBrush now follows ActiveTab.AccentBrush (same per-tab identity color as
           the title-bar strip and page-header border) instead of a fixed blue. BoxShadow stays on
           the fixed resource; Avalonia's BoxShadow shorthand can't bind to a per-tab value, the
           same disclosed limitation the v0.7.48.0 theme-derivation pass ran into for DynamicResource. -->
      <Border Grid.Column="0" Margin="8" CornerRadius="6" Background="{DynamicResource GlassOptionHoverGradient}" BorderBrush="{Binding ActiveTabAccentBrush}" BorderThickness="1" BoxShadow="{Binding ActiveTabAccentGlowShadow}" ClipToBounds="True">
        <Grid RowDefinitions="*,Auto">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="7,0">
              <!-- v0.7.110.1: 26 distinct transparent crystal/metal navigation icons, decoded once at 112px for 56-DIP display. -->
              <StackPanel IsVisible="{Binding IsV5HomeCategory}" Spacing="3">
                <ToggleButton Classes="nav" IsChecked="{Binding IsDashboardPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Dashboard"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt dashboard}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Dashboard}"/></Grid></Border></ToggleButton>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsV5ServerCategory}" Spacing="3">
                <ToggleButton Classes="nav" IsChecked="{Binding IsServerSetupPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="ServerSetup"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt server_setup}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.ServerSetup}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsServerPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Configuration"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt configuration}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Configuration}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsConsolePage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Console"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt console}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Console}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsWorkspacePage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Workspace"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt workspace}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Workspace}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsLauncherPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Launcher"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt launcher}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Launcher}"/></Grid></Border></ToggleButton>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsV5WorldCategory}" VerticalAlignment="Top" Spacing="3">
                <ToggleButton Classes="nav" IsChecked="{Binding IsWorldExplorerPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Inspector"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt inspector}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Inspector}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsPlayersPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Players"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt players}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Players}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsBasesPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Bases"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt bases}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Bases}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsGuildsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Guilds"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt guilds}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Guilds}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsMapPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Map"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt map}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Map}"/></Grid></Border></ToggleButton>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsV5BackupsCategory}" Spacing="3"><ToggleButton Classes="nav" IsChecked="{Binding IsBackupsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Backups"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt backup-sphere}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Backups}"/></Grid></Border></ToggleButton></StackPanel>
              <StackPanel IsVisible="{Binding IsV5ModsCategory}" Spacing="3">
                <ToggleButton Classes="nav" IsChecked="{Binding IsModDashboardPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="ModDashboard"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt mod_dashboard}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.ModDashboard}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsModLibraryPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="ModLibrary"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt mod_library}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.ModLibrary}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsUe4ssPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Ue4ss"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt ue4ss}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Ue4ss}"/></Grid></Border></ToggleButton>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsV5ToolsCategory}" Spacing="3">
                <ToggleButton Classes="nav" IsChecked="{Binding IsUpdateCenterPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="UpdateCenter"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt update_center}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.UpdateCenter}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsDoctorPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Doctor"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt server_doctor}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Doctor}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsCrashAnalyzerPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="CrashAnalyzer"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt crash_analyzer}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.CrashAnalyzer}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsSaveToolsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="SaveTools"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt save_tools}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.SaveTools}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsDiagnosticsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="DiagnosticsCenter"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt diagnostics}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.DiagnosticsCenter}"/></Grid></Border></ToggleButton>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsV5HostCategory}" Spacing="3">
                <ToggleButton Classes="nav" IsChecked="{Binding IsHostPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Host"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt host}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Host}"/></Grid></Border></ToggleButton>
              </StackPanel>
              <StackPanel IsVisible="{Binding IsV5SystemCategory}" Spacing="3">
                <ToggleButton Classes="nav" IsChecked="{Binding IsSettingsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Settings"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt settings}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Settings}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsNotificationsPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Notifications"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt notifications}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Notifications}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsActivityAuditPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="ActivityAudit"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt activity_audit}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.ActivityAudit}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsAutomationPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Automation"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt automation}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Automation}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsAlertCenterPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="AlertCenter"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt alert_center}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.AlertCenter}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsSecurityPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Security"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt security}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Security}"/></Grid></Border></ToggleButton>
                <ToggleButton Classes="nav" IsChecked="{Binding IsFleetPage, Mode=OneWay}" Command="{Binding NavigateCommand}" CommandParameter="Fleet"><Border Classes="navSurface"><Grid ColumnDefinitions="54,*" ColumnSpacing="12"><Image Source="{services:IconArt fleet}" Width="50" Height="50" Stretch="Uniform"/><TextBlock Grid.Column="1" Text="{services:Tr nav.Fleet}"/></Grid></Border></ToggleButton>
              </StackPanel>
            </Grid>
          </ScrollViewer>
          <Border Grid.Row="1" Classes="statuscard" Margin="7,5,7,9" Padding="10"><StackPanel Spacing="3"><TextBlock Text="{services:TrText ServerState}" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}"/><TextBlock Text="{services:TrText ConnectionState}" FontSize="10" Foreground="{DynamicResource BlueBrush}" TextWrapping="Wrap"/></StackPanel></Border>
        </Grid>
      </Border>
      <Grid Grid.Column="1" ClipToBounds="True">
        <Image Source="{Binding PageArtwork}" Stretch="UniformToFill" Opacity="0.22" IsHitTestVisible="False"/>
        <Border Background="{DynamicResource Bg0ScrimBrush}"/>
        <!-- v0.7.79.0: same theme-color wash as the page-header art above. -->
        <Border Background="{DynamicResource BlueAccentBorderBrush}" Opacity="0.14"/>
        <ScrollViewer Margin="4,8,8,8">
          <StackPanel Margin="22" Spacing="20">
        <!-- v0.8.14.0: says so when cards are hidden or read-only because of the signed-in role (RoleAccess). -->
        <Border x:Name="RoleHiddenNotice" Classes="statuscard" Padding="10,6" IsVisible="{Binding HasRoleHiddenNotice}">
          <TextBlock Text="{services:TrText RoleHiddenNotice}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap"/>
        </Border>
        <!-- DASHBOARD -->
        <!-- v0.7.53.0: Dashboard Layout Density, item 13. Smaller/denser stat cards, matching the
             v0.2.16.4 reference and the same padding/font-size treatment the v0.7.32.0 density pass
             already applied to Server Setup/Backups/MOD Library/Server Doctor. Structural changes
             from that same reference (inline ribbon buttons, collapsible-tree nav) are a different,
             much larger change and explicitly out of scope here, this is card density only. -->
        <StackPanel IsVisible="{Binding IsDashboardPage}" Spacing="6">

          <!-- v0.7.31.0: identity is the install location, not host:port; see
               MainWindowViewModel.RecomputeDuplicateInstallWarnings. This can only be discovered
               after connecting (a ConnectionProfile alone has no install-path concept), so it's a
               warning banner here rather than something that could block the wizard beforehand. -->
          <Border Classes="statuscard" BorderBrush="{DynamicResource AmberBrush}" BorderThickness="1" Padding="10,7" IsVisible="{Binding ActiveTab.HasDuplicateInstallWarning}">
            <TextBlock Text="{services:TrText ActiveTab.DuplicateInstallWarning}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" FontSize="12"/>
          </Border>

          <!-- v1.0.2.0 (roadmap R-2): a switched-on outside channel with no proven delivery in 7 days, or whose last send failed. -->
          <Border x:Name="DeliveryWarningBanner" Classes="statuscard" BorderBrush="{DynamicResource AmberBrush}" BorderThickness="1" Padding="10,7" IsVisible="{Binding DeliveryHealth.AnyFlagged}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBlock Text="{services:TrText DeliveryHealth.Summary}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" FontSize="12" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Classes="open" Content="{services:Tr dashboard.openAlertCenter}" Command="{Binding NavigateCommand}" CommandParameter="AlertCenter"/>
            </Grid>
          </Border>

          <Border Classes="card accentHome" Padding="7,5" IsVisible="{Binding ManagementApiConnected}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <TextBlock Text="{services:Tr dashboard.lifecycle}" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}" FontSize="11"/>
              <TextBlock Grid.Column="1" Text="{services:TrText LifecycleStatusText}" TextWrapping="Wrap" FontSize="11"/>
            </Grid>
          </Border>

          <!-- v1.0.0.1: the stuck-start protocol. Shown when a start has run two minutes without opening its port, and while a
               test runs or its result is on screen: test once with every MOD off, or find the MOD by testing one at a time. -->
          <Border x:Name="StuckStartPanel" Classes="statuscard" BorderBrush="{DynamicResource AmberBrush}" BorderThickness="1" Padding="10,7" IsVisible="{Binding ShowStuckStartPanel}">
            <StackPanel Spacing="6">
              <TextBlock Text="{services:Tr dashboard.stuckStartTitle}" FontWeight="SemiBold" Foreground="{DynamicResource AmberBrush}"/>
              <TextBlock Text="{services:Tr dashboard.stuckStartHint}" TextWrapping="Wrap" FontSize="11" IsVisible="{Binding IsStartupStuck}"/>
              <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsStartupStuck}">
                <Button Classes="verify" Content="{services:Tr dashboard.stuckTestLoad}" Command="{Binding BeginStuckTestLoadCommand}" Margin="0,0,8,0" AutomationProperties.Name="{services:Tr dashboard.stuckTestLoad}"/>
                <Button Classes="verify" Content="{services:Tr dashboard.stuckOneAtATime}" Command="{Binding BeginModSafeStartCommand}" AutomationProperties.Name="{services:Tr dashboard.stuckOneAtATime}"/>
              </WrapPanel>
              <TextBlock Text="{services:TrText StuckStartStatusText}" TextWrapping="Wrap" FontSize="11" IsVisible="{Binding HasModSafeStartStatus}"/>
              <WrapPanel Orientation="Horizontal">
                <Button Classes="plain" Content="{services:Tr dashboard.stuckCancelTest}" Command="{Binding CancelModSafeStartCommand}" IsVisible="{Binding IsModSafeStartRunning}" Margin="0,0,8,0" AutomationProperties.Name="{services:Tr dashboard.stuckCancelTest}"/>
                <Button Classes="plain" Content="{services:Tr dashboard.stuckDismiss}" Command="{Binding DismissModSafeStartCommand}" IsVisible="{Binding HasModSafeStartStatus}" AutomationProperties.Name="{services:Tr dashboard.stuckDismiss}"/>
              </WrapPanel>
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="1.15*,1.15*,1.15*,1.15*" ColumnSpacing="8">
            <Border Classes="statuscard" Padding="8,6" Classes.glowGreen="{Binding IsServerGlowGreen}" Classes.glowRed="{Binding IsServerGlowRed}" Classes.glowAmber="{Binding IsServerGlowAmber}">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <TextBlock Text="{services:Tr dashboard.server}" Classes="muted"/>
                <TextBlock Grid.Row="1" Text="{services:TrText ServerState}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Text="{services:TrText DashboardSessionText}" Classes="muted"/>
                <Border Grid.Column="1" Grid.RowSpan="3" Background="{DynamicResource CardStrongBrush}" BorderBrush="{DynamicResource BlueAccentBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="8,3" VerticalAlignment="Center"><TextBlock Text="{services:TrText UptimeText}" Foreground="{DynamicResource BlueBrush}" FontWeight="Bold" FontSize="12"/></Border>
              </Grid>
            </Border>
            <Border Grid.Column="1" Classes="card glowDarkGreen" Padding="8,6">
              <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <TextBlock Text="{services:Tr dashboard.activeWorld}" Classes="muted"/>
                <Button Classes="open" Grid.Column="1" Content="{services:Tr dashboard.open}" Padding="8,3" Command="{Binding NavigateCommand}" CommandParameter="Inspector"/>
                <TextBlock Grid.Row="1" Text="{services:TrText DashboardWorldNicknameText}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{services:TrText DashboardWorldText}" FontSize="9" FontFamily="Consolas, monospace" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6">
                  <TextBlock Text="{services:TrText DashboardWorldPulseText}" Classes="muted" VerticalAlignment="Center"/>
                  <Button Classes="info" Content="{services:Tr dashboard.copyId}" Padding="6,2" Click="CopyActiveWorldId_Click" ToolTip.Tip="{services:Tr dashboard.copyId.tip}"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="2" Classes="card glowAmber" Padding="8,6">
              <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                <TextBlock Text="{services:Tr dashboard.backup}" Classes="muted"/>
                <Button Classes="open" Grid.Column="1" Content="{services:Tr dashboard.open}" Padding="8,3" Command="{Binding NavigateCommand}" CommandParameter="Backups"/>
                <TextBlock Grid.Row="1" Text="{services:TrText DashboardBackupText}" FontSize="15" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Text="{services:TrFormat dashboard.format.stored, Path=BackupTotalSizeText}" Classes="muted"/>
              </Grid>
            </Border>
            <Border Grid.Column="3" Classes="card" Padding="8,6" Classes.glowGreen="{Binding IsHealthGlowGreen}" Classes.glowRed="{Binding IsHealthGlowRed}" Classes.glowAmber="{Binding IsHealthGlowAmber}" Classes.glowNeutral="{Binding IsHealthGlowNeutral}">
              <Grid RowDefinitions="Auto,Auto,Auto">
                <TextBlock Text="{services:Tr dashboard.overallHealth}" Classes="muted"/>
                <TextBlock Grid.Row="1" Text="{services:TrText DashboardHealthText}" FontSize="15" FontWeight="SemiBold" Foreground="{Binding HealthStateColorKey, Converter={x:Static converters:SemanticStatusColorConverter.Instance}}"/>
                <TextBlock Grid.Row="2" Text="{services:TrText DashboardHealthDetail}" Classes="muted" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <Border Classes="card glowPurple" Padding="8,6"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{services:Tr dashboard.players}" Classes="muted"/><TextBlock Text="{services:TrFormat dashboard.format.online, Path=OnlinePlayerCountText}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{services:TrFormat dashboard.format.known, Path=PlayerRecordCountText}" Classes="muted"/></StackPanel><Button Classes="open" Grid.Column="1" Content="{services:Tr dashboard.open}" Padding="7,2" VerticalAlignment="Center" Command="{Binding NavigateCommand}" CommandParameter="Players"/></Grid></Border>
            <Border Grid.Column="1" Classes="card accentHome" Padding="8,6"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{services:Tr dashboard.guildsBases}" Classes="muted"/><TextBlock Text="{services:TrText DashboardGuildText}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{services:TrText SemanticStateText}" Classes="muted"/></StackPanel><Button Classes="open" Grid.Column="1" Content="{services:Tr dashboard.open}" Padding="7,2" VerticalAlignment="Center" Command="{Binding NavigateCommand}" CommandParameter="Guilds"/></Grid></Border>
            <Border Grid.Column="2" Classes="card accentHome" Padding="8,6"><Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2"><TextBlock Text="{services:Tr dashboard.modPlatform}" Classes="muted"/><TextBlock Text="{services:TrText DashboardModText}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{services:TrFormat dashboard.format.health, Path=ModHealth}" Classes="muted"/></StackPanel><Button Classes="open" Grid.Column="1" Content="{services:Tr dashboard.open}" Padding="7,2" VerticalAlignment="Center" Command="{Binding NavigateCommand}" CommandParameter="ModDashboard"/></Grid></Border>
            <Border Grid.Column="3" Classes="card accentHome" Padding="8,6" ClipToBounds="True">
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6" ClipToBounds="True">
                <StackPanel MinWidth="0"><TextBlock Text="{services:Tr dashboard.cpu}" Classes="muted"/><TextBlock Text="{services:TrText CpuText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></StackPanel>
                <StackPanel Grid.Column="1" MinWidth="0"><TextBlock Text="{services:Tr dashboard.memory}" Classes="muted"/><TextBlock Text="{services:TrText MemoryText}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{services:TrFormat dashboard.format.threads, Path=ThreadCountText}" Classes="muted" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel>
                <Border Grid.Column="2" ClipToBounds="True" HorizontalAlignment="Stretch" VerticalAlignment="Center" MinWidth="0">
                  <StackPanel Spacing="6" MinWidth="0">
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding CpuPercentValue}" Height="6" MinWidth="0" HorizontalAlignment="Stretch" ToolTip.Tip="{services:Tr dashboard.cpu.tip}"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding MemoryScaleValue}" Height="6" MinWidth="0" HorizontalAlignment="Stretch" ToolTip.Tip="{services:Tr dashboard.memory.tip}"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
          </Grid>

          <Border Background="{DynamicResource CardStrongBrush}" BorderBrush="{DynamicResource BlueAccentBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6">
            <Grid ColumnDefinitions="1.25*,1*,1*,1.25*,1.4*" ColumnSpacing="12">
              <StackPanel><TextBlock Text="{services:Tr dashboard.worldPulse}" Foreground="{DynamicResource BlueBrush}" FontSize="9" FontWeight="Bold"/><TextBlock Text="{services:TrText DashboardWorldClockText}" FontSize="15" FontWeight="Bold"/><TextBlock Text="{services:TrText DashboardWorldClockDetailText}" Classes="muted" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel>
              <StackPanel Grid.Column="1"><TextBlock Text="{services:Tr dashboard.serverSession}" Classes="muted" FontSize="9"/><TextBlock Text="{services:TrText UptimeText}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{services:TrText DashboardSessionText}" Classes="muted" FontSize="9"/></StackPanel>
              <StackPanel Grid.Column="2"><TextBlock Text="{services:Tr dashboard.playersThisSession}" Classes="muted" FontSize="9"/><TextBlock Text="{services:TrText DashboardPlayersSessionText}" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="{services:TrFormat dashboard.format.knownPlayers, Path=PlayerRecordCountText}" Classes="muted" FontSize="9"/></StackPanel>
              <StackPanel Grid.Column="3"><TextBlock Text="{services:Tr dashboard.worldSave}" Classes="muted" FontSize="9"/><TextBlock Text="{services:TrText DashboardPulseSaveText}" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="{services:TrText DashboardPulseBackupText}" Classes="muted" FontSize="9"/></StackPanel>
              <StackPanel Grid.Column="4"><TextBlock Text="{services:Tr dashboard.lastActivity}" Classes="muted" FontSize="9"/><TextBlock Text="{services:TrText DashboardLastActivityText}" TextWrapping="Wrap" MaxHeight="40" FontSize="9" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
            </Grid>
          </Border>

          <Border Classes="card accentHome" Padding="8">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,*,Auto" ColumnSpacing="12">
              <TextBlock Text="{services:Tr dashboard.health}" Classes="muted" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{services:TrText DashboardHealthText}" FontWeight="Bold" Foreground="{Binding HealthStateColorKey, Converter={x:Static converters:SemanticStatusColorConverter.Instance}}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{services:TrText DashboardRestText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="{services:TrText DashboardRconText}" Foreground="{DynamicResource AmberBrush}" VerticalAlignment="Center" ToolTip.Tip="{services:Tr dashboard.rcon.tip}"/>
              <TextBlock Grid.Column="4" Text="{services:TrText DashboardModsStripText}" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="5" Text="{services:TrText DashboardBackupStripText}" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="7">
                <Button Classes="verify" Content="{services:Tr dashboard.scan}" Padding="10,3" Command="{Binding RunDoctorCommand}" ToolTip.Tip="{services:Tr dashboard.scan.tip}"/>
                <Button Classes="apply" Content="{services:Tr dashboard.save}" Padding="10,3" Command="{Binding SaveWorldNowCommand}" IsEnabled="{Binding CanOperate}" ToolTip.Tip="{services:Tr dashboard.save.tip}"/>
                <Button Classes="danger" Content="{services:Tr dashboard.cleanup}" Padding="10,3" IsEnabled="False" ToolTip.Tip="{services:Tr dashboard.cleanup.tip}"/>
              </StackPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="1.65*,*" ColumnSpacing="10" Height="100">
            <Border Classes="card accentHome" Padding="10">
              <Grid RowDefinitions="Auto,*" RowSpacing="6">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource GreenBrush}"/>
                    <TextBlock Text="{services:Tr dashboard.resourceHistory}" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="{services:Tr dashboard.live}" Foreground="{DynamicResource GreenBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                  </StackPanel>
                  <ComboBox AutomationProperties.Name="{services:Tr ui.a11y_history_range}" Grid.Column="1" Width="104" Height="28" ItemsSource="{Binding HistoryRanges}" SelectedItem="{Binding SelectedHistoryRange}"/>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="190,*" ColumnSpacing="10">
                  <StackPanel VerticalAlignment="Center" Spacing="5">
                    <TextBlock Text="{services:TrText HistoryCpuSummary}" Foreground="{DynamicResource BlueBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{services:TrText HistoryMemorySummary}" Foreground="{DynamicResource VioletBrush}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{services:TrText HistoryFpsSummary}" Foreground="{DynamicResource GreenBrush}" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{services:Tr dashboard.fps.tip}"/>
                    <TextBlock Text="{services:TrText HistorySampleSummary}" Classes="muted" FontSize="9"/>
                  </StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1" CornerRadius="5" Padding="4" ClipToBounds="True">
                    <controls:ResourceHistoryChart ItemsSource="{Binding ResourceHistory}" Height="66" MinWidth="0" ClipToBounds="True"/>
                  </Border>
                </Grid>
              </Grid>
            </Border>
            <Border Grid.Column="1" Classes="card accentHome" Padding="10">
              <StackPanel Spacing="6">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{services:Tr dashboard.liveActivity}" FontSize="15" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{services:TrText LastObservedText}" Classes="muted"/></Grid>
                <ItemsControl ItemsSource="{Binding DashboardActivityLines}" MaxHeight="105"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource MutedBrush}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              </StackPanel>
            </Border>
          </Grid>

          <!-- v0.7.33.0: removed the duplicate ONLINE PLAYERS card that stood beside this log
               card; the top-row PLAYERS summary card (with its own OPEN button to the Players
               page) already covers that. Log card now spans the full width in its place. -->
          <Border Classes="card accentHome" Padding="10">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{services:Tr dashboard.log}" FontSize="15" FontWeight="SemiBold"/><Button Classes="open" Grid.Column="1" Content="{services:Tr dashboard.openConsole}" Command="{Binding NavigateCommand}" CommandParameter="Console"/></Grid>
              <TextBlock Text="{services:TrText LogFileText}" Classes="muted" FontSize="10"/>
              <ListBox AutomationProperties.Name="{services:Tr dashboard.log}" ItemsSource="{Binding LogLines}" MaxHeight="140" Background="{DynamicResource DecoBackground_07110A}" BorderBrush="{DynamicResource DecoBorder_214C2A}" Foreground="{DynamicResource GreenBrush}" FontFamily="Consolas, monospace" FontSize="10">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="2,1"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_12241A}"/></Style>
                  <Style Selector="ListBoxItem:nth-child(2n)"><Setter Property="Background" Value="{DynamicResource DecoBackground_0B1712}"/></Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{Binding Converter={x:Static converters:ConsoleLineColorConverter.Instance}}"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </StackPanel>
          </Border>

          <Border Classes="card accentHome" Padding="8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="10">
              <StackPanel><TextBlock Text="{services:Tr dashboard.serverName}" Classes="muted" FontSize="9"/><TextBlock Text="{Binding DashboardServerName}" FontSize="13" FontWeight="Bold"/></StackPanel>
              <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderSoftBrush}" Margin="4,0"/>
              <StackPanel Grid.Column="2"><TextBlock Text="{services:Tr dashboard.description}" Classes="muted" FontSize="9"/><TextBlock Text="{Binding DashboardServerDescriptionVerbatim}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DashboardServerDescriptionVerbatim}"/></StackPanel>
              <Border Grid.Column="3" Width="1" Background="{DynamicResource BorderSoftBrush}" Margin="4,0"/>
              <StackPanel Grid.Column="4"><TextBlock Text="{services:Tr dashboard.currentOperation}" Classes="muted" FontSize="9"/><TextBlock Text="{services:TrText LifecycleStatusText}" FontSize="10" Foreground="{DynamicResource BlueBrush}" MaxWidth="300" TextTrimming="CharacterEllipsis"/></StackPanel>
            </Grid>
          </Border>

          <!-- v1.0.0.1 (requested 2026-09-30): the addresses players use. Local ones for the same network, the public one for the
               internet; selectable so they can be copied. -->
          <Border x:Name="DashboardAddresses" Classes="card accentHome" Padding="8">
            <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="10">
              <TextBlock Text="{services:Tr dashboard.localAddresses}" Classes="muted" FontSize="10" VerticalAlignment="Center"/>
              <SelectableTextBlock Grid.Column="1" Text="{Binding LocalAddressesVerbatim}" FontFamily="Consolas, monospace" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{services:Tr dashboard.publicAddress}" Classes="muted" FontSize="10" VerticalAlignment="Center"/>
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <SelectableTextBlock Text="{Binding PublicAddressVerbatim}" FontFamily="Consolas, monospace" FontSize="12"/>
                <TextBlock Text="{services:TrText PublicAddressNote}" Classes="muted" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- SERVER SETUP — parity-oriented environment checklist -->
        <StackPanel IsVisible="{Binding IsServerSetupPage}" Spacing="10">
          <!-- v0.7.32.0: compact variant of these 4 cards, with explicit tight Padding, smaller
               FontSize, and shortened description text (the prior full-sentence descriptions were
               what actually drove card height via text wrap, more than padding did; these cards
               have no base .statuscard Padding/FontSize of their own to shrink). Also removes
               "Verify Files" here for real; v0.7.26.0 added it to the ribbon but never removed
               this original embedded copy. -->
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <Border Classes="statuscard accentServer" Padding="8,5"><StackPanel Spacing="2"><TextBlock Text="{services:Tr ui.components}" Classes="muted" FontSize="10"/><TextBlock Text="{services:TrText SetupComponentCountText}" FontSize="15" FontWeight="Bold"/><TextBlock Text="{services:Tr ui.steam_storage_runtime}" Classes="muted" FontSize="9"/></StackPanel></Border>
            <Border Grid.Column="1" Classes="statuscard accentServer" Padding="8,5"><StackPanel Spacing="2" HorizontalAlignment="Center"><TextBlock Text="{services:Tr ui.ready}" Classes="muted" FontSize="10" HorizontalAlignment="Center"/><TextBlock Text="{services:TrText SetupReadyCountText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}" HorizontalAlignment="Center"/><TextBlock Text="{services:Tr ui.verified}" Classes="muted" FontSize="9" HorizontalAlignment="Center"/></StackPanel></Border>
            <Border Grid.Column="2" Classes="statuscard accentServer" Padding="8,5"><StackPanel Spacing="2"><TextBlock Text="{services:Tr ui.attention}" Classes="muted" FontSize="10"/><TextBlock Text="{services:TrText SetupAttentionCountText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource AmberBrush}"/><TextBlock Text="{services:Tr ui.see_row_action}" Classes="muted" FontSize="9"/></StackPanel></Border>
            <Border Grid.Column="3" Classes="statuscard accentServer" Padding="8,5"><StackPanel Spacing="2"><TextBlock Text="{services:Tr ui.environment_health}" Classes="muted" FontSize="10"/><TextBlock Text="{services:TrText EnvironmentHealthText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}"/></StackPanel></Border>
          </Grid>
          <TextBlock Text="{services:Tr ui.server_environment}" FontSize="15" FontWeight="Bold" Margin="4,2,0,0"/>
          <Border Classes="card accentServer" Padding="0" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
              <Grid Background="{DynamicResource Bg2Brush}" ColumnDefinitions="110,190,95,2*,2.35*" Height="38">
                <TextBlock Text="{services:Tr ui.action}" Margin="12,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="{services:Tr ui.component}" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="2" Text="{services:Tr ui.status}" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="{services:Tr ui.location}" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBlock Grid.Column="4" Text="{services:Tr ui.details}" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
              </Grid>
              <ScrollViewer Grid.Row="1" MaxHeight="{Binding ServerSetupTableMaxHeight}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding EnvironmentItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:EnvironmentChecklistItemDto">
                      <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="2">
                        <Grid ColumnDefinitions="110,190,95,2*,2.35*" MinHeight="39">
                          <Button Classes="verify" Content="{services:TrText ActionDisplay}" services:ButtonIntent.Label="{Binding Action}" Click="EnvironmentAction_Click" Margin="4,3" Padding="6,3" MinHeight="30" FontSize="9" IsEnabled="{Binding ActionSupported}" ToolTip.Tip="{services:TrText ActionToolTip}"/>
                          <TextBlock Grid.Column="1" Text="{services:TrText Component}" Margin="10,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
                          <!-- v0.7.79.0: direct live feedback ("the Ready should be in the middle
                               of the green. can we also add a gradient glassy effect"). Explicit
                               Stretch + Center (rather than relying on Border/TextBlock defaults)
                               guarantees the text sits centered in the full pill regardless of how
                               wide the STATUS column ends up; flat GreenBrush/AmberBrush/RedBrush
                               fills replaced with the app's existing glass-gradient family
                               (Success/Warning/Danger Glass, the same ones ribbon buttons already
                               use) plus a thin matching accent border for definition. -->
                          <Grid Grid.Column="2" Margin="8,6">
                            <Border Classes="tag" services:StatusTag.Status="{Binding Status}"><TextBlock Text="{services:TrText Status}"/></Border>
                          </Grid>
                          <TextBlock Grid.Column="3" Text="{services:TrText Location}" Margin="10,0" VerticalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{services:TrText Location}"/>
                          <TextBlock Grid.Column="4" Text="{services:TrText Details}" Margin="10,0" VerticalAlignment="Center" FontSize="10" TextWrapping="Wrap" MaxHeight="34"/>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>

          <Border Classes="card accentServer" Padding="12" Background="{DynamicResource Bg1Brush}">
            <Grid ColumnDefinitions="*,260" ColumnSpacing="16">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <TextBlock Text="{services:Tr ui.operation_monitor}" FontWeight="Bold"/>
                  <Border Background="{DynamicResource CardStrongBrush}" CornerRadius="4" Padding="8,2"><TextBlock Text="{services:TrText SetupOperationState}" FontSize="10" FontWeight="Bold"/></Border>
                </StackPanel>
                <TextBlock Text="{services:TrText SetupOperationTitle}" FontSize="15" FontWeight="SemiBold" Margin="0,7,0,0"/>
                <TextBlock Text="{services:TrText SetupOperationDetail}" Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0"/>
                <TextBlock Text="{services:TrText SetupRecentActivity}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,6,0,0"/>
              </StackPanel>
              <!-- v0.7.89.0 bug fix: reported live. "how is this overall progress at 100% when
                   there are missing items?" This bar only ever tracked the most recently run
                   operation's own progress (e.g. Create Default Settings finishing), never the
                   environment's actual ready/missing count, which is already shown by the
                   READY/ATTENTION cards above. "OVERALL" wrongly implied it summarized the whole
                   environment. -->
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="{services:Tr ui.operation_progress}" Classes="muted" FontSize="10" FontWeight="SemiBold"/>
                <ProgressBar Value="{Binding SetupOperationProgress}" Minimum="0" Maximum="100" Height="18" Margin="0,6,0,0"/>
                <TextBlock Text="{services:TrText SetupOperationProgressText}" HorizontalAlignment="Right" Margin="0,3,0,0"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>

        <!-- UPDATE CENTER -->
        <StackPanel IsVisible="{Binding IsUpdateCenterPage}" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <StackPanel IsVisible="{Binding IsUpdateCenterPage}">
                <TextBlock Text="{services:Tr ui.review_palworld_dedicated_server_update_readines_68ab23}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Text="{services:TrText DistributionState}" Foreground="{DynamicResource VioletBrush}" Margin="0,4,0,0" />
            </StackPanel>
            <!-- v0.7.42.0: Refresh/Preview SteamCMD Plan moved to the ribbon. -->
          </Grid>

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="14">
            <Border Classes="card accentTools">
              <StackPanel Spacing="6">
                <TextBlock Text="{services:Tr ui.platform}" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{services:TrText DistributionPlatform}" FontSize="20" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card accentTools">
              <StackPanel Spacing="6">
                <TextBlock Text="{services:Tr ui.steamcmd}" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{services:TrText SteamCmdState}" FontSize="20" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card accentTools">
              <StackPanel Spacing="6">
                <TextBlock Text="{services:Tr ui.palworld_server}" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{services:TrText ServerInstallState}" FontSize="20" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- v0.7.45.0: Update Center Overhaul, real installed/latest version tracking per
               component (item 51), grouped into the two labeled sections the v0.2.16.4 reference
               used. Some rows cannot report a real "latest version" (no reliable unattended source
               exists; see HeadlessComponentUpdateService); those show "Unavailable"/"Check
               manually" honestly rather than a fabricated comparison. -->
          <Border Classes="card accentTools" IsVisible="{Binding HasComponentVersions}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{services:Tr ui.core_server}" Classes="muted" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="{Binding ComponentVersionsCheckedAtText, StringFormat='Checked {0}'}" Classes="muted" FontSize="11"/>
              </Grid>
              <TextBlock x:Name="ComponentUpdateMessageText" Text="{services:TrText ComponentUpdateMessage}" IsVisible="{Binding HasComponentUpdateMessage}" TextWrapping="Wrap" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding CoreServerComponents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ComponentVersionDto">
                    <Border Classes="statuscard accentTools" Margin="0,3">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="1.4*,*,*,*,1.4*">
                          <TextBlock Text="{services:TrText Component}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="1" Text="{services:TrText InstalledVersion}" FontFamily="Consolas, monospace" FontSize="12"/>
                          <TextBlock Grid.Column="2" Text="{services:TrText LatestVersion}" FontFamily="Consolas, monospace" FontSize="12"/>
                          <Border Classes="tag" Grid.Column="3" HorizontalAlignment="Left" services:StatusTag.Status="{Binding StatusText}"><TextBlock Text="{services:TrText StatusText}"/></Border>
                          <TextBlock Grid.Column="4" Text="{services:TrText Source}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="{services:TrText Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        <!-- v1.0.1.0: Update on every row (ComponentVersionDto.UpdateMethod); greyed out only where there is
                             nothing it could do (SteamCMD updates itself), with the reason beside it. -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="apply" Content="{services:Tr ui.update}" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).UpdateComponentCommand}" CommandParameter="{Binding}" ToolTip.Tip="{services:TrText UpdateHint}" ToolTip.ShowOnDisabled="True" Padding="8,3" FontSize="11"/>
                          <Button Classes="open" Content="{services:Tr ui.open}" Click="OpenComponentSourceUrl_Click" IsVisible="{Binding ShowsOpen}" ToolTip.Tip="{services:Tr ui.open_the_official_page_to_check_this_manually}" Padding="8,3" FontSize="11"/>
                          <TextBlock Text="{services:TrText UpdateHint}" IsVisible="{Binding !CanUpdate}" Classes="muted" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Text="{services:Tr ui.save_and_runtime_dependencies}" Classes="muted" FontWeight="Bold" Margin="0,8,0,0"/>
              <ItemsControl ItemsSource="{Binding SaveRuntimeDependencyComponents}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ComponentVersionDto">
                    <Border Classes="statuscard accentTools" Margin="0,3">
                      <StackPanel Spacing="3">
                        <Grid ColumnDefinitions="1.4*,*,*,*,1.4*">
                          <TextBlock Text="{services:TrText Component}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="1" Text="{services:TrText InstalledVersion}" FontFamily="Consolas, monospace" FontSize="12"/>
                          <TextBlock Grid.Column="2" Text="{services:TrText LatestVersion}" FontFamily="Consolas, monospace" FontSize="12"/>
                          <Border Classes="tag" Grid.Column="3" HorizontalAlignment="Left" services:StatusTag.Status="{Binding StatusText}"><TextBlock Text="{services:TrText StatusText}"/></Border>
                          <TextBlock Grid.Column="4" Text="{services:TrText Source}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        </Grid>
                        <TextBlock Text="{services:TrText Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                        <!-- v1.0.1.0: Update on every row (ComponentVersionDto.UpdateMethod); greyed out only where there is
                             nothing it could do (SteamCMD updates itself), with the reason beside it. -->
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <Button Classes="apply" Content="{services:Tr ui.update}" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).UpdateComponentCommand}" CommandParameter="{Binding}" ToolTip.Tip="{services:TrText UpdateHint}" ToolTip.ShowOnDisabled="True" Padding="8,3" FontSize="11"/>
                          <Button Classes="open" Content="{services:Tr ui.open}" Click="OpenComponentSourceUrl_Click" IsVisible="{Binding ShowsOpen}" ToolTip.Tip="{services:Tr ui.open_the_official_page_to_check_this_manually}" Padding="8,3" FontSize="11"/>
                          <TextBlock Text="{services:TrText UpdateHint}" IsVisible="{Binding !CanUpdate}" Classes="muted" FontSize="11" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        </StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <TextBlock Text="{services:Tr ui.use_refresh_in_the_ribbon_to_check_every_compone_78bb96}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasComponentVersions}"/>

          <Border Classes="card accentTools">
            <StackPanel Spacing="12">
              <TextBlock Text="{services:Tr ui.palworld_dedicated_server}" FontSize="18" FontWeight="SemiBold" />
              <CheckBox Content="{services:Tr ui.validate_server_files_with_steamcmd}" IsChecked="{Binding ValidateServerFiles}" />
              <Button Classes="apply" HorizontalAlignment="Left"
                      Content="{services:Tr ui.update_palworld_server}"
                      Command="{Binding UpdatePalworldServerCommand}"/>
              <TextBlock Text="{services:Tr ui.palserver_must_be_stopped_this_action_updates_th_fa55f5}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock Text="{services:TrText DistributionDetail}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </Border>

          <Border Classes="card accentTools">
            <StackPanel Spacing="8">
              <TextBlock Text="{services:Tr ui.steamcmd_plan}" FontSize="17" FontWeight="SemiBold" />
              <TextBox AutomationProperties.Name="{services:Tr ui.steamcmd_plan}" Text="{Binding DistributionPlanText}" AcceptsReturn="True" IsReadOnly="True" MinHeight="130" FontFamily="Consolas, monospace" FontSize="11" />
            </StackPanel>
          </Border>

          <Border Classes="card accentTools">
            <StackPanel Spacing="8">
              <TextBlock Text="{services:Tr ui.last_steamcmd_output}" FontSize="17" FontWeight="SemiBold" />
              <TextBox AutomationProperties.Name="{services:Tr ui.last_steamcmd_output}" Text="{Binding DistributionOutputText}" AcceptsReturn="True" IsReadOnly="True" MinHeight="160" FontFamily="Consolas, monospace" FontSize="11" />
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- WORLD EXPLORER -->
        <StackPanel IsVisible="{Binding IsWorldExplorerPage}" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <TextBlock Text="{services:TrText WorldExplorerState}" Foreground="{DynamicResource VioletBrush}" />
              <TextBlock Text="{services:TrText WorldExplorerDetail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <!-- v0.7.42.0: Refresh World moved to the ribbon; Validator & Recovery stays as an
                 in-page cross-navigation link, not a page action. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
              <Button Classes="verify" Content="{services:Tr ui.validator_and_recovery}" Command="{Binding NavigateCommand}" CommandParameter="WorldTransactions" ToolTip.Tip="{services:Tr ui.open_protected_validation_transaction_and_recove_190244}"/>
            </StackPanel>
          </Grid>

          <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="12">
            <Border Classes="card accentWorld">
              <StackPanel Spacing="5"><TextBlock Text="{services:Tr ui.active_world}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText DashboardWorldNicknameText}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{services:TrText ActiveWorldIdText}" FontSize="11" TextWrapping="Wrap" FontFamily="Consolas, monospace" ToolTip.Tip="{services:Tr ui.full_canonical_active_world_id}"/><Button Classes="info" Content="{services:Tr ui.copy_world_id}" HorizontalAlignment="Left" Padding="8,3" Click="CopyActiveWorldId_Click"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card accentWorld">
              <StackPanel Spacing="5"><TextBlock Text="{services:Tr ui.worlds}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText WorldCountText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card accentWorld">
              <StackPanel Spacing="5"><TextBlock Text="{services:Tr ui.files}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText WorldFileCountText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="3" Classes="card accentWorld">
              <StackPanel Spacing="5"><TextBlock Text="{services:Tr ui.player_saves}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText WorldPlayerSaveCountText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="card accentWorld">
              <StackPanel Spacing="5"><TextBlock Text="{services:Tr ui.total_size}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText WorldSizeText}" FontSize="22" FontWeight="SemiBold"/></StackPanel>
            </Border>
          </Grid>

          <Border Classes="card accentWorld">
            <StackPanel Spacing="8">
              <TextBlock Text="{services:Tr ui.world_inspector_sections}" FontSize="17" FontWeight="SemiBold"/>
              <WrapPanel><TextBlock Text="{services:Tr ui.overview}" Margin="0,0,16,4"/><TextBlock Text="{services:Tr ui.players}" Margin="0,0,16,4"/><TextBlock Text="{services:Tr ui.guilds}" Margin="0,0,16,4"/><TextBlock Text="{services:Tr ui.bases}" Margin="0,0,16,4"/><TextBlock Text="{services:Tr ui.saves}" Margin="0,0,16,4"/><TextBlock Text="{services:Tr ui.statistics}" Margin="0,0,16,4"/><TextBlock Text="{services:Tr ui.files}" Margin="0,0,16,4"/><TextBlock Text="{services:Tr ui.world_explorer}" Margin="0,0,16,4"/><TextBlock Text="{services:Tr ui.world_health}" Margin="0,0,16,4"/><TextBlock Text="{services:Tr ui.integrity}" Margin="0,0,16,4"/></WrapPanel>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><Border Classes="statuscard accentWorld"><StackPanel><TextBlock Text="{services:Tr ui.players}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText WorldInspectorPlayerCountText}" FontSize="20"/></StackPanel></Border><Border Grid.Column="1" Classes="statuscard accentWorld"><StackPanel><TextBlock Text="{services:Tr ui.guilds}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText WorldInspectorGuildCountText}" FontSize="20"/></StackPanel></Border><Border Grid.Column="2" Classes="statuscard accentWorld"><StackPanel><TextBlock Text="{services:Tr ui.base_references}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText WorldInspectorBaseCountText}" FontSize="20"/></StackPanel></Border></Grid>
            </StackPanel>
          </Border>

          <Border Classes="card accentWorld">
            <StackPanel Spacing="6">
              <TextBlock Text="{services:Tr ui.server_authoritative_saveroot}" FontWeight="SemiBold" />
              <TextBlock Text="{services:TrText WorldSaveRootText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontFamily="Consolas, monospace" FontSize="11" />
              <TextBlock Text="{services:Tr ui.world_explorer_is_read_only_in_this_phase_it_inv_0dd60d}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Grid ColumnDefinitions="2*,3*" ColumnSpacing="14">
            <Border Classes="card accentWorld">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="{services:Tr ui.discovered_worlds}" FontSize="17" FontWeight="SemiBold" />
                <ListBox AutomationProperties.Name="{services:Tr ui.discovered_worlds}" Grid.Row="1" ItemsSource="{Binding WorldCandidates}" MaxHeight="390">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:WorldCandidateDto">
                      <StackPanel Margin="0,6">
                        <TextBlock Text="{Binding Nickname}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding WorldId}" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" ToolTip.Tip="{services:Tr ui.full_canonical_world_id}"/>
                        <TextBlock Text="{services:TrText UpdatedText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                        <TextBlock Text="{services:TrText LevelSizeText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <Border Grid.Column="1" Classes="card accentWorld">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="{services:Tr ui.active_world_files}" FontSize="17" FontWeight="SemiBold" />
                <ListBox AutomationProperties.Name="{services:Tr ui.active_world_files}" Grid.Row="1" ItemsSource="{Binding WorldFiles}" SelectedItem="{Binding SelectedWorldFile}" MaxHeight="390">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:WorldFileDto">
                      <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="10" Margin="0,5">
                        <StackPanel>
                          <TextBlock Text="{services:TrText RelativePath}" FontFamily="Consolas, monospace" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip.Tip="{services:TrText RelativePath}" />
                          <TextBlock Text="{services:TrText Category}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{services:TrText UpdatedText}" FontSize="11" />
                          <TextBlock Text="{services:TrText Status}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{services:TrText SizeText}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
          </Grid>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
            <Border Classes="card accentWorld">
              <StackPanel Spacing="7"><TextBlock Text="{services:Tr ui.statistics_saves}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding WorldSaveDataCountText, StringFormat='Save-data files: {0}'}"/><TextBlock Text="{Binding WorldDiagnosticCountText, StringFormat='Decoded / diagnostic files: {0}'}"/><TextBlock Text="{Binding WorldEmptyCountText, StringFormat='Empty files: {0}'}"/><TextBlock Text="{Binding WorldAgeRangeText, StringFormat='File age range: {0}'}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card accentWorld">
              <StackPanel Spacing="7"><TextBlock Text="{services:Tr ui.world_health_integrity}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{services:TrText WorldIntegrityState}" FontSize="20" Foreground="{DynamicResource VioletBrush}"/><ItemsControl ItemsSource="{Binding WorldIntegrityFindings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{services:TrText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{services:Tr ui.read_only_structural_evidence_no_local_gui_files_cd5c95}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
            </Border>
          </Grid>
        </StackPanel>

        <!-- BASES AND GUILDS. v1.0.0.5 (asked 2026-10-05: "the bases and guilds sections look too similar and have redundant
             data"): both pages used to open with the same summary, count cards and evidence text, and both lists repeated the
             guild's name, ID and leader. A base is a place (where it is, which Pals work there, who owns it); a guild is people
             (its roster by name, who leads it, the bases it holds). Each links to the other, and a base opens on the map. -->
        <StackPanel IsVisible="{Binding IsPlayerGuildExplorerPage}" Spacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="{services:TrText BasesSummaryText}" FontSize="16" FontWeight="SemiBold" IsVisible="{Binding IsBasesPage}"/>
            <TextBlock Text="{services:TrText GuildsSummaryText}" FontSize="16" FontWeight="SemiBold" IsVisible="{Binding IsGuildsPage}"/>
            <TextBlock Text="{services:TrText PlayerGuildDetail}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
            <TextBlock Text="{services:TrText PlayerGuildState}" Foreground="{DynamicResource VioletBrush}" FontSize="11"/>
          </StackPanel>

          <!-- GUILDS: people -->
          <StackPanel x:Name="GuildsPageBody" IsVisible="{Binding IsGuildsPage}" Spacing="14">
            <Border Classes="card accentWorld">
              <Grid ColumnDefinitions="2*,*,Auto,Auto" ColumnSpacing="10">
                <TextBox PlaceholderText="{services:Tr ui.search_guild_id_leader_or_player_id}" Text="{Binding GuildSearchText}"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.a11y_guild_status_filter}" Grid.Column="1" ItemsSource="{Binding GuildStatusFilters}" SelectedItem="{Binding SelectedGuildStatusFilter}"/>
                <TextBlock Grid.Column="2" Text="{services:TrText GuildVisibleCountText}" Foreground="{DynamicResource VioletBrush}" VerticalAlignment="Center"/>
                <Button Classes="info" Grid.Column="3" Content="{services:Tr ui.export_guilds_csv}" Click="ExportGuildsCsv_Click"/>
              </Grid>
            </Border>
            <Grid ColumnDefinitions="2*,3*" ColumnSpacing="14">
              <Border Classes="card accentWorld">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                  <TextBlock Text="{services:Tr ui.guilds}" FontSize="18" FontWeight="SemiBold"/>
                  <ListBox AutomationProperties.Name="{services:Tr ui.guilds}" Grid.Row="1" ItemsSource="{Binding FilteredExplorerGuilds}" SelectedItem="{Binding SelectedExplorerGuild}" MaxHeight="520" ToolTip.Tip="{services:Tr ui.right_click_for_guild_administration_actions}">
                      <ListBox.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="{services:Tr ui.transfer_leadership_to}" Click="TransferGuildLeadership_OnClick" IsEnabled="{Binding CanManageAdmin}"/>
                          <MenuItem Header="{services:Tr ui.add_player}" Click="AddPlayerToGuild_OnClick" IsEnabled="{Binding CanManageAdmin}"/>
                          <MenuItem Header="{services:Tr ui.remove_broken_member}" Click="RemoveBrokenGuildMember_OnClick" IsEnabled="{Binding CanManageAdmin}"/>
                          <MenuItem Header="{services:Tr ui.claim_orphaned_guild}" Click="ClaimOrphanedGuild_OnClick" IsEnabled="{Binding CanManageAdmin}"/>
                        </ContextMenu>
                      </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:GuildExplorerItemDto">
                        <StackPanel Spacing="3" Margin="0,8">
                          <TextBlock Text="{Binding GuildNameVerbatim}" FontSize="17" FontWeight="SemiBold"/>
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="♛" Foreground="{DynamicResource AmberBrush}"/>
                            <TextBlock Text="{Binding LeaderNameVerbatim}"/>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{services:TrText MembersBasesText}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                            <TextBlock Text="{services:TrText OnlineText}" Foreground="{DynamicResource GreenBrush}" FontSize="11"/>
                          </StackPanel>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
              <Border Grid.Column="1" Classes="card accentWorld">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding SelectedExplorerGuild.GuildNameVerbatim}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource VioletBrush}"/>
                      <TextBlock Text="{Binding SelectedExplorerGuild.GuildId}" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                      <Button Classes="info" Content="{services:Tr ui.copy_guild_id}" Click="CopyGuildId_Click"/>
                      <Button Classes="open" Content="{services:Tr ui.open_leader_player}" Command="{Binding OpenSelectedGuildLeaderCommand}"/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="{services:Tr ui.roster}" FontWeight="SemiBold"/>
                  <ItemsControl x:Name="GuildRoster" ItemsSource="{Binding SelectedExplorerGuild.Roster}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:GuildMemberRow">
                        <Grid ColumnDefinitions="24,*,90,2*" ColumnSpacing="8" Margin="0,3">
                          <TextBlock Text="♛" Foreground="{DynamicResource AmberBrush}" IsVisible="{Binding IsLeader}"/>
                          <TextBlock Grid.Column="1" Text="{Binding NameVerbatim}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="2" Text="{services:TrText RoleText}" Foreground="{DynamicResource MutedBrush}"/>
                          <TextBlock Grid.Column="3" Text="{services:TrText StatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{services:Tr ui.bases}" FontWeight="SemiBold"/>
                  <ItemsControl ItemsSource="{Binding SelectedExplorerGuild.BaseCards}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:BaseExplorerItemDto">
                        <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8" Margin="0,3">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="⌂" Foreground="{DynamicResource VioletBrush}"/>
                            <TextBlock Text="{Binding LocationVerbatim}" FontFamily="Consolas, monospace"/>
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{services:TrText WorkerCountText}" Foreground="{DynamicResource MutedBrush}"/>
                          <Button Classes="open" Grid.Column="2" Content="{services:Tr ui.open_base}" Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenGuildBaseCommand}" CommandParameter="{Binding BaseId}"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </Grid>
            <Border Classes="card accentWorld"><StackPanel Spacing="8"><TextBlock Text="{services:Tr ui.guild_ownership_operations}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{services:Tr ui.applies_to_the_selected_guild_above_requires_pal_5e89f6}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><Grid ColumnDefinitions="180,2*,Auto" ColumnSpacing="10"><ComboBox AutomationProperties.Name="{services:Tr ui.a11y_guild_operation}" ItemsSource="{Binding GuildOperationTypes}" SelectedItem="{Binding GuildOperationType}"/><TextBox Grid.Column="1" PlaceholderText="{services:Tr ui.target_player_id_32_hex}" Text="{Binding GuildOperationPlayerId}"/><Button Classes="info" Grid.Column="2" Content="{services:Tr ui.preview}" Command="{Binding PreviewGuildOwnershipCommand}"/></Grid><TextBlock Text="{services:TrText GuildOperationStatusText}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/><CheckBox Content="{services:Tr ui.i_reviewed_this_plan_and_confirm_the_active_palw_4fd78f}" IsChecked="{Binding GuildOperationConfirmed}"/><Button Classes="danger" Content="{services:Tr ui.apply_with_fresh_safety_backup}" HorizontalAlignment="Left" Command="{Binding ApplyGuildOwnershipCommand}"/></StackPanel></Border>
          </StackPanel>

          <!-- BASES: places -->
          <StackPanel x:Name="BasesPageBody" IsVisible="{Binding IsBasesPage}" Spacing="14">
            <Border Classes="card accentWorld"><Grid ColumnDefinitions="2*,*,Auto,Auto" ColumnSpacing="10"><TextBox PlaceholderText="{services:Tr ui.search_base_id_guild_or_leader}" Text="{Binding BaseSearchText}"/><ComboBox AutomationProperties.Name="{services:Tr ui.a11y_base_status_filter}" Grid.Column="1" ItemsSource="{Binding BaseStatusFilters}" SelectedItem="{Binding SelectedBaseStatusFilter}"/><TextBlock Grid.Column="2" Text="{services:TrText BaseVisibleCountText}" Foreground="{DynamicResource VioletBrush}" VerticalAlignment="Center"/><Button Classes="info" Grid.Column="3" Content="{services:Tr ui.export_bases_csv}" Click="ExportBasesCsv_Click"/></Grid></Border>
            <Grid ColumnDefinitions="2*,3*" ColumnSpacing="14">
              <Border Classes="card accentWorld">
                <Grid RowDefinitions="Auto,*" RowSpacing="8">
                  <TextBlock Text="{services:Tr ui.bases}" FontSize="18" FontWeight="SemiBold"/>
                  <ListBox AutomationProperties.Name="{services:Tr ui.bases}" Grid.Row="1" ItemsSource="{Binding FilteredExplorerBases}" SelectedItem="{Binding SelectedExplorerBase}" MaxHeight="520" ToolTip.Tip="{services:Tr ui.right_click_for_base_administration_actions}">
                    <ListBox.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="{services:Tr ui.copy_base_info}" Click="CopyBaseInfo_OnClick"/>
                        <Separator/>
                        <MenuItem Header="{services:Tr ui.transfer_to_guild}" Click="TransferBase_OnClick" IsEnabled="{Binding CanManageAdmin}"/>
                        <MenuItem Header="{services:Tr ui.wipe_base_completely}" Click="WipeBase_OnClick" IsEnabled="{Binding CanManageAdmin}"/>
                      </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:BaseExplorerItemDto">
                        <StackPanel Spacing="3" Margin="0,8">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⌂" FontSize="17" Foreground="{DynamicResource VioletBrush}"/>
                            <TextBlock Text="{Binding LocationVerbatim}" FontSize="17" FontWeight="SemiBold" FontFamily="Consolas, monospace"/>
                          </StackPanel>
                          <TextBlock Text="{services:TrText WorkerCountText}"/>
                          <TextBlock Text="{Binding WorkerSummaryVerbatim}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding GuildNameVerbatim}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
              </Border>
              <Border Grid.Column="1" Classes="card accentWorld">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="*,Auto">
                    <StackPanel>
                      <TextBlock Text="{Binding SelectedExplorerBase.LocationVerbatim}" FontSize="22" FontWeight="SemiBold" FontFamily="Consolas, monospace" Foreground="{DynamicResource VioletBrush}"/>
                      <TextBlock Text="{services:TrText SelectedExplorerBase.LocationText}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                    </StackPanel>
                    <Button x:Name="ShowBaseOnMapButton" Grid.Column="1" Classes="open" Content="{services:Tr ui.show_on_map}" Command="{Binding ShowSelectedBaseOnMapCommand}" IsEnabled="{Binding SelectedExplorerBase.HasLocation}" VerticalAlignment="Top"/>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel>
                      <TextBlock Text="{services:Tr ui.owned_by}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                      <TextBlock Text="{Binding SelectedExplorerBase.GuildNameVerbatim}" FontSize="16"/>
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="♛" Foreground="{DynamicResource AmberBrush}"/>
                        <TextBlock Text="{Binding SelectedExplorerBase.LeaderNameVerbatim}"/>
                      </StackPanel>
                    </StackPanel>
                    <Button Classes="open" Grid.Column="1" Content="{services:Tr ui.open_guild}" Command="{Binding OpenSelectedBaseGuildCommand}" VerticalAlignment="Top"/>
                  </Grid>
                  <TextBlock Text="{services:TrText SelectedExplorerBase.WorkerCountText}" FontWeight="SemiBold"/>
                  <ListBox x:Name="BaseWorkers" AutomationProperties.Name="{services:Tr ui.workers}" ItemsSource="{Binding SelectedExplorerBase.Workers}" MaxHeight="260">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:PalLocationDto">
                        <Grid ColumnDefinitions="*,60,*" ColumnSpacing="8">
                          <TextBlock Text="{Binding WorkerNameVerbatim}" FontWeight="SemiBold"/>
                          <TextBlock Grid.Column="1" Text="{services:TrText LevelText}" Foreground="{DynamicResource MutedBrush}"/>
                          <TextBlock Grid.Column="2" Text="{Binding OwnerNameVerbatim}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{Binding SelectedExplorerBase.BaseId}" FontFamily="Consolas, monospace" FontSize="10" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                    <Button Classes="info" Grid.Column="1" Content="{services:Tr ui.copy_base_id}" Click="CopyBaseId_Click"/>
                  </Grid>
                </StackPanel>
              </Border>
            </Grid>
            <Border Classes="card accentWorld"><StackPanel Spacing="8"><TextBlock Text="{services:Tr ui.base_ownership_transfer}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{services:Tr ui.applies_to_the_selected_base_above_moves_the_bas_c0d0ff}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><Grid ColumnDefinitions="2*,Auto" ColumnSpacing="10"><TextBox PlaceholderText="{services:Tr ui.target_guild_id_32_hex}" Text="{Binding BaseTransferTargetGuildId}"/><Button Classes="info" Grid.Column="1" Content="{services:Tr ui.preview_transfer}" Command="{Binding PreviewBaseTransferCommand}"/></Grid><TextBlock Text="{services:TrText BaseTransferStatusText}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/><CheckBox Content="{services:Tr ui.i_reviewed_this_plan_and_confirm_the_active_palw_4fd78f}" IsChecked="{Binding BaseTransferConfirmed}"/><Button Classes="danger" Content="{services:Tr ui.apply_with_fresh_safety_backup}" HorizontalAlignment="Left" Command="{Binding ApplyBaseTransferCommand}"/></StackPanel></Border>
            <Border Classes="card accentWorld"><StackPanel Spacing="8"><TextBlock Text="{services:Tr ui.base_recovery}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{services:Tr ui.applies_to_the_selected_base_above_permanently_r_763a73}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/><Button Classes="info" Content="{services:Tr ui.preview_recovery}" HorizontalAlignment="Left" Command="{Binding PreviewBaseRecoveryCommand}"/><TextBlock Text="{services:TrText BaseRecoveryStatusText}" Foreground="{DynamicResource OrangeBrush}" TextWrapping="Wrap"/><CheckBox Content="{services:Tr ui.i_reviewed_this_plan_and_confirm_the_active_palw_73337a}" IsChecked="{Binding BaseRecoveryConfirmed}"/><Button Classes="danger" Content="{services:Tr ui.apply_with_fresh_safety_backup}" HorizontalAlignment="Left" Command="{Binding ApplyBaseRecoveryCommand}"/></StackPanel></Border>
          </StackPanel>

          <Border Classes="card accentWorld" IsVisible="{Binding HasPlayerGuildWarnings}">
            <StackPanel Spacing="7">
              <TextBlock Text="{services:Tr ui.semantic_warnings_limitations}" FontSize="17" FontWeight="SemiBold"/>
              <ItemsControl ItemsSource="{Binding PlayerGuildWarnings}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{services:TrText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="0,2"/>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- SERVER -->
        <StackPanel IsVisible="{Binding IsServerPage}" Spacing="12">
          <Border Classes="card accentServer" ClipToBounds="True">
            <!-- v0.7.82.0: flattened from a row-indexed Grid to a single StackPanel so Server
                 Identity can sit first, with the Simple/Advanced toggle, QoL preset, search and
                 file path controls relocated further down (just above World Settings) instead of
                 competing with identity/network for the top of the page. -->
            <StackPanel Spacing="10">
              <Border Classes="statuscard accentServer" BorderBrush="{DynamicResource AmberBrush}" BorderThickness="1" IsVisible="{Binding HasSimpleSettingsGap}">
                <TextBlock Text="{services:TrText SimpleSettingsGapText}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" FontSize="12"/>
              </Border>
              <Border Classes="statuscard accentServer" BorderBrush="{DynamicResource AmberAccentBorderBrush}" BorderThickness="2" Background="{DynamicResource CardStrongBrush}" BoxShadow="{DynamicResource AmberAccentGlowShadowLow}" Padding="16">
                <Grid ColumnDefinitions="150,*,150,*" ColumnSpacing="16" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
                  <TextBlock Text="{services:Tr ui.server_identity}" Grid.ColumnSpan="4" FontWeight="Bold" Foreground="{DynamicResource AmberBrush}" Margin="0,0,0,4"/>
                  <TextBlock Grid.Row="1" Text="{services:Tr ui.server_name}" Classes="muted" VerticalAlignment="Center"/>
                  <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding ServerNameSetting.DisplayValue, Mode=TwoWay}" PlaceholderText="{services:Tr ui.palworld_server_name}" Classes.dirty="{Binding ServerNameSetting.IsDirty}"/>
                    <Button Grid.Column="1" Content="{services:Tr ui.generate}" Classes="info" Command="{Binding GenerateServerNameCommand}" ToolTip.Tip="{services:Tr ui.generates_a_random_server_browser_name_locally_s_c54884}" AutomationProperties.Name="{services:Tr ui.generate_a_random_server_name}" Padding="14,7" FontWeight="SemiBold"/>
                  </Grid>
                  <TextBlock Grid.Row="1" Grid.Column="2" Text="{services:Tr ui.description}" Classes="muted" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding ServerDescriptionSetting.DisplayValue, Mode=TwoWay}" PlaceholderText="{services:Tr ui.server_browser_description}" Classes.dirty="{Binding ServerDescriptionSetting.IsDirty}"/>
                  <TextBlock Grid.Row="2" Text="{services:Tr ui.admin_password}" Classes="muted" VerticalAlignment="Center"/>
                  <TextBox AutomationProperties.Name="{services:Tr ui.admin_password}" Grid.Row="2" Grid.Column="1" Text="{Binding AdminPasswordSetting.DisplayValue, Mode=TwoWay}" PasswordChar="●" Classes.dirty="{Binding AdminPasswordSetting.IsDirty}"/>
                  <TextBlock Grid.Row="2" Grid.Column="2" Text="{services:Tr ui.server_password}" Classes="muted" VerticalAlignment="Center"/>
                  <TextBox AutomationProperties.Name="{services:Tr ui.server_password}" Grid.Row="2" Grid.Column="3" Text="{Binding ServerPasswordSetting.DisplayValue, Mode=TwoWay}" PasswordChar="●" Classes.dirty="{Binding ServerPasswordSetting.IsDirty}"/>
                </Grid>
              </Border>

              <TextBlock Text="{services:Tr ui.network_access_and_limits}" FontWeight="Bold" Margin="4,4,0,0"/>
              <ItemsControl ItemsSource="{Binding SimpleToggleSettings}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:PalworldSimpleToggleItem">
                    <Border Classes="statuscard accentServer" Classes.dirty="{Binding IsDirty}" Margin="0,0,10,7" Padding="10,8" Width="260">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox AutomationProperties.Name="{services:TrText DisplayName}" IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <StackPanel><TextBlock Text="{services:TrText Title}" FontWeight="Bold"/><TextBlock Text="{services:TrText Description}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding SimpleNetworkSettings}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:PalworldSettingDto">
                    <Border Classes="statuscard accentServer" Classes.dirty="{Binding IsDirty}" Margin="0,0,10,7" Padding="10,8">
                      <StackPanel Spacing="3" Width="160">
                        <TextBlock Text="{Binding DisplayName}" Classes="muted" FontSize="10"/>
                        <TextBox AutomationProperties.Name="{Binding DisplayName}" Text="{Binding DisplayValue, Mode=TwoWay}"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- v0.7.26.0: Import/Export/Load Active/Save Changes/Reset Unsaved moved to the
                   ribbon (Load Active removed entirely as redundant), see MainWindowViewModel's
                   BuildRibbonGroupsForActivePage. Only Simple/Advanced/QoL preset/Save As Preset
                   stay here, since they were not part of that relocation. -->
              <Grid ColumnDefinitions="Auto,Auto,Auto,200,Auto,150,Auto,*" ColumnSpacing="8">
                <Button Classes="plain" Content="{services:Tr ui.simple_settings}" Command="{Binding ShowSimpleConfigCommand}"/>
                <Button Classes="plain" Grid.Column="1" Content="{services:Tr ui.advanced_settings}" Command="{Binding ShowAdvancedConfigCommand}"/>
                <TextBlock Grid.Column="2" Text="{services:Tr ui.qol_preset}" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0"/>
                <ComboBox Grid.Column="3" ItemsSource="{Binding PalworldConfigPresets}" SelectedItem="{Binding SelectedConfigPreset, Mode=TwoWay}" ToolTip.Tip="{services:Tr ui.selecting_a_preset_applies_it_immediately}"/>
                <TextBox Grid.Column="5" PlaceholderText="{services:Tr ui.new_preset_name}" Text="{Binding NewConfigPresetName, Mode=TwoWay}"/>
                <Button Classes="apply" Grid.Column="6" Content="{services:Tr ui.save_as_preset}" Command="{Binding SaveCurrentAsPresetCommand}" ToolTip.Tip="{services:Tr ui.saves_every_currently_loaded_setting_value_as_a_e221d7}"/>
              </Grid>

              <Grid ColumnDefinitions="*,180" ColumnSpacing="8">
                <TextBox PlaceholderText="{services:Tr ui.search_setting_name_category_or_description}" Text="{Binding ConfigSearchText, Mode=TwoWay}"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.qol_preset}" Grid.Column="1" ItemsSource="{Binding PalworldConfigCategories}" SelectedItem="{Binding SelectedConfigCategory, Mode=TwoWay}"/>
              </Grid>

              <StackPanel Spacing="3">
                <TextBlock Text="{services:TrText PalworldConfigPath}" FontFamily="Consolas, monospace" FontSize="11" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock IsVisible="{Binding IsConfigAdvancedView}" Text="{services:Tr ui.advanced_settings_exposes_every_known_and_custom_a51ad8}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>

              <StackPanel IsVisible="{Binding IsConfigSimpleView}" Spacing="10">
                  <!-- v0.7.38.0: preset-loaded/unsaved-changes/validation notification strip,
                       relocated here from directly under the Simple/Advanced toggle row above,
                       right next to World Settings (renamed from Gameplay Rates), the section it's
                       actually reporting the state of. -->
                  <StackPanel Spacing="3">
                    <TextBlock Text="{services:TrText PalworldConfigState}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                      <TextBlock Text="{services:TrText PalworldConfigDirtyText}" Foreground="{DynamicResource AmberBrush}"/>
                      <TextBlock Text="{services:TrText PalworldConfigValidationText}" Foreground="{DynamicResource GreenBrush}" TextWrapping="Wrap" MaxWidth="470"/>
                    </StackPanel>
                    <TextBlock Text="{services:Tr ui.simple_settings_shows_server_identity_connectivi_c2fcef}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                  </StackPanel>

                  <!-- v0.7.38.0: renamed from "Gameplay Rates" and split into three labeled
                       sub-sections (World / Player &amp; Pal / Items &amp; Work), matching the
                       v0.2.16.4 reference's grouping, instead of one flat 22-row list. -->
                  <TextBlock Text="{services:Tr ui.world_settings}" FontWeight="Bold" Margin="4,4,0,0"/>

                  <TextBlock Text="{services:Tr ui.world}" Classes="muted" FontWeight="SemiBold" Margin="4,2,0,0"/>
                  <ItemsControl ItemsSource="{Binding SimpleWorldRateSettings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:PalworldSimpleSettingItem">
                        <Border Classes="statuscard accentServer" Classes.dirty="{Binding IsDirty}" Margin="0,0,0,7" Padding="10,8">
                          <Grid ColumnDefinitions="Auto,2*,220,95,130" ColumnSpacing="10">
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" ToolTip.Tip="{services:Tr ui.clear_to_return_this_option_to_its_default_value}"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{services:TrText Title}" FontWeight="Bold"/><TextBlock Text="{services:TrText Description}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                            <Slider AutomationProperties.Name="{services:Tr ui.world}" Grid.Column="2" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" Value="{Binding SliderValue, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Classes="badge" VerticalAlignment="Center"><TextBlock Text="{services:TrText ValueText}" HorizontalAlignment="Center"/></Border>
                            <TextBlock Grid.Column="4" Text="{services:TrText DefaultComparisonText}" Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="{services:Tr ui.player_and_pal}" Classes="muted" FontWeight="SemiBold" Margin="4,6,0,0"/>
                  <ItemsControl ItemsSource="{Binding SimplePlayerPalRateSettings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:PalworldSimpleSettingItem">
                        <Border Classes="statuscard accentServer" Classes.dirty="{Binding IsDirty}" Margin="0,0,0,7" Padding="10,8">
                          <Grid ColumnDefinitions="Auto,2*,220,95,130" ColumnSpacing="10">
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" ToolTip.Tip="{services:Tr ui.clear_to_return_this_option_to_its_default_value}"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{services:TrText Title}" FontWeight="Bold"/><TextBlock Text="{services:TrText Description}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                            <Slider AutomationProperties.Name="{services:Tr ui.player_and_pal}" Grid.Column="2" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" Value="{Binding SliderValue, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Classes="badge" VerticalAlignment="Center"><TextBlock Text="{services:TrText ValueText}" HorizontalAlignment="Center"/></Border>
                            <TextBlock Grid.Column="4" Text="{services:TrText DefaultComparisonText}" Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="{services:Tr ui.items_and_work}" Classes="muted" FontWeight="SemiBold" Margin="4,6,0,0"/>
                  <ItemsControl ItemsSource="{Binding SimpleItemsWorkRateSettings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:PalworldSimpleSettingItem">
                        <Border Classes="statuscard accentServer" Classes.dirty="{Binding IsDirty}" Margin="0,0,0,7" Padding="10,8">
                          <Grid ColumnDefinitions="Auto,2*,220,95,130" ColumnSpacing="10">
                            <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" ToolTip.Tip="{services:Tr ui.clear_to_return_this_option_to_its_default_value}"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{services:TrText Title}" FontWeight="Bold"/><TextBlock Text="{services:TrText Description}" Classes="muted" FontSize="10" TextWrapping="Wrap"/></StackPanel>
                            <Slider AutomationProperties.Name="{services:Tr ui.items_and_work}" Grid.Column="2" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}" TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" Value="{Binding SliderValue, Mode=TwoWay}" VerticalAlignment="Center"/>
                            <Border Grid.Column="3" Classes="badge" VerticalAlignment="Center"><TextBlock Text="{services:TrText ValueText}" HorizontalAlignment="Center"/></Border>
                            <TextBlock Grid.Column="4" Text="{services:TrText DefaultComparisonText}" Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center" TextAlignment="Right"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Grid IsVisible="{Binding IsConfigAdvancedView}" RowDefinitions="Auto,*">
                  <Grid Background="{DynamicResource Bg2Brush}" ColumnDefinitions="135,210,*,150,190,95" Height="40">
                    <TextBlock Text="{services:Tr ui.category}" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{services:Tr ui.setting}" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="2" Text="{services:Tr ui.description}" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="{services:Tr ui.default_value}" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="4" Text="{services:Tr ui.active_value}" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                    <TextBlock Grid.Column="5" Text="{services:Tr ui.state}" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold"/>
                  </Grid>
                  <ListBox AutomationProperties.Name="{services:Tr ui.a11y_palworld_settings}" Grid.Row="1" ItemsSource="{Binding FilteredPalworldSettings}" MaxHeight="560" ClipToBounds="True">
                    <ListBox.Styles>
                      <Style Selector="ListBoxItem"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
                      <Style Selector="Border.differsFromDefault"><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_F4C542}"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Background" Value="{DynamicResource DecoBackground_14D4A017}"/></Style>
                      <!-- v0.7.87.0: unsaved-edit highlight for Advanced Settings rows, matching Simple
                           Settings' own Border.statuscard.dirty. Flags active value against what was
                           last loaded/saved, distinct from differsFromDefault above (which flags against
                           Palworld's factory default regardless of save state). Both can apply at once. -->
                      <Style Selector="Border.rowDirty"><Setter Property="BorderBrush" Value="{DynamicResource AmberAccentBorderBrush}"/><Setter Property="BorderThickness" Value="0,0,0,3"/><Setter Property="Background" Value="{DynamicResource CardAmberGradient}"/></Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:PalworldSettingDto">
                        <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="4,7" HorizontalAlignment="Stretch" Classes.differsFromDefault="{Binding IsDifferentFromDefault}" Classes.rowDirty="{Binding IsDirty}">
                          <Grid ColumnDefinitions="135,210,*,150,190,95" ColumnSpacing="8">
                            <TextBlock Text="{services:TrText Category}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Name}" Classes="muted" FontSize="9"/></StackPanel>
                            <TextBlock Grid.Column="2" Text="{services:TrText Description}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBlock Grid.Column="3" Text="{services:TrText DefaultValue}" FontFamily="Consolas, monospace" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <TextBox AutomationProperties.Name="{Binding DisplayName}" Grid.Column="4" Text="{Binding DisplayValue, Mode=TwoWay}" VerticalAlignment="Center" Classes.dirty="{Binding IsDirty}"/>
                            <TextBlock Grid.Column="5" Text="{services:TrText IsModifiedDisplay}" Foreground="{DynamicResource AmberBrush}" VerticalAlignment="Center" TextAlignment="Center"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- v0.7.99.0: the dedicated Map page under World. The map used to be a card on the Players
             page, which is why it was hard to find. The map sits on the left so it is visible without
             scrolling; controls, players and bases sit beside it. Markers are centred on their point:
             a marker used to be placed by its top-left corner, which drew it about 5 canvas pixels
             right and down of where it really is. -->
        <StackPanel IsVisible="{Binding IsMapPage}" Spacing="12">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border Classes="card accentWorld" VerticalAlignment="Top">
              <Viewbox Width="560" Height="560" HorizontalAlignment="Left">
                <!-- 482 wide so the 1 pixel border leaves exactly 480 map units inside, which is what the
                     marker and zoom maths assume. The inner Grid takes the wheel and drag input. -->
                <Border Width="482" Height="482" ClipToBounds="True" Background="{DynamicResource Bg1Brush}" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="1">
                  <Grid Background="Transparent"
                        PointerWheelChanged="MapSurface_OnPointerWheelChanged"
                        PointerPressed="MapSurface_OnPointerPressed"
                        PointerMoved="MapSurface_OnPointerMoved"
                        PointerReleased="MapSurface_OnPointerReleased"
                        PointerCaptureLost="MapSurface_OnPointerCaptureLost">
                    <Image Source="{Binding MapBackgroundBitmap}" Stretch="UniformToFill" RenderTransformOrigin="0%,0%" RenderTransform="{Binding MapImageTransform}"/>
                    <ItemsControl ItemsSource="{Binding BaseMapPoints}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <!-- Markers are placed with a margin taken from their data. Canvas.Left and Canvas.Top on a template
                           root, or on the item container, did not position them: every marker sat in the top-left corner. -->
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BaseMapPointDto">
                          <!-- v0.7.115.0: the marker button holds only the dot, with MinWidth/MinHeight 0 so the app-wide
                               Button style (MinHeight 31, centred content) no longer shifts the dot off its point.
                               The name label is drawn in its own layer below. -->
                          <Button Classes="marker" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding MarkerMargin}"
                                  Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ZoomToBaseCommand}"
                                  CommandParameter="{Binding BaseId}" ToolTip.Tip="{services:TrText Tooltip}">
                            <Rectangle Width="10" Height="10" Fill="{DynamicResource AmberBrush}" Stroke="{DynamicResource DecoBorder_0B141B}" StrokeThickness="1.5"/>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- v0.8.11.0: owned Pals (base workers and party members) from the save, clustered at the current zoom;
                         the count is drawn inside the marker. Above bases (a cluster beside a base is a badge on its corner, see PalMapLayout) and under players. -->
                    <ItemsControl ItemsSource="{Binding PalMapPoints}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PalMapPointDto">
                          <Button Classes="palMarker marker" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding MarkerMargin}"
                                  Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ZoomToPalGroupCommand}"
                                  CommandParameter="{Binding Key}" ToolTip.Tip="{services:TrText Tooltip}">
                            <Grid Width="14" Height="14">
                              <Ellipse Fill="{DynamicResource DecoBackground_9F7AEA}" Stroke="{DynamicResource DecoBorder_0B141B}" StrokeThickness="1.5"/>
                              <TextBlock Text="{services:TrText CountText}" FontSize="8" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding PlayerMapPoints}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <!-- Online players are solid green dots (live position). Offline players are hollow grey rings at the
                           last position the save recorded for them. -->
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PlayerMapPointDto">
                          <!-- v0.7.115.0: dot only, MinWidth/MinHeight 0 (see the base marker above); labels are their own layer. -->
                          <Button Classes="marker" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding MarkerMargin}"
                                  Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectMapPlayerCommand}"
                                  CommandParameter="{Binding PlayerId}" ToolTip.Tip="{services:TrText Tooltip}">
                            <Grid Width="10" Height="10">
                              <Ellipse Fill="{DynamicResource GreenBrush}" Stroke="{DynamicResource DecoBorder_0B141B}" StrokeThickness="1.5" IsVisible="{Binding IsOnline}"/>
                              <Ellipse Fill="{DynamicResource DecoBackground_664A5568}" Stroke="{DynamicResource DecoBorder_E2E8F0}" StrokeThickness="1.5" IsVisible="{Binding IsOffline}"/>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- v0.7.115.0 (deficiency report): name labels in their own layers, each at exactly the rectangle
                         MapLabelLayout placed it in, so what the harness checks for overlap is what is drawn. Not
                         clickable, so they never steal a click meant for a dot; NoWrap so the width stays one line. -->
                    <ItemsControl ItemsSource="{Binding BaseMapPoints}" IsHitTestVisible="False">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:BaseMapPointDto">
                          <TextBlock Text="{Binding GuildName}" Margin="{Binding LabelPosition}" HorizontalAlignment="Left" VerticalAlignment="Top"
                                     TextWrapping="NoWrap" Foreground="{DynamicResource AmberBrush}" FontSize="9"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding PlayerMapPoints}" IsHitTestVisible="False">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:PlayerMapPointDto">
                          <Panel HorizontalAlignment="Left" VerticalAlignment="Top" Margin="{Binding LabelPosition}">
                            <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" Foreground="White" FontSize="10" FontWeight="SemiBold" IsVisible="{Binding IsOnline}"/>
                            <TextBlock Text="{Binding Name}" TextWrapping="NoWrap" Foreground="{DynamicResource DecoForeground_CBD5E0}" FontSize="10" IsVisible="{Binding IsOffline}"/>
                          </Panel>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
              </Viewbox>
            </Border>

            <StackPanel Grid.Column="1" Spacing="12">
              <Border Classes="card accentWorld">
                <StackPanel Spacing="8">
                  <TextBlock Text="{services:Tr ui.world_map_players_and_bases}" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="{services:Tr ui.solid_green_dots_are_online_players_at_their_liv_44b657}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                  <TextBlock Text="{services:Tr ui.scroll_to_zoom_drag_to_pan_click_a_marker_or_a_n_7d2c6a}" TextWrapping="Wrap"/>
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="{services:TrText MapZoomText}" VerticalAlignment="Center" Margin="0,0,12,6"/>
                    <Button Classes="caution" Content="{services:Tr ui.reset_view}" Command="{Binding ResetMapViewCommand}" IsEnabled="{Binding IsMapZoomed}" Margin="0,0,12,6" ToolTip.Tip="{services:Tr ui.zooms_back_out_to_the_whole_map}"/>
                    <CheckBox Content="{services:Tr ui.show_offline_players_last_known_position}" IsChecked="{Binding ShowOfflinePlayersOnMap}" Margin="0,0,0,6" ToolTip.Tip="{services:Tr ui.draws_players_who_are_not_online_at_the_last_pos_6351ae}"/>
                  </WrapPanel>
                  <WrapPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding MapPresets}">
                      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:MapPreset">
                          <Button Classes="listItem" Content="{Binding DisplayName}" Margin="0,0,8,8"
                                  Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SetMapPresetCommand}"
                                  CommandParameter="{Binding}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Classes="open" Content="{services:Tr ui.browse_for_map_background}" Click="BrowseMapBackground_Click" Margin="0,0,8,8"/>
                    <Button Classes="caution" Content="{services:Tr ui.clear_background}" Command="{Binding ClearMapBackgroundCommand}" Margin="0,0,8,8"/>
                    <Button Classes="info" Content="{services:Tr ui.refresh}" Command="{Binding RefreshPlayersCommand}" Margin="0,0,8,8" ToolTip.Tip="{services:Tr ui.re_reads_online_players_and_base_locations}"/>
                  </WrapPanel>
                  <CheckBox Content="{services:Tr ui.real_world_positions_and_bases_palpagos}" IsChecked="{Binding UseCalibratedWorldPositions}" IsVisible="{Binding IsPalpagosMapActive}" ToolTip.Tip="{services:Tr ui.places_players_and_guild_bases_on_the_palpagos_m_c7f0d4}"/>
                  <TextBlock Text="{services:TrText MapBackgroundStatusText}" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock Text="{services:TrText MapPlayersStatusText}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
                  <TextBlock Text="{services:Tr ui.pick_the_palpagos_preset_above_to_see_real_playe_0b4218}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" IsVisible="{Binding !IsPalpagosMapActive}"/>
                  <WrapPanel Orientation="Horizontal" IsVisible="{Binding IsBaseMarkersActive}">
                    <CheckBox Content="{services:Tr ui.show_guild_bases}" IsChecked="{Binding ShowBasesOnMap}" Margin="0,0,10,6"/>
                    <CheckBox Content="{services:Tr ui.show_pals_at_bases_and_in_parties}" IsChecked="{Binding ShowPalsOnMap}" Margin="0,0,10,6" ToolTip.Tip="{services:Tr ui.violet_circles_are_owned_pals_at_the_last_positi_6a5074}"/>
                    <Button Classes="info" Content="{services:Tr ui.refresh_bases}" Command="{Binding RefreshMapBasesCommand}" Margin="0,0,10,6"/>
                  </WrapPanel>
                  <TextBlock Text="{services:TrText MapBasesStatusText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" IsVisible="{Binding IsBaseMarkersActive}"/>
                  <TextBlock Text="{services:TrText MapPalsStatusText}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" IsVisible="{Binding IsBaseMarkersActive}"/>
                </StackPanel>
              </Border>
              <Border Classes="card accentWorld">
                <StackPanel Spacing="8">
                  <TextBlock Text="{services:Tr ui.players_on_the_map}" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="{services:Tr ui.online_offline_last_known_position_click_a_name_1be6cc}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                  <TextBlock Text="{Binding SelectedPlayerRecord.PlayerName, StringFormat='Selected: {0}', FallbackValue='No player selected. Click a dot or a name.'}" TextTrimming="CharacterEllipsis"/>
                  <WrapPanel Orientation="Horizontal">
                    <Button Classes="apply" Content="{services:Tr ui.teleport_to_me}" Command="{Binding TeleportPlayerToMeCommand}" IsEnabled="{Binding CanManageAdmin}" Margin="0,0,8,8" ToolTip.Tip="{services:Tr ui.summons_the_selected_online_player_to_your_admin_67d902}"/>
                    <Button Classes="apply" Content="{services:Tr ui.teleport_to_player}" Command="{Binding TeleportToPlayerCommand}" IsEnabled="{Binding CanManageAdmin}" Margin="0,0,8,8" ToolTip.Tip="{services:Tr ui.moves_your_admin_character_to_the_selected_onlin_c77733}"/>
                  </WrapPanel>
                  <TextBlock Text="{services:Tr ui.palworld_s_vanilla_rcon_has_no_teleport_to_coord_cda233}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding PlayerMapPoints}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:PlayerMapPointDto">
                        <Button Classes="listItem" Margin="0,0,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SelectMapPlayerCommand}"
                                CommandParameter="{Binding PlayerId}">
                          <TextBlock Text="{services:TrText ListText}" TextTrimming="CharacterEllipsis"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <!-- v0.7.113.0: Teleport Points. The game's own fast travel cannot be opened up from the
                   server (only bEnableFastTravel / bEnableFastTravelOnlyBaseCamp exist), so players type a
                   chat command and MystTiq runs PalDefender's tp over RCON. See HeadlessTeleportService. -->
              <Border Classes="card accentWorld" IsVisible="{Binding CanOperate}" IsEnabled="{Binding CanManageAdmin}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{services:Tr ui.teleport_points}" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="{services:Tr ui.named_spots_players_can_teleport_to_from_anywher_4ef3f7}"
                             Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                  <WrapPanel Orientation="Horizontal">
                    <CheckBox Content="{services:Tr ui.let_players_use_the_chat_command}" IsChecked="{Binding TeleportEnabled}" Margin="0,0,14,6"/>
                    <TextBlock Text="{services:Tr ui.command}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                    <TextBox Text="{Binding TeleportCommandPrefix}" Width="90" Margin="0,0,14,6" ToolTip.Tip="{services:Tr ui.starts_with_or_so_it_never_clashes_with_paldefen_cb6a1b}"/>
                    <TextBlock Text="{services:Tr ui.cooldown_s}" VerticalAlignment="Center" Margin="0,0,6,6"/>
                    <NumericUpDown Value="{Binding TeleportCooldownSeconds}" Minimum="0" Maximum="3600" FormatString="0" Width="130" Margin="0,0,0,6" ToolTip.Tip="{services:Tr ui.how_long_a_player_waits_between_teleports}"/>
                  </WrapPanel>
                  <TextBox Text="{Binding TeleportPointsText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" MaxHeight="200"
                           PlaceholderText="{services:Tr ui.one_per_line_name_then_x_y_optional_height_spawn_c9162e}"/>
                  <TextBlock Text="{services:Tr ui.coordinates_are_paldefender_s_own_what_its_getpo_038d13}"
                             Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                  <WrapPanel Orientation="Horizontal">
                    <Button Classes="apply" Content="{services:Tr ui.save_points}" Command="{Binding SaveTeleportCommand}" Margin="0,0,8,8"/>
                    <Button Classes="apply" Content="{services:Tr ui.capture_selected_player_s_position}" Command="{Binding CaptureTeleportPositionCommand}" Margin="0,0,8,8" ToolTip.Tip="{services:Tr ui.asks_paldefender_where_the_selected_online_playe_6a7616}"/>
                    <Button Classes="info" Content="{services:Tr ui.refresh}" Command="{Binding RefreshTeleportCommand}" Margin="0,0,8,8"/>
                  </WrapPanel>
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <TextBlock Text="{services:Tr ui.send_selected_player_to}" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding TeleportSendPointName}" PlaceholderText="{services:Tr ui.point_name}"/>
                    <Button Classes="apply" Grid.Column="2" Content="{services:Tr ui.send}" Command="{Binding SendPlayerToTeleportPointCommand}" ToolTip.Tip="{services:Tr ui.teleports_the_selected_online_player_to_a_saved_b0d643}"/>
                  </Grid>
                  <TextBlock Text="{services:TrText TeleportStatusText}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
                  <TextBlock Text="{services:TrText TeleportProviderText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                  <TextBlock Text="{services:TrText TeleportChatSourceText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding TeleportRecentUses}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:TeleportUseDto">
                        <TextBlock Text="{services:TrText ListText}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <!-- v0.8.11.0: one row per Pals marker, so a cluster can be found and zoomed without hunting on the map. -->
              <Border Classes="card accentWorld" IsVisible="{Binding IsBaseMarkersActive}">
                <StackPanel Spacing="8">
                  <TextBlock Text="{services:Tr ui.pals_on_the_map}" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="{services:Tr ui.violet_owned_pals_at_the_last_position_the_save_0bccfb}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding PalMapPoints}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:PalMapPointDto">
                        <Button Classes="listItem" Margin="0,0,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ZoomToPalGroupCommand}"
                                CommandParameter="{Binding Key}" ToolTip.Tip="{services:TrText Tooltip}">
                          <TextBlock Text="{services:TrText ListText}" Foreground="{DynamicResource DecoForeground_9F7AEA}" TextTrimming="CharacterEllipsis"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <Border Classes="card accentWorld">
                <StackPanel Spacing="8">
                  <TextBlock Text="{services:Tr ui.guild_bases}" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="{services:Tr ui.in_game_map_coordinates_as_the_game_s_own_map_sh_0b705a}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                  <ItemsControl ItemsSource="{Binding BaseMapPoints}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:BaseMapPointDto">
                        <Button Classes="listItem" Margin="0,0,0,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).ZoomToBaseCommand}"
                                CommandParameter="{Binding BaseId}">
                          <TextBlock Text="{services:TrText ListText}" Foreground="{DynamicResource AmberBrush}" TextTrimming="CharacterEllipsis"/>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsPlayersPage}" Spacing="12">
          <Border Classes="card accentWorld">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="12">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                  <TextBlock Text="{services:Tr ui.player_directory}" FontSize="21" FontWeight="SemiBold"/>
                  <TextBlock Text="{services:TrText PlayersPageState}" Foreground="{DynamicResource GreenBrush}"/>
                  <TextBlock Text="{services:TrText PlayersPageDetail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{services:TrText PlayerVisibleCountText}" Foreground="{DynamicResource VioletBrush}" VerticalAlignment="Center"/>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="2*,*,*,Auto" ColumnSpacing="10">
                <TextBox PlaceholderText="{services:Tr ui.search_player_id_guild_or_platform}" Text="{Binding PlayerSearchText}"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.a11y_player_filter}" Grid.Column="1" ItemsSource="{Binding PlayerViewFilters}" SelectedItem="{Binding SelectedPlayerViewFilter}"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.a11y_admin_filter}" Grid.Column="2" ItemsSource="{Binding PlayerAdminFilters}" SelectedItem="{Binding SelectedPlayerAdminFilter}"/>
                <!-- v0.7.18.0: requested directly: a selectable way to hide rows that share a
                     display name with another record (a rejoin under a different platform ID, a
                     stale entry from an old save, etc.). View-only: nothing is deleted or merged,
                     so unchecking always restores every record. -->
                <!-- v0.7.42.0: Discover Saves/Export CSV moved to the ribbon. -->
                <CheckBox Grid.Column="3" Content="{services:Tr ui.hide_duplicate_names}" IsChecked="{Binding HideDuplicatePlayerNames}" VerticalAlignment="Center" ToolTip.Tip="{services:Tr ui.shows_only_one_row_per_player_name_preferring_on_e7f24c}"/>
              </Grid>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="3*,2*" ColumnSpacing="14">
            <Border Classes="card accentWorld">
              <Grid RowDefinitions="Auto,*" RowSpacing="8">
                <TextBlock Text="{services:Tr ui.live_and_known_players}" FontSize="17" FontWeight="SemiBold"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding FilteredPlayerRecords}" SelectedItem="{Binding SelectedPlayerRecord}" MaxHeight="520" ToolTip.Tip="{services:Tr ui.select_a_player_right_click_online_records_for_s_ff8201}">
                  <ListBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{services:Tr ui.kick_player}" Command="{Binding KickSelectedPlayerCommand}" IsEnabled="{Binding CanManageAdmin}" ToolTip.Tip="{services:Tr ui.available_only_while_the_selected_player_is_onli_f21796}"/>
                      <MenuItem Header="{services:Tr ui.ban_player}" Command="{Binding BanSelectedPlayerCommand}" IsEnabled="{Binding CanManageAdmin}" ToolTip.Tip="{services:Tr ui.available_only_while_the_selected_player_is_onli_f21796}"/>
                      <Separator/>
                      <MenuItem Header="{services:Tr ui.copy_player_data_from}" Click="CopyIntoPlayer_OnClick" IsEnabled="{Binding CanManageAdmin}" ToolTip.Tip="{services:Tr ui.copies_inventory_recipes_records_skins_and_quest_c1ee83}"/>
                      <MenuItem Header="{services:Tr ui.delete_player_completely}" Click="DeletePlayer_OnClick" IsEnabled="{Binding CanManageAdmin}" ToolTip.Tip="{services:Tr ui.permanently_deletes_this_player_s_save_file_and_a85585}"/>
                      <Separator/>
                      <MenuItem Header="{services:Tr ui.whisper_backend_required}" Command="{Binding WhisperSelectedPlayerCommand}" IsEnabled="False"/>
                      <MenuItem Header="{services:Tr ui.promote_backend_required}" Command="{Binding PromoteSelectedPlayerCommand}" IsEnabled="False"/>
                      <MenuItem Header="{services:Tr ui.give_items_typed_in_player_administration}" Command="{Binding GiveItemSelectedPlayerCommand}" ToolTip.Tip="{services:Tr ui.gives_the_items_and_pals_typed_in_the_give_box_u_d5e13e}"/>
                    </ContextMenu>
                  </ListBox.ContextMenu>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:PlayerExplorerItemDto">
                      <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="3,10">
                        <Grid ColumnDefinitions="2*,1.35*,*,*,*" ColumnSpacing="12">
                          <StackPanel Spacing="2">
                            <TextBlock Text="{Binding PlayerName}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding PlayerId}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="{services:Tr ui.steam_identity}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                            <TextBlock Text="{Binding SteamIdentityVerbatim}" FontFamily="Consolas, monospace" FontSize="10" TextTrimming="CharacterEllipsis"/>
                          </StackPanel>
                          <StackPanel Grid.Column="2"><TextBlock Text="{services:TrText OnlineText}" Foreground="{DynamicResource GreenBrush}"/><TextBlock Text="{services:TrText Platform}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel>
                          <StackPanel Grid.Column="3"><TextBlock Text="{services:TrText SaveStateText}"/><TextBlock Text="{services:TrText SaveSizeText}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel>
                          <StackPanel Grid.Column="4"><TextBlock Text="{Binding GuildName}"/><TextBlock Text="{services:TrText Ping}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/></StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="14">
              <Border Classes="card accentWorld">
                <StackPanel Spacing="7">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{services:Tr ui.selected_player}" FontSize="17" FontWeight="SemiBold"/><Button Classes="info" Grid.Column="1" Content="{services:Tr ui.load_metadata}" Command="{Binding LoadPlayerMetadataCommand}"/></Grid>
                  <TextBlock Text="{Binding SelectedPlayerRecord.PlayerName}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource VioletBrush}"/>
                  <TextBlock Text="{Binding SelectedPlayerRecord.PlayerId}" Foreground="{DynamicResource MutedBrush}"/>
                  <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="8" RowSpacing="3">
                    <TextBlock Text="{services:Tr ui.steam_id}" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding SelectedPlayerRecord.SteamIdVerbatim}" FontFamily="Consolas, monospace" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Row="1" Text="{services:Tr ui.palworld_user_id}" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPlayerRecord.UserIdVerbatim}" FontFamily="Consolas, monospace" TextTrimming="CharacterEllipsis"/>
                  </Grid>
                  <Button Classes="open" Content="{services:Tr ui.open_steam_profile}" HorizontalAlignment="Left" IsVisible="{Binding SelectedPlayerRecord.HasSteamId}" Tag="{Binding SelectedPlayerRecord.SteamId}" Click="OpenSteamProfile_OnClick"/>
                  <TextBlock Text="{services:TrText SelectedPlayerRecord.OnlineText}"/>
                  <TextBlock Text="{services:TrText SelectedPlayerRecord.SaveStateText}"/>
                  <TextBlock Text="{services:TrText SelectedPlayerRecord.UpdatedText}" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock Text="{Binding SelectedPlayerRecord.GuildName}"/>
                  <TextBlock Text="{services:TrText SelectedPlayerRecord.Role}" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock Text="{services:TrText SelectedPlayerRecord.Evidence}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                  <TextBlock Text="{services:TrText PlayerRegistrySummaryText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>

              <Border Classes="card accentWorld">
                <StackPanel Spacing="8">
                  <TextBlock Text="{services:Tr ui.notes_and_warnings}" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="{services:TrText PlayerMetadataState}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                  <TextBox PlaceholderText="{services:Tr ui.private_operator_notes}" Text="{Binding SelectedPlayerNotes}" AcceptsReturn="True" MinHeight="78" MaxLength="4000" TextWrapping="Wrap"/>
                  <Button Classes="apply" Content="{services:Tr ui.save_notes}" Command="{Binding SavePlayerNotesCommand}"/>
                  <TextBox PlaceholderText="{services:Tr ui.add_an_operator_warning}" Text="{Binding NewPlayerWarning}" MaxLength="1000"/>
                  <Button Content="{services:Tr ui.add_warning}" Command="{Binding AddPlayerWarningCommand}" Classes="apply"/>
                  <ListBox AutomationProperties.Name="{services:Tr ui.notes_and_warnings}" ItemsSource="{Binding SelectedPlayerWarnings}" MaxHeight="130">
                    <ListBox.ItemTemplate><DataTemplate x:DataType="models:PlayerWarningDto"><TextBlock Text="{services:TrText DisplayText}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <!-- v0.7.99.0: the live map moved to its own page under World. -->
          <Border Classes="card accentWorld">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <TextBlock Text="{services:Tr ui.the_live_map_of_online_players_and_guild_bases_h_be8885}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
              <Button Classes="open" Grid.Column="1" Content="{services:Tr ui.open_map}" Command="{Binding NavigateCommand}" CommandParameter="Map"/>
            </Grid>
          </Border>

          <Border Classes="card accentWorld">
            <StackPanel Spacing="9">
              <TextBlock Text="{services:Tr ui.player_administration}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{services:Tr ui.kick_and_ban_route_through_the_palworld_rest_api_8c91fd}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="2*,Auto,Auto" ColumnSpacing="10">
                <TextBox PlaceholderText="{services:Tr ui.kick_ban_reason}" Text="{Binding PlayerActionMessage}"/>
                <Button Grid.Column="1" Content="{services:Tr ui.kick}" Command="{Binding KickSelectedPlayerCommand}" IsEnabled="{Binding CanManageAdmin}" Classes="danger"/>
                <Button Grid.Column="2" Content="{services:Tr ui.ban}" Command="{Binding BanSelectedPlayerCommand}" IsEnabled="{Binding CanManageAdmin}" Classes="danger"/>
              </Grid>
              <!-- v0.7.15.0: the "Whitelist" stub button was removed here (stale dead UI: the real
                   Whitelist feature already shipped in v0.7.10.0 with its own working card further
                   down this same page). The "Temporary Ban" stub was replaced with a real duration
                   field + button (HeadlessTemporaryBanService). The "Remove Admin" stub was removed
                   outright: Palworld has no per-player admin grant/revoke concept at all (RCON's
                   AdminPassword is a single server-wide credential, not a per-player flag), so this
                   stub had no real backend capability to ever point at. -->
              <WrapPanel Orientation="Horizontal">
                <Button Classes="apply" Content="{services:Tr ui.unban}" Command="{Binding UnbanSelectedPlayerCommand}" IsEnabled="{Binding CanManageAdmin}" Margin="0,0,8,8" ToolTip.Tip="{services:Tr ui.removes_the_selected_player_s_steam_userid_from_a211e9}"/>
                <Button Classes="apply" Content="{services:Tr ui.teleport_to_me}" Command="{Binding TeleportPlayerToMeCommand}" IsEnabled="{Binding CanManageAdmin}" Margin="0,0,8,8" ToolTip.Tip="{services:Tr ui.summons_the_selected_online_player_to_your_admin_2f6256}"/>
                <Button Classes="apply" Content="{services:Tr ui.teleport_to_player}" Command="{Binding TeleportToPlayerCommand}" IsEnabled="{Binding CanManageAdmin}" Margin="0,0,8,8" ToolTip.Tip="{services:Tr ui.moves_your_admin_character_to_the_selected_onlin_91d9e9}"/>
              </WrapPanel>
              <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock VerticalAlignment="Center" Text="{services:Tr ui.temp_ban}" Classes="muted"/>
                <NumericUpDown Grid.Column="1" Width="120" Minimum="0.1" Maximum="720" Increment="1" FormatString="F1" Value="{Binding NewTemporaryBanDurationHours}" ToolTip.Tip="{services:Tr ui.duration_in_hours_before_this_ban_is_automatical_527be4}"/>
                <Button Grid.Column="2" Content="{services:Tr ui.temp_ban_560bdc}" Command="{Binding CreateTemporaryBanCommand}" Classes="danger" ToolTip.Tip="{services:Tr ui.bans_the_selected_online_player_immediately_same_0f5bde}"/>
              </Grid>
              <!-- v0.7.112.0: Give Item. Vanilla Palworld has no give command; this goes through PalDefender's
                   giveitems/givepal over RCON, the same provider Starter Kits use, and says so when it is
                   missing. Same line format as the kit editor. -->
              <TextBlock Text="{services:Tr ui.give_items_or_pals}" IsVisible="{Binding CanManageAdmin}" FontWeight="SemiBold" Margin="0,4,0,0"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding CanManageAdmin}">
                <TextBox Text="{Binding GiveItemsText}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="140"
                         PlaceholderText="{services:Tr ui.one_per_line_item_palsphere_10_pal_weaseldragon_9c778c}"/>
                <Button Grid.Column="1" Content="{services:Tr ui.give}" VerticalAlignment="Top" Classes="apply" Command="{Binding GiveItemSelectedPlayerCommand}" ToolTip.Tip="{services:Tr ui.gives_these_to_the_selected_online_player_throug_2328b5}"/>
              </Grid>
              <TextBlock IsVisible="{Binding CanManageAdmin}" Text="{services:Tr ui.lines_use_palworld_s_internal_ids_the_same_ones_e66c62}"
                         Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              <!-- v0.8.3.0: item picker. Lists the item and Pal ids this server's own world save contains (so they
                   are the installed game version's ids), plus kit ids and earlier gives; adds a line to the Give box
                   or the selected Starter Kit. -->
              <Border x:Name="GameIdPicker" Classes="statuscard accentWorld" IsVisible="{Binding CanOperate}">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{services:Tr ui.find_an_item_or_pal}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding GameIdFilterText}" PlaceholderText="{services:Tr ui.search_names_or_ids_e_g_pal_sphere_lamball}"/>
                    <Button Classes="info" Grid.Column="2" Content="{services:Tr ui.load_ids}" Command="{Binding LoadGameIdsCommand}" ToolTip.Tip="{services:Tr ui.reads_the_item_and_pal_ids_that_occur_in_this_se_8cee74}"/>
                  </Grid>
                  <ListBox AutomationProperties.Name="{services:Tr ui.find_an_item_or_pal}" x:Name="GameIdList" ItemsSource="{Binding FilteredGameIds}" SelectedItem="{Binding SelectedGameId}" MaxHeight="170">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:GameIdCatalogEntryDto"><TextBlock Text="{services:TrText DisplayText}" FontSize="12"/></DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="{services:TrText GameIdAmountLabel}" VerticalAlignment="Center" Classes="muted" Margin="0,0,8,6"/>
                    <TextBox Text="{Binding GameIdAmountText}" Width="110" Margin="0,0,10,6" ToolTip.Tip="{services:Tr ui.items_how_many_1_to_1_000_000_pals_the_level_1_t_1c3680}"/>
                    <Button IsEnabled="{Binding CanManageAdmin}" Content="{services:Tr ui.add_to_give}" Classes="apply" Command="{Binding AddGameIdToGiveCommand}" Margin="0,0,8,6" ToolTip.Tip="{services:Tr ui.adds_the_selected_id_as_a_new_line_in_the_give_b_8aa12d}"/>
                    <Button Classes="apply" IsEnabled="{Binding CanManageAdmin}" Content="{services:Tr ui.add_to_selected_kit}" Command="{Binding AddGameIdToKitCommand}" Margin="0,0,8,6" ToolTip.Tip="{services:Tr ui.adds_the_selected_id_to_the_kit_selected_under_s_24f806}"/>
                  </WrapPanel>
                  <TextBlock Text="{services:TrText GameIdCatalogStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <!-- v1.0.4.0 (roadmap S-1, S-2; owner decision D-2): the selected player's main inventory from the world save. One
                   plain stack removed, or one added (the item picked above), each previewed and confirmed, applied with a fresh,
                   checked safety backup while the server is stopped. -->
              <Border x:Name="InventoryCard" Classes="statuscard accentWorld" IsVisible="{Binding CanManageAdmin}">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{services:Tr ui.inventory_saved}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Classes="info" Grid.Column="1" Content="{services:Tr ui.load_inventory}" Command="{Binding LoadInventoryCommand}"/>
                  </Grid>
                  <TextBlock Text="{services:Tr ui.inventory_saved_hint}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                  <ListBox AutomationProperties.Name="{services:Tr ui.inventory_saved}" x:Name="InventoryList" ItemsSource="{Binding InventorySlots}" SelectedItem="{Binding SelectedInventorySlot}" MaxHeight="200">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:InventorySlotDto">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                          <TextBlock Text="{Binding RowVerbatim}" FontFamily="Consolas, monospace" FontSize="12"/>
                          <TextBlock Text="{services:TrText RecordText}" Classes="muted" FontSize="11"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <WrapPanel>
                    <Button Classes="danger" Content="{services:Tr ui.remove_selected_stack}" Click="RemoveInventoryStack_OnClick" IsEnabled="{Binding CanManageAdmin}" Margin="0,0,8,6"/>
                    <Button Classes="apply" Content="{services:Tr ui.add_to_inventory}" Click="AddInventoryItem_OnClick" IsEnabled="{Binding CanManageAdmin}" Margin="0,0,8,6"/>
                  </WrapPanel>
                  <TextBlock Text="{services:TrText InventoryStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <!-- v1.0.6.0 (roadmap S-3): the selected player's Pal box from the world save; add a Pal (a copy of one of that
                   species already in a Pal box) or remove one, with a preview, a confirmation and a checked backup. -->
              <Border x:Name="PalBoxCard" Classes="statuscard accentWorld" IsVisible="{Binding CanManageAdmin}">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <TextBlock Text="{services:Tr ui.palbox_saved}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Classes="info" Grid.Column="1" Content="{services:Tr ui.load_palbox}" Command="{Binding LoadPalBoxCommand}"/>
                  </Grid>
                  <TextBlock Text="{services:Tr ui.palbox_saved_hint}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                  <ListBox AutomationProperties.Name="{services:Tr ui.palbox_saved}" x:Name="PalBoxList" ItemsSource="{Binding PalBoxPals}" SelectedItem="{Binding SelectedPalBoxPal}" MaxHeight="200">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:PalBoxPalDto">
                        <TextBlock Text="{Binding RowVerbatim}" FontFamily="Consolas, monospace" FontSize="12"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <WrapPanel>
                    <Button Classes="danger" Content="{services:Tr ui.remove_selected_pal}" Click="RemovePalBoxPal_OnClick" IsEnabled="{Binding CanManageAdmin}" Margin="0,0,8,6"/>
                    <ComboBox AutomationProperties.Name="{services:Tr ui.pal_to_add}" ItemsSource="{Binding PalBoxSpecies}" SelectedItem="{Binding SelectedPalBoxSpecies}" MinWidth="180" Margin="0,0,8,6"/>
                    <Button Classes="apply" Content="{services:Tr ui.add_to_palbox}" Click="AddPalBoxPal_OnClick" IsEnabled="{Binding CanManageAdmin}" Margin="0,0,8,6"/>
                  </WrapPanel>
                  <TextBlock Text="{services:TrText PalBoxStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <TextBlock Text="{services:TrText PlayerAdminStatusText}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText ModerationProviderStatusText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- BAN LIST (v0.7.8.0). Collapsed by default, matching the v0.7.5.0 no-scroll pattern:
               a secondary, occasional-use tool, not primary page content. -->
          <Border Classes="card accentWorld">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleBanListCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="▸" IsVisible="{Binding !IsBanListExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="▾" IsVisible="{Binding IsBanListExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="{services:Tr ui.ban_list}" FontSize="17" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Classes="info" Grid.Column="1" Content="{services:Tr ui.refresh}" Command="{Binding RefreshBanListCommand}" IsVisible="{Binding IsBanListExpanded}"/>
              </Grid>
              <StackPanel Spacing="8" IsVisible="{Binding IsBanListExpanded}">
                <TextBlock Text="{services:Tr ui.read_directly_from_the_server_via_rcon_banlist_b_527108}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBox AutomationProperties.Name="{services:Tr ui.ban_list}" Text="{Binding BanListText}" AcceptsReturn="True" IsReadOnly="True" MinHeight="90" MaxHeight="200" FontFamily="Consolas, monospace" FontSize="12"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- TEMPORARY BANS (v0.7.15.0). Collapsed by default, matching the v0.7.5.0 no-scroll
               pattern and Ban List's placement immediately above. Lists active auto-expiring bans
               applied via the "Temp Ban" control in the Player Administration card above; each one
               can be lifted early here, or left to expire on its own via the headless service's
               poll-driven sweep. -->
          <Border Classes="card accentWorld">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleTemporaryBansCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="▸" IsVisible="{Binding !IsTemporaryBansExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="▾" IsVisible="{Binding IsTemporaryBansExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="{services:Tr ui.temporary_bans}" FontSize="17" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Classes="info" Grid.Column="1" Content="{services:Tr ui.refresh}" Command="{Binding RefreshTemporaryBansCommand}" IsVisible="{Binding IsTemporaryBansExpanded}"/>
              </Grid>
              <StackPanel Spacing="8" IsVisible="{Binding IsTemporaryBansExpanded}">
                <TextBlock Text="{services:TrText TemporaryBanState}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <ListBox AutomationProperties.Name="{services:Tr ui.temporary_bans}" ItemsSource="{Binding TemporaryBans}" MaxHeight="200">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:TemporaryBanEntryDto">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel>
                          <TextBlock FontWeight="SemiBold" Text="{Binding PlayerName}"/>
                          <TextBlock Classes="muted" FontSize="11" Text="{services:TrText Reason}" TextWrapping="Wrap"/>
                          <TextBlock Classes="muted" FontSize="10" Text="{services:TrText RemainingText}"/>
                        </StackPanel>
                        <Button Classes="caution" Grid.Column="1" Content="{services:Tr ui.lift_now}" VerticalAlignment="Center"
                                Command="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).CancelTemporaryBanCommand}"
                                CommandParameter="{Binding PlayerId}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- WHITELIST (v0.7.10.0). Collapsed by default, matching the v0.7.5.0 no-scroll pattern.
               Named as an explicit deferred roadmap item before this release. Opt-in: when
               Enabled, any online player not on this list is automatically kicked (checked on the
               same poll cadence the player registry already uses). -->
          <Border Classes="card accentWorld" IsVisible="{Binding CanManageAdmin}" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleWhitelistCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="▸" IsVisible="{Binding !IsWhitelistExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="▾" IsVisible="{Binding IsWhitelistExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="{services:Tr ui.whitelist}" FontSize="17" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Classes="info" Grid.Column="1" Content="{services:Tr ui.refresh}" Command="{Binding RefreshWhitelistCommand}" IsVisible="{Binding IsWhitelistExpanded}"/>
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding IsWhitelistExpanded}">
                <TextBlock Text="{services:TrText WhitelistState}" Classes="muted" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="220,Auto" ColumnSpacing="10">
                  <TextBlock Text="{services:Tr ui.enabled_auto_kick_anyone_not_listed}" VerticalAlignment="Center" Classes="muted"/>
                  <CheckBox AutomationProperties.Name="{services:Tr ui.enabled_auto_kick_anyone_not_listed}" Grid.Column="1" IsChecked="{Binding WhitelistConfig.Enabled}"/>
                </Grid>
                <Grid ColumnDefinitions="*,180,Auto" ColumnSpacing="10">
                  <TextBox Text="{Binding NewWhitelistPlayerId}" PlaceholderText="{services:Tr ui.steam_userid}"/>
                  <TextBox Grid.Column="1" Text="{Binding NewWhitelistLabel}" PlaceholderText="{services:Tr ui.label_optional}"/>
                  <Button Classes="apply" Grid.Column="2" Content="{services:Tr ui.add}" Command="{Binding AddWhitelistEntryCommand}"/>
                </Grid>
                <ListBox AutomationProperties.Name="{services:Tr ui.whitelist}" ItemsSource="{Binding WhitelistEntries}" SelectedItem="{Binding SelectedWhitelistEntry}" MaxHeight="180">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:WhitelistEntryDto">
                      <Grid ColumnDefinitions="*,180"><TextBlock Text="{Binding PlayerId}"/><TextBlock Grid.Column="1" Text="{services:TrText Label}" Classes="muted"/></Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="danger" Content="{services:Tr ui.remove_selected}" Command="{Binding RemoveWhitelistEntryCommand}"/>
                  <Button Classes="apply" Content="{services:Tr ui.save_whitelist}" Command="{Binding SaveWhitelistCommand}"/>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- UNIQUE PLAYER NAMES (v1.0.0.2). Each name belongs to the first account seen with it, or to the account it is
               reserved for; case is ignored. The service checks on the same poll as the whitelist and turns away a player
               using another account's name (HeadlessNameGuardService). -->
          <Border x:Name="UniqueNamesCard" Classes="card accentWorld" IsVisible="{Binding CanManageAdmin}" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleNameGuardCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="▸" IsVisible="{Binding !IsNameGuardExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="▾" IsVisible="{Binding IsNameGuardExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="{services:Tr ui.unique_names}" FontSize="17" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Classes="info" Grid.Column="1" Content="{services:Tr ui.refresh}" Command="{Binding RefreshNameGuardCommand}" IsVisible="{Binding IsNameGuardExpanded}"/>
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding IsNameGuardExpanded}">
                <TextBlock Text="{services:Tr ui.unique_names_hint}" Classes="muted" TextWrapping="Wrap"/>
                <TextBlock Text="{services:TrText NameGuardState}" TextWrapping="Wrap"/>
                <CheckBox Content="{services:Tr ui.unique_names_enabled}" IsChecked="{Binding NameGuardConfig.Enabled}"/>
                <CheckBox Content="{services:Tr ui.unique_names_kick}" IsChecked="{Binding NameGuardConfig.KickDuplicates}" IsEnabled="{Binding NameGuardConfig.Enabled}"/>
                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="10">
                  <TextBox AutomationProperties.Name="{services:Tr ui.reserve_name}" Text="{Binding NewReservedName}" PlaceholderText="{services:Tr ui.reserve_name}"/>
                  <TextBox Grid.Column="1" AutomationProperties.Name="{services:Tr ui.reserve_owner}" Text="{Binding NewReservedOwner}" PlaceholderText="{services:Tr ui.reserve_owner}"/>
                  <Button Classes="apply" Grid.Column="2" Content="{services:Tr ui.reserve}" Command="{Binding ReserveNameCommand}"/>
                </Grid>
                <ListBox AutomationProperties.Name="{services:Tr ui.unique_names}" ItemsSource="{Binding NameClaims}" SelectedItem="{Binding SelectedNameClaim}" MaxHeight="220">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:NameClaimDto">
                      <Grid ColumnDefinitions="*,*,160" ColumnSpacing="8">
                        <TextBlock Text="{Binding NameVerbatim}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding OwnerVerbatim}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="{services:TrText Kind}" Classes="muted"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="caution" Content="{services:Tr ui.release_selected}" Command="{Binding ReleaseNameCommand}"/>
                  <Button Classes="apply" Content="{services:Tr ui.save_unique_names}" Command="{Binding SaveNameGuardCommand}"/>
                </StackPanel>
                <StackPanel Spacing="4" IsVisible="{Binding HasNameGuardEvents}">
                  <TextBlock Text="{services:Tr ui.unique_names_turned_away}" FontWeight="SemiBold"/>
                  <ItemsControl ItemsSource="{Binding NameGuardEvents}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:NameGuardEventDto">
                        <Grid ColumnDefinitions="140,*,*,110" ColumnSpacing="8">
                          <TextBlock Text="{Binding AtVerbatim}" Classes="muted"/>
                          <TextBlock Grid.Column="1" Text="{Binding NameVerbatim}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="2" Text="{Binding UserIdVerbatim}" Classes="muted" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Grid.Column="3" Text="{services:TrText Outcome}" Classes="muted"/>
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- STARTER KITS (v0.7.94.0). Delivery uses PalDefender's give commands over RCON, since
               vanilla Palworld has no give command; the card shows the real provider status and a Test
               button. Auto-gift only ever applies to players first seen after it is switched on. -->
          <Border Classes="card accentWorld" IsVisible="{Binding CanManageAdmin}" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleKitsCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="▸" IsVisible="{Binding !IsKitsExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="▾" IsVisible="{Binding IsKitsExpanded}" FontWeight="Bold"/>
                    <TextBlock Text="{services:Tr ui.starter_kits}" FontSize="17" FontWeight="SemiBold"/>
                  </StackPanel>
                </Button>
                <Button Classes="info" Grid.Column="1" Content="{services:Tr ui.refresh}" Command="{Binding RefreshKitsCommand}" IsVisible="{Binding IsKitsExpanded}"/>
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding IsKitsExpanded}">
                <TextBlock Text="{services:TrText KitStatusText}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{services:TrText KitProviderText}" Classes="muted" TextWrapping="Wrap"/>
                <Button Classes="verify" Content="{services:Tr ui.test_paldefender}" Command="{Binding TestKitProviderCommand}" HorizontalAlignment="Left" ToolTip.Tip="{services:Tr ui.sends_the_version_command_over_rcon_and_shows_th_6319b4}"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{services:Tr ui.kits}" FontWeight="SemiBold"/>
                    <ListBox AutomationProperties.Name="{services:Tr ui.kits}" ItemsSource="{Binding Kits}" SelectedItem="{Binding SelectedKit}" MaxHeight="180">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:KitDefinitionDto"><TextBlock Text="{services:TrText DisplayText}"/></DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <Button Classes="apply" Content="{services:Tr ui.new_kit}" Command="{Binding NewKitCommand}"/>
                      <Button Classes="danger" Content="{services:Tr ui.delete_kit}" Command="{Binding DeleteKitCommand}"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Spacing="6" IsEnabled="{Binding HasSelectedKit}">
                    <TextBlock Text="{services:Tr ui.selected_kit}" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding KitNameText, Mode=TwoWay}" PlaceholderText="{services:Tr ui.kit_name}" MaxLength="64"/>
                    <TextBox Text="{Binding KitEntriesText, Mode=TwoWay}" AcceptsReturn="True" MinHeight="110" FontFamily="Consolas, monospace" FontSize="12"
                             PlaceholderText="{services:Tr ui.one_per_line_item_palsphere_10_pal_weaseldragon_9c778c}"/>
                    <TextBlock Text="{services:Tr ui.tip_find_an_item_or_pal_under_player_administrat_167e7f}"
                               Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
                </Grid>
                <Border Classes="statuscard accentWorld">
                  <StackPanel Spacing="6">
                    <CheckBox Content="{services:Tr ui.auto_gift_the_chosen_kit_to_new_players}" IsChecked="{Binding KitAutoGiftEnabled}"/>
                    <ComboBox ItemsSource="{Binding Kits}" SelectedItem="{Binding KitAutoGiftKit}" MinWidth="260" HorizontalAlignment="Left" PlaceholderText="{services:Tr ui.kit_to_auto_gift}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="models:KitDefinitionDto"><TextBlock Text="{services:TrText DisplayText}"/></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Text="{services:TrText KitAutoGiftNote}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Classes="apply" Content="{services:Tr ui.save_kits}" Command="{Binding SaveKitsCommand}"/>
                  <Button Classes="apply" Content="{services:Tr ui.give_kit_to_selected_player}" Command="{Binding GiveSelectedKitCommand}" ToolTip.Tip="{services:Tr ui.gives_the_selected_kit_to_the_player_selected_in_d833e0}"/>
                  <Button Classes="caution" Content="{services:Tr ui.reset_player_s_claims}" Command="{Binding ResetKitClaimCommand}" ToolTip.Tip="{services:Tr ui.lets_auto_gift_give_this_player_the_kit_again_if_bf254d}"/>
                </StackPanel>
                <TextBlock Text="{services:Tr ui.recent_claims}" FontWeight="SemiBold"/>
                <ListBox AutomationProperties.Name="{services:Tr ui.recent_claims}" ItemsSource="{Binding KitClaims}" MaxHeight="120">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:KitClaimDto"><TextBlock Text="{services:TrText DisplayText}" FontSize="11"/></DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- PAL EDITOR (v0.6.15.0 "Save-Data Edit Engine Foundation"): relocated here from the
               Guilds page in v0.7.1.0, since editing an individual Pal has no conceptual tie to
               guild ownership and belongs alongside the rest of this page's player-focused tools.
               Collapsed by default since v0.7.5.0 (no-scroll pass 1). -->
          <Button Classes="sectionToggle" Command="{Binding TogglePalEditorCommand}">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="▸" IsVisible="{Binding !IsPalEditorExpanded}" FontWeight="Bold"/>
              <TextBlock Text="▾" IsVisible="{Binding IsPalEditorExpanded}" FontWeight="Bold"/>
              <TextBlock Text="{services:Tr ui.pal_editor}" FontSize="17" FontWeight="SemiBold"/>
            </StackPanel>
          </Button>
          <Grid ColumnDefinitions="3*,2*" ColumnSpacing="14" IsVisible="{Binding IsPalEditorExpanded}">
            <Border Classes="card accentWorld">
              <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{services:Tr ui.pal_editor}" FontSize="18" FontWeight="SemiBold"/><Button Classes="info" Grid.Column="1" Content="{services:Tr ui.refresh_pals}" Command="{Binding RefreshPalsCommand}"/></Grid>
                <TextBlock Grid.Row="1" Text="{services:Tr ui.individual_pal_stat_identity_editing_decoded_fro_c219fa}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <ListBox AutomationProperties.Name="{services:Tr ui.pal_editor}" Grid.Row="2" ItemsSource="{Binding ExplorerPals}" SelectedItem="{Binding SelectedExplorerPal}" MaxHeight="420">
                  <ListBox.ItemTemplate><DataTemplate x:DataType="models:PalInstanceDto"><Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="10" Margin="0,6"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{services:TrText OwnerDisplay}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding Level, StringFormat='Lv. {0}'}" VerticalAlignment="Center"/><Border Grid.Column="2" Classes="tag info" IsVisible="{Binding IsRarePal}"><TextBlock Text="{services:Tr ui.lucky}"/></Border></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>
            <Border Classes="card accentWorld"><StackPanel Spacing="8">
              <TextBlock Text="{services:Tr ui.edit_selected_pal}" FontSize="17" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="6">
                <TextBlock Text="{services:Tr ui.nickname}" VerticalAlignment="Center"/><TextBox AutomationProperties.Name="{services:Tr ui.nickname}" Grid.Column="1" Text="{Binding PalEditNickName}"/>
                <TextBlock Grid.Row="1" Text="{services:Tr ui.level}" VerticalAlignment="Center"/><NumericUpDown AutomationProperties.Name="{services:Tr ui.level}" Grid.Row="1" Grid.Column="1" Minimum="1" Maximum="255" Value="{Binding PalEditLevel}"/>
                <TextBlock Grid.Row="2" Text="{services:Tr ui.rank}" VerticalAlignment="Center"/><NumericUpDown AutomationProperties.Name="{services:Tr ui.rank}" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="5" Value="{Binding PalEditRank}"/>
                <TextBlock Grid.Row="3" Text="{services:Tr ui.talent_hp}" VerticalAlignment="Center"/><NumericUpDown AutomationProperties.Name="{services:Tr ui.talent_hp}" Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PalEditTalentHp}"/>
                <TextBlock Grid.Row="4" Text="{services:Tr ui.talent_shot}" VerticalAlignment="Center"/><NumericUpDown AutomationProperties.Name="{services:Tr ui.talent_shot}" Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PalEditTalentShot}"/>
                <TextBlock Grid.Row="5" Text="{services:Tr ui.talent_def}" VerticalAlignment="Center"/><NumericUpDown AutomationProperties.Name="{services:Tr ui.talent_def}" Grid.Row="5" Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding PalEditTalentDefense}"/>
                <TextBlock Grid.Row="6" Text="{services:Tr ui.gender}" VerticalAlignment="Center"/><ComboBox AutomationProperties.Name="{services:Tr ui.gender}" Grid.Row="6" Grid.Column="1" ItemsSource="{Binding PalGenderOptions}" SelectedItem="{Binding PalEditGender}"/>
              </Grid>
              <CheckBox Content="{services:Tr ui.lucky_israrepal}" IsChecked="{Binding PalEditIsRarePal}"/>
              <Button Classes="info" Content="{services:Tr ui.preview}" Command="{Binding PreviewPalEditCommand}"/>
              <TextBlock Text="{services:TrText PalEditStatusText}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
              <CheckBox Content="{services:Tr ui.i_reviewed_this_plan_and_confirm_the_active_palw_4fd78f}" IsChecked="{Binding PalEditConfirmed}"/>
              <Button Classes="danger" Content="{services:Tr ui.apply_with_fresh_safety_backup}" HorizontalAlignment="Left" Command="{Binding ApplyPalEditCommand}"/>
            </StackPanel></Border>
          </Grid>

          <Border Classes="card accentWorld" IsVisible="{Binding CanManageAdmin}" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="9">
              <TextBlock Text="{services:Tr ui.character_account_migration}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{services:Tr ui.migrate_a_source_player_s_guild_membership_to_an_60f4dd}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <StackPanel Spacing="4">
                  <TextBlock Text="{services:Tr ui.source_player}" Classes="muted"/>
                  <ComboBox AutomationProperties.Name="{services:Tr ui.source_player}" ItemsSource="{Binding PlayerRecords}" SelectedItem="{Binding MigrationSourcePlayer}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="models:PlayerExplorerItemDto"><TextBlock Text="{Binding PlayerName}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{services:Tr ui.destination_player}" Classes="muted"/>
                  <ComboBox AutomationProperties.Name="{services:Tr ui.destination_player}" ItemsSource="{Binding PlayerRecords}" SelectedItem="{Binding MigrationDestinationPlayer}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="models:PlayerExplorerItemDto"><TextBlock Text="{Binding PlayerName}"/></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
              </Grid>
              <Button Classes="info" Content="{services:Tr ui.preview_migration}" Command="{Binding PreviewCharacterMigrationCommand}"/>
              <TextBlock Text="{services:TrText MigrationState}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" IsVisible="{Binding MigrationPreview.CanApply}">
                <ComboBox AutomationProperties.Name="{services:Tr ui.a11y_source_character_afterwards}" ItemsSource="{Binding CharacterDispositionOptions}" SelectedItem="{Binding MigrationDisposition}"/>
                <Button Grid.Column="1" Content="{services:Tr ui.apply_migration}" Command="{Binding ApplyCharacterMigrationCommand}" Classes="danger"/>
              </Grid>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsMonitoringPage}" Spacing="12">
          <Border Classes="card accentServer" IsVisible="{Binding IsConsolePage}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="5">
                <TextBlock Text="{services:Tr ui.filter_search_pause_and_export_the_combined_pals_5c9e27}" Foreground="{DynamicResource MutedBrush}"/>
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{services:TrText ConsoleViewState}" Foreground="{DynamicResource GreenBrush}" VerticalAlignment="Center"/>
            </Grid>
          </Border>
          <Border Classes="card accentSystem" IsVisible="{Binding IsActivityAuditPage}">
            <StackPanel Spacing="5"><TextBlock Text="{services:Tr ui.review_persistent_mysttiq_management_api_activit_67dba3}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/></StackPanel>
          </Border>

          <Grid ColumnDefinitions="*,*,*,*,*" ColumnSpacing="14" IsVisible="{Binding IsActivityAuditPage}">
            <Border Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Text="{services:Tr ui.cpu}" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{services:TrText CpuText}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource VioletBrush}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Text="{services:Tr ui.palserver_ram}" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{services:TrText MemoryText}" FontSize="24" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="card">
              <StackPanel Spacing="6">
                <TextBlock Text="{services:Tr ui.threads}" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{services:TrText ThreadCountText}" FontSize="24" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
            <Border Grid.Column="3" Classes="card" ToolTip.Tip="{services:Tr ui.real_in_game_simulation_fps_from_palworld_s_own_b871c3}">
              <StackPanel Spacing="6">
                <TextBlock Text="{services:Tr ui.server_fps}" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{services:TrText ServerFpsText}" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}" />
              </StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="card" ToolTip.Tip="{services:Tr ui.real_in_game_frame_time_from_palworld_s_own_rest_105dbf}">
              <StackPanel Spacing="6">
                <TextBlock Text="{services:Tr ui.frame_time}" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{services:TrText ServerFrameTimeText}" FontSize="24" FontWeight="SemiBold" />
              </StackPanel>
            </Border>
          </Grid>

          <Border Classes="card accentSystem" IsVisible="{Binding IsActivityAuditPage}">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{services:Tr ui.mysttiq_activity_audit_log}" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="{services:TrText ActivityFileText}" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Classes="info" Content="{services:Tr ui.refresh_audit}" Command="{Binding RefreshActivityCommand}" ToolTip.Tip="{services:Tr ui.reload_persistent_mysttiq_management_and_api_act_03d42b}"/><Button Classes="info" Content="{services:Tr ui.export_visible}" Click="ExportActivity_Click"/><Button Classes="danger" Content="{services:Tr ui.clear_persistent_audit_policy_locked}" IsEnabled="False"/></StackPanel>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="2*,*,*" ColumnSpacing="8"><TextBox Text="{Binding ActivitySearchText}" PlaceholderText="{services:Tr ui.search_activity}"/><ComboBox AutomationProperties.Name="{services:Tr ui.a11y_severity_filter}" Grid.Column="1" ItemsSource="{Binding ActivitySeverityOptions}" SelectedItem="{Binding ActivitySeverityFilter}"/><ComboBox AutomationProperties.Name="{services:Tr ui.a11y_category_filter}" Grid.Column="2" ItemsSource="{Binding ActivityCategoryOptions}" SelectedItem="{Binding ActivityCategoryFilter}"/></Grid>
              <TextBlock Grid.Row="2" Text="{services:TrText ActivityDetail}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <ListBox Grid.Row="3" ItemsSource="{Binding ActivityLines}" MaxHeight="360" ToolTip.Tip="{services:Tr ui.persistent_management_events_written_by_the_head_d21c48}">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" FontFamily="Consolas, monospace" FontSize="11" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <TextBlock IsVisible="{Binding IsActivityAuditPage}" Text="{services:Tr ui.audit_retention_is_append_only_from_the_gui_pers_92a532}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap"/>

          <Border Classes="card accentServer" IsVisible="{Binding IsConsolePage}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
              <StackPanel Spacing="5">
                <TextBlock Text="{services:Tr ui.startup_console_capture}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{services:Tr ui.startup_console_capture_desc}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{services:TrText ConsoleCaptureState}" Foreground="{DynamicResource BlueBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{services:TrText ConsoleCaptureDetail}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                <TextBlock Text="{services:Tr ui.startup_capture_restart_note}" Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" MinWidth="150">
                <Button Classes="verify" Content="{services:Tr ui.refresh_capture_status}" Command="{Binding RefreshConsoleCaptureCommand}"/>
                <Button Classes="apply" Content="{services:Tr ui.enable_startup_capture}" Command="{Binding InstallConsoleCaptureCommand}" IsEnabled="{Binding CanInstallConsoleCapture}"/>
                <Button Classes="danger" Content="{services:Tr ui.remove_startup_capture}" Command="{Binding UninstallConsoleCaptureCommand}" IsEnabled="{Binding CanRemoveConsoleCapture}"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- v0.7.26.0: RCON moved above Console Log (was below); Refresh View/Pause/Clear/Export
               moved from this card's own header into the ribbon (BuildRibbonGroupsForActivePage). -->
          <Border Classes="card accentServer" IsVisible="{Binding IsConsolePage}">
            <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{services:Tr ui.rcon}" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock Text="{services:Tr ui.palworld_rcon_is_a_legacy_deprecated_administrat_4fba29}" Foreground="{DynamicResource AmberBrush}"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{services:TrText RconState}" Foreground="{DynamicResource BlueBrush}" VerticalAlignment="Center"/>
              </Grid>
              <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="8">
                <Button Classes="verify" Content="{services:Tr ui.rcon_doctor}" Command="{Binding RconDoctorCommand}"/>
                <Button Classes="apply" Grid.Column="1" Content="{services:Tr ui.connect}" Command="{Binding RconConnectCommand}"/>
                <Button Classes="danger" Grid.Column="2" Content="{services:Tr ui.disconnect}" Command="{Binding RconDisconnectCommand}"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.a11y_rcon_preset}" Grid.Column="3" ItemsSource="{Binding RconPresetOptions}" SelectedItem="{Binding SelectedRconPreset, Mode=TwoWay}"/>
                <TextBlock Grid.Column="4" Text="{services:TrText RconDetail}" MaxWidth="360" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
              </Grid>
              <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding RconCommandText, Mode=TwoWay}" PlaceholderText="{services:Tr ui.rcon_command_for_example_info_showplayers_save}"/>
                <Button Grid.Column="1" Classes="apply" Content="{services:Tr ui.send_command}" Command="{Binding RconSendCommand}" IsEnabled="{Binding CanManageAdmin}"/>
              </Grid>
              <ListBox AutomationProperties.Name="{services:Tr ui.a11y_rcon_output}" Grid.Row="3" ItemsSource="{Binding RconOutputLines}" MaxHeight="220" Background="{DynamicResource DecoBackground_0A1118}" FontFamily="Consolas, monospace" FontSize="11" ClipToBounds="True">
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Classes="card accentServer" IsVisible="{Binding IsConsolePage}">
            <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
              <StackPanel>
                <TextBlock Text="{services:Tr ui.console_log}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{services:TrText LogFileText}" Foreground="{DynamicResource MutedBrush}"/>
              </StackPanel>
              <Grid Grid.Row="1" ColumnDefinitions="150,150,*,Auto" ColumnSpacing="8">
                <ComboBox ItemsSource="{Binding ConsoleSeverityOptions}" SelectedItem="{Binding ConsoleSeverityFilter, Mode=TwoWay}" ToolTip.Tip="{services:Tr ui.filter_the_console_by_severity}"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding ConsoleCategoryOptions}" SelectedItem="{Binding ConsoleCategoryFilter, Mode=TwoWay}" ToolTip.Tip="{services:Tr ui.filter_the_console_by_source_category}"/>
                <TextBox Grid.Column="2" PlaceholderText="{services:Tr ui.search_console}" Text="{Binding ConsoleSearchText, Mode=TwoWay}"/>
                <CheckBox Grid.Column="3" Content="{services:Tr ui.hide_routine_rest}" IsChecked="{Binding HideRoutineRest, Mode=TwoWay}" VerticalAlignment="Center"/>
              </Grid>
              <ListBox AutomationProperties.Name="{services:Tr ui.console_log}" Grid.Row="2" ItemsSource="{Binding FilteredLogLines}" MaxHeight="390" Background="{DynamicResource DecoBackground_07110A}" BorderBrush="{DynamicResource DecoBorder_214C2A}" Foreground="{DynamicResource GreenBrush}"
                       FontFamily="Consolas, monospace" FontSize="11" ClipToBounds="True">
                <ListBox.Styles>
                  <Style Selector="ListBoxItem"><Setter Property="Padding" Value="2,1"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource DecoBorder_12241A}"/></Style>
                  <Style Selector="ListBoxItem:nth-child(2n)"><Setter Property="Background" Value="{DynamicResource DecoBackground_0B1712}"/></Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" Foreground="{Binding Converter={x:Static converters:ConsoleLineColorConverter.Instance}}"/></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>

          <Border Classes="card accentSystem" IsVisible="{Binding IsActivityAuditPage}">
            <StackPanel Spacing="10">
              <TextBlock Text="{services:Tr ui.recent_metrics}" FontSize="18" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding MetricHistory}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:MetricHistoryPoint">
                    <TextBlock Text="{services:TrText DisplayText}" FontFamily="Consolas, monospace" FontSize="11" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <TextBlock Text="{services:TrText MonitoringDetail}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsBackupsPage}" Spacing="12">
          <!-- v0.7.27.0: Create Backup/Verify All/Refresh/Open Backup Root moved to the ribbon
               (see MainWindowViewModel's BuildRibbonGroupsForActivePage). -->
          <!-- v0.7.37.0: removed the "N backup(s) / total size" header text that stood here,
               fully redundant with the TOTAL ARCHIVES card's own count and size directly below. -->

          <!-- v0.7.32.0: compact variant, same treatment as Server Setup's cards. -->
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="8">
            <Border Classes="statuscard accentBackups" Padding="8,5"><StackPanel Spacing="2"><TextBlock Text="{services:Tr ui.total_archives}" Classes="muted" FontSize="10"/><TextBlock Text="{services:TrText BackupArchiveCountText}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{services:TrText BackupTotalSizeText}" Classes="muted" FontSize="9"/></StackPanel></Border>
            <Border Grid.Column="1" Classes="statuscard accentBackups" Padding="8,5"><StackPanel Spacing="2"><TextBlock Text="{services:Tr ui.verified}" Classes="muted" FontSize="10"/><TextBlock Text="{services:TrText BackupVerifiedCountText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}"/><TextBlock Text="{services:Tr ui.deep_verification}" Classes="muted" FontSize="9"/></StackPanel></Border>
            <Border Grid.Column="2" Classes="statuscard accentBackups" Padding="8,5"><StackPanel Spacing="2"><TextBlock Text="{services:Tr ui.pending_review}" Classes="muted" FontSize="10"/><TextBlock Text="{services:TrText BackupPendingCountText}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AmberBrush}"/><TextBlock Text="{services:Tr ui.not_yet_verified}" Classes="muted" FontSize="9"/></StackPanel></Border>
            <Border Grid.Column="3" Classes="statuscard accentBackups" Padding="8,5"><StackPanel Spacing="2"><TextBlock Text="{services:Tr ui.retention}" Classes="muted" FontSize="10"/><TextBlock Text="{Binding BackupRetentionKeepLatest, StringFormat='Keep {0}'}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{services:Tr ui.preview_required}" Classes="muted" FontSize="9"/></StackPanel></Border>
          </Grid>

          <!-- v0.7.37.0: two-column layout mirroring the v0.2.16.4 reference, the table (wider,
               left) beside a narrower right-hand column stacking the selection/retention action
               cards, instead of one long full-width vertical stack. The reference's own third
               right-column card ("Backup Locations") has no equivalent here anymore: its one
               action (Open Backup Root) already moved into the ribbon in v0.7.27.0. Created also
               now leads the table's columns instead of the filename, per direct request. -->
          <!-- v1.0.0.4: found live: the save folder belonged to administrators, so every restore failed. Shown for a server on
               this computer when restores cannot replace it; the fix runs through Windows' administrator prompt. -->
          <Border x:Name="SaveFolderAccessCard" Classes="card accentBackups" BorderBrush="{DynamicResource AmberBrush}" BorderThickness="1" IsVisible="{Binding ShowSaveFolderAccessFix}" Margin="0,0,0,12">
            <StackPanel Spacing="8">
              <TextBlock Text="{services:Tr ui.save_folder_access_title}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AmberBrush}"/>
              <TextBlock Text="{services:Tr ui.save_folder_access_hint}" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding SavedFolderPathVerbatim}" FontFamily="Consolas, monospace" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <Button Classes="apply" Content="{services:Tr ui.fix_save_folder_access}" Command="{Binding FixSaveFolderAccessCommand}" IsEnabled="{Binding CanManageAdmin}" HorizontalAlignment="Left"/>
              <TextBlock Text="{services:TrText SaveFolderAccessStatus}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Grid ColumnDefinitions="2.2*,*" ColumnSpacing="12">
            <Border Classes="card accentBackups">
              <Grid RowDefinitions="Auto,*" RowSpacing="10">
                <!-- v1.0.0.4: each backup's in-game day, from its own Level.sav, so a restore can be checked by day. -->
                <Grid ColumnDefinitions="*,2*,*,*,*" ColumnSpacing="12">
                  <TextBlock Text="{services:Tr ui.created}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Grid.Column="1" Text="{services:Tr ui.backup}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Grid.Column="2" Text="{services:Tr ui.world_day}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Grid.Column="3" Text="{services:Tr ui.size}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Grid.Column="4" Text="{services:Tr ui.status}" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                </Grid>
                <ListBox AutomationProperties.Name="{services:Tr ui.backups}" Grid.Row="1" ItemsSource="{Binding BackupItems}" SelectedItem="{Binding SelectedBackup}" MaxHeight="480">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:BackupItemDto">
                      <Grid ColumnDefinitions="*,2*,*,*,*" ColumnSpacing="12" Margin="0,5">
                        <TextBlock Text="{services:TrText CreatedText}" />
                        <TextBlock Grid.Column="1" Text="{Binding FileName}" />
                        <TextBlock Grid.Column="2" Text="{services:TrText WorldDayText}" />
                        <TextBlock Grid.Column="3" Text="{services:TrText SizeText}" />
                        <Border Classes="tag" Grid.Column="4" HorizontalAlignment="Left" services:StatusTag.Status="{Binding VerificationText}"><TextBlock Text="{services:TrText VerificationText}"/></Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="12">
              <Border Classes="card accentBackups">
                <StackPanel Spacing="10">
                  <TextBlock Text="{services:Tr ui.selected_backup}" FontSize="17" FontWeight="SemiBold" />
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Classes="verify" Content="{services:Tr ui.verify_selected}" Command="{Binding VerifySelectedBackupCommand}"/>
                    <Button Classes="caution" Content="{services:Tr ui.restore_selected}" Command="{Binding RestoreBackupCommand}"/>
                    <Button Classes="danger" Content="{services:Tr ui.delete_selected}" Command="{Binding DeleteBackupCommand}"/>
                  </StackPanel>
                  <CheckBox Content="{services:Tr ui.i_understand_restore_replaces_the_active_save}" IsChecked="{Binding BackupRestoreConfirmed}"/>
                  <TextBlock Text="{services:Tr ui.restore_requires_palserver_to_be_stopped_mysttiq_8daf7a}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
                </StackPanel>
              </Border>

              <Border Classes="card accentBackups">
                <StackPanel Spacing="10">
                  <TextBlock Text="{services:Tr ui.retention_cleanup}" FontSize="17" FontWeight="SemiBold"/>
                  <TextBlock Text="{services:Tr ui.preview_is_immutable_and_short_lived_apply_delet_5540b3}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                  <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="{services:Tr ui.keep_latest}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <!-- v0.7.102.0: 140 wide with a whole-number format. At 90 the spin buttons left room for one digit, so a value of 10 read as "1". -->
                    <NumericUpDown AutomationProperties.Name="{services:Tr ui.keep_latest}" Value="{Binding BackupRetentionKeepLatest}" Minimum="1" Maximum="1000" Width="140" FormatString="0" Margin="0,0,16,0"/>
                    <TextBlock Text="{services:Tr ui.maximum_age_days}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <NumericUpDown AutomationProperties.Name="{services:Tr ui.maximum_age_days}" Value="{Binding BackupRetentionMaxAgeDays}" Minimum="1" Maximum="3650" Width="150" FormatString="0" Margin="0,0,16,0"/>
                    <Button Classes="info" Content="{services:Tr ui.preview_cleanup}" Command="{Binding PreviewBackupRetentionCommand}" Margin="0,0,8,0"/>
                    <Button Classes="danger" Content="{services:Tr ui.apply_exact_preview}" Command="{Binding ApplyBackupRetentionCommand}"/>
                  </WrapPanel>
                  <ItemsControl ItemsSource="{Binding BackupRetentionItems}">
                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:BackupRetentionItemDto"><TextBlock Text="{services:TrText DisplayText}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{services:TrText BackupRetentionState}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>

          <TextBlock Text="{services:TrText BackupDetail}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsModsPage}" Spacing="12">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel>
              <!-- v0.7.78.0: the MOD Library variant of this header text moved into its own card
                   above "Install Validated ZIP" (direct request: "the top comments could be moved
                   to its own card and then added above install validated zip"), so it's gated out
                   here now. MOD Dashboard's own description/state/summary text moved into the new
                   hero banner below instead of sitting here as plain text, part of the same
                   request's follow-up: "help with the MOD dashboard to change the look and feel of
                   it so it doesn't feel like it is essentially the same as the MOD library." -->
              <StackPanel IsVisible="{Binding IsUe4ssPage}">
                <TextBlock Text="{services:Tr ui.inspect_the_active_runtime_resolver_mods_roots_r_723742}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </StackPanel>
          </Grid>
          <!-- v0.7.27.0: "Refresh MODs"/"Verify & Scan" (MOD Dashboard + MOD Library) and "Refresh
               Runtime" (UE4SS) moved to the ribbon (BuildRibbonGroupsForActivePage). -->

          <!-- v0.7.78.0: hero health banner, new. Dashboard previously opened with the exact same
               plain description-text pattern every other page uses, then went straight into 6
               flat, identically-styled stat cards matching Library's own card look almost exactly.
               This leads with one big, color-coded status statement (green=Healthy,
               amber=Degraded) the way an actual monitoring dashboard would, distinct from Library's
               working/management framing. -->
          <Border Classes="card" Classes.glowGreen="{Binding IsModHealthGood}" IsVisible="{Binding IsModDashboardPage}">
            <Grid ColumnDefinitions="Auto,*">
              <TextBlock Text="{services:TrText ModHealth}" FontSize="28" FontWeight="Bold"/>
              <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="{services:Tr ui.at_a_glance_operational_health_and_confirmed_iss_3e93e9}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{services:TrText ModSummary}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{services:TrText ModState}" Foreground="{DynamicResource MutedBrush}" FontSize="11"/>
              </StackPanel>
            </Grid>
          </Border>

          <!-- v0.7.32.0: gated to IsModDashboardPage only (was IsModInventoryPage, shared with MOD
               Library); these 6 cards duplicated MOD Dashboard on the Library page, per direct
               request; Dashboard keeps its own copy. v0.7.78.0: recolored by what each card means
               instead of all six sharing the same flat accentMods look, part of the same
               look-and-feel differentiation as the hero banner above. -->
          <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="10" IsVisible="{Binding IsModDashboardPage}">
            <Border Classes="card" Classes.glowGreen="{Binding IsModHealthGood}"><StackPanel><TextBlock Text="{services:Tr ui.health}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText ModHealth}" FontSize="18" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Grid.Column="1" Classes="card glowCyan"><StackPanel><TextBlock Text="{services:Tr ui.installed}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText ModInstalledText}" FontSize="22"/></StackPanel></Border>
            <Border Grid.Column="2" Classes="card glowGreen"><StackPanel><TextBlock Text="{services:Tr ui.confirmed}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText ModConfirmedText}" FontSize="22"/></StackPanel></Border>
            <Border Grid.Column="3" Classes="card accentMods" BorderBrush="{DynamicResource AmberBrush}"><StackPanel><TextBlock Text="{services:Tr ui.unverified}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText ModUnverifiedText}" FontSize="22"/></StackPanel></Border>
            <Border Grid.Column="4" Classes="card accentMods"><StackPanel><TextBlock Text="{services:Tr ui.disabled}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText ModDisabledText}" FontSize="22"/></StackPanel></Border>
            <Border Grid.Column="5" Classes="card accentMods" BorderBrush="{DynamicResource RedBrush}"><StackPanel><TextBlock Text="{services:Tr ui.issues}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText ModIssuesText}" FontSize="22"/></StackPanel></Border>
          </Grid>

          <Border Classes="card accentMods" IsVisible="{Binding IsUe4ssPage}">
            <StackPanel Spacing="12">
              <TextBlock Text="{services:Tr ui.ue4ss_runtime}" FontSize="18" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                <Border Classes="statuscard accentMods"><StackPanel Spacing="4"><TextBlock Text="{services:Tr ui.installed_version}" Classes="muted"/><TextBlock Text="{services:TrText Ue4ssInstalledVersion}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="1" Classes="statuscard accentMods"><StackPanel Spacing="4"><TextBlock Text="{services:Tr ui.runtime_health}" Classes="muted"/><TextBlock Text="{services:TrText Ue4ssHealth}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{services:TrText Ue4ssDetection}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="2" Classes="statuscard accentMods"><StackPanel Spacing="4"><TextBlock Text="{services:Tr ui.active_fork}" Classes="muted"/><TextBlock Text="{services:TrText SelectedUe4ssFork}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
              </Grid>
              <Border Classes="statuscard accentMods">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="Auto,220,*">
                    <TextBlock Text="{services:Tr ui.release_source}" VerticalAlignment="Center"/>
                    <ComboBox AutomationProperties.Name="{services:Tr ui.release_source}" Grid.Column="1" ItemsSource="{Binding Ue4ssForkOptions}" SelectedItem="{Binding SelectedUe4ssFork}"/>
                    <TextBlock Grid.Column="2" Text="{services:TrText Ue4ssReleaseCatalogStatusText}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </Grid>
                  <!-- v0.7.48.0: UE4SS Release Catalog, real release data. "Refresh Runtime" in the
                       ribbon populates this. v0.7.49.0: install/rollback. Select a release here,
                       then use Preview Install, Confirm Install, and Rollback in the ribbon. -->
                  <ListBox AutomationProperties.Name="{services:Tr ui.a11y_ue4ss_releases}" ItemsSource="{Binding Ue4ssVisibleReleases}" SelectedItem="{Binding SelectedUe4ssRelease}" IsVisible="{Binding HasUe4ssReleases}">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:Ue4ssReleaseDto">
                        <Border Classes="statuscard accentMods" Margin="0,3">
                          <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                              <TextBlock Text="{services:TrText AssetText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{services:TrText ChannelText}" Classes="muted" FontSize="11" VerticalAlignment="Center" Margin="10,0"/>
                            <TextBlock Grid.Column="2" Text="{services:TrText PublishedAtText}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="{services:TrText Ue4ssInstallState}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasUe4ssReleases}"/>
                </StackPanel>
              </Border>
              <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Border Classes="statuscard accentMods"><StackPanel Spacing="4"><TextBlock Text="{services:Tr ui.active_mods_root}" Classes="muted"/><TextBlock Text="{services:TrText Ue4ssActiveRoot}" FontFamily="Consolas, monospace" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
                <Border Grid.Column="1" Classes="statuscard accentMods"><StackPanel Spacing="4"><TextBlock Text="{services:Tr ui.runtime_mods_root}" Classes="muted"/><TextBlock Text="{services:TrText Ue4ssRuntimeRoot}" FontFamily="Consolas, monospace" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border>
              </Grid>
              <TextBlock Text="{services:TrText Ue4ssWarning}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap"/>
              <Button Classes="caution" Content="{services:Tr ui.repair_ue4ss_mod_state}" Command="{Binding RepairModsCommand}" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>

          <Border Classes="card accentMods" IsVisible="{Binding IsModDashboardPage}">
            <StackPanel Spacing="8">
              <TextBlock Text="{services:Tr ui.needs_attention}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{services:Tr ui.mods_whose_confirmed_health_is_neither_healthy_d_4cff25}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="{services:Tr ui.all_mods_are_healthy_disabled_or_active_unverifi_74d30b}" Foreground="{DynamicResource GreenBrush}" IsVisible="{Binding !HasModsNeedingAttention}"/>
              <ItemsControl ItemsSource="{Binding ModsNeedingAttention}" IsVisible="{Binding HasModsNeedingAttention}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ModItemDto">
                    <Border Classes="dataRow" Padding="8,6">
                      <Grid ColumnDefinitions="90,2*,*,2*" ColumnSpacing="10">
                        <TextBlock Text="{services:TrText Type}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/>
                        <Border Classes="tag" Grid.Column="2" HorizontalAlignment="Left" services:StatusTag.Status="{Binding Health}"><TextBlock Text="{services:TrText Health}"/></Border>
                        <TextBlock Grid.Column="3" Text="{services:TrText Evidence}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" FontSize="11"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Classes="open" Content="{services:Tr ui.open_mod_library}" Command="{Binding NavigateCommand}" CommandParameter="ModLibrary" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>

          <!-- v0.7.43.0: findings-completeness fix. Items 21 and 40 both asked for "the running
               MODs listed here [on MOD Dashboard], the Mod on the left and the description on the
               right"; v0.7.40.0 only ever built this for MOD Library, leaving Dashboard with no
               MODs list at all (a real gap, not a deliberate scope cut). Read-only here (no
               Enable/Disable/Delete/Rollback/Update actions, no Install Validated ZIP), matching
               this page's own existing framing ("Open MOD Library to browse, install, or change
               enabled state"); Dashboard stays at-a-glance, mutation stays on MOD Library. The
               website-sourced description part of the original ask is being designed for multiple
               sources as its own scoped follow-up version; this pass ships the list/details
               infrastructure that work will build on. Evidence surfaces MystTiq's own real
               evidence in the meantime, same as MOD Library's details panel. -->
          <Grid ColumnDefinitions="1.6*,*" ColumnSpacing="12" IsVisible="{Binding IsModDashboardPage}">
            <Border Classes="card accentMods">
              <StackPanel Spacing="10">
                <!-- v0.7.78.0: renamed from "Installed MODs" (identical to Library's own card
                     title) to something distinct, direct follow-up to the look-and-feel ask. -->
                <TextBlock Text="{services:Tr ui.mod_overview}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{services:Tr ui.read_only_here_open_mod_library_to_change_enable_a5535b}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                <!-- v0.7.78.0: intentionally more compact than Library's own row (no install path,
                     no version, no update badge); Dashboard is a glance view, Library is where
                     that detail actually matters and where you can act on it. Part of the same
                     look-and-feel differentiation as the hero banner and recolored stat cards. -->
                <ListBox AutomationProperties.Name="{services:Tr ui.mod_overview}" ItemsSource="{Binding ModItems}" SelectedItem="{Binding SelectedMod}" MaxHeight="360">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ModItemDto">
                      <Grid ColumnDefinitions="60,2*,*" ColumnSpacing="8" Margin="0,4">
                        <TextBlock Text="{services:TrText Type}" FontWeight="SemiBold" FontSize="11"/>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="2"><TextBlock Text="{services:TrText EnabledText}" FontSize="11"/><Border Classes="tag" HorizontalAlignment="Left" Margin="0,2,0,0" services:StatusTag.Status="{Binding Health}"><TextBlock Text="{services:TrText Health}"/></Border></StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Classes="card accentMods">
              <Grid>
              <StackPanel Spacing="10" IsVisible="{Binding HasSelectedMod}">
                <TextBlock Text="{services:Tr ui.mod_details}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedMod.Name}" FontWeight="Bold" TextWrapping="Wrap"/>
                <StackPanel Spacing="3">
                  <TextBlock Text="{services:Tr ui.overall_health}" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{services:TrText SelectedMod.Health}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="{services:Tr ui.installation}" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{services:TrText SelectedMod.Type}"/>
                  <TextBlock Text="{services:TrText SelectedMod.Package}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock Text="{services:TrText SelectedMod.EnabledText}"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="{services:Tr ui.runtime}" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{services:TrText SelectedMod.RuntimeState}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="{services:Tr ui.evidence}" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{services:TrText SelectedMod.Evidence}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </StackPanel>
              <TextBlock Text="{services:Tr ui.select_a_mod_from_the_list_to_see_its_details_he_969534}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" IsVisible="{Binding !HasSelectedMod}"/>
              </Grid>
            </Border>
          </Grid>

          <!-- v0.7.78.0: Install Validated ZIP and Available Local Steam Workshop Mods placed
               side by side at the top of the page (direct request: "put install zip and available
               local steam mods in cards side by side at the top"), replacing v0.7.40.0's stacked
               ZIP-card-above-3-column-grid layout. The left column is a StackPanel of two cards
               (page info, then Install Validated ZIP); Available Workshop Mods on the right sits in
               the same Grid row and naturally stretches to their combined height (direct request:
               "the available steam mods would still be on the right but the height of those 2
               combined"). -->
          <Grid ColumnDefinitions="*,1.4*" ColumnSpacing="12" IsVisible="{Binding IsModLibraryPage}">
            <StackPanel Spacing="12">
              <Border Classes="card accentMods">
                <StackPanel Spacing="6">
                  <TextBlock Text="{services:Tr ui.inspect_installed_server_mod_packages_install_ne_2829f1}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                  <TextBlock Text="{services:TrText ModState}" Foreground="{DynamicResource VioletBrush}"/>
                  <TextBlock Text="{services:TrText ModSummary}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
              </Border>
              <Border Classes="card accentMods">
              <StackPanel Spacing="10">
                <TextBlock Text="{services:Tr ui.install_validated_zip}" FontSize="18" FontWeight="SemiBold"/>
                <!-- v0.7.39.0: PAK vs. UE4SS is now detected from the archive's own contents
                     server-side (any .pak/.ucas/.utoc file anywhere in it means PAK, otherwise
                     UE4SS), so the manual type picker that used to sit here is gone; a wrong guess
                     there used to silently install a mod under the wrong type. -->
                <TextBlock Text="{services:Tr ui.the_gui_uploads_the_archive_to_the_headless_serv_9a019b}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                <!-- v0.7.78.0: direct feedback removed the manual "Package name (optional)" box
                     (package name now always comes from the ZIP's own filename, matching PAK/UE4SS
                     type auto-detection) and the two permanently-disabled "BACKEND REQUIRED"
                     buttons (no backend exists for either and none is planned near-term, so they
                     were removed rather than left as dead clutter). Added a drag-and-drop zone
                     (direct request)
                     wired to the exact same InstallModZipAsync path the picker button already uses;
                     ZipInstallDropZone_OnDragOver/_OnDrop in MainWindow.axaml.cs only accept a
                     single real, existing .zip file, matching the Choose ZIP dialog's own filter. -->
                <!-- v1.0.0.3 (reported 2026-10-05: drag and drop did not install): without a background only the button and caption
                     took the drop; a drop on the rest of the zone went to the card behind it. -->
                <Border x:Name="ZipInstallDropZone" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="2" CornerRadius="6" Padding="16" DragDrop.AllowDrop="True">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <Button Classes="apply" Content="{services:Tr ui.choose_zip_and_install}" Click="InstallModZip_Click" IsEnabled="{Binding CanManageAdmin}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{services:Tr ui.or_drag_a_zip_file_here}" Foreground="{DynamicResource MutedBrush}" FontSize="11" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              </Border>
            </StackPanel>

            <Border Grid.Column="1" Classes="card accentMods">
              <StackPanel Spacing="10">
                <TextBlock Text="{services:Tr ui.available_local_steam_workshop_mods}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{services:Tr ui.scans_locally_installed_steam_workshop_content_f_78b72f}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button Classes="info" Content="{services:Tr ui.refresh_9cbbfc}" Command="{Binding ScanWorkshopModsCommand}" Margin="0,0,6,6"/>
                  <Button Classes="apply" Content="{services:Tr ui.import_selected}" Command="{Binding ImportSelectedWorkshopModCommand}" Margin="0,0,6,6"/>
                </WrapPanel>
                <TextBlock Text="{services:TrText WorkshopScanState}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
                <ListBox AutomationProperties.Name="{services:Tr ui.available_local_steam_workshop_mods}" ItemsSource="{Binding WorkshopItems}" SelectedItem="{Binding SelectedWorkshopItem}" MaxHeight="320">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:WorkshopItemDto">
                      <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="8" Margin="0,6">
                        <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding WorkshopId}" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas, monospace"/></StackPanel>
                        <TextBlock Grid.Column="1" Text="{services:TrText SuggestedPackage}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"/>
                        <Border Classes="tag" Grid.Column="2" services:StatusTag.Status="{Binding StatusText}"><TextBlock Text="{services:TrText StatusText}"/></Border>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>
          </Grid>

          <!-- v1.0.5.0 (roadmap M-1; owner decision 2026-10-06): the MOD browser. One search across a chosen source (the
               Downloads folder and other folders, Thunderstore, CurseForge, GitHub releases of repositories the owner adds,
               Nexus Mods); Install Selected File fetches only from that source's hosts, shows what the archive holds, asks,
               and installs through the validated ZIP install. -->
          <Border x:Name="ModBrowserCard" Classes="card accentMods" IsVisible="{Binding IsModLibraryPage}">
            <Expander IsExpanded="True">
              <Expander.Header><TextBlock Text="{services:Tr ui.mod_browser}" FontSize="17" FontWeight="SemiBold"/></Expander.Header>
              <StackPanel Spacing="10" Margin="0,8,0,0">
                <TextBlock Text="{services:Tr ui.mod_browser_hint}" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" FontSize="12" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="8">
                  <ComboBox AutomationProperties.Name="{services:Tr ui.mod_source}" ItemsSource="{Binding ModSourceOptions}" SelectedItem="{Binding SelectedModSource}" HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:ModSourceOption">
                        <TextBlock Text="{services:TrText Name}"/>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBox Grid.Column="1" Text="{Binding ModBrowserQuery, Mode=TwoWay}" PlaceholderText="{services:Tr ui.mod_browser_query}"/>
                  <Button Classes="info" Grid.Column="2" Content="{services:Tr ui.search_mods}" Command="{Binding SearchModBrowserCommand}" IsDefault="False"/>
                </Grid>

                <StackPanel x:Name="ModBrowserFoldersSetup" Spacing="6" IsVisible="{Binding IsFolderModSource}">
                  <TextBlock Text="{services:Tr ui.mod_browser_folders_hint}" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" FontSize="11" TextWrapping="Wrap"/>
                  <ListBox AutomationProperties.Name="{services:Tr ui.mod_browser_folders}" ItemsSource="{Binding ModBrowserFolders}" SelectedItem="{Binding SelectedModBrowserFolder}" MaxHeight="90" FontWeight="Normal" FontSize="12"/>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding NewModBrowserFolder, Mode=TwoWay}" PlaceholderText="{services:Tr ui.mod_browser_folder_placeholder}"/>
                    <Button Classes="apply" Grid.Column="1" Content="{services:Tr ui.add_folder}" Command="{Binding AddModBrowserFolderCommand}"/>
                    <Button Classes="danger" Grid.Column="2" Content="{services:Tr ui.remove_selected_folder}" Command="{Binding RemoveModBrowserFolderCommand}"/>
                  </Grid>
                </StackPanel>

                <StackPanel x:Name="ModBrowserCurseForgeSetup" Spacing="6" IsVisible="{Binding IsCurseForgeModSource}">
                  <TextBlock Text="{services:Tr ui.curseforge_key_hint}" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" FontSize="11" TextWrapping="Wrap"/>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding CurseForgeKeyInput, Mode=TwoWay}" PasswordChar="●" PlaceholderText="{services:Tr ui.curseforge_api_key}"/>
                    <Button Classes="apply" Grid.Column="1" Content="{services:Tr ui.save_key}" Command="{Binding SaveCurseForgeKeyCommand}"/>
                    <Button Classes="danger" Grid.Column="2" Content="{services:Tr ui.forget_key}" Command="{Binding ForgetCurseForgeKeyCommand}"/>
                  </Grid>
                </StackPanel>

                <StackPanel x:Name="ModBrowserGitHubSetup" Spacing="6" IsVisible="{Binding IsGitHubModSource}">
                  <TextBlock Text="{services:Tr ui.github_repos_hint}" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" FontSize="11" TextWrapping="Wrap"/>
                  <ListBox AutomationProperties.Name="{services:Tr ui.github_repositories}" ItemsSource="{Binding ModBrowserRepositories}" SelectedItem="{Binding SelectedModBrowserRepository}" MaxHeight="90" FontWeight="Normal" FontSize="12"/>
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding NewModBrowserRepository, Mode=TwoWay}" PlaceholderText="{services:Tr ui.github_repo_placeholder}"/>
                    <Button Classes="apply" Grid.Column="1" Content="{services:Tr ui.add_repository}" Command="{Binding AddModBrowserRepositoryCommand}"/>
                    <Button Classes="danger" Grid.Column="2" Content="{services:Tr ui.remove_selected_repository}" Command="{Binding RemoveModBrowserRepositoryCommand}"/>
                  </Grid>
                </StackPanel>

                <StackPanel x:Name="ModBrowserNexusSetup" Spacing="6" IsVisible="{Binding IsNexusModSource}">
                  <TextBlock Text="{services:Tr ui.nexus_browser_hint}" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" FontSize="11" TextWrapping="Wrap"/>
                  <TextBlock Text="{services:TrText NxmHandlerText}" Foreground="{DynamicResource VioletBrush}" FontWeight="Normal" FontSize="12" TextWrapping="Wrap"/>
                  <WrapPanel>
                    <Button Classes="apply" Content="{services:Tr ui.allow_nxm_links}" Click="UseMystTiqForNxm_OnClick" Margin="0,0,8,6"/>
                    <Button Classes="danger" Content="{services:Tr ui.stop_taking_nxm_links}" Command="{Binding StopUsingMystTiqForNxmLinksCommand}" Margin="0,0,8,6"/>
                  </WrapPanel>
                </StackPanel>

                <Grid ColumnDefinitions="3*,2*" ColumnSpacing="10">
                  <ListBox x:Name="ModBrowserResultsList" AutomationProperties.Name="{services:Tr ui.mod_browser_results}" ItemsSource="{Binding ModBrowserResults}" SelectedItem="{Binding SelectedModListing}" MaxHeight="260">
                    <ListBox.ItemTemplate>
                      <DataTemplate x:DataType="models:ModListing">
                        <StackPanel Margin="0,4">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="{Binding ByLineVerbatim}" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal"/>
                          <TextBlock Text="{Binding SummaryVerbatim}" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" TextWrapping="Wrap" MaxHeight="34"/>
                          <TextBlock Text="{services:TrText NoteText}" IsVisible="{Binding HasNote}" FontSize="11" Foreground="{DynamicResource AmberBrush}" FontWeight="Normal" TextWrapping="Wrap"/>
                        </StackPanel>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <StackPanel Grid.Column="1" Spacing="8">
                    <ListBox AutomationProperties.Name="{services:Tr ui.a11y_mod_files}" ItemsSource="{Binding ModBrowserFiles}" SelectedItem="{Binding SelectedModFile}" MaxHeight="180">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:ModListingFile">
                          <StackPanel Margin="0,3">
                            <TextBlock Text="{Binding RowVerbatim}" FontWeight="Normal" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{services:TrText NoteText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" TextWrapping="Wrap"/>
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <WrapPanel>
                      <Button Classes="apply" Content="{services:Tr ui.install_selected_file}" Click="InstallBrowserMod_OnClick" IsEnabled="{Binding CanManageAdmin}" Margin="0,0,8,6"/>
                      <Button Classes="open" Content="{services:Tr ui.open_page}" Command="{Binding OpenModBrowserPageCommand}" Margin="0,0,8,6"/>
                    </WrapPanel>
                  </StackPanel>
                </Grid>
                <TextBlock Text="{services:TrText ModBrowserStatus}" Foreground="{DynamicResource VioletBrush}" FontWeight="Normal" TextWrapping="Wrap"/>
                <TextBlock Text="{services:Tr ui.mod_browser_attribution}" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" TextWrapping="Wrap"/>
              </StackPanel>
            </Expander>
          </Border>

          <!-- v0.7.93.0: Nexus Mods catalog. Collapsed by default. Uses the person's own Nexus API key
               from this PC (never sent to the MystTiq server). Nexus's public API lists only 10 mods
               per category and has no search, and only Premium accounts get direct download links, so
               the card offers lists, lookup by id or page URL, Open on Nexus, and an nxm link paste for
               free accounts. Every download still goes through the validated ZIP install. -->
          <Border Classes="card accentMods" IsVisible="{Binding IsModLibraryPage}">
            <Expander Header="{services:Tr ui.nexus_mods_catalog}" FontSize="17" FontWeight="SemiBold" IsExpanded="False">
              <StackPanel Spacing="10" Margin="0,8,0,0">
                <TextBlock Text="{services:Tr ui.browse_palworld_mods_on_nexus_mods_and_install_a_851339}" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" FontSize="12" TextWrapping="Wrap"/>
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding NexusApiKeyInput, Mode=TwoWay}" PasswordChar="●" PlaceholderText="{services:Tr ui.nexus_mods_api_key}"/>
                  <Button Grid.Column="1" Classes="apply" Content="{services:Tr ui.connect_1a2303}" Command="{Binding NexusConnectCommand}"/>
                  <Button Classes="apply" Grid.Column="2" Content="{services:Tr ui.save_key}" Command="{Binding NexusSaveKeyCommand}" ToolTip.Tip="{services:Tr ui.stores_the_key_on_this_pc_only_encrypted_for_you_88097d}"/>
                  <Button Classes="danger" Grid.Column="3" Content="{services:Tr ui.forget_key}" Command="{Binding NexusForgetKeyCommand}"/>
                </Grid>
                <TextBlock Text="{services:TrText NexusAccountText}" Foreground="{DynamicResource VioletBrush}" FontWeight="Normal" TextWrapping="Wrap"/>
                <WrapPanel>
                  <Button Classes="info" Content="{services:Tr ui.trending}" Command="{Binding NexusLoadListCommand}" CommandParameter="trending" Margin="0,0,6,6"/>
                  <Button Classes="info" Content="{services:Tr ui.latest_added}" Command="{Binding NexusLoadListCommand}" CommandParameter="latest_added" Margin="0,0,6,6"/>
                  <Button Classes="info" Content="{services:Tr ui.latest_updated}" Command="{Binding NexusLoadListCommand}" CommandParameter="latest_updated" Margin="0,0,14,6"/>
                  <TextBox Width="260" Text="{Binding NexusLookupText, Mode=TwoWay}" PlaceholderText="{services:Tr ui.mod_id_or_nexusmods_com_page_url}" Margin="0,0,6,6"/>
                  <Button Classes="open" Content="{services:Tr ui.look_up}" Command="{Binding NexusLookupCommand}" Margin="0,0,6,6"/>
                </WrapPanel>
                <ListBox AutomationProperties.Name="{services:Tr ui.a11y_nexus_mods_results}" ItemsSource="{Binding NexusMods}" SelectedItem="{Binding SelectedNexusMod}" MaxHeight="220">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:NexusModDto">
                      <StackPanel Margin="0,4">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ByLine}" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal"/>
                        <TextBlock Text="{services:TrText Summary}" FontSize="11" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" TextWrapping="Wrap" MaxHeight="34"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <WrapPanel>
                  <Button Classes="open" Content="{services:Tr ui.show_files}" Command="{Binding NexusShowFilesCommand}" Margin="0,0,6,6"/>
                  <Button Classes="open" Content="{services:Tr ui.open_on_nexus}" Command="{Binding NexusOpenPageCommand}" Margin="0,0,6,6"/>
                </WrapPanel>
                <ListBox AutomationProperties.Name="{services:Tr ui.a11y_mod_files}" ItemsSource="{Binding NexusFiles}" SelectedItem="{Binding SelectedNexusFile}" MaxHeight="150">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:NexusFileDto">
                      <StackPanel Margin="0,3">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                        <TextBlock Text="{services:TrText Detail}" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal"/>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Button Classes="apply" Content="{services:Tr ui.download_and_install_selected_file}" Command="{Binding NexusInstallFileCommand}" HorizontalAlignment="Left" ToolTip.Tip="{services:Tr ui.premium_accounts_only_because_nexus_only_issues_4d6eac}"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox Text="{Binding NexusNxmLinkText, Mode=TwoWay}" PlaceholderText="{services:Tr ui.free_account_paste_the_nxm_link_from_the_mod_man_1520ec}"/>
                  <Button Classes="apply" Grid.Column="1" Content="{services:Tr ui.install_from_link}" Command="{Binding NexusInstallFromNxmCommand}"/>
                </Grid>
                <TextBlock Text="{services:TrText NexusStatusText}" Foreground="{DynamicResource VioletBrush}" FontWeight="Normal" TextWrapping="Wrap"/>
                <TextBlock Text="{services:TrText NexusRateText}" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal"/>
                <TextBlock Text="{services:Tr ui.mod_data_from_nexus_mods_nexusmods_com_mysttiq_i_c8f955}" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontWeight="Normal" TextWrapping="Wrap"/>
              </StackPanel>
            </Expander>
          </Border>

          <!-- v0.7.78.0: Installed MODs widened to 2/3 of the row, MOD DETAILS to the right at 1/3
               (direct request), replacing v0.7.40.0's equal 1.3*/1.3*/* three-column split now that
               Available Workshop Mods moved to its own row above. The selected-MOD button cluster
               (Enable/Disable/Rollback/Repair/Delete Selected) that used to sit above this list is
               gone entirely; those actions are now a right-click context menu on the list itself
               (matching how Bases/Guilds/Players already expose per-row mutations), and the
               page-level all-MODs/maintenance actions (Enable All, Disable All, Repair, Safe-Start)
               moved to the ribbon's new "MOD Maintenance" group. Direct follow-up to the
               button-row-redesign request: "should we move the buttons to the ribbon? can we add a
               right click as well." -->
          <Grid ColumnDefinitions="2*,*" ColumnSpacing="12" IsVisible="{Binding IsModLibraryPage}">
            <Border Classes="card accentMods">
              <StackPanel Spacing="10">
                <TextBlock Text="{services:Tr ui.installed_mods}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{services:Tr ui.disabled_and_active_unverified_are_informational_87d14e}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                <ListBox ItemsSource="{Binding ModItems}" SelectedItem="{Binding SelectedMod}" MaxHeight="560" ToolTip.Tip="{services:Tr ui.right_click_a_mod_for_enable_disable_rollback_re_1ff8ee}">
                  <ListBox.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="{services:Tr ui.enable_selected}" Command="{Binding EnableSelectedModCommand}"/>
                      <MenuItem Header="{services:Tr ui.disable_selected}" Command="{Binding DisableSelectedModCommand}"/>
                      <Separator/>
                      <MenuItem Header="{services:Tr ui.rollback_selected}" Command="{Binding RollbackSelectedModCommand}" ToolTip.Tip="{services:Tr ui.restores_this_mod_to_its_state_before_the_last_i_53cdb3}"/>
                      <MenuItem Header="{services:Tr ui.repair_selected}" Command="{Binding RepairSelectedModCommand}" ToolTip.Tip="{services:Tr ui.re_imports_this_mod_fresh_from_its_matched_local_05893d}"/>
                      <Separator/>
                      <MenuItem Header="{services:Tr ui.delete_selected}" Command="{Binding DeleteSelectedModCommand}"/>
                    </ContextMenu>
                  </ListBox.ContextMenu>
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ModItemDto">
                      <Grid ColumnDefinitions="60,2*,*" ColumnSpacing="8" Margin="0,6">
                        <TextBlock Text="{services:TrText Type}" FontWeight="SemiBold" FontSize="11"/>
                        <StackPanel Grid.Column="1">
                          <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                          <TextBlock Text="{services:TrText InstallPath}" FontSize="10" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                          <!-- v0.7.78.0: per-row update availability, direct request ("under
                               installed MODs card it should have the info if there is an updated
                               version"). Reuses the same local Steam Workshop content-cache
                               comparison the MOD DETAILS panel's on-demand Check for Update already
                               used; here it's computed once per mod during the regular inventory
                               scan instead of needing a manual click per selection. -->
                          <TextBlock Text="{services:TrText InstalledVersionText}" FontSize="10" Foreground="{DynamicResource CyanBrush}" Margin="0,2,0,0"/>
                          <Border Classes="tag warn" HorizontalAlignment="Left" Margin="0,2,0,0" IsVisible="{Binding UpdateAvailable}" ToolTip.Tip="{services:TrText UpdateHint}"><TextBlock Text="{services:Tr ui.update_available}"/></Border>
                        </StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="{services:TrText EnabledText}" FontSize="11"/><Border Classes="tag" HorizontalAlignment="Left" Margin="0,2,0,0" services:StatusTag.Status="{Binding Health}"><TextBlock Text="{services:TrText Health}"/></Border></StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Classes="card accentMods">
              <Grid>
              <StackPanel Spacing="10" IsVisible="{Binding HasSelectedMod}">
                <TextBlock Text="{services:Tr ui.mod_details}" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedMod.Name}" FontWeight="Bold" TextWrapping="Wrap"/>
                <StackPanel Spacing="3">
                  <TextBlock Text="{services:Tr ui.overall_health}" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{services:TrText SelectedMod.Health}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="{services:Tr ui.installation}" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{services:TrText SelectedMod.Type}"/>
                  <TextBlock Text="{services:TrText SelectedMod.Package}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                  <TextBlock Text="{services:TrText SelectedMod.InstallPath}" FontSize="10" FontFamily="Consolas, monospace" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                  <TextBlock Text="{services:TrText SelectedMod.EnabledText}"/>
                  <TextBlock Text="{services:TrText SelectedMod.InstalledVersionText}" Foreground="{DynamicResource CyanBrush}"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="{services:Tr ui.runtime}" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{services:TrText SelectedMod.RuntimeState}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="{services:Tr ui.compatibility}" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{Binding SelectedMod.RuntimeConfirmed, StringFormat='Runtime confirmed: {0}'}"/>
                </StackPanel>
                <StackPanel Spacing="3">
                  <TextBlock Text="{services:Tr ui.evidence}" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{services:TrText SelectedMod.Evidence}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- v0.7.41.0: MOD update detection (item 52). Check compares the installed MOD
                     against a matching local Steam Workshop item's own content cache, real,
                     locally-verifiable evidence, not a live network lookup or a fabricated "latest
                     version" claim. Update only enables once a real newer local copy was found. -->
                <StackPanel Spacing="3">
                  <TextBlock Text="{services:Tr ui.update}" Classes="muted" FontSize="10"/>
                  <WrapPanel>
                    <Button Content="{services:Tr ui.check_for_update}" Classes="verify" Command="{Binding CheckSelectedModUpdateCommand}" Margin="0,0,6,6"/>
                    <Button Content="{services:Tr ui.update}" Classes="apply" Command="{Binding UpdateSelectedModCommand}" Margin="0,0,6,6"/>
                  </WrapPanel>
                  <TextBlock Text="{services:TrText SelectedModUpdateText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- v0.7.55.0: website-sourced MOD descriptions (item 40's deferred half),
                     designed for multiple sources: an automatic Steam Workshop match (reusing the
                     same local-content match the UPDATE section above already uses), or a manually
                     set Source URL (e.g. a GitHub repo) for MODs with no Workshop match. Fetching
                     only ever happens on this button's own click, never on selection or on page
                     load, so browsing the MOD list never triggers a network call by itself. -->
                <StackPanel Spacing="3">
                  <TextBlock Text="{services:Tr ui.description}" Classes="muted" FontSize="10"/>
                  <WrapPanel>
                    <Button Content="{services:Tr ui.fetch_refresh_description}" Classes="info" Command="{Binding FetchSelectedModDescriptionCommand}" Margin="0,0,6,6" ToolTip.Tip="{services:Tr ui.only_fetches_when_clicked_never_automatic}"/>
                  </WrapPanel>
                  <StackPanel Spacing="3" IsVisible="{Binding HasSelectedModDescription}">
                    <TextBlock Text="{Binding SelectedModDescription.Source, StringFormat='Source: {0}'}" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                    <TextBlock Text="{services:TrText SelectedModDescription.Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <!-- Long Steam Workshop descriptions routinely exceed a fixed height, so this
                         scrolls rather than silently clipping past MaxHeight. -->
                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                      <TextBlock Text="{services:TrText SelectedModDescription.Description}" TextWrapping="Wrap"/>
                    </ScrollViewer>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                      <TextBlock Text="{Binding SelectedModDescription.SourceUrl}" FontSize="10" Foreground="{DynamicResource CyanBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      <Button Classes="open" Grid.Column="1" Content="{services:Tr ui.open}" FontSize="11" Padding="8,2" Click="OpenModDescriptionSource_Click" ToolTip.Tip="{services:Tr ui.open_this_link_in_your_default_browser}"/>
                    </Grid>
                  </StackPanel>
                  <TextBlock Text="{services:TrText SelectedModDescription.Detail}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding HasModDescriptionResult}"/>
                  <!-- Only shown after an actual fetch attempt found nothing, so it doesn't
                       presumptuously claim "no match" before Fetch has ever been clicked for this
                       selection. -->
                  <TextBlock Text="{services:Tr ui.no_known_workshop_match_set_a_source_url_e_g_a_g_e24281}" Classes="muted" FontSize="10" TextWrapping="Wrap" IsVisible="{Binding ShowNoModDescriptionMatchMessage}"/>
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding SelectedModDescriptionSourceInput}" PlaceholderText="{services:Tr ui.https_github_com_owner_repo}"/>
                    <Button Classes="info" Grid.Column="1" Content="{services:Tr ui.set_source}" Command="{Binding SetSelectedModDescriptionSourceCommand}"/>
                  </Grid>
                </StackPanel>
              </StackPanel>
              <TextBlock Text="{services:Tr ui.select_a_mod_from_the_installed_mods_list_to_see_5c86e5}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" IsVisible="{Binding !HasSelectedMod}"/>
              </Grid>
            </Border>
          </Grid>

          <!-- v0.7.59.0: Safe-Start MOD Diagnostic live status. Polled independently of IsBusy over
               a DispatcherTimer since the diagnostic itself runs server-side over several minutes
               (a full start/stop cycle per candidate MOD), so this card shows real progress rather
               than a spinner with no detail for that whole duration. -->
          <Border Classes="card accentMods" IsVisible="{Binding HasModSafeStartStatus}">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{services:Tr ui.safe_start_diagnostic}" FontSize="14" FontWeight="SemiBold"/>
                <Button Grid.Column="1" Content="{services:Tr ui.cancel}" Classes="plain" Command="{Binding CancelModSafeStartCommand}" IsVisible="{Binding ModSafeStartStatus.IsRunning}"/>
              </Grid>
              <TextBlock Text="{services:TrText ModSafeStartStatus.Phase}" TextWrapping="Wrap" IsVisible="{Binding ModSafeStartStatus.IsRunning}"/>
              <TextBlock Text="{services:TrText ModSafeStartStatus.ProgressText}" Classes="muted" FontSize="11" IsVisible="{Binding ModSafeStartStatus.IsRunning}"/>
              <ItemsControl ItemsSource="{Binding ModSafeStartStatus.Results}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:SafeStartModResultDto">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8" Margin="0,2">
                      <Border Classes="tag ok" IsVisible="{Binding Ok}"><TextBlock Text="{services:Tr ui.ok}"/></Border>
                      <Border Classes="tag fail" IsVisible="{Binding !Ok}"><TextBlock Text="{services:Tr ui.disabled}"/></Border>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{services:TrText Package}" FontWeight="SemiBold"/>
                        <TextBlock Text="{services:TrText Detail}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{services:TrText ModSafeStartStatus.FinalMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource GreenBrush}"
                         IsVisible="{Binding ModSafeStartStatus.Success}"/>
              <TextBlock Text="{services:TrText ModSafeStartStatus.FinalMessage}" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="{DynamicResource AmberBrush}"
                         IsVisible="{Binding ModSafeStartStatus.CompletedUnsuccessfully}"/>
            </StackPanel>
          </Border>

          <Border Classes="card accentMods">
            <TextBlock Text="{services:Tr ui.enable_disable_requires_palserver_to_be_stopped_481d00}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
          </Border>
        </StackPanel>

        <!-- NETWORK DIAGNOSTICS -->
        <StackPanel IsVisible="{Binding IsDiagnosticsPage}" Spacing="12">
          <!-- v0.7.42.0: Run Diagnostics/Add-Repair Firewall Rule/Restart Server moved to the
               ribbon. "Re-run Network Tests" was a literal duplicate of Run Diagnostics (same
               command), removed rather than relocated. "Open Server Log" was redundant with the
               always-present global ribbon Quick Actions "Console" button, removed too. -->
          <Grid ColumnDefinitions="*">
            <StackPanel><TextBlock Text="{services:Tr ui.runtime_and_network_health_are_evaluated_indepen_25b100}" Foreground="{DynamicResource MutedBrush}"/></StackPanel>
          </Grid>
          <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
            <Border Classes="card accentTools"><StackPanel><TextBlock Text="{services:Tr ui.runtime}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText NetworkRuntime}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Grid.Column="1" Classes="card accentTools"><StackPanel><TextBlock Text="{services:Tr ui.network}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText NetworkHealth}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource VioletBrush}"/></StackPanel></Border>
            <Border Grid.Column="2" Classes="card accentTools"><StackPanel><TextBlock Text="{services:Tr ui.game_port}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding NetworkPort}" FontSize="20" FontWeight="SemiBold"/></StackPanel></Border>
            <Border Grid.Column="3" Classes="card accentTools"><StackPanel><TextBlock Text="{services:Tr ui.lan_endpoint}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText NetworkLanEndpoint}" FontSize="16" FontWeight="SemiBold"/></StackPanel></Border>
          </Grid>
          <!-- v0.9.6.0: the firewall rule for the port this server binds; allowing it removes the rule for an old port. -->
          <Border Classes="card accentTools" IsVisible="{Binding HasFirewallStatus}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="{services:Tr ui.windows_firewall}" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="{services:TrText FirewallStatusText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{services:Tr ui.firewall_linux_commands}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding HasFirewallCommands}"/>
                <TextBox AutomationProperties.Name="{services:Tr ui.firewall_linux_commands}" Text="{Binding FirewallCommandsText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" FontFamily="Consolas, monospace" FontSize="11" IsVisible="{Binding HasFirewallCommands}"/>
              </StackPanel>
              <Button Grid.Column="1" Classes="apply" VerticalAlignment="Center" Content="{services:Tr ui.allow_through_firewall}" AutomationProperties.Name="{services:Tr ui.allow_through_firewall}" Command="{Binding RepairFirewallCommand}" IsVisible="{Binding FirewallNeedsAction}"/>
            </Grid>
          </Border>          <Border Classes="card accentTools"><StackPanel Spacing="6"><TextBlock Text="{services:Tr ui.binding}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText NetworkBinding}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding NetworkRecommendation, StringFormat='Recommended action: {0}'}" TextWrapping="Wrap"/></StackPanel></Border>
          <ItemsControl ItemsSource="{Binding NetworkDiagnosticChecks}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:NetworkDiagnosticCheckDto">
              <Border Classes="card accentTools" Margin="0,0,0,8"><Grid ColumnDefinitions="180,100,*,220" ColumnSpacing="12">
                <TextBlock Text="{services:TrText Test}" FontWeight="SemiBold"/><Border Classes="tag" Grid.Column="1" HorizontalAlignment="Left" services:StatusTag.Status="{Binding StateText}"><TextBlock Text="{services:TrText StateText}"/></Border>
                <TextBlock Grid.Column="2" Text="{services:TrText Details}" TextWrapping="Wrap"/><TextBlock Grid.Column="3" Text="{services:TrText Recommendation}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              </Grid></Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <Border Classes="card accentTools"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{services:Tr ui.support_diagnostic_report}" FontSize="17" FontWeight="SemiBold"/><WrapPanel Grid.Column="1"><Button Classes="info" Content="{services:Tr ui.copy_report}" Click="CopyNetworkDiagnosticReport_Click" Margin="0,0,8,0"/><Button Classes="info" Content="{services:Tr ui.export_report}" Click="ExportNetworkDiagnosticReport_Click" Margin="0,0,8,0"/><Button Classes="apply" Content="{services:Tr ui.create_support_package}" Click="CreateSupportPackage_Click" Margin="0,0,8,0"/><Button Classes="open" Content="{services:Tr ui.open_local_diagnostics}" Tag="runtime" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/></WrapPanel></Grid><TextBlock Text="{services:Tr ui.support_output_excludes_passwords_bearer_tokens_13a61f}" Foreground="{DynamicResource MutedBrush}"/><TextBox AutomationProperties.Name="{services:Tr ui.support_diagnostic_report}" Text="{Binding NetworkReportText}" AcceptsReturn="True" IsReadOnly="True" MinHeight="180" FontFamily="Consolas, monospace" FontSize="11"/></StackPanel></Border>

          <!-- WAN / EXTERNAL REACHABILITY (v0.6.11.0). Collapsed by default since v0.7.5.0
               (no-scroll pass 1) — a secondary deep-dive tool, not the primary diagnostic view. -->
          <Border Classes="card accentTools">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleWanDiagnosticsCommand}" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="▸" IsVisible="{Binding !IsWanDiagnosticsExpanded}" FontWeight="Bold"/><TextBlock Text="▾" IsVisible="{Binding IsWanDiagnosticsExpanded}" FontWeight="Bold"/><TextBlock Text="{services:Tr ui.wan_external_reachability}" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                </Button>
                <WrapPanel Grid.Column="1" IsVisible="{Binding IsWanDiagnosticsExpanded}">
                  <Button Classes="verify" Content="{services:Tr ui.run_reachability_check}" Command="{Binding RunWanReachabilityCommand}" Margin="0,0,8,0"/>
                  <Button Classes="apply" Content="{services:Tr ui.add_upnp_port_mapping}" Command="{Binding RepairUpnpMappingCommand}" ToolTip.Tip="{services:Tr ui.adds_a_port_forward_mapping_on_your_router_via_u_0e17a0}" Margin="0,0,8,0"/>
                </WrapPanel>
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding IsWanDiagnosticsExpanded}">
              <TextBlock Text="{services:Tr ui.public_ip_the_router_s_upnp_port_mapping_and_a_s_7ebbb9}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                <Border Classes="card accentTools"><StackPanel><TextBlock Text="{services:Tr ui.public_ip_port}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{Binding WanPublicIpPort}" FontSize="16" FontWeight="SemiBold"/></StackPanel></Border>
                <Border Grid.Column="1" Classes="card accentTools"><StackPanel><TextBlock Text="{services:Tr ui.router_upnp_mapping}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText WanUpnpState}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource VioletBrush}"/></StackPanel></Border>
                <Border Grid.Column="2" Classes="card accentTools"><StackPanel><TextBlock Text="{services:Tr ui.router}" Foreground="{DynamicResource MutedBrush}"/><TextBlock Text="{services:TrText WanRouterDescription}" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/></StackPanel></Border>
              </Grid>
              <ItemsControl ItemsSource="{Binding WanReachabilityChecks}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:WanReachabilityCheckDto">
                  <Border Classes="card accentTools" Margin="0,0,0,8"><Grid ColumnDefinitions="180,100,*,220" ColumnSpacing="12">
                    <TextBlock Text="{services:TrText Test}" FontWeight="SemiBold"/><Border Classes="tag" Grid.Column="1" HorizontalAlignment="Left" services:StatusTag.Status="{Binding StateText}"><TextBlock Text="{services:TrText StateText}"/></Border>
                    <TextBlock Grid.Column="2" Text="{services:TrText Details}" TextWrapping="Wrap"/><TextBlock Grid.Column="3" Text="{services:TrText Recommendation}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
                  </Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{services:TrText WanStatus}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <WrapPanel Grid.Column="1">
                  <Button Classes="info" Content="{services:Tr ui.copy_ip_port}" Click="CopyWanPublicIpPort_Click" Margin="0,0,8,0"/>
                  <Button Classes="open" Content="{services:Tr ui.open_port_checker}" Command="{Binding OpenExternalPortCheckerCommand}" ToolTip.Tip="{services:Tr ui.opens_a_well_known_external_port_checker_website_66782a}"/>
                </WrapPanel>
              </Grid>
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- LOCAL MACHINE DIAGNOSTICS (v0.6.4.0). Collapsed by default since v0.7.5.0
               (no-scroll pass 1) — a secondary deep-dive tool, not the primary diagnostic view. -->
          <Border Classes="card accentTools">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleLocalDiagnosticsCommand}" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="▸" IsVisible="{Binding !IsLocalDiagnosticsExpanded}" FontWeight="Bold"/><TextBlock Text="▾" IsVisible="{Binding IsLocalDiagnosticsExpanded}" FontWeight="Bold"/><TextBlock Text="{services:Tr ui.local_machine_diagnostics}" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                </Button>
                <Button Grid.Column="1" Classes="verify" Content="{services:Tr ui.diagnose_connection}" Command="{Binding DiagnoseConnectionCommand}" VerticalAlignment="Top" IsVisible="{Binding IsLocalDiagnosticsExpanded}"/>
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding IsLocalDiagnosticsExpanded}">
              <TextBlock Text="{services:Tr ui.diagnoses_the_selected_connection_profile_from_t_354026}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText LocalDiagnosticsState}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding LocalConnectionFindings}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:DiagnosticFindingDto">
                  <Border Classes="statuscard accentTools" Margin="0,0,0,6"><Grid ColumnDefinitions="120,140,*" ColumnSpacing="12">
                    <Border Classes="tag" HorizontalAlignment="Left" services:StatusTag.Status="{Binding StateText}"><TextBlock Text="{services:TrText StateText}"/></Border><TextBlock Grid.Column="1" Text="{services:TrText Component}"/><TextBlock Grid.Column="2" Text="{services:TrText Evidence}" TextWrapping="Wrap"/>
                  </Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{services:Tr ui.this_machine}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/>
              <ItemsControl ItemsSource="{Binding LocalMachineFindings}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="models:DiagnosticFindingDto">
                  <Border Classes="statuscard accentTools" Margin="0,0,0,6"><Grid ColumnDefinitions="120,140,*" ColumnSpacing="12">
                    <Border Classes="tag" HorizontalAlignment="Left" services:StatusTag.Status="{Binding StateText}"><TextBlock Text="{services:TrText StateText}"/></Border><TextBlock Grid.Column="1" Text="{services:TrText Component}"/><TextBlock Grid.Column="2" Text="{services:TrText Evidence}" TextWrapping="Wrap"/>
                  </Grid></Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsDoctorPage}" Spacing="12">
          <Border Classes="card accentTools">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <!-- v0.7.27.0: Run Doctor/Refresh and Export Diagnostic Report moved to the ribbon
                   (BuildRibbonGroupsForActivePage). -->
              <StackPanel Spacing="10">
                <TextBlock Text="{services:TrText DoctorStatus}" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="{services:TrText DoctorSummary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding DoctorCheckedAt, StringFormat='Last checked: {0}'}" Foreground="{DynamicResource MutedBrush}" />
                <TextBlock Text="{services:TrText DoctorExportPath}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
              </StackPanel>
              <!-- v0.7.28.0: managed process list, sourced from ServerStatusDto.Processes; that
                   data already flowed end-to-end from the headless host's FindManagedServerProcesses
                   before this, just never read on the Desktop side. "Kill Processes" in the ribbon's
                   Doctor group reuses ForceStopServerCommand. -->
              <StackPanel Grid.Column="1" Spacing="6" MinWidth="220" IsVisible="{Binding HasManagedProcesses}">
                <TextBlock Text="{services:Tr ui.managed_processes}" Classes="muted" FontWeight="Bold"/>
                <ItemsControl ItemsSource="{Binding ManagedProcesses}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ServerProcessDto">
                      <TextBlock Text="{services:TrText DisplayText}" FontFamily="Consolas, monospace" FontSize="11" TextWrapping="Wrap"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
          </Border>

          <!-- v0.7.44.0: Palworld Instance Detection & Termination Tool. Machine-wide scan, not just
               this tab's own managed processes (the MANAGED PROCESSES panel above); motivated by a
               real collision hit during this app's own release verification, where an unrelated
               PalServer process had no in-app way to be identified or stopped. Reuses the same
               list-plus-details-panel pattern established for MOD Dashboard/MOD Library
               (v0.7.40.0/v0.7.43.0). -->
          <Border Classes="card accentTools" IsVisible="{Binding HasAllInstances}">
            <Grid ColumnDefinitions="1.6*,*" ColumnSpacing="12">
              <StackPanel Spacing="8">
                <TextBlock Text="{services:Tr ui.all_palworld_instances_on_this_machine}" Classes="muted" FontWeight="Bold"/>
                <TextBlock Text="{services:Tr ui.every_palworld_process_on_this_machine_not_just_15e4c1}" Classes="muted" TextWrapping="Wrap" FontSize="11"/>
                <ListBox AutomationProperties.Name="{services:Tr ui.all_palworld_instances_on_this_machine}" ItemsSource="{Binding AllInstances}" SelectedItem="{Binding SelectedInstance}" MaxHeight="240">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ServerInstanceDto">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="2">
                          <TextBlock Text="{services:TrText DisplayText}" FontFamily="Consolas, monospace" FontSize="12"/>
                          <TextBlock Text="{services:TrText PathText}" Classes="muted" FontSize="10" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{services:TrText ManagedText}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource GreenBrush}" IsVisible="{Binding ManagedByThisProfile}"/>
                        <TextBlock Grid.Column="1" Text="{services:TrText ManagedText}" FontSize="10" VerticalAlignment="Center" Foreground="{DynamicResource AmberBrush}" IsVisible="{Binding !ManagedByThisProfile}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </StackPanel>
              <Grid Grid.Column="1">
                <StackPanel Spacing="8" IsVisible="{Binding HasSelectedInstance}">
                  <TextBlock Text="{services:Tr ui.instance_details}" Classes="muted" FontWeight="Bold"/>
                  <TextBlock Text="{services:TrText SelectedInstance.DisplayText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <TextBlock Text="{services:TrText SelectedInstance.PathText}" Classes="muted" TextWrapping="Wrap" FontSize="11"/>
                  <StackPanel Spacing="6" IsVisible="{Binding IsSelectedInstanceManaged}">
                    <TextBlock Text="{services:Tr ui.managed_by_this_tab_use_the_safe_crash_recovery_619bd1}" Classes="muted" TextWrapping="Wrap" FontSize="11"/>
                    <Button Content="{services:Tr ui.stop_via_mysttiq}" Classes="danger" Command="{Binding ForceStopServerCommand}"/>
                  </StackPanel>
                  <StackPanel Spacing="6" IsVisible="{Binding !IsSelectedInstanceManaged}">
                    <TextBlock Text="{services:Tr ui.not_confirmed_as_this_tab_s_own_managed_process_66c379}" Classes="muted" TextWrapping="Wrap" Foreground="{DynamicResource AmberBrush}" FontSize="11"/>
                    <Button Content="{services:Tr ui.force_kill_unmanaged}" Classes="danger" Command="{Binding TerminateSelectedInstanceCommand}"/>
                  </StackPanel>
                  <TextBlock Text="{services:TrText InstanceTerminationResultText}" TextWrapping="Wrap" FontSize="11" IsVisible="{Binding HasInstanceTerminationResult}"/>
                </StackPanel>
                <TextBlock Text="{services:Tr ui.select_an_instance_above_to_see_details_and_avai_446490}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasSelectedInstance}"/>
              </Grid>
            </Grid>
          </Border>
          <TextBlock Text="{services:Tr ui.no_palworld_instances_detected_on_this_machine_y_cd624a}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !HasAllInstances}"/>

          <TextBlock Text="{services:TrText DiagnosticsReportDetail}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
          <!-- v0.7.79.0: denser than v0.7.32.0's own compact pass. Direct live feedback ("these
               items listed should be compacted and make use of the spacing a bit more. Perhaps
               Pass can be highlighted in green or red"). State is now a colored badge (green
               Pass/red Fail/amber Warning/neutral for anything else) instead of plain bold text, so
               status reads at a glance without scanning the word itself. Evidence and Recommendation
               collapse onto one row of columns instead of two full-width stacked lines, and
               Recommendation is hidden entirely when it's identical to Evidence (common for a
               passing check, e.g. both saying "Steam installation detected."), real redundant
               text this feedback was also about, not just visual density. -->
          <ItemsControl ItemsSource="{Binding DiagnosticFindings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:DiagnosticFindingDto">
                <Border Classes="card accentTools" Padding="8,5" Margin="0,0,0,4">
                  <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                    <Border Classes="tag" VerticalAlignment="Center" services:StatusTag.Status="{Binding StateText}"><TextBlock Text="{services:TrText StateText}"/></Border>
                    <StackPanel Grid.Column="1" MinWidth="150" VerticalAlignment="Center">
                      <TextBlock Text="{services:TrText Component}" FontSize="13" FontWeight="SemiBold"/>
                      <TextBlock Text="{services:TrText Category}" Foreground="{DynamicResource MutedBrush}" FontSize="10"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{services:TrText Evidence}" TextWrapping="Wrap" FontSize="11"/>
                      <TextBlock Text="{services:TrText Recommendation}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" IsVisible="{Binding ShowRecommendation}"/>
                    </StackPanel>
                    <!-- v0.7.105.0: the Fix button needs an explicit tick first, the same "I understand"
                         pattern Backup Restore already uses (a desired follow-up named since v0.7.102.0).
                         Content stays a short "Confirmed" so the row doesn't grow; the sentence describing
                         exactly what the fix does is the tooltip instead. -->
                    <StackPanel Grid.Column="3" Spacing="4" VerticalAlignment="Center" HorizontalAlignment="Right">
                      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                        <Button Classes="verify" Content="{services:Tr ui.recheck}" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).RecheckDiagnosticCommand}" CommandParameter="{Binding}"/>
                        <Button Content="{services:TrText FixButtonText}" Classes="apply" IsVisible="{Binding CanFix}" IsEnabled="{Binding FixConfirmed}" Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).FixDiagnosticCommand}" CommandParameter="{Binding}"/>
                      </StackPanel>
                      <CheckBox Content="{services:Tr ui.confirmed}" ToolTip.Tip="{services:TrText FixConfirmText}" IsChecked="{Binding FixConfirmed}" IsVisible="{Binding CanFix}" FontSize="10" HorizontalAlignment="Right"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <!-- WORKSPACE -->
        <StackPanel IsVisible="{Binding IsWorkspacePage}" Spacing="12">
          <Border Classes="card accentServer">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel><TextBlock Text="{services:Tr ui.review_validate_and_open_every_mysttiq_working_l_15d2bb}" Classes="muted" TextWrapping="Wrap"/></StackPanel>
              <!-- v0.7.27.0: "Refresh" moved to the ribbon (BuildRibbonGroupsForActivePage); "Validate All" stays here, not part of that relocation. -->
              <WrapPanel Grid.Column="1"><Button Classes="verify" Content="{services:Tr ui.validate_all}" Command="{Binding ValidateWorkspaceCommand}"/></WrapPanel>
            </Grid>
          </Border>

          <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
            <Border Classes="statuscard accentServer"><StackPanel><TextBlock Text="{services:Tr ui.deployment_mode}" Classes="muted"/><TextBlock Text="{services:TrText WorkspaceDeploymentMode}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/><TextBlock Text="{services:Tr ui.local_paths_are_enabled_only_for_the_local_profi_cf4428}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Grid.Column="1" Classes="statuscard accentServer"><StackPanel><TextBlock Text="{services:Tr ui.workspace_health}" Classes="muted"/><TextBlock Text="{services:TrText WorkspaceHealthText}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource AmberBrush}"/><TextBlock Text="{services:TrText WorkspaceState}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Grid.Column="2" Classes="statuscard accentServer"><StackPanel><TextBlock Text="{services:Tr ui.server_discovery}" Classes="muted"/><TextBlock Text="{services:TrText WorkspaceDiscoveryText}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource GreenBrush}"/><TextBlock Text="{services:Tr ui.environment_checks_come_from_the_managed_server}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          </Grid>

          <Border Classes="card accentServer">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{services:Tr ui.workspace_locations}" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/><Button Grid.Column="1" Classes="apply" Content="{services:Tr ui.save_paths}" Command="{Binding SaveConfigurationCommand}"/></Grid>
              <Grid ColumnDefinitions="170,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" RowSpacing="7">
                <TextBlock Text="{services:Tr ui.executable_root}" Classes="muted" VerticalAlignment="Center"/><TextBox AutomationProperties.Name="{services:Tr ui.executable_root}" Grid.Column="1" Text="{Binding WorkspaceExecutableRoot}" IsReadOnly="True"/><Button Grid.Column="3" Content="{services:Tr ui.open}" Classes="open" Tag="executable" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="1" Text="{services:Tr ui.workspace_root}" Classes="muted" VerticalAlignment="Center"/><TextBox AutomationProperties.Name="{services:Tr ui.workspace_root}" Grid.Row="1" Grid.Column="1" Text="{Binding WorkspaceRoot}" IsReadOnly="True"/><Button Grid.Row="1" Grid.Column="3" Content="{services:Tr ui.open}" Classes="open" Tag="workspace" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="2" Text="{services:Tr ui.application_data}" Classes="muted" VerticalAlignment="Center"/><TextBox AutomationProperties.Name="{services:Tr ui.application_data}" Grid.Row="2" Grid.Column="1" Text="{Binding WorkspaceApplicationData}" IsReadOnly="True"/><Button Grid.Row="2" Grid.Column="3" Content="{services:Tr ui.open}" Classes="open" Tag="appdata" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="3" Text="{services:Tr ui.palworld_server}" Classes="muted" VerticalAlignment="Center"/><TextBox AutomationProperties.Name="{services:Tr ui.palworld_server}" Grid.Row="3" Grid.Column="1" Text="{Binding ConfigServerRoot}"/><Button Grid.Row="3" Grid.Column="2" Content="{services:Tr ui.browse}" Classes="open" Tag="server" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceBrowse_Click"/><Button Grid.Row="3" Grid.Column="3" Content="{services:Tr ui.open}" Classes="open" Tag="server" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="4" Text="{services:Tr ui.steamcmd}" Classes="muted" VerticalAlignment="Center"/><TextBox AutomationProperties.Name="{services:Tr ui.steamcmd}" Grid.Row="4" Grid.Column="1" Text="{Binding ConfigSteamCmdPath}"/><Button Grid.Row="4" Grid.Column="2" Content="{services:Tr ui.browse}" Classes="open" Tag="steamcmd" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceBrowse_Click"/><Button Grid.Row="4" Grid.Column="3" Content="{services:Tr ui.open}" Classes="open" Tag="steamcmd" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="5" Text="{services:Tr ui.backups}" Classes="muted" VerticalAlignment="Center"/><TextBox AutomationProperties.Name="{services:Tr ui.backups}" Grid.Row="5" Grid.Column="1" Text="{Binding ConfigBackupRoot}"/><Button Grid.Row="5" Grid.Column="2" Content="{services:Tr ui.browse}" Classes="open" Tag="backup" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceBrowse_Click"/><Button Grid.Row="5" Grid.Column="3" Content="{services:Tr ui.open}" Classes="open" Tag="backup" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="6" Text="{services:Tr ui.runtime}" Classes="muted" VerticalAlignment="Center"/><TextBox AutomationProperties.Name="{services:Tr ui.runtime}" Grid.Row="6" Grid.Column="1" Text="{Binding ConfigRuntimeRoot}"/><Button Grid.Row="6" Grid.Column="2" Content="{services:Tr ui.browse}" Classes="open" Tag="runtime" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceBrowse_Click"/><Button Grid.Row="6" Grid.Column="3" Content="{services:Tr ui.open}" Classes="open" Tag="runtime" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="7" Text="{services:Tr ui.downloads}" Classes="muted" VerticalAlignment="Center"/><TextBox AutomationProperties.Name="{services:Tr ui.downloads}" Grid.Row="7" Grid.Column="1" Text="{Binding WorkspaceDownloadsRoot}" IsReadOnly="True"/><Button Grid.Row="7" Grid.Column="3" Content="{services:Tr ui.open}" Classes="open" Tag="downloads" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="8" Text="{services:Tr ui.exports}" Classes="muted" VerticalAlignment="Center"/><TextBox AutomationProperties.Name="{services:Tr ui.exports}" Grid.Row="8" Grid.Column="1" Text="{Binding WorkspaceExportsRoot}" IsReadOnly="True"/><Button Grid.Row="8" Grid.Column="3" Content="{services:Tr ui.open}" Classes="open" Tag="exports" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
                <TextBlock Grid.Row="9" Text="{services:Tr ui.logs}" Classes="muted" VerticalAlignment="Center"/><TextBox AutomationProperties.Name="{services:Tr ui.logs}" Grid.Row="9" Grid.Column="1" Text="{Binding WorkspaceLogsRoot}" IsReadOnly="True"/><Button Grid.Row="9" Grid.Column="3" Content="{services:Tr ui.open}" Classes="open" Tag="logs" IsEnabled="{Binding IsLocalProfile}" Click="WorkspaceOpen_Click"/>
              </Grid>
              <TextBlock Text="{services:Tr ui.browse_open_are_local_profile_only_remote_paths_beddc2}" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>


        <!-- LAUNCHER / ADVANCED STARTUP (v1.0.0.1) -->
        <StackPanel IsVisible="{Binding IsLauncherPage}" Spacing="12">
          <Border Classes="card accentServer">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="3">
                  <TextBlock Text="{services:Tr ui.launcher_advanced_startup}" FontSize="20" FontWeight="SemiBold"/>
                  <TextBlock Text="{services:Tr ui.launcher_intro}" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Classes="info" Content="{services:Tr ui.launcher_load_saved}" Command="{Binding LoadConfigurationCommand}"/>
                  <Button Classes="apply" Content="{services:Tr ui.launcher_save_settings}" Command="{Binding SaveConfigurationCommand}"/>
                </StackPanel>
              </Grid>

              <TextBlock Text="{services:Tr ui.launcher_troubleshooting_presets}" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>
              <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
                <Border Classes="statuscard accentServer">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{services:Tr ui.launcher_preset_default}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{services:Tr ui.launcher_preset_default_desc}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                    <Button Classes="apply" Content="{services:Tr ui.launcher_apply_default}" Command="{Binding ApplyLauncherPresetCommand}" CommandParameter="Default" HorizontalAlignment="Left"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Classes="statuscard accentServer">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{services:Tr ui.launcher_preset_no_mods}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{services:Tr ui.launcher_preset_no_mods_desc}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                    <Button Classes="apply" Content="{services:Tr ui.launcher_apply_no_mods}" Command="{Binding ApplyLauncherPresetCommand}" CommandParameter="NoMods" HorizontalAlignment="Left"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Classes="statuscard accentServer">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{services:Tr ui.launcher_preset_show_window}" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock Text="{services:Tr ui.launcher_preset_show_window_desc}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                    <Button Classes="apply" Content="{services:Tr ui.launcher_apply_show_window}" Command="{Binding ApplyLauncherPresetCommand}" CommandParameter="ShowWindow" HorizontalAlignment="Left"/>
                  </StackPanel>
                </Border>
                  <!-- v1.0.0.1 (2026-10-04): the start the owner found keeps players' characters, exactly. -->
                  <Border Grid.Column="3" Classes="statuscard accentServer">
                    <StackPanel Spacing="6">
                      <TextBlock Text="{services:Tr ui.launcher_preset_double_click}" FontSize="16" FontWeight="SemiBold"/>
                      <TextBlock Text="{services:Tr ui.launcher_preset_double_click_desc}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                      <Button Classes="apply" Content="{services:Tr ui.launcher_apply_double_click}" Command="{Binding ApplyLauncherPresetCommand}" CommandParameter="DoubleClick" HorizontalAlignment="Left"/>
                    </StackPanel>
                  </Border>
              </Grid>
              <TextBlock Text="{services:TrText ConfigLauncherPresetStatus}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="{services:Tr ui.launcher_preset_preserve_note}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Classes="card accentServer">
            <StackPanel Spacing="10">
              <TextBlock Text="{services:Tr ui.launcher_executable_and_working_directory}" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="180,220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                <TextBlock Text="{services:Tr ui.launcher_executable}" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" AutomationProperties.Name="{services:Tr ui.launcher_executable}" ItemsSource="{Binding ConfigLauncherExecutableOptions}" SelectedItem="{Binding ConfigLauncherExecutable, Mode=TwoWay}"/>
                <TextBox Grid.Column="2" AutomationProperties.Name="{services:Tr ui.launcher_custom_executable_path}" Text="{Binding ConfigLauncherCustomExecutablePath, Mode=TwoWay}" PlaceholderText="{services:Tr ui.launcher_custom_executable_path}"/>

                <TextBlock Grid.Row="1" Text="{services:Tr ui.launcher_working_directory}" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1" AutomationProperties.Name="{services:Tr ui.launcher_working_directory}" ItemsSource="{Binding ConfigLauncherWorkingDirectoryOptions}" SelectedItem="{Binding ConfigLauncherWorkingDirectory, Mode=TwoWay}"/>
                <TextBox Grid.Row="1" Grid.Column="2" AutomationProperties.Name="{services:Tr ui.launcher_custom_working_directory}" Text="{Binding ConfigLauncherCustomWorkingDirectory, Mode=TwoWay}" PlaceholderText="{services:Tr ui.launcher_custom_working_directory}"/>

                <TextBlock Grid.Row="2" Text="{services:Tr ui.launcher_window_style}" VerticalAlignment="Center"/>
                <ComboBox Grid.Row="2" Grid.Column="1" AutomationProperties.Name="{services:Tr ui.launcher_window_style}" ItemsSource="{Binding ConfigLauncherWindowStyleOptions}" SelectedItem="{Binding ConfigLauncherWindowStyle, Mode=TwoWay}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{services:Tr ui.launcher_palserver_normal_launcher_note}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>

                <TextBlock Grid.Row="3" Text="{services:Tr ui.launcher_path_macros}" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Text="{services:Tr ui.launcher_path_macros_note}" Classes="muted" FontSize="11"/>
              </Grid>

              <TextBlock Text="{services:Tr ui.launcher_windows_process_creation}" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto" RowSpacing="6" ColumnSpacing="16">
                <CheckBox Content="UseShellExecute" IsChecked="{Binding ConfigLauncherUseShellExecute, Mode=TwoWay}"/>
                <CheckBox Grid.Column="1" Content="CreateNoWindow" IsChecked="{Binding ConfigLauncherCreateNoWindow, Mode=TwoWay}"/>
                <CheckBox Grid.Column="2" Content="{services:Tr ui.launcher_hide_managed_windows}" IsChecked="{Binding ConfigLauncherHideManagedWindows, Mode=TwoWay}"/>
                <CheckBox Grid.Row="1" Content="{services:Tr ui.launcher_redirect_stdout}" IsChecked="{Binding ConfigLauncherRedirectStandardOutput, Mode=TwoWay}"/>
                <CheckBox Grid.Row="1" Grid.Column="1" Content="{services:Tr ui.launcher_redirect_stderr}" IsChecked="{Binding ConfigLauncherRedirectStandardError, Mode=TwoWay}"/>
                <CheckBox Grid.Row="1" Grid.Column="2" Content="{services:Tr ui.launcher_copy_redirected_output}" IsChecked="{Binding ConfigLauncherCaptureRedirectedOutput, Mode=TwoWay}"/>
              </Grid>

              <TextBlock Text="{services:Tr ui.launcher_command_line_switches}" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="*,*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6" ColumnSpacing="16">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <CheckBox Content="-port=" IsChecked="{Binding ConfigLauncherPortEnabled, Mode=TwoWay}" VerticalAlignment="Center"/>
                  <NumericUpDown Width="100" AutomationProperties.Name="{services:Tr ui.port}" Value="{Binding ConfigLauncherPort, Mode=TwoWay}" Minimum="1" Maximum="65535"/>
                </StackPanel>
                <CheckBox Grid.Column="1" Content="-log" IsChecked="{Binding ConfigLauncherLog, Mode=TwoWay}"/>
                <CheckBox Grid.Column="2" Content="-logformat=text" IsChecked="{Binding ConfigLauncherLogFormatText, Mode=TwoWay}"/>

                <CheckBox Grid.Row="1" Content="-stdout" IsChecked="{Binding ConfigLauncherStdout, Mode=TwoWay}"/>
                <CheckBox Grid.Row="1" Grid.Column="1" Content="-FullStdOutLogOutput" IsChecked="{Binding ConfigLauncherFullStdOutLogOutput, Mode=TwoWay}"/>
                <CheckBox Grid.Row="1" Grid.Column="2" Content="-unattended" IsChecked="{Binding ConfigLauncherUnattended, Mode=TwoWay}"/>

                <CheckBox Grid.Row="2" Content="-useperfthreads" IsChecked="{Binding ConfigLauncherUsePerfThreads, Mode=TwoWay}"/>
                <CheckBox Grid.Row="2" Grid.Column="1" Content="-NoAsyncLoadingThread" IsChecked="{Binding ConfigLauncherNoAsyncLoadingThread, Mode=TwoWay}"/>
                <CheckBox Grid.Row="2" Grid.Column="2" Content="-UseMultithreadForDS" IsChecked="{Binding ConfigLauncherUseMultithreadForDs, Mode=TwoWay}"/>

                <CheckBox Grid.Row="3" Content="-abslog=" IsChecked="{Binding ConfigLauncherAbsLog, Mode=TwoWay}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" AutomationProperties.Name="{services:Tr ui.launcher_log_path}" Text="{Binding ConfigLauncherAbsLogPath, Mode=TwoWay}" PlaceholderText="{services:Tr ui.launcher_log_path}"/>

                <CheckBox Grid.Row="4" Content="{services:Tr ui.launcher_no_mods}" IsChecked="{Binding ConfigLauncherNoMods, Mode=TwoWay}"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{services:Tr ui.launcher_no_mods_note}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
              </Grid>

              <TextBlock Text="{services:Tr ui.launcher_custom_arguments}" FontWeight="SemiBold"/>
              <TextBox AutomationProperties.Name="{services:Tr ui.launcher_custom_arguments}" Text="{Binding ConfigLauncherCustomArguments, Mode=TwoWay}" AcceptsReturn="True" MinHeight="90" PlaceholderText="{services:Tr ui.launcher_custom_arguments_example}"/>

              <TextBlock Text="{services:Tr ui.launcher_effective_command}" FontWeight="SemiBold"/>
              <TextBox AutomationProperties.Name="{services:Tr ui.launcher_effective_command}" Text="{Binding ConfigLauncherEffectiveCommand, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="62"/>
              <TextBlock Text="{services:TrText ConfigLauncherProcessSummary}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText ConfigLauncherWarning}" Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- WORLD VALIDATOR / REPAIR / RECOVERY / TRANSACTION CENTER -->
        <StackPanel IsVisible="{Binding IsWorldTransactionsPage}" Spacing="12">
          <Border Classes="card accentWorld">
            <StackPanel Spacing="12">
              <!-- v0.7.42.0: Validate Active World/Export Report moved to the ribbon. -->
              <StackPanel Spacing="4"><TextBlock Text="{services:Tr ui.world_validator}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{services:TrText WorldValidationState}" Classes="muted" TextWrapping="Wrap"/></StackPanel>
              <ItemsControl ItemsSource="{Binding WorldValidationFindings}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:WorldValidationFindingDto"><Border Classes="statuscard accentWorld" Margin="0,3"><Grid ColumnDefinitions="100,130,*" ColumnSpacing="10"><TextBlock Text="{services:TrText Severity}" Foreground="{DynamicResource AmberBrush}"/><TextBlock Grid.Column="1" Text="{services:TrText Category}"/><TextBlock Grid.Column="2" Text="{services:TrText Detail}" TextWrapping="Wrap" Classes="muted"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card accentWorld">
            <StackPanel Spacing="12">
              <TextBlock Text="{services:Tr ui.repair_center_recovery}" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Text="{services:Tr ui.import_archive_workflow_analyze_accept_options_r_f2373d}" Classes="muted" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="190,Auto,*" ColumnSpacing="10"><ComboBox AutomationProperties.Name="{services:Tr ui.a11y_import_mode}" ItemsSource="{Binding WorldTransactionModes}" SelectedItem="{Binding WorldTransactionMode}"/><Button Classes="verify" Grid.Column="1" Content="{services:Tr ui.analyze_zip_archive}" Click="AnalyzeWorldArchive_Click" IsEnabled="{Binding CanManageAdmin}"/><TextBlock Grid.Column="2" Text="{services:TrText WorldTransactionState}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/></Grid>
              <Border Classes="statuscard accentWorld"><StackPanel Spacing="6"><TextBlock Text="{services:Tr ui.transaction_plan}" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding WorldTransactionPlanSteps}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
              <CheckBox Content="{services:Tr ui.i_reviewed_this_plan_and_confirm_the_active_palw_4fd78f}" IsChecked="{Binding WorldTransactionConfirmed}"/>
              <Button Classes="danger" Content="{services:Tr ui.apply_with_fresh_safety_backup}" HorizontalAlignment="Left" Command="{Binding ApplyWorldTransactionCommand}"/>
            </StackPanel>
          </Border>
          <Border Classes="card accentWorld">
            <StackPanel Spacing="10"><TextBlock Text="{services:Tr ui.transaction_center_durable_journal}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{services:Tr ui.every_accepted_mutation_records_preview_acceptan_5df00d}" Classes="muted" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding WorldTransactionHistory}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:WorldTransactionJournalDto"><Border Classes="statuscard accentWorld" Margin="0,3"><StackPanel Spacing="3"><TextBlock Text="{services:TrText Summary}" FontWeight="SemiBold"/><TextBlock Text="{Binding TransactionId}" FontFamily="Consolas, monospace" FontSize="10"/><TextBlock Text="{Binding SafetyBackup, StringFormat='Safety backup: {0}'}" Classes="muted"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Border>
          <Border Classes="card accentWorld">
            <StackPanel Spacing="10">
              <!-- v0.7.42.0: Refresh moved to the ribbon. -->
              <StackPanel Spacing="4"><TextBlock Text="{services:Tr ui.operation_platform}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{services:Tr ui.cross_feature_view_of_the_shared_operation_coord_809d15}" Classes="muted" TextWrapping="Wrap"/></StackPanel>
              <ItemsControl ItemsSource="{Binding RecentOperations}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:OperationRecordDto"><Border Classes="statuscard accentWorld" Margin="0,3"><Grid ColumnDefinitions="150,180,100,100,*" ColumnSpacing="10"><TextBlock Text="{services:TrText Kind}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{services:TrText Source}" Classes="muted"/><TextBlock Grid.Column="2" Text="{services:TrText Phase}"/><TextBlock Grid.Column="3" Text="{services:TrText TransactionState}" Classes="muted"/><TextBlock Grid.Column="4" Text="{services:TrText UpdatedUtc}" Classes="muted"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- CRASH ANALYZER -->
        <StackPanel IsVisible="{Binding IsCrashAnalyzerPage}" Spacing="12">
          <Border Classes="card accentTools"><StackPanel Spacing="10">
            <!-- v0.7.42.0: Refresh History/Run Analysis moved to the ribbon. -->
            <TextBlock Text="{services:TrText CrashAnalyzerState}" TextWrapping="Wrap" Classes="muted"/>
            <TextBlock Text="{services:Tr ui.each_finding_matches_a_known_failure_pattern_and_0dac47}" TextWrapping="Wrap"/>
          </StackPanel></Border>
          <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <Border Classes="card accentTools"><StackPanel Spacing="8"><TextBlock Text="{services:Tr ui.findings}" FontWeight="SemiBold"/><ListBox AutomationProperties.Name="{services:Tr ui.findings}" ItemsSource="{Binding CrashFindings}" SelectedItem="{Binding SelectedCrashFinding, Mode=TwoWay}" MinHeight="160"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{services:TrText Display}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
            <Border Grid.Column="1" Classes="card accentTools"><StackPanel Spacing="8"><TextBlock Text="{services:Tr ui.safe_isolation_plan}" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding CrashIsolationPlan}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='•  {0}'}" Margin="0,3" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          </Grid>
          <!-- v0.7.97.0: cause, fixes and evidence for the finding picked in the list above. -->
          <Border Classes="card accentTools" IsVisible="{Binding HasSelectedCrashFinding}">
            <StackPanel Spacing="8" DataContext="{Binding SelectedCrashFinding}" x:DataType="models:CrashFindingDto">
              <TextBlock Text="{services:TrText Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText StatusText}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText SeenText}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="{services:Tr ui.what_this_usually_means}" FontWeight="SemiBold" IsVisible="{Binding HasCause}"/>
              <TextBlock Text="{services:TrText Cause}" TextWrapping="Wrap" IsVisible="{Binding HasCause}"/>
              <TextBlock Text="{services:Tr ui.what_to_try}" FontWeight="SemiBold" IsVisible="{Binding HasFixes}"/>
              <TextBlock Text="{services:TrText FixesText}" TextWrapping="Wrap" IsVisible="{Binding HasFixes}"/>
              <TextBlock Text="{services:TrText ModsText}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap"/>
              <TextBlock Text="{services:Tr ui.evidence_most_recent_matching_lines}" FontWeight="SemiBold"/>
              <TextBox AutomationProperties.Name="{services:Tr ui.evidence_most_recent_matching_lines}" Text="{Binding EvidenceText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="200" FontFamily="Consolas, monospace" FontSize="12"/>
            </StackPanel>
          </Border>
          <Border Classes="card accentTools"><StackPanel Spacing="8"><TextBlock Text="{services:Tr ui.persisted_analysis_history}" FontWeight="SemiBold"/><ListBox AutomationProperties.Name="{services:Tr ui.persisted_analysis_history}" ItemsSource="{Binding CrashHistory}" MaxHeight="220"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{services:TrText Display}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
        </StackPanel>

        <!-- PALWORLD SAVE TOOLS -->
        <StackPanel IsVisible="{Binding IsSaveToolsPage}" Spacing="12">
          <Border Classes="card accentTools"><StackPanel Spacing="10">
            <!-- v0.7.42.0: Refresh/Run Self-Tests moved to the ribbon. -->
            <TextBlock Text="{services:TrText SaveToolsState}" TextWrapping="Wrap" Classes="muted"/>
            <TextBlock Text="{services:TrText SaveToolsPaths}" TextWrapping="Wrap" FontFamily="Consolas"/>
            <TextBlock Text="{services:Tr ui.inspection_is_read_only_save_mutation_remains_be_30042e}" TextWrapping="Wrap"/>
          </StackPanel></Border>
          <Grid ColumnDefinitions="2*,3*" ColumnSpacing="12">
            <Border Classes="card accentTools"><StackPanel Spacing="8"><TextBlock Text="{services:Tr ui.self_test_results}" FontWeight="SemiBold"/><ListBox AutomationProperties.Name="{services:Tr ui.self_test_results}" ItemsSource="{Binding SaveToolsTests}" MinHeight="180" MaxHeight="420"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{services:TrText Display}"/><TextBlock Text="{services:TrText Detail}" Classes="muted" TextWrapping="Wrap" MaxHeight="72"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></Border>
            <Border Grid.Column="1" Classes="card accentTools"><Grid RowDefinitions="Auto,*" RowSpacing="8"><TextBlock Text="{services:Tr ui.server_side_save_inventory}" FontWeight="SemiBold"/><ListBox AutomationProperties.Name="{services:Tr ui.server_side_save_inventory}" Grid.Row="1" ItemsSource="{Binding SaveFiles}" SelectedItem="{Binding SelectedSaveFile}" MinHeight="180" MaxHeight="420"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{services:TrText Display}" TextWrapping="Wrap"/></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
          </Grid>
        </StackPanel>

        <!-- NOTIFICATIONS -->
        <StackPanel IsVisible="{Binding IsNotificationsPage}" Spacing="12">
          <!-- v0.7.42.0: Refresh/Self-Test/Mark All Read/Export Visible moved to the ribbon. -->
          <Border Classes="card accentSystem"><Grid ColumnDefinitions="*"><StackPanel><TextBlock Text="{services:TrText NotificationState}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Grid></Border>
          <Border Classes="card accentSystem"><StackPanel Spacing="10"><Grid ColumnDefinitions="2*,*" ColumnSpacing="8"><TextBox Text="{Binding NotificationSearchText}" PlaceholderText="{services:Tr ui.search_notifications}"/><ComboBox AutomationProperties.Name="{services:Tr ui.a11y_severity_filter}" Grid.Column="1" ItemsSource="{Binding NotificationSeverityOptions}" SelectedItem="{Binding NotificationSeverityFilter}"/></Grid>
            <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
              <ListBox AutomationProperties.Name="{services:Tr nav.Notifications}" ItemsSource="{Binding FilteredNotifications}" SelectedItem="{Binding SelectedNotification}" MaxHeight="470"><ListBox.ItemTemplate><DataTemplate x:DataType="models:NotificationItemDto"><Border Classes="statuscard accentSystem" Margin="0,3"><StackPanel Spacing="3"><TextBlock Text="{services:TrText Title}" FontWeight="SemiBold"/><TextBlock Text="{services:TrText Message}" TextWrapping="Wrap"/><TextBlock Text="{services:TrText Severity}" Foreground="{DynamicResource VioletBrush}"/><TextBlock Text="{services:TrText StateText}" Classes="muted" FontSize="10"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
              <Border Grid.Column="1" Classes="statuscard accentSystem"><StackPanel Spacing="8"><TextBlock Text="{services:Tr ui.selected_notification}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{services:TrText SelectedNotification.Title}" FontWeight="SemiBold"/><TextBlock Text="{services:TrText SelectedNotification.Message}" TextWrapping="Wrap"/><TextBlock Text="{services:TrText SelectedNotification.StateText}" Classes="muted"/><Button Classes="caution" Content="{services:Tr ui.toggle_read_unread}" Command="{Binding ToggleNotificationReadCommand}"/><Button Classes="caution" Content="{services:Tr ui.pin_unpin}" Command="{Binding ToggleNotificationPinCommand}"/><Button Classes="plain" Content="{services:Tr ui.dismiss}" Command="{Binding DismissNotificationCommand}"/></StackPanel></Border>
            </Grid>
          </StackPanel></Border>
        </StackPanel>

        <!-- AUTOMATION -->
        <StackPanel IsVisible="{Binding IsAutomationPage}" Spacing="12">
          <!-- v0.7.102.0: shown only while there are no rules, since then nothing is scheduled, backups included. -->
          <Border Classes="card accentSystem" IsVisible="{Binding HasNoAutomationRules}">
            <StackPanel Spacing="4">
              <TextBlock Text="{services:Tr ui.nothing_is_scheduled_yet}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource AmberBrush}"/>
              <TextBlock Text="{services:Tr ui.there_are_no_automation_rules_so_no_backup_runs_162377}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <!-- v0.7.42.0: Refresh moved to the ribbon. -->
          <Border Classes="card accentSystem"><StackPanel Spacing="4"><TextBlock Text="{services:Tr ui.scheduled_automation}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{services:TrText AutomationState}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          <Grid ColumnDefinitions="2*,*" ColumnSpacing="12">
            <Border Classes="card accentSystem"><StackPanel Spacing="8"><TextBlock Text="{services:Tr ui.rules}" FontSize="17" FontWeight="SemiBold"/>
              <ListBox AutomationProperties.Name="{services:Tr ui.rules}" ItemsSource="{Binding AutomationRules}" SelectedItem="{Binding SelectedAutomationRule}" MaxHeight="420"><ListBox.ItemTemplate><DataTemplate x:DataType="models:AutomationRuleDto"><Border Classes="statuscard accentSystem" Margin="0,3"><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{services:TrText ScheduleText}" Classes="muted"/><TextBlock Text="{services:TrText Action.Kind}" Foreground="{DynamicResource VioletBrush}"/><TextBlock><Run Text="{services:Tr ui.enabled}"/><Run Text="{services:TrText Enabled}"/></TextBlock></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            </StackPanel></Border>
            <Border Grid.Column="1" Classes="statuscard accentSystem" IsEnabled="{Binding CanManageAdmin}"><StackPanel Spacing="8"><TextBlock Text="{services:Tr ui.selected_rule}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedAutomationRule.Name}" FontWeight="SemiBold"/><TextBlock Text="{services:TrText SelectedAutomationRule.ScheduleText}" Classes="muted" TextWrapping="Wrap"/><Button Classes="apply" Content="{services:Tr ui.run_now}" Command="{Binding RunAutomationRuleNowCommand}"/><Button Classes="caution" Content="{services:Tr ui.enable_disable}" Command="{Binding ToggleAutomationRuleEnabledCommand}"/><Button Classes="danger" Content="{services:Tr ui.delete}" Command="{Binding DeleteAutomationRuleCommand}"/></StackPanel></Border>
          </Grid>
          <Border Classes="card accentSystem" IsVisible="{Binding CanManageAdmin}" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="10">
              <TextBlock Text="{services:Tr ui.new_rule}" FontSize="17" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                <TextBlock Text="{services:Tr ui.name}" VerticalAlignment="Center" Classes="muted"/><TextBox Grid.Column="1" Text="{Binding NewAutomationRuleName}" PlaceholderText="{services:Tr ui.nightly_backup}"/>
                <TextBlock Grid.Row="1" Text="{services:Tr ui.trigger}" VerticalAlignment="Center" Classes="muted"/><ComboBox AutomationProperties.Name="{services:Tr ui.trigger}" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding AutomationTriggerKinds}" SelectedItem="{Binding NewAutomationTriggerKind}"/>
                <TextBlock Grid.Row="2" Text="{services:Tr ui.time_utc_hh_mm_interval_min_idle_threshold_min}" VerticalAlignment="Center" Classes="muted"/>
                <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,*,*" ColumnSpacing="10"><TextBox Text="{Binding NewAutomationTimeOfDayUtc}" PlaceholderText="03:00"/><NumericUpDown AutomationProperties.Name="{services:Tr ui.time_utc_hh_mm_interval_min_idle_threshold_min}" Grid.Column="1" Value="{Binding NewAutomationIntervalMinutes}" Minimum="1"/><NumericUpDown Grid.Column="2" Value="{Binding NewAutomationIdleThresholdMinutes}" Minimum="1" ToolTip.Tip="{services:Tr ui.used_only_when_trigger_is_idleempty_stop_after_t_8c30de}"/></Grid>
                <TextBlock Grid.Row="3" Text="{services:Tr ui.action}" VerticalAlignment="Center" Classes="muted"/><ComboBox AutomationProperties.Name="{services:Tr ui.action}" Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AutomationActionKinds}" SelectedItem="{Binding NewAutomationActionKind}"/>
                <TextBlock Grid.Row="4" Text="{services:Tr ui.notification_title_message}" VerticalAlignment="Center" Classes="muted"/>
                <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="*,*" ColumnSpacing="10"><TextBox Text="{Binding NewAutomationNotificationTitle}" PlaceholderText="{services:Tr ui.title}"/><TextBox Grid.Column="1" Text="{Binding NewAutomationNotificationMessage}" PlaceholderText="{services:Tr ui.message}"/></Grid>
                <TextBlock Grid.Row="5" Text="{services:Tr ui.rcon_command}" VerticalAlignment="Center" Classes="muted"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding NewAutomationRconCommand}" PlaceholderText="{services:Tr ui.broadcast_hello}"/>
              </Grid>
              <Button Classes="apply" Content="{services:Tr ui.create_rule}" HorizontalAlignment="Left" Command="{Binding CreateAutomationRuleCommand}"/>
            </StackPanel>
          </Border>
          <Border Classes="card accentSystem"><StackPanel Spacing="8"><TextBlock Text="{services:Tr ui.recent_runs}" FontSize="17" FontWeight="SemiBold"/>
            <ItemsControl ItemsSource="{Binding AutomationRuns}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="models:AutomationRunRecordDto"><Border Classes="statuscard accentSystem" Margin="0,3"><Grid ColumnDefinitions="150,100,*" ColumnSpacing="10"><TextBlock Text="{Binding RuleName}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{services:TrText State}"/><TextBlock Grid.Column="2" Text="{services:TrText Detail}" Classes="muted" TextWrapping="Wrap"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          </StackPanel></Border>
        </StackPanel>

        <!-- ALERT CENTER -->
        <StackPanel IsVisible="{Binding IsAlertCenterPage}" Spacing="12">
          <!-- v0.7.42.0: Refresh moved to the ribbon (Discord Bot/Anti-Cheat's own per-section
               refresh buttons below stay in-page, tied to their own collapsible sections). -->
          <Border Classes="card accentSystem"><StackPanel Spacing="4"><TextBlock Text="{services:Tr ui.alert_center}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{services:TrText AlertCenterState}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Classes="statuscard accentSystem"><StackPanel Spacing="4"><TextBlock Text="{services:Tr ui.disk_space_prediction}" Classes="muted"/><TextBlock Text="{services:TrText DiskSpacePrediction.FreeGb}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/><TextBlock Text="{services:TrText DiskSpacePrediction.Detail}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Classes="card accentSystem" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="10">
              <TextBlock Text="{services:Tr ui.threshold_rules}" FontSize="17" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="220,Auto,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                <TextBlock Text="{services:Tr ui.sustained_high_cpu}" VerticalAlignment="Center" Classes="muted"/><CheckBox AutomationProperties.Name="{services:Tr ui.sustained_high_cpu}" Grid.Column="1" IsChecked="{Binding AlertRules.HighCpuSustained.Enabled}"/><NumericUpDown AutomationProperties.Name="{services:Tr ui.sustained_high_cpu}" Grid.Column="2" Value="{Binding AlertRules.HighCpuSustained.ThresholdPercent}" Minimum="1" Maximum="100"/>
                <TextBlock Grid.Row="1" Text="{services:Tr ui.sustained_high_memory_mb}" VerticalAlignment="Center" Classes="muted"/><CheckBox AutomationProperties.Name="{services:Tr ui.sustained_high_memory_mb}" Grid.Row="1" Grid.Column="1" IsChecked="{Binding AlertRules.HighMemorySustained.Enabled}"/><NumericUpDown AutomationProperties.Name="{services:Tr ui.sustained_high_memory_mb}" Grid.Row="1" Grid.Column="2" Value="{Binding AlertRules.HighMemorySustained.ThresholdMb}" Minimum="1"/>
                <TextBlock Grid.Row="2" Text="{services:Tr ui.low_disk_space}" VerticalAlignment="Center" Classes="muted"/><CheckBox AutomationProperties.Name="{services:Tr ui.low_disk_space}" Grid.Row="2" Grid.Column="1" IsChecked="{Binding AlertRules.LowDiskSpace.Enabled}"/><NumericUpDown AutomationProperties.Name="{services:Tr ui.low_disk_space}" Grid.Row="2" Grid.Column="2" Value="{Binding AlertRules.LowDiskSpace.ThresholdPercent}" Minimum="1" Maximum="100"/>
                <TextBlock Grid.Row="3" Text="{services:Tr ui.disk_exhaustion_predicted_within_days}" VerticalAlignment="Center" Classes="muted"/><CheckBox AutomationProperties.Name="{services:Tr ui.disk_exhaustion_predicted_within_days}" Grid.Row="3" Grid.Column="1" IsChecked="{Binding AlertRules.DiskSpaceExhaustionPredicted.Enabled}"/><NumericUpDown AutomationProperties.Name="{services:Tr ui.disk_exhaustion_predicted_within_days}" Grid.Row="3" Grid.Column="2" Value="{Binding AlertRules.DiskSpaceExhaustionPredicted.ThresholdDays}" Minimum="1"/>
                <TextBlock Grid.Row="4" Text="{services:Tr ui.mod_ue4ss_health_needs_attention}" VerticalAlignment="Center" Classes="muted"/><CheckBox AutomationProperties.Name="{services:Tr ui.mod_ue4ss_health_needs_attention}" Grid.Row="4" Grid.Column="1" IsChecked="{Binding AlertRules.ModHealthDegraded.Enabled}"/><TextBlock Grid.Row="4" Grid.Column="2" Text="{services:Tr ui.fires_when_an_enabled_mod_reports_failed_missing_d454e6}" Classes="muted" VerticalAlignment="Center" FontSize="11"/>
                <!-- v0.9.8.0: the game server behind Steam's public build, or PalDefender not updated for the game. -->
                <TextBlock Grid.Row="5" Text="{services:Tr ui.component_out_of_date}" VerticalAlignment="Center" Classes="muted"/><CheckBox AutomationProperties.Name="{services:Tr ui.component_out_of_date}" Grid.Row="5" Grid.Column="1" IsChecked="{Binding AlertRules.ComponentOutdated.Enabled}"/><TextBlock Grid.Row="5" Grid.Column="2" Text="{services:Tr ui.component_out_of_date_hint}" Classes="muted" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <!-- v0.7.108.0: was an env-var-only live-testing knob (MYSTTIQ_ALERT_REMINDER_MINUTES) in
                     v0.7.107.0; now a real setting here too, applying to every rule above. 0 turns the
                     "Still active: ..." follow-up off entirely. -->
                <TextBlock Grid.Row="6" Text="{services:Tr ui.reminder_every_minutes_0_off}" VerticalAlignment="Center" Classes="muted" ToolTip.Tip="{services:Tr ui.how_often_a_still_active_condition_sends_a_still_24ec91}"/>
                <NumericUpDown AutomationProperties.Name="{services:Tr ui.reminder_every_minutes_0_off}" Grid.Row="6" Grid.Column="2" Value="{Binding AlertRules.ReminderMinutes}" Minimum="0" Maximum="10080" FormatString="0"/>
              </Grid>
              <!-- v0.7.111.0: crash-recovery alerts had no settings at all. Stored in this profile's own
                   rules, so each server tab has its own, and saved with Save Rules like everything above. -->
              <TextBlock Text="{services:Tr ui.crash_alerts}" FontSize="15" FontWeight="SemiBold" Margin="0,6,0,0"/>
              <CheckBox Content="{services:Tr ui.send_crash_recovery_alerts_crashed_restart_faile_12e88a}" IsChecked="{Binding AlertRules.CrashAlerts.Enabled}"/>
              <CheckBox Content="{services:Tr ui.also_send_server_is_back_up_notices}" IsChecked="{Binding AlertRules.CrashAlerts.RecoveryNotices}" IsEnabled="{Binding AlertRules.CrashAlerts.Enabled}"/>
              <Button Classes="apply" Content="{services:Tr ui.save_rules}" HorizontalAlignment="Left" Command="{Binding SaveAlertRulesCommand}"/>
            </StackPanel>
          </Border>
          <!-- v0.7.111.0: a timed mute for every alert on this server, for maintenance. Applies at once,
               no Save needed; the end time is set by the MystTiq host's own clock. -->
          <Border Classes="card accentSystem" IsVisible="{Binding CanManageAdmin}" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="8">
              <TextBlock Text="{services:Tr ui.mute_alerts}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{services:TrText AlertRules.MuteStatusText}" Classes="muted" TextWrapping="Wrap"/>
              <WrapPanel>
                <Button Classes="caution" Content="{services:Tr ui.mute_1_hour}" Command="{Binding MuteAlertsCommand}" CommandParameter="60" Margin="0,0,8,8"/>
                <Button Classes="caution" Content="{services:Tr ui.mute_8_hours}" Command="{Binding MuteAlertsCommand}" CommandParameter="480" Margin="0,0,8,8"/>
                <Button Classes="caution" Content="{services:Tr ui.mute_24_hours}" Command="{Binding MuteAlertsCommand}" CommandParameter="1440" Margin="0,0,8,8"/>
                <Button Classes="caution" Content="{services:Tr ui.mute_7_days}" Command="{Binding MuteAlertsCommand}" CommandParameter="10080" Margin="0,0,8,8"/>
                <Button Classes="apply" Content="{services:Tr ui.unmute}" Command="{Binding MuteAlertsCommand}" CommandParameter="0" IsVisible="{Binding AlertRules.IsMuted}" Margin="0,0,8,8"/>
              </WrapPanel>
              <TextBlock Text="{services:Tr ui.muted_alerts_are_not_queued_crash_alerts_skipped_cb5362}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <!-- v0.8.4.0: the lighter option: keep every notification on the Notifications page, stop sending them to
               Discord, email and webhooks for a while. Applies at once; the end time is set by the host's clock. -->
          <Border x:Name="PauseDeliveryCard" Classes="card accentSystem" IsVisible="{Binding CanManageAdmin}" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="8">
              <TextBlock Text="{services:Tr ui.pause_discord_email_and_webhooks}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{services:TrText NotificationDelivery.StatusText}" Classes="muted" TextWrapping="Wrap"/>
              <WrapPanel>
                <Button Classes="caution" Content="{services:Tr ui.pause_1_hour}" Command="{Binding PauseDeliveryCommand}" CommandParameter="60" Margin="0,0,8,8"/>
                <Button Classes="caution" Content="{services:Tr ui.pause_8_hours}" Command="{Binding PauseDeliveryCommand}" CommandParameter="480" Margin="0,0,8,8"/>
                <Button Classes="caution" Content="{services:Tr ui.pause_24_hours}" Command="{Binding PauseDeliveryCommand}" CommandParameter="1440" Margin="0,0,8,8"/>
                <Button Classes="caution" Content="{services:Tr ui.pause_7_days}" Command="{Binding PauseDeliveryCommand}" CommandParameter="10080" Margin="0,0,8,8"/>
                <Button Classes="apply" Content="{services:Tr ui.resume}" Command="{Binding PauseDeliveryCommand}" CommandParameter="0" IsVisible="{Binding NotificationDelivery.IsPaused}" Margin="0,0,8,8"/>
                <Button Classes="apply" Content="{services:Tr ui.send_test_notification}" Command="{Binding SendTestNotificationCommand}" Margin="0,0,8,8"
                        ToolTip.Tip="{services:Tr ui.creates_a_test_notification_through_the_normal_p_b060d4}"/>
              </WrapPanel>
              <TextBlock Text="{services:Tr ui.unlike_mute_alerts_nothing_is_silenced_in_mystti_3218bd}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <!-- v1.0.2.0 (roadmap R-2, alert delivery proof): every send to Discord, email or a webhook is recorded with its
               result; a switched-on channel with no proven delivery in 7 days, or whose last send failed, is flagged. -->
          <Border x:Name="DeliveryHealthCard" Classes="card accentSystem">
            <StackPanel Spacing="8">
              <TextBlock Text="{services:Tr ui.delivery}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{services:TrText DeliveryHealth.Summary}" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding DeliveryHealth.Channels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:NotificationChannelHealthDto">
                    <Grid ColumnDefinitions="110,110,*" ColumnSpacing="10" Margin="0,2">
                      <TextBlock Text="{services:TrText Channel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Classes="tag" HorizontalAlignment="Left" services:StatusTag.Status="{Binding StateText}"><TextBlock Text="{services:TrText StateText}"/></Border>
                      <TextBlock Grid.Column="2" Text="{services:TrText Detail}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{services:Tr ui.recent_sends}" FontWeight="SemiBold" IsVisible="{Binding DeliveryHealth.HasRecent}"/>
              <ItemsControl ItemsSource="{Binding DeliveryHealth.Recent}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:NotificationDeliveryRecordDto">
                    <Grid ColumnDefinitions="140,90,90,*" ColumnSpacing="10" Margin="0,1">
                      <TextBlock Text="{Binding WhenVerbatim}" Classes="muted" FontSize="11" VerticalAlignment="Center"/>
                      <TextBlock Grid.Column="1" Text="{services:TrText Channel}" FontSize="11" VerticalAlignment="Center"/>
                      <Border Grid.Column="2" Classes="tag" HorizontalAlignment="Left" services:StatusTag.Status="{Binding ResultText}"><TextBlock Text="{services:TrText ResultText}"/></Border>
                      <StackPanel Grid.Column="3"><TextBlock Text="{services:TrText Title}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="{services:TrText Detail}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis"/></StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <!-- v0.7.5.0 (no-scroll pass 1): Discord Bot and Anti-Cheat are large, independent
               features unrelated to Threshold Rules above; both collapse by default. -->
          <Border Classes="card accentSystem" IsVisible="{Binding CanManageAdmin}" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleDiscordBotCommand}" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="▸" IsVisible="{Binding !IsDiscordBotExpanded}" FontWeight="Bold"/><TextBlock Text="▾" IsVisible="{Binding IsDiscordBotExpanded}" FontWeight="Bold"/><TextBlock Text="{services:Tr ui.discord_bot}" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                </Button>
                <Button Classes="info" Grid.Column="1" Content="{services:Tr ui.refresh}" Command="{Binding RefreshDiscordBotConfigCommand}" VerticalAlignment="Top" IsVisible="{Binding IsDiscordBotExpanded}"/>
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding IsDiscordBotExpanded}">
              <TextBlock Text="{services:TrText DiscordBotState}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="{services:Tr ui.guild_scoped_slash_commands_mysttiq_status_playe_0306a0}" Classes="muted" TextWrapping="Wrap" FontSize="11"/>
              <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                <TextBlock Text="{services:Tr ui.enabled_92c1cd}" VerticalAlignment="Center" Classes="muted"/><CheckBox AutomationProperties.Name="{services:Tr ui.enabled_92c1cd}" Grid.Column="1" IsChecked="{Binding DiscordBotConfig.Enabled}"/>
                <TextBlock Grid.Row="1" Text="{services:Tr ui.bot_token}" VerticalAlignment="Center" Classes="muted"/>
                <TextBox Grid.Row="1" Grid.Column="1" Width="320" HorizontalAlignment="Left" Text="{Binding DiscordBotConfig.BotToken}" PasswordChar="•" PlaceholderText="{Binding DiscordBotTokenWatermark}"/>
                <TextBlock Grid.Row="2" Text="{services:Tr ui.guild_server_id}" VerticalAlignment="Center" Classes="muted"/><TextBox AutomationProperties.Name="{services:Tr ui.guild_server_id}" Grid.Row="2" Grid.Column="1" Text="{Binding DiscordBotConfig.GuildId}"/>
                <TextBlock Grid.Row="3" Text="{services:Tr ui.owner_discord_user_id_optional}" VerticalAlignment="Center" Classes="muted"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DiscordBotConfig.OwnerDiscordUserId}" PlaceholderText="{services:Tr ui.always_granted_the_owner_role_bypassing_role_map_48220c}"/>
                <!-- v0.7.95.0: live features. The bot keeps ONE status message up to date in this channel and
                     posts join, leave and server start or stop lines to the events channel. Needs the bot to
                     have View Channel, Send Messages and Embed Links there. Blank turns each off. -->
                <TextBlock Grid.Row="4" Text="{services:Tr ui.live_status_channel_id}" VerticalAlignment="Center" Classes="muted"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding DiscordBotConfig.StatusChannelId}" PlaceholderText="{services:Tr ui.optional_one_self_updating_status_message_is_kep_aadc8d}"/>
                <TextBlock Grid.Row="5" Text="{services:Tr ui.events_channel_id}" VerticalAlignment="Center" Classes="muted"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding DiscordBotConfig.EventsChannelId}" PlaceholderText="{services:Tr ui.optional_players_joining_or_leaving_server_start_ed21b8}"/>
                <TextBlock Grid.Row="6" Text="{services:Tr ui.show_status_in_bot_presence}" VerticalAlignment="Center" Classes="muted"/><CheckBox Grid.Row="6" Grid.Column="1" IsChecked="{Binding DiscordBotConfig.ShowPresence}" Content="{services:Tr ui.bot_shows_watching_n_players_online}"/>
              </Grid>
              <TextBlock Text="{services:Tr ui.role_mapping_discord_role_id_mysttiq_role}" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="*,140,Auto" ColumnSpacing="10">
                <TextBox Text="{Binding NewRoleMappingDiscordRoleId}" PlaceholderText="{services:Tr ui.discord_role_id}"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.a11y_role}" Grid.Column="1" ItemsSource="{Binding MystTiqRoles}" SelectedItem="{Binding NewRoleMappingRole}"/>
                <Button Classes="apply" Grid.Column="2" Content="{services:Tr ui.add}" Command="{Binding AddDiscordRoleMappingCommand}"/>
              </Grid>
              <ListBox AutomationProperties.Name="{services:Tr ui.role_mapping_discord_role_id_mysttiq_role}" ItemsSource="{Binding DiscordRoleMappings}" SelectedItem="{Binding SelectedRoleMapping}" MaxHeight="180">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:DiscordRoleMappingDto">
                    <Grid ColumnDefinitions="*,140"><TextBlock Text="{Binding DiscordRoleId}"/><TextBlock Grid.Column="1" Text="{services:TrText Role}"/></Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="danger" Content="{services:Tr ui.remove_selected_mapping}" Command="{Binding RemoveDiscordRoleMappingCommand}"/>
                <Button Classes="apply" Content="{services:Tr ui.save_discord_bot_config}" Command="{Binding SaveDiscordBotConfigCommand}"/>
              </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card accentSystem" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <Button Classes="sectionToggle" Command="{Binding ToggleAntiCheatCommand}" VerticalAlignment="Top">
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="▸" IsVisible="{Binding !IsAntiCheatExpanded}" FontWeight="Bold"/><TextBlock Text="▾" IsVisible="{Binding IsAntiCheatExpanded}" FontWeight="Bold"/><TextBlock Text="{services:Tr ui.anti_cheat_and_save_integrity_scanning}" FontSize="17" FontWeight="SemiBold"/></StackPanel>
                </Button>
                <Button Classes="info" Grid.Column="1" Content="{services:Tr ui.refresh}" Command="{Binding RefreshAntiCheatCommand}" VerticalAlignment="Top" IsVisible="{Binding IsAntiCheatExpanded}"/>
              </Grid>
              <StackPanel Spacing="10" IsVisible="{Binding IsAntiCheatExpanded}">
              <TextBlock Text="{services:TrText AntiCheatState}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="{services:Tr ui.every_rule_defaults_to_flag_notify_log_only_swit_66192b}" Classes="muted" TextWrapping="Wrap" FontSize="11"/>
              <Grid ColumnDefinitions="220,120,140" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="10">
                <TextBlock Text="{services:Tr ui.invalid_steam_id_on_join}" VerticalAlignment="Center" Classes="muted"/>
                <CheckBox AutomationProperties.Name="{services:Tr ui.invalid_steam_id_on_join}" Grid.Column="1" IsChecked="{Binding AntiCheatRules.InvalidSteamId.Enabled}"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.invalid_steam_id_on_join}" Grid.Column="2" ItemsSource="{Binding AntiCheatResponses}" SelectedItem="{Binding AntiCheatRules.InvalidSteamId.Response}"/>
                <TextBlock Grid.Row="1" Text="{services:Tr ui.impossible_level_max_allowed}" VerticalAlignment="Center" Classes="muted"/>
                <CheckBox AutomationProperties.Name="{services:Tr ui.impossible_level_max_allowed}" Grid.Row="1" Grid.Column="1" IsChecked="{Binding AntiCheatRules.ImpossibleLevel.Enabled}"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.impossible_level_max_allowed}" Grid.Row="1" Grid.Column="2" ItemsSource="{Binding AntiCheatResponses}" SelectedItem="{Binding AntiCheatRules.ImpossibleLevel.Response}"/>
                <TextBlock Grid.Row="2" Text="{services:Tr ui.pal_stat_anomaly_periodic_scan}" VerticalAlignment="Center" Classes="muted"/>
                <CheckBox AutomationProperties.Name="{services:Tr ui.pal_stat_anomaly_periodic_scan}" Grid.Row="2" Grid.Column="1" IsChecked="{Binding AntiCheatRules.PalStatAnomaly.Enabled}"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.pal_stat_anomaly_periodic_scan}" Grid.Row="2" Grid.Column="2" ItemsSource="{Binding AntiCheatResponses}" SelectedItem="{Binding AntiCheatRules.PalStatAnomaly.Response}"/>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{services:Tr ui.max_allowed_level}" VerticalAlignment="Center" Classes="muted"/>
                <NumericUpDown AutomationProperties.Name="{services:Tr ui.max_allowed_level}" Value="{Binding AntiCheatRules.ImpossibleLevel.MaxAllowedLevel}" Minimum="1" Maximum="9999" Width="140"/>
              </StackPanel>
              <Button Classes="apply" Content="{services:Tr ui.save_anti_cheat_rules}" HorizontalAlignment="Left" Command="{Binding SaveAntiCheatRulesCommand}"/>
              <TextBlock Text="{services:Tr ui.recent_findings}" FontWeight="SemiBold"/>
              <ListBox AutomationProperties.Name="{services:Tr ui.recent_findings}" ItemsSource="{Binding AntiCheatFindings}" MaxHeight="220">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:AntiCheatFindingDto">
                    <Border Classes="statuscard accentSystem" Margin="0,3"><StackPanel Spacing="2">
                      <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding RuleKey}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{services:TrText ResponseTaken}"/></Grid>
                      <TextBlock Text="{services:TrText Detail}" Classes="muted" TextWrapping="Wrap" FontSize="11"/>
                    </StackPanel></Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              </StackPanel>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- SECURITY -->
        <StackPanel IsVisible="{Binding IsSecurityPage}" Spacing="12">
          <!-- v0.7.42.0: Refresh moved to the ribbon. -->
          <Border Classes="card accentSystem"><StackPanel Spacing="4"><TextBlock Text="{services:Tr ui.security}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{services:TrText SecurityState}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          <!-- v1.0.3.0 (roadmap W-1, owner decision D-1): a read-only view in any browser, signed in with a MystTiq account. -->
          <Border x:Name="BrowserViewCard" Classes="card accentSystem">
            <StackPanel Spacing="4">
              <TextBlock Text="{services:Tr ui.browser_view}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{services:Tr ui.browser_view_hint}" Classes="muted" TextWrapping="Wrap"/>
              <SelectableTextBlock Text="{Binding BrowserViewUrlVerbatim}" FontFamily="Consolas, monospace"/>
            </StackPanel>
          </Border>
          <Border Classes="card accentSystem" IsVisible="{Binding HasLastCreatedPrincipalToken}"><StackPanel Spacing="6"><TextBlock Text="{services:Tr ui.new_token_shown_once_copy_it_now}" FontWeight="SemiBold" Foreground="{DynamicResource AmberBrush}"/><SelectableTextBlock Text="{Binding LastCreatedPrincipalToken}" FontFamily="Consolas, monospace"/></StackPanel></Border>
          <Border Classes="card accentSystem" IsVisible="{Binding CanManagePrincipals}" IsEnabled="{Binding CanManagePrincipals}">
            <StackPanel Spacing="10">
              <TextBlock Text="{services:Tr ui.create_principal}" FontSize="17" FontWeight="SemiBold"/>
              <Grid ColumnDefinitions="150,*" ColumnSpacing="10"><TextBox Text="{Binding NewPrincipalName}" PlaceholderText="{services:Tr ui.name}"/><ComboBox AutomationProperties.Name="{services:Tr ui.a11y_role}" Grid.Column="1" ItemsSource="{Binding MystTiqRoles}" SelectedItem="{Binding NewPrincipalRole}"/></Grid>
              <Button Classes="apply" Content="{services:Tr ui.create}" HorizontalAlignment="Left" Command="{Binding CreatePrincipalCommand}"/>
            </StackPanel>
          </Border>
          <Border Classes="card accentSystem"><StackPanel Spacing="8"><TextBlock Text="{services:Tr ui.principals}" FontSize="17" FontWeight="SemiBold"/>
            <ListBox AutomationProperties.Name="{services:Tr ui.principals}" ItemsSource="{Binding Principals}" SelectedItem="{Binding SelectedPrincipal}" MaxHeight="360"><ListBox.ItemTemplate><DataTemplate x:DataType="models:MystTiqPrincipalDto"><Border Classes="statuscard accentSystem" Margin="0,3"><Grid ColumnDefinitions="*,120,Auto" ColumnSpacing="10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{services:TrText Role}"/><TextBlock Grid.Column="2" Text="{services:TrText IsExpired}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
            <Button Classes="danger" Content="{services:Tr ui.revoke_selected}" HorizontalAlignment="Left" Command="{Binding RevokePrincipalCommand}" IsEnabled="{Binding CanManagePrincipals}"/>
          </StackPanel></Border>
          <!-- v0.7.114.0: named user accounts. Principals above are tokens for scripts and integrations;
               these are people, who sign in with a password on the Settings page. Owner only. -->
          <Border Classes="card accentSystem" IsVisible="{Binding CanManagePrincipals}" IsEnabled="{Binding CanManagePrincipals}">
            <StackPanel Spacing="10">
              <TextBlock Text="{services:Tr ui.user_accounts}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{services:Tr ui.people_who_sign_in_with_a_username_and_password_4ca134}"
                         Classes="muted" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,*,130,*" ColumnSpacing="8" RowDefinitions="Auto,Auto" RowSpacing="8">
                <TextBox Text="{Binding NewUserUsername}" PlaceholderText="{services:Tr ui.username}"/>
                <TextBox Grid.Column="1" Text="{Binding NewUserDisplayName}" PlaceholderText="{services:Tr ui.display_name_optional}"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.a11y_role}" Grid.Column="2" ItemsSource="{Binding MystTiqRoles}" SelectedItem="{Binding NewUserRole}" HorizontalAlignment="Stretch"/>
                <TextBox Grid.Column="3" Text="{Binding NewUserScope}" PlaceholderText="{services:Tr ui.only_this_server_id_optional}"/>
                <TextBox Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding NewUserPassword}" PasswordChar="●" PlaceholderText="{services:Tr ui.password_at_least_10_characters}"/>
                <Button Grid.Row="1" Grid.Column="2" Classes="apply" Content="{services:Tr ui.create_account}" Command="{Binding CreateUserCommand}"/>
              </Grid>
              <ListBox AutomationProperties.Name="{services:Tr ui.user_accounts}" ItemsSource="{Binding UserAccounts}" SelectedItem="{Binding SelectedUserAccount}" MaxHeight="300">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:UserAccountDto">
                    <Grid ColumnDefinitions="*,*,90,120,*" ColumnSpacing="10">
                      <TextBlock Text="{Binding Username}" FontWeight="SemiBold"/>
                      <TextBlock Grid.Column="1" Text="{Binding DisplayName}"/>
                      <TextBlock Grid.Column="2" Text="{services:TrText Role}"/>
                      <Border Classes="tag" Grid.Column="3" HorizontalAlignment="Left" services:StatusTag.Status="{Binding StatusText}"><TextBlock Text="{services:TrText StatusText}"/></Border>
                      <TextBlock Grid.Column="4" Text="{services:TrText LastLoginText}" Classes="muted"/>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding UserResetPassword}" PasswordChar="●" PlaceholderText="{services:Tr ui.new_password_for_the_selected_account}"/>
                <Button Classes="caution" Grid.Column="1" Content="{services:Tr ui.reset_password}" Command="{Binding ResetUserPasswordCommand}" ToolTip.Tip="{services:Tr ui.sets_a_new_password_and_signs_the_account_out_ev_510d9d}"/>
                <Button Classes="caution" Grid.Column="2" Content="{services:Tr ui.enable_disable}" Command="{Binding ToggleUserEnabledCommand}" ToolTip.Tip="{services:Tr ui.a_disabled_account_cannot_sign_in_and_its_open_s_c22536}"/>
                <Button Grid.Column="3" Classes="danger" Content="{services:Tr ui.delete}" Command="{Binding DeleteUserCommand}"/>
              </Grid>
              <TextBlock Text="{services:TrText UserAccountsState}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- FLEET -->
        <StackPanel IsVisible="{Binding IsFleetPage}" Spacing="12">
          <!-- v0.7.42.0: Refresh moved to the ribbon. -->
          <Border Classes="card accentSystem"><StackPanel Spacing="4"><TextBlock Text="{services:Tr ui.fleet}" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="{services:TrText FleetState}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border>
          <Border Classes="card accentSystem" IsVisible="{Binding CanOperate}" IsEnabled="{Binding CanOperate}">
            <StackPanel Spacing="10">
              <TextBlock Text="{services:Tr ui.fleet_actions}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{services:Tr ui.runs_across_every_configured_server_profile_stag_f49f53}" Classes="muted" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="apply" Content="{services:Tr ui.backup_all}" Command="{Binding BackupAllCommand}"/>
                <Button Classes="verify" Content="{services:Tr ui.doctor_all}" Command="{Binding DoctorAllCommand}"/>
                <Button Classes="apply" Content="{services:Tr ui.update_all}" Command="{Binding UpdateAllCommand}"/>
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card accentSystem"><StackPanel Spacing="8"><TextBlock Text="{services:Tr ui.server_profiles}" FontSize="17" FontWeight="SemiBold"/>
            <ListBox AutomationProperties.Name="{services:Tr ui.server_profiles}" ItemsSource="{Binding FleetServers}" MaxHeight="360"><ListBox.ItemTemplate><DataTemplate x:DataType="models:ServerProfileSummaryDto"><Border Classes="statuscard accentSystem" Margin="0,3"><Grid ColumnDefinitions="12,*,140,Auto" ColumnSpacing="10"><Ellipse Width="8" Height="8" Fill="{Binding StatusDotColorKey, Converter={x:Static converters:SemanticStatusColorConverter.Instance}}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Grid.Column="2" Text="{services:TrText Runtime}" Classes="muted"/><TextBlock Grid.Column="3" Text="{services:TrText StatusText}"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          </StackPanel></Border>
          <!-- v0.7.81.0: turned into an explicit step-by-step workflow, direct request: "the clone
               world option in fleet should be a workflow with drop down options to clarify what it
               is doing." Was a single row of two textboxes and a Clone button with no confirmation
               gate, for an operation that copies an entire server installation. Now: an explicit
               SOURCE label (previously only implicit, always "whichever profile this tab is
               connected to"), a real PORT OFFSET dropdown (WorldCloneRequestDto already had this
               field; it was never exposed in the UI at all before, the server just used its own
               default), and a confirmation checkbox gating the Clone button, matching the same
               Preview-adjacent safety-gate pattern already used for Guild/Base Ownership operations
               elsewhere on this page. No server-side Preview endpoint exists for cloning yet, so
               this doesn't claim to have one; the checkbox is the safety gate here, not a preview
               step. -->
          <Border Classes="card accentSystem" IsVisible="{Binding CanManagePrincipals}" IsEnabled="{Binding CanManagePrincipals}">
            <StackPanel Spacing="10">
              <TextBlock Text="{services:Tr ui.clone_world}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{services:Tr ui.duplicates_the_currently_connected_profile_s_ent_1e1bf3}" Classes="muted" TextWrapping="Wrap"/>

              <!-- v0.7.81.0 follow-up: direct request ("it should indicate better what server is
                   being cloned (server name - description)"). Name alone doesn't distinguish two
                   profiles that happen to share a display name, or say anything about where this
                   server actually lives. BaseAddress (the profile's own connection URL, always
                   accurate since it's what this tab is actually talking to) is added as the
                   description line, matching the "name - description" ask as two lines rather than
                   forcing both into one combined string. -->
              <StackPanel Spacing="3">
                <TextBlock Text="{services:Tr ui.source_the_connection_this_tab_currently_uses}" Classes="muted" FontSize="10"/>
                <TextBlock Text="{Binding SelectedProfile.Name}" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding SelectedProfile.BaseAddress}" Classes="muted" FontSize="11" FontFamily="Consolas, monospace"/>
              </StackPanel>

              <StackPanel Spacing="3">
                <TextBlock Text="{services:Tr ui.new_profile}" Classes="muted" FontSize="10"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                  <TextBox PlaceholderText="{services:Tr ui.new_profile_id_e_g_world_2}" Text="{Binding CloneNewProfileId}"/>
                  <TextBox Grid.Column="1" PlaceholderText="{services:Tr ui.display_name_optional}" Text="{Binding CloneNewProfileName}"/>
                </Grid>
              </StackPanel>

              <StackPanel Spacing="3">
                <TextBlock Text="{services:Tr ui.port_offset}" Classes="muted" FontSize="10"/>
                <TextBlock Text="{services:Tr ui.added_to_the_source_server_s_own_ports_game_quer_d5bd9e}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.port_offset}" ItemsSource="{Binding CloneWorldPortOffsetOptions}" SelectedItem="{Binding CloneWorldPortOffset}" HorizontalAlignment="Left" MinWidth="140"/>
              </StackPanel>

              <CheckBox Content="{services:Tr ui.i_understand_this_copies_the_entire_server_insta_704aeb}" IsChecked="{Binding CloneWorldConfirmed}"/>
              <Button Classes="apply" Content="{services:Tr ui.clone}" Command="{Binding CloneWorldCommand}" HorizontalAlignment="Left"/>
              <TextBlock Text="{services:TrText CloneWorldStatusText}" Classes="muted" TextWrapping="Wrap"/>
              <!-- v0.7.84.0: closes the previously-undisclosed "needs a restart to come online" gap
                   the wizard's own Clone path already fixed in v0.7.83.0, offered here as an
                   explicit button rather than fired automatically, since this page's connection is
                   already actively in use. -->
              <Button Classes="caution" Content="{services:Tr ui.restart_mysttiq_now_to_bring_it_online}" Command="{Binding RestartAfterCloneCommand}" HorizontalAlignment="Left" IsVisible="{Binding CloneWorldNeedsRestart}"/>
              <!-- v0.9.6.0: the clone's game port is new, so it needs its own firewall rule. -->
              <TextBlock Text="{services:Tr ui.clone_firewall_hint}" Classes="muted" FontSize="11" TextWrapping="Wrap" IsVisible="{Binding CloneWorldNeedsRestart}"/>
            </StackPanel>
          </Border>
          <Border Classes="card accentSystem"><StackPanel Spacing="8"><TextBlock Text="{services:Tr ui.last_fleet_action_results}" FontSize="17" FontWeight="SemiBold"/>
            <ListBox AutomationProperties.Name="{services:Tr ui.last_fleet_action_results}" ItemsSource="{Binding FleetActionResults}" MaxHeight="240"><ListBox.ItemTemplate><DataTemplate x:DataType="models:FleetActionResultDto"><Border Classes="statuscard accentSystem" Margin="0,3"><StackPanel Spacing="2"><Grid ColumnDefinitions="*,Auto" ColumnSpacing="10"><TextBlock Text="{Binding ServerProfileId}" FontWeight="SemiBold"/><TextBlock Grid.Column="1" Text="{services:TrText Success}"/></Grid><TextBlock Text="{services:TrText Error}" Classes="muted" Foreground="{DynamicResource RedBrush}" TextWrapping="Wrap" IsVisible="{Binding !Success}"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
          </StackPanel></Border>
        </StackPanel>

        <!-- HOST (v0.8.17.0): the machine the connected server runs on (for a remote server that machine, not this
             PC), and the server's process priority and eco mode. Readings refresh with the 5-second tick while open.
             Full-width cards in order of use: the machine, the priority card, the network, then the disks (a machine
             with many drives has a long disk list, so it comes last; found in the live check). -->
        <StackPanel IsVisible="{Binding IsHostPage}" Spacing="12">
          <Border x:Name="HostMachineCard" Classes="card accentSystem">
            <StackPanel Spacing="8">
              <TextBlock Text="{services:Tr ui.this_machine}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{services:TrText HostMachineText}" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText HostProcessorText}" Classes="muted" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="20">
                <StackPanel Spacing="4">
                  <TextBlock Text="{services:Tr ui.processor}" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{services:TrText HostCpuText}" FontSize="17" FontWeight="SemiBold"/>
                  <ProgressBar Value="{Binding HostCpuPercent}" Maximum="100" Height="6" MinHeight="6"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="4">
                  <TextBlock Text="{services:Tr ui.memory}" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{services:TrText HostMemoryText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <ProgressBar Value="{Binding HostMemoryPercent}" Maximum="100" Height="6" MinHeight="6"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4" MinWidth="120">
                  <TextBlock Text="{services:Tr ui.uptime}" Classes="muted" FontSize="10"/>
                  <TextBlock Text="{services:TrText HostUptimeText}" FontSize="17" FontWeight="SemiBold"/>
                </StackPanel>
              </Grid>
              <TextBlock Text="{services:Tr ui.for_a_remote_server_this_is_the_server_s_own_mac_9c32c0}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText HostStatusText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <!-- v0.8.20.0: the machine's history (one reading a minute, 7 days). -->
          <Border x:Name="HostHistoryCard" Classes="card accentSystem">
            <StackPanel Spacing="8">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{services:Tr ui.history}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.history}" x:Name="HostHistoryRange" Grid.Column="1" ItemsSource="{Binding HostHistoryRangeOptions}" SelectedIndex="{Binding HostHistoryRangeIndex}" MinWidth="170"/>
              </Grid>
              <controls:HostHistoryChart x:Name="HostHistoryChart" Samples="{Binding HostHistorySamples}" Height="120" MinWidth="0" ClipToBounds="True"/>
              <TextBlock Text="{services:TrText HostHistorySummaryText}" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText HostHistoryCoverageText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText HostHistoryStatusText}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" IsVisible="{Binding HostHistoryStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
          </Border>
          <!-- Everyone signed in can read it; changing it is Admin, as on the server (v0.8.14.0 pattern: read-only). -->
          <Border x:Name="HostPriorityCard" Classes="card accentSystem" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="10">
              <TextBlock Text="{services:Tr ui.server_priority_eco_mode_and_cores}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{services:Tr ui.applies_to_this_server_s_own_processes_on_window_66598f}" Classes="muted" TextWrapping="Wrap"/>
              <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{services:Tr ui.priority}" VerticalAlignment="Center" Margin="0,0,12,6"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.priority}" x:Name="HostPriorityCombo" ItemsSource="{Binding PriorityOptions}" SelectedIndex="{Binding SelectedPriorityIndex}" MinWidth="210" Margin="0,0,24,6"/>
                <TextBlock Text="{services:Tr ui.eco_mode}" VerticalAlignment="Center" Margin="0,0,12,6"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.eco_mode}" x:Name="HostEcoCombo" ItemsSource="{Binding EcoModeOptions}" SelectedIndex="{Binding SelectedEcoModeIndex}" MinWidth="210" Margin="0,0,24,6"/>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsEcoWhenEmpty}" Margin="0,0,0,6">
                  <TextBlock Text="{services:Tr ui.after}" VerticalAlignment="Center"/>
                  <TextBox AutomationProperties.Name="{services:Tr ui.a11y_minutes_before_eco_mode}" x:Name="HostEcoMinutes" Text="{Binding EcoAfterEmptyMinutesText}" Width="64"/>
                  <TextBlock Text="{services:Tr ui.minutes_with_no_one_online}" VerticalAlignment="Center"/>
                </StackPanel>
              </WrapPanel>
              <!-- v0.8.24.0: processor cores (affinity). -->
              <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="{services:Tr ui.processor_cores}" VerticalAlignment="Center"/>
                <TextBox x:Name="HostCoresBox" Text="{Binding CoresText}" PlaceholderText="{services:Tr ui.every_core}" Width="180"/>
              </StackPanel>
              <TextBlock Text="{services:TrText CoresHintText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText PriorityWarningText}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" IsVisible="{Binding HasPriorityWarning}"/>
              <TextBlock Text="{services:TrText EfficiencyNoteText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="apply" Content="{services:Tr ui.save_and_apply}" Command="{Binding SaveResourcePolicyCommand}"/>
                <TextBlock Text="{services:TrText ResourcePolicyStatusText}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Text="{services:TrText EcoStateText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText ResourceErrorText}" Foreground="{DynamicResource RedBrush}" TextWrapping="Wrap" IsVisible="{Binding HasResourceError}"/>
              <ItemsControl ItemsSource="{Binding HostProcesses}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:ProcessResourceStateDto">
                    <Border Classes="statuscard" Margin="0,3">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{services:TrText Title}" FontWeight="SemiBold"/>
                        <TextBlock Text="{services:TrText StateText}" Classes="muted" TextWrapping="Wrap"/>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <!-- v0.8.18.0: bandwidth. Read by everyone, changed by Admin (as the server enforces). The limits go into the
               server's Engine.ini before every start, so a change made while it runs waits for the next start. -->
          <Border x:Name="HostBandwidthCard" Classes="card accentSystem" IsEnabled="{Binding CanManageAdmin}">
            <StackPanel Spacing="10">
              <TextBlock Text="{services:Tr ui.bandwidth_limits}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{services:Tr ui.how_much_the_server_may_send_to_each_player_and_7bff90}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText BandwidthDefaultsText}" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText BandwidthNowText}" Classes="muted" TextWrapping="Wrap"/>
              <WrapPanel Orientation="Horizontal">
                <TextBlock Text="{services:Tr ui.limits}" VerticalAlignment="Center" Margin="0,0,12,6"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.limits}" x:Name="BandwidthModeCombo" ItemsSource="{Binding BandwidthModeOptions}" SelectedIndex="{Binding BandwidthModeIndex}" MinWidth="240" Margin="0,0,24,6"/>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBandwidthCustom}" Margin="0,0,24,6">
                  <TextBox AutomationProperties.Name="{services:Tr ui.mbit_s_per_player}" x:Name="BandwidthPerPlayer" Text="{Binding PerPlayerMbpsText}" Width="72"/>
                  <TextBlock Text="{services:Tr ui.mbit_s_per_player}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsBandwidthCustom}" Margin="0,0,0,6">
                  <TextBox AutomationProperties.Name="{services:Tr ui.network_updates_per_second}" x:Name="BandwidthTickRate" Text="{Binding TickRateText}" Width="60"/>
                  <TextBlock Text="{services:Tr ui.network_updates_per_second}" VerticalAlignment="Center"/>
                </StackPanel>
              </WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{services:Tr ui.your_upload_speed_optional}" VerticalAlignment="Center"/>
                <TextBox AutomationProperties.Name="{services:Tr ui.your_upload_speed_optional}" x:Name="BandwidthUpload" Text="{Binding UploadBudgetMbpsText}" Width="80"/>
                <TextBlock Text="{services:Tr ui.mbit_s_for_the_estimate_below}" Classes="muted" VerticalAlignment="Center"/>
              </StackPanel>
              <TextBlock Text="{services:TrText BandwidthWorstCaseText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText BandwidthOverBudgetText}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" IsVisible="{Binding BandwidthOverBudget}"/>
              <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding HasBandwidthSuggestion}">
                <TextBlock Text="{services:TrText BandwidthSuggestionText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button Classes="apply" Content="{services:Tr ui.use_it}" Command="{Binding ApplyBandwidthSuggestionCommand}"/>
              </StackPanel>
              <TextBlock Text="{services:Tr ui.fewer_network_updates_per_second_use_less_upload_e95bc8}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Button Classes="apply" Content="{services:Tr ui.save}" Command="{Binding SaveNetworkPolicyCommand}"/>
                <TextBlock Text="{services:TrText BandwidthStatusText}" Classes="muted" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
              <TextBlock Text="{services:TrText BandwidthRestartText}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" IsVisible="{Binding BandwidthRestartNeeded}"/>
            </StackPanel>
          </Border>
          <Border x:Name="HostNetworkCard" Classes="card accentSystem">
            <StackPanel Spacing="8">
              <TextBlock Text="{services:Tr ui.network}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{services:Tr ui.traffic_of_the_whole_machine_through_each_adapte_26cfa8}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding HostNetwork}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:HostNetworkAdapterDto">
                    <StackPanel Spacing="2" Margin="0,0,0,10">
                      <TextBlock Text="{services:TrText Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{services:TrText RateText}"/>
                      <TextBlock Text="{services:TrText LinkText}" Classes="muted" FontSize="11"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <Border x:Name="HostDisksCard" Classes="card accentSystem">
            <StackPanel Spacing="8">
              <TextBlock Text="{services:Tr ui.disks}" FontSize="17" FontWeight="SemiBold"/>
              <TextBlock Text="{services:Tr ui.the_disks_holding_something_of_this_server_come_e67132}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding HostDisks}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:HostDiskDto">
                    <StackPanel Spacing="3" Margin="0,0,0,10">
                      <TextBlock Text="{services:TrText Title}" FontWeight="SemiBold"/>
                      <TextBlock Text="{services:TrText UsageText}" TextWrapping="Wrap"/>
                      <ProgressBar Value="{Binding UsedPercent}" Maximum="100" Height="6" MinHeight="6"/>
                      <TextBlock Text="{services:Tr ui.less_than_10_free}" Foreground="{DynamicResource AmberBrush}" FontSize="11" IsVisible="{Binding IsLow}"/>
                      <TextBlock Text="{services:TrText HoldsText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </StackPanel>

        <!-- SETTINGS -->
        <StackPanel IsVisible="{Binding IsSettingsPage}" Spacing="12">
          <Border Classes="card accentSystem">
            <StackPanel Spacing="12">
              <TextBlock Text="{services:Tr ui.appearance}" FontSize="18" FontWeight="SemiBold"/>
              <TextBlock Text="{services:Tr ui.accent_theme_mode_and_density_applies_immediatel_8cf7f3}" Classes="muted" TextWrapping="Wrap"/>
              <!-- v0.8.16.0: the mode picker replaces the Light mode checkbox. The mode is per tab, like the accent theme;
                   density applies to every tab. -->
              <WrapPanel x:Name="ThemeModePicker" Orientation="Horizontal">
                <TextBlock Text="{services:Tr ui.mode}" VerticalAlignment="Center" Margin="0,0,12,6"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.mode}" x:Name="ThemeModeCombo" ItemsSource="{Binding ThemeModeLabels}" SelectedIndex="{Binding SelectedThemeModeIndex}" MinWidth="210" Margin="0,0,24,6"/>
                <TextBlock Text="{services:Tr ui.density}" VerticalAlignment="Center" Margin="0,0,12,6"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.density}" x:Name="DensityCombo" ItemsSource="{Binding DensityLabels}" SelectedIndex="{Binding SelectedDensityIndex}" MinWidth="160" Margin="0,0,0,6"/>
              </WrapPanel>
              <TextBlock Text="{services:Tr ui.midnight_is_true_black_for_oled_screens_high_con_9103e3}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText DisplayPreferencesStatusText}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding DisplayPreferencesStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
              <!-- v0.8.5.0: display language. Applies at once and is remembered on this computer. -->
              <Grid x:Name="LanguagePicker" ColumnDefinitions="Auto,Auto" ColumnSpacing="12">
                <TextBlock Text="{services:Tr settings.language.label}" VerticalAlignment="Center"/>
                <ComboBox AutomationProperties.Name="{services:Tr settings.language.label}" Grid.Column="1" ItemsSource="{Binding UiLanguages}" SelectedItem="{Binding SelectedUiLanguage}" MinWidth="180"/>
              </Grid>
              <TextBlock Text="{services:Tr settings.language.note}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
              <ItemsControl ItemsSource="{Binding AccentThemeOptions}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Classes="listItem" Margin="0,0,8,8" Padding="12,7"
                            Command="{Binding $parent[ItemsControl].((vm:MainWindowViewModel)DataContext).SetAccentThemeCommand}"
                            CommandParameter="{Binding}">
                      <TextBlock Text="{services:TrText}"/>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
          <!-- v0.7.13.0: this card now only ever handles EDITING an already-saved profile: the
               "Set Up New Server" wizard (Local/Remote choice, Connection Details, In-Game Server
               Defaults, Confirm & Finish) moved to its own dedicated host, shown in place of the
               whole nav sidebar/ribbon/page-content area while IsCreatingNewProfile is true (see
               the Grid.Row="3" wizard host near the end of this file). IsCreatingNewProfile is
               therefore never true while this Settings-page content is even visible, so every
               wizard-only IsVisible branch that used to live in this card was removed rather than
               left as dead, always-false conditions. -->
          <Border Classes="card accentSystem">
            <StackPanel Spacing="12">
              <TextBlock Text="{services:Tr ui.connection_profiles}" FontSize="18" FontWeight="SemiBold"/>

              <ComboBox AutomationProperties.Name="{services:Tr ui.connection_profiles}" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" MinWidth="400">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="models:ConnectionProfile">
                    <TextBlock Text="{Binding Name}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <StackPanel Orientation="Horizontal" Spacing="10">
                <Button Classes="info" Content="{services:Tr ui.discover_lan_services}" Command="{Binding DiscoverServicesCommand}"/>
                <Button Classes="plain" Content="{services:Tr ui.cancel}" Command="{Binding CancelDiscoveryCommand}" IsVisible="{Binding IsDiscovering}"/>
                <Button Classes="apply" Content="{services:Tr ui.bootstrap_local_service}" Command="{Binding BootstrapLocalCommand}" IsEnabled="{Binding IsLocalProfile}"/>
                <TextBlock Text="{services:TrText DiscoveryStateText}" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap" />
              </StackPanel>
              <!-- v0.9.6.0: virtual adapters (WSL, Hyper-V, Docker) are searched only when ticked; extra ranges can be typed in. -->
              <WrapPanel>
                <CheckBox Content="{services:Tr ui.include_virtual_adapters}" IsChecked="{Binding DiscoveryIncludeVirtualAdapters}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                <TextBox AutomationProperties.Name="{services:Tr ui.extra_ranges}" Text="{Binding DiscoveryExtraRanges}" PlaceholderText="{services:Tr ui.extra_ranges_watermark}" MinWidth="260"/>
              </WrapPanel>
              <!-- v0.9.6.0: the ranges being searched, how far the search is, and Cancel. -->
              <StackPanel Spacing="4" IsVisible="{Binding HasDiscoveryRanges}">
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding DiscoveryProgressValue}" Height="4" IsVisible="{Binding IsDiscovering}"/>
                <WrapPanel>
                  <TextBlock Text="{services:Tr ui.searching_ranges}" Classes="muted" FontSize="11" Margin="0,0,6,0"/>
                  <TextBlock Text="{services:TrText DiscoveryRangesText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                </WrapPanel>
                <WrapPanel IsVisible="{Binding HasDiscoverySkipped}">
                  <TextBlock Text="{services:Tr ui.not_searched_virtual}" Classes="muted" FontSize="11" Margin="0,0,6,0"/>
                  <TextBlock Text="{services:TrText DiscoverySkippedText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                </WrapPanel>
                <WrapPanel IsVisible="{Binding HasDiscoveryProblems}">
                  <TextBlock Text="{services:Tr ui.could_not_read_ranges}" Foreground="{DynamicResource AmberBrush}" FontSize="11" Margin="0,0,6,0"/>
                  <TextBlock Text="{services:TrText DiscoveryProblemsText}" Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
                </WrapPanel>
              </StackPanel>

              <ComboBox AutomationProperties.Name="{services:Tr ui.connection_profiles}" ItemsSource="{Binding DiscoveredServices}" SelectedItem="{Binding SelectedDiscoveredService}" MinWidth="400">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="services:DiscoveredMystTiqService">
                    <TextBlock Text="{Binding DisplayName}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                <TextBlock Text="{services:Tr ui.name}" VerticalAlignment="Center" />
                <TextBox AutomationProperties.Name="{services:Tr ui.name}" Grid.Column="1" Text="{Binding ProfileName}" />

                <TextBlock Grid.Row="1" Text="{services:Tr ui.service_url}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ServerUrl}" PlaceholderText="{services:Tr ui.https_192_168_1_248_8213}" />

                <!-- v0.7.63.0: two profiles CAN legitimately share the same Service URL; a
                     multi-server fleet host (see LocalManagementApiHost's "Multi-Server Fleet"
                     comment) serves several distinct PalServer instances behind one address, one
                     per server ID. This field is what actually tells them apart; leaving it blank
                     targets the host's default server. Saving a profile whose URL AND this field
                     both match an existing profile is rejected (see BuildProfileFromEditor);
                     that combination is a genuine duplicate, not a second server. -->
                <TextBlock Grid.Row="2" Text="{services:Tr ui.target_server_id}" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TargetServerId}" PlaceholderText="{services:Tr ui.blank_this_host_s_default_server}" />

                <TextBlock Grid.Row="3" Text="{services:Tr ui.bearer_token}" VerticalAlignment="Center" />
                <!-- v0.7.71.0: watermark updated; tokens are now remembered (CredentialStore,
                     Windows DPAPI-encrypted) after a successful Connect, not process-memory-only
                     as before. "Forget" clears just the saved copy, leaving the typed value alone. -->
                <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                  <TextBox Text="{Binding BearerToken}" PasswordChar="●" RevealPassword="{Binding ShowBearerToken}" PlaceholderText="{services:Tr ui.saved_encrypted_after_connecting}" />
                  <ToggleButton Grid.Column="1" IsChecked="{Binding ShowBearerToken}" Content="{Binding ShowBearerToken, Converter={x:Static converters:BoolToEyeGlyphConverter.Instance}}" ToolTip.Tip="{services:Tr ui.show_hide_the_bearer_token}" Padding="8,4"/>
                  <Button Classes="danger" Grid.Column="2" Content="{services:Tr ui.forget}" Command="{Binding ForgetSavedTokenCommand}" ToolTip.Tip="{services:Tr ui.remove_the_saved_encrypted_token_for_this_profil_f473c2}" Padding="8,4"/>
                </Grid>

                <TextBlock Grid.Row="4" Text="{services:Tr ui.tls_sha_256_pin}" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CertificateSha256}" PlaceholderText="{services:Tr ui.optional_64_hex_certificate_fingerprint}" />

                <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <Button Classes="apply" Content="{services:Tr ui.connect_1a2303}" Command="{Binding ConnectCommand}"/>
                  <Button Classes="apply" Content="{services:Tr ui.save_profile}" Command="{Binding SaveProfileCommand}"/>
                  <Button Classes="danger" Content="{services:Tr ui.delete_profile}" Command="{Binding DeleteProfileCommand}"/>
                </StackPanel>
              </Grid>
              <!-- v0.7.114.0: named accounts. Signing in fills the Bearer token above with a session token
                   and connects; the password itself is never saved. -->
              <TextBlock Text="{services:Tr ui.sign_in_with_a_user_account}" FontWeight="SemiBold" Margin="0,6,0,0"/>
              <TextBlock Text="{services:Tr ui.for_a_mysttiq_with_authentication_on_remote_acce_6d3ba2}" Classes="muted" FontSize="12" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="*,*,Auto,Auto" ColumnSpacing="8">
                <TextBox Text="{Binding SignInUsername}" PlaceholderText="{services:Tr ui.username}"/>
                <TextBox Grid.Column="1" Text="{Binding SignInPassword}" PasswordChar="●" PlaceholderText="{services:Tr ui.password}"/>
                <Button Grid.Column="2" Classes="apply" Content="{services:Tr ui.sign_in}" Command="{Binding SignInCommand}"/>
                <Button Classes="plain" Grid.Column="3" Content="{services:Tr ui.sign_out}" Command="{Binding SignOutCommand}" ToolTip.Tip="{services:Tr ui.ends_this_session_on_the_server_and_forgets_the_051e27}"/>
              </Grid>
              <TextBlock Text="{services:TrText SignedInText}" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText SignInStatusText}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <Border Classes="card accentSystem" IsVisible="{Binding !IsCreatingNewProfile}">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel>
                  <TextBlock Text="{services:Tr ui.managed_server_headless_configuration}" FontSize="18" FontWeight="SemiBold" />
                  <TextBlock Text="{services:TrText ConfigState}" Foreground="{DynamicResource MutedBrush}" />
                  <TextBlock Text="{services:TrText ConfigSecurityText}" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                  <Button Classes="info" Content="{services:Tr ui.load}" Command="{Binding LoadConfigurationCommand}"/>
                  <Button Classes="apply" Content="{services:Tr ui.save}" Command="{Binding SaveConfigurationCommand}"/>
                </StackPanel>
              </Grid>

              <TextBlock Text="{services:Tr ui.management_api}" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                <TextBlock Text="{services:Tr ui.enabled_92c1cd}" VerticalAlignment="Center" />
                <CheckBox AutomationProperties.Name="{services:Tr ui.enabled_92c1cd}" Grid.Column="1" IsChecked="{Binding ConfigApiEnabled}" />
                <TextBlock Grid.Row="1" Text="{services:Tr ui.bind_address}" VerticalAlignment="Center" />
                <TextBox AutomationProperties.Name="{services:Tr ui.bind_address}" Grid.Row="1" Grid.Column="1" Text="{Binding ConfigBindAddress}" />
                <TextBlock Grid.Row="2" Text="{services:Tr ui.port}" VerticalAlignment="Center" />
                <NumericUpDown AutomationProperties.Name="{services:Tr ui.port}" Grid.Row="2" Grid.Column="1" Value="{Binding ConfigPort}" Minimum="1024" Maximum="65535" />
              </Grid>

              <TextBlock Text="{services:Tr ui.lifecycle}" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="180,*,180,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                <TextBlock Text="{services:Tr ui.startup_timeout}" VerticalAlignment="Center" />
                <NumericUpDown AutomationProperties.Name="{services:Tr ui.startup_timeout}" Grid.Column="1" Value="{Binding StartupTimeoutSeconds}" Minimum="1" Maximum="3600" />
                <TextBlock Grid.Column="2" Text="{services:Tr ui.stop_timeout}" VerticalAlignment="Center" />
                <NumericUpDown AutomationProperties.Name="{services:Tr ui.stop_timeout}" Grid.Column="3" Value="{Binding StopTimeoutSeconds}" Minimum="1" Maximum="3600" />

                <TextBlock Grid.Row="1" Text="{services:Tr ui.service_poll}" VerticalAlignment="Center" />
                <NumericUpDown AutomationProperties.Name="{services:Tr ui.service_poll}" Grid.Row="1" Grid.Column="1" Value="{Binding ServicePollSeconds}" Minimum="1" Maximum="300" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="{services:Tr ui.recovery_backoff}" VerticalAlignment="Center" />
                <NumericUpDown AutomationProperties.Name="{services:Tr ui.recovery_backoff}" Grid.Row="1" Grid.Column="3" Value="{Binding RecoveryBackoffSeconds}" Minimum="1" Maximum="3600" />

                <TextBlock Grid.Row="2" Text="{services:Tr ui.recovery_attempts}" VerticalAlignment="Center" />
                <NumericUpDown AutomationProperties.Name="{services:Tr ui.recovery_attempts}" Grid.Row="2" Grid.Column="1" Value="{Binding MaximumRecoveryAttempts}" Minimum="1" Maximum="100" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="{services:Tr ui.recovery_window}" VerticalAlignment="Center" />
                <NumericUpDown AutomationProperties.Name="{services:Tr ui.recovery_window}" Grid.Row="2" Grid.Column="3" Value="{Binding RecoveryWindowSeconds}" Minimum="1" Maximum="86400" />
              </Grid>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{services:Tr ui.server_paths}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Classes="open" Grid.Column="1" Content="{services:Tr ui.manage_in_workspace}" Command="{Binding NavigateCommand}" CommandParameter="Workspace"/>
              </Grid>
              <TextBlock Text="{Binding ConfigServerRoot, StringFormat='Server root: {0}'}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ConfigSteamCmdPath, StringFormat='SteamCMD: {0}'}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ConfigBackupRoot, StringFormat='Backup root: {0}'}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="{Binding ConfigRuntimeRoot, StringFormat='Runtime root: {0}'}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="{services:Tr ui.editable_on_the_workspace_page_which_is_the_one_29c1bc}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>

              <!-- v0.9.6.0: the firewall rule for the -port= above, beside where the port is set. -->
              <Border Classes="statuscard accentSystem" IsVisible="{Binding HasFirewallStatus}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{services:TrText FirewallStatusText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{services:Tr ui.firewall_settings_hint}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Button Classes="apply" Grid.Column="1" VerticalAlignment="Center" Content="{services:Tr ui.allow_through_firewall}" AutomationProperties.Name="{services:Tr ui.allow_through_firewall}" Command="{Binding RepairFirewallCommand}" IsVisible="{Binding FirewallNeedsAction}"/>
                </Grid>
              </Border>

              <TextBlock Text="{services:Tr ui.configuration_is_validated_before_writing_and_a_9746a1}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
            </StackPanel>
          </Border>

          <Border Classes="card accentSystem" IsVisible="{Binding !IsCreatingNewProfile}">
            <StackPanel Spacing="7">
              <TextBlock Text="{services:Tr ui.security}" FontWeight="SemiBold" />
              <TextBlock Text="{services:TrText SecretPolicyText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock Text="{services:Tr ui.https_uses_normal_os_certificate_validation_unle_8cdd75}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" />
              <TextBlock Text="{services:TrText ProfileStorageText}" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
            </StackPanel>
          </Border>
        </StackPanel>
</StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>

    <!-- v0.7.13.0: dedicated wizard host, shown in place of the normal nav sidebar/ribbon/page
         content while a tab is mid-setup (IsCreatingNewProfile). Previously the whole "Set Up New
         Server" flow was embedded inside the Settings page's card stack, indistinguishable from
         regular app chrome and reachable/escapable via ordinary navigation. Modeled instead on how
         connection-manager apps (SSH/database/remote-desktop clients) keep "New Connection" a
         focused, separate sequence with its own steps, not a page among many. -->
    <Grid Grid.Row="3" ClipToBounds="True" IsVisible="{Binding IsCreatingNewProfile}">
      <Image Source="{Binding SetupArtwork}" Stretch="UniformToFill" Opacity="0.22" IsHitTestVisible="False"/>
      <Border Background="{DynamicResource Bg0ScrimBrush}"/>
      <!-- v0.7.79.0: same theme-color wash as the main Dashboard's own copy of this image. -->
      <Border Background="{DynamicResource BlueAccentBorderBrush}" Opacity="0.14"/>
      <ScrollViewer Margin="4,8,8,8">
        <!-- v0.7.64.0: widened 680 to 860. At 680, Step 2's field grid (already split into two
             columns) had to share space with a same-row Auto-width button column, leaving each
             field only about 180px; not enough for its own content (watermarks and typed values
             were clipping, not just wrapping). -->
        <StackPanel Margin="22" Spacing="20" MaxWidth="860" HorizontalAlignment="Center" VerticalAlignment="Center">

          <!-- v0.7.81.0: the old STEP 0 (Local/Remote choice cards) was removed. Direct live
               feedback ("it should not be trying to connect to a previously installed version as we
               already have an option to connect to a local server or remote server from the plus").
               Every "+"-menu entry point now resolves Local vs. Remote itself before ever reaching
               step 1 (ChooseLocalConnection/ChooseRemoteConnection called immediately in
               OpenNewServerTab/OpenConnectLocalServerTab/OpenConnectRemoteServerTab), so this
               screen had become dead, unreachable UI. -->

          <!-- STEP 1: CONNECTION DETAILS (Local or Remote sub-view, per which "+" entry was used) -->
          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStep1}">
            <StackPanel Spacing="12">
              <TextBlock Text="{services:TrText WizardStep1HeaderText}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>

              <StackPanel IsVisible="{Binding IsLocalConnectionChoice}" Spacing="10">
                <TextBlock Text="{services:TrText WizardStep1InstructionText}" Classes="muted" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Classes="info" Content="{services:Tr ui.auto_detect_local_service}" Command="{Binding DetectLocalServiceCommand}"/>
                  <TextBlock Text="{services:TrText Detail}" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                  <TextBlock Text="{services:Tr ui.name}" VerticalAlignment="Center"/>
                  <TextBox AutomationProperties.Name="{services:Tr ui.name}" Grid.Column="1" Text="{Binding ProfileName}"/>
                  <TextBlock Grid.Row="1" Text="{services:Tr ui.service_url}" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ServerUrl}" PlaceholderText="{services:Tr ui.http_127_0_0_1_8213}"/>
                </Grid>
              </StackPanel>

              <StackPanel IsVisible="{Binding IsRemoteConnectionChoice}" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Classes="verify" Content="{services:Tr ui.scan_network}" Command="{Binding DiscoverServicesCommand}"/>
                  <Button Classes="plain" Content="{services:Tr ui.cancel}" Command="{Binding CancelDiscoveryCommand}" IsVisible="{Binding IsDiscovering}"/>
                  <TextBlock Text="{services:TrText DiscoveryStateText}" VerticalAlignment="Center" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
                <!-- v0.9.6.0: virtual adapters (WSL, Hyper-V, Docker) are searched only when ticked; extra ranges can be typed in. -->
                <WrapPanel>
                  <CheckBox Content="{services:Tr ui.include_virtual_adapters}" IsChecked="{Binding DiscoveryIncludeVirtualAdapters}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                  <TextBox AutomationProperties.Name="{services:Tr ui.extra_ranges}" Text="{Binding DiscoveryExtraRanges}" PlaceholderText="{services:Tr ui.extra_ranges_watermark}" MinWidth="260"/>
                </WrapPanel>
                <!-- v0.9.6.0: the ranges being searched, how far the search is, and Cancel. -->
                <StackPanel Spacing="4" IsVisible="{Binding HasDiscoveryRanges}">
                  <ProgressBar Minimum="0" Maximum="100" Value="{Binding DiscoveryProgressValue}" Height="4" IsVisible="{Binding IsDiscovering}"/>
                  <WrapPanel>
                    <TextBlock Text="{services:Tr ui.searching_ranges}" Classes="muted" FontSize="11" Margin="0,0,6,0"/>
                    <TextBlock Text="{services:TrText DiscoveryRangesText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                  </WrapPanel>
                  <WrapPanel IsVisible="{Binding HasDiscoverySkipped}">
                    <TextBlock Text="{services:Tr ui.not_searched_virtual}" Classes="muted" FontSize="11" Margin="0,0,6,0"/>
                    <TextBlock Text="{services:TrText DiscoverySkippedText}" Classes="muted" FontSize="11" TextWrapping="Wrap"/>
                  </WrapPanel>
                  <WrapPanel IsVisible="{Binding HasDiscoveryProblems}">
                    <TextBlock Text="{services:Tr ui.could_not_read_ranges}" Foreground="{DynamicResource AmberBrush}" FontSize="11" Margin="0,0,6,0"/>
                    <TextBlock Text="{services:TrText DiscoveryProblemsText}" Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
                  </WrapPanel>
                </StackPanel>
                <ComboBox AutomationProperties.Name="{services:Tr ui.service_url}" ItemsSource="{Binding DiscoveredServices}" SelectedItem="{Binding SelectedDiscoveredService}" MinWidth="400">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="services:DiscoveredMystTiqService">
                      <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                  <TextBlock Text="{services:Tr ui.name}" VerticalAlignment="Center"/>
                  <TextBox AutomationProperties.Name="{services:Tr ui.name}" Grid.Column="1" Text="{Binding ProfileName}"/>
                  <TextBlock Grid.Row="1" Text="{services:Tr ui.service_url}" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ServerUrl}" PlaceholderText="{services:Tr ui.https_192_168_1_248_8213}"/>
                  <TextBlock Grid.Row="2" Text="{services:Tr ui.bearer_token}" VerticalAlignment="Center"/>
                  <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                    <TextBox Text="{Binding BearerToken}" PasswordChar="●" RevealPassword="{Binding ShowBearerToken}" PlaceholderText="{services:Tr ui.saved_encrypted_after_connecting}"/>
                    <ToggleButton Grid.Column="1" IsChecked="{Binding ShowBearerToken}" Content="{Binding ShowBearerToken, Converter={x:Static converters:BoolToEyeGlyphConverter.Instance}}" ToolTip.Tip="{services:Tr ui.show_hide_the_bearer_token}" Padding="8,4"/>
                    <Button Classes="danger" Grid.Column="2" Content="{services:Tr ui.forget}" Command="{Binding ForgetSavedTokenCommand}" ToolTip.Tip="{services:Tr ui.remove_the_saved_encrypted_token_for_this_profil_f473c2}" Padding="8,4"/>
                  </Grid>
                  <TextBlock Grid.Row="3" Text="{services:Tr ui.tls_sha_256_pin}" VerticalAlignment="Center"/>
                  <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CertificateSha256}" PlaceholderText="{services:Tr ui.optional_64_hex_certificate_fingerprint}"/>
                </Grid>
              </StackPanel>

              <!-- v0.7.81.0: "← Back" removed, since there's no earlier step to return to now that
                   step 0 is gone; this cancels the wizard (closes the tab) instead. -->
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Classes="plain" Content="{services:Tr ui.cancel}" Command="{Binding CloseActiveTabCommand}" ToolTip.Tip="{services:Tr ui.closes_this_tab_disabled_if_it_s_the_only_open_t_99ad6f}"/>
                <Button Grid.Column="1" Classes="apply" Content="{services:Tr ui.connect_1a2303}" Command="{Binding ConnectCommand}"/>
                <Button Grid.Column="2" Classes="plain" Content="{services:TrText WizardStep1NextButtonLabel}" HorizontalAlignment="Right" Command="{Binding WizardAdvanceCommand}" IsEnabled="{Binding ManagementApiConnected}" ToolTip.Tip="{services:Tr ui.connect_first_then_continue}"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- v0.7.82.0: World Source choice, install-wizard only. Cards reordered to New World /
               Import / Clone to match direct feedback's own stated order. -->
          <StackPanel IsVisible="{Binding IsWizardStepWorldSource}" Spacing="18">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="{services:Tr ui.step_2_of_8_world_source}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="{services:Tr ui.how_should_this_new_server_s_world_start_out}" Classes="muted" HorizontalAlignment="Center"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="16">
              <Button Classes="ghost" Padding="0" Command="{Binding ChooseNewWorldSourceCommand}">
                <Border Classes="card accentHome" Padding="20">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="🌱" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="{services:Tr ui.set_up_a_new_world}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="{services:Tr ui.installs_the_palworld_dedicated_server_fresh_and_b5ca96}" Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Button>
              <Button Grid.Column="1" Classes="ghost" Padding="0" Command="{Binding ChooseImportWorldSourceCommand}">
                <Border Classes="card accentWorld" Padding="20">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="📦" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="{services:Tr ui.import_a_world}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="{services:Tr ui.installs_fresh_then_brings_in_a_world_archive_fr_7dfa5f}" Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Button>
              <Button Grid.Column="2" Classes="ghost" Padding="0" Command="{Binding ChooseCloneWorldSourceCommand}">
                <Border Classes="card accentMods" Padding="20">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="🧬" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="{services:Tr ui.clone_an_existing_server}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="{services:Tr ui.copies_an_already_configured_server_s_binaries_w_224551}" Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Button>
            </Grid>
          </StackPanel>

          <!-- v0.7.82.0: Clone source picker, unchanged content from the old combined step 3, just
               its own gate/label changed (no longer paired with Install in the same step). -->
          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStepCloneSource}">
            <StackPanel Spacing="12">
              <TextBlock Text="{services:Tr ui.step_3_of_8_clone_an_existing_server}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock Text="{services:Tr ui.pick_a_server_you_ve_already_set_up_to_copy_from_da5f25}" Classes="muted" TextWrapping="Wrap"/>
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="10" ColumnSpacing="12">
                <TextBlock Text="{services:Tr ui.clone_from}" VerticalAlignment="Center"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.clone_from}" Grid.Column="1" ItemsSource="{Binding CloneableSourceProfiles}" SelectedItem="{Binding NewServerCloneSourceProfile}">
                  <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:ConnectionProfile">
                      <TextBlock Text="{Binding Name}"/>
                    </DataTemplate>
                  </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Grid.Row="1" Text="{services:Tr ui.new_server_id}" VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding NewServerCloneTargetId}" PlaceholderText="{services:Tr ui.e_g_world_2}"/>
                <TextBlock Grid.Row="2" Text="{services:Tr ui.port_offset}" VerticalAlignment="Center"/>
                <ComboBox AutomationProperties.Name="{services:Tr ui.port_offset}" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding CloneWorldPortOffsetOptions}" SelectedItem="{Binding CloneWorldPortOffset}" HorizontalAlignment="Left" MinWidth="140"/>
              </Grid>
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Classes="plain" Content="{services:Tr ui.back}" Command="{Binding WizardBackCommand}"/>
                <Button Grid.Column="1" Classes="apply" Content="{services:Tr ui.clone_now}" Command="{Binding CloneIntoNewServerCommand}"/>
              </Grid>
              <TextBlock Text="{services:TrText NewServerCloneStatusText}" Classes="muted" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>

          <!-- v0.7.82.0: Identity & Ports, moved out of the old combined Settings step so it's
               collected right after World Source instead of after Install. The values are only
               staged here (Setup* fields); FinishInstallAndAdvanceCommand actually applies them
               (CreateDefaultServerSettingsAsync) once Install (step 6) has produced a real
               PalWorldSettings.ini to write into; that constraint is genuine, not arbitrary
               sequencing, see PalworldSettingsConfigurationService.CreateDefault. -->
          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStepIdentityPorts}">
            <StackPanel Spacing="10">
              <StackPanel>
                <TextBlock Text="{services:Tr ui.step_3_of_8_server_identity_and_ports}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>
                <TextBlock Text="{services:Tr ui.these_values_are_applied_automatically_right_aft_6e158c}" Classes="muted" TextWrapping="Wrap"/>
              </StackPanel>
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                <StackPanel><TextBlock Text="{services:Tr ui.server_name}" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox AutomationProperties.Name="{services:Tr ui.server_name}" Text="{Binding SetupServerName, Mode=TwoWay}" MaxLength="128"/><Button Classes="info" Grid.Column="1" Content="🎲" Command="{Binding GenerateSetupServerNameCommand}" ToolTip.Tip="{services:Tr ui.generate_a_random_server_name}" AutomationProperties.Name="{services:Tr ui.generate_a_random_server_name}" Padding="10,7"/></Grid></StackPanel>
                <StackPanel Grid.Column="1"><TextBlock Text="{services:Tr ui.description}" Classes="muted"/><TextBox AutomationProperties.Name="{services:Tr ui.description}" Text="{Binding SetupServerDescription, Mode=TwoWay}" MaxLength="512"/></StackPanel>
                <StackPanel Grid.Row="1"><TextBlock Text="{services:Tr ui.admin_password}" Classes="muted"/><TextBox Text="{Binding SetupAdminPassword, Mode=TwoWay}" PasswordChar="●" PlaceholderText="{services:Tr ui.optional_sent_only_to_the_authenticated_headless_407242}"/></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="{services:Tr ui.server_password_optional}" Classes="muted"/><TextBox AutomationProperties.Name="{services:Tr ui.server_password_optional}" Text="{Binding SetupServerPassword, Mode=TwoWay}" PasswordChar="●"/></StackPanel>
                <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
                  <StackPanel><TextBlock Text="{services:Tr ui.players}" Classes="muted"/><TextBox AutomationProperties.Name="{services:Tr ui.players}" Text="{Binding SetupMaximumPlayers, Mode=TwoWay}" Width="72"/></StackPanel>
                  <!-- v0.7.88.0: direct live feedback. Game Port should draw attention and explain
                       when it needs to change, since the default is correct for the common
                       single-server case and only needs changing to avoid colliding with another
                       server already running on the same machine. -->
                  <Border Classes="statuscard accentSystem" Padding="8" BorderBrush="{DynamicResource AmberAccentBorderBrush}" BorderThickness="2">
                    <StackPanel><TextBlock Text="{services:Tr ui.game_port}" Classes="muted"/><TextBox AutomationProperties.Name="{services:Tr ui.game_port}" Text="{Binding SetupGamePort, Mode=TwoWay}" Width="82"/></StackPanel>
                  </Border>
                  <StackPanel><TextBlock Text="{services:Tr ui.rest_port}" Classes="muted"/><TextBox AutomationProperties.Name="{services:Tr ui.rest_port}" Text="{Binding SetupRestPort, Mode=TwoWay}" Width="82"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.ColumnSpan="2" Spacing="2">
                  <TextBlock Text="{services:Tr ui.only_change_game_port_if_you_re_running_multiple_bda89a}" Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
                  <TextBlock Text="{services:TrText SetupGamePortWarningText}" IsVisible="{Binding HasSetupGamePortWarning}" Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
                  <TextBlock Text="{services:TrText SetupRestPortWarningText}" IsVisible="{Binding HasSetupRestPortWarning}" Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Classes="plain" Content="{services:Tr ui.back}" Command="{Binding WizardBackCommand}"/>
                <Button Grid.Column="2" Classes="plain" Content="{services:Tr ui.next_world_settings}" HorizontalAlignment="Right" Command="{Binding WizardAdvanceCommand}"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- v0.7.82.0: World Settings choice. A preset applies automatically right after Install;
               "Customize" can't show real slider values before a real PalWorldSettings.ini exists, so
               it defers to the existing, fully-live Configuration page after Finish instead of faking
               pre-install values (see NewServerWorldSettingsChoice's own comment). -->
          <StackPanel IsVisible="{Binding IsWizardStepWorldSettingsChoice}" Spacing="18">
            <StackPanel Spacing="4" HorizontalAlignment="Center">
              <TextBlock Text="{services:Tr ui.step_4_of_8_world_settings}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}" HorizontalAlignment="Center"/>
              <TextBlock Text="{services:Tr ui.apply_a_starter_preset_automatically_after_insta_e29892}" Classes="muted" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
              <Button Classes="ghost" Padding="0" Command="{Binding ChooseWorldSettingsPresetCommand}">
                <Border Classes="card accentBackups" Padding="20">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="⚙️" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="{services:Tr ui.use_a_starter_preset}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="{services:Tr ui.pick_a_preset_vanilla_quality_of_life_etc_below_f85906}" Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Button>
              <Button Grid.Column="1" Classes="ghost" Padding="0" Command="{Binding ChooseWorldSettingsCustomizeCommand}">
                <Border Classes="card accentWorld" Padding="20">
                  <StackPanel Spacing="8" HorizontalAlignment="Center">
                    <TextBlock Text="🎛️" FontSize="28" HorizontalAlignment="Center"/>
                    <TextBlock Text="{services:Tr ui.customize_after_install}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="{services:Tr ui.finish_setup_with_defaults_then_fine_tune_every_381464}" Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"/>
                  </StackPanel>
                </Border>
              </Button>
            </Grid>
            <StackPanel IsVisible="{Binding IsWorldSettingsChoicePreset}" Spacing="6" HorizontalAlignment="Center">
              <TextBlock Text="{services:Tr ui.starter_preset}" Classes="muted" FontSize="11" HorizontalAlignment="Center"/>
              <ComboBox AutomationProperties.Name="{services:Tr ui.starter_preset}" ItemsSource="{Binding PalworldConfigPresets}" SelectedItem="{Binding SelectedConfigPreset}" MinWidth="240"/>
            </StackPanel>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
              <Button Classes="plain" Content="{services:Tr ui.back}" Command="{Binding WizardBackCommand}"/>
            </Grid>
          </StackPanel>

          <!-- v0.7.82.0: Install Directory. See ContinueFromInstallDirectoryAsync's own comment for
               the full registration/restart/reconnect story. It always registers a new, genuinely
               distinct server profile now, since the "typical" default location is permanently owned
               by the always-present "Local MystTiq" profile (confirmed live: reusing it collided with
               BuildProfileFromEditor's own duplicate-connection guard). Only the target directory
               varies by occupancy, not whether registration happens. -->
          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStepInstallDirectory}">
            <StackPanel Spacing="12">
              <TextBlock Text="{services:Tr ui.step_5_of_8_install_directory}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock Text="{services:TrText NewServerInstallDirectoryStatusText}" Classes="muted" TextWrapping="Wrap"/>
              <!-- v0.7.88.0 bug fix: reported live. This step previously showed no field at all to
                   see or change the target directory, just the warning box below. -->
              <StackPanel Spacing="3">
                <TextBlock Text="{services:Tr ui.target_directory}" Classes="muted" FontSize="11"/>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                  <TextBox AutomationProperties.Name="{services:Tr ui.target_directory}" Text="{Binding NewServerInstallDirectoryEffectivePath, Mode=TwoWay}" FontFamily="Consolas, monospace"/>
                  <Button Classes="open" Grid.Column="1" Content="{services:Tr ui.browse}" Tag="installDirectory" Click="WorkspaceBrowse_Click"/>
                </Grid>
              </StackPanel>
              <Border Classes="statuscard accentSystem" BorderBrush="{DynamicResource AmberAccentBorderBrush}" BorderThickness="1">
                <TextBlock Text="{services:Tr ui.continuing_registers_this_as_a_new_server_profil_323daf}" Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
              </Border>
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Classes="plain" Content="{services:Tr ui.back}" Command="{Binding WizardBackCommand}"/>
                <Button Grid.Column="1" Classes="plain" Content="{services:Tr ui.continue}" Command="{Binding ContinueFromInstallDirectoryCommand}"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- v0.7.82.0: Download &amp; Install, moved from the old combined step 3. Content is
               unchanged, only its own gate/label/step-count and final button changed (now finishes
               into the auto-apply step instead of the old Settings step). -->
          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStepInstall}">
            <StackPanel Spacing="12">
              <TextBlock Text="{services:Tr ui.step_6_of_8_install_palworld_dedicated_server}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock Text="{services:Tr ui.downloads_and_installs_the_palworld_dedicated_se_6cbeec}" Classes="muted" TextWrapping="Wrap"/>
              <!-- v0.7.85.0: real inline world import, not a placeholder anymore. PalServer.exe
                   generates its own real initial world within a few minutes of its first start
                   (confirmed live), so this starts the server once, stops it, then embeds the
                   already-existing World Transactions "world-import" Analyze/Apply flow to replace
                   that placeholder world, the same bindings the World Transactions page itself uses. -->
              <StackPanel IsVisible="{Binding IsWorldSourceImport}" Spacing="10">
                <Border Classes="statuscard accentWorld">
                  <StackPanel Spacing="8">
                    <TextBlock Text="{services:Tr ui.import_your_world}" FontWeight="SemiBold"/>
                    <TextBlock Text="{services:TrText NewServerImportPrepareStatusText}" Classes="muted" TextWrapping="Wrap"/>
                    <Button Classes="apply" Content="{services:Tr ui.prepare_for_import}" Command="{Binding PrepareForWorldImportCommand}" HorizontalAlignment="Left" IsVisible="{Binding !NewServerImportReady}"/>
                    <StackPanel IsVisible="{Binding NewServerImportReady}" Spacing="8">
                      <Grid ColumnDefinitions="190,Auto,*" ColumnSpacing="10">
                        <ComboBox AutomationProperties.Name="{services:Tr ui.import_your_world}" ItemsSource="{Binding WorldTransactionModes}" SelectedItem="{Binding WorldTransactionMode}"/>
                        <Button Classes="verify" Grid.Column="1" Content="{services:Tr ui.analyze_zip_archive}" Click="AnalyzeWorldArchive_Click" IsEnabled="{Binding CanManageAdmin}"/>
                        <TextBlock Grid.Column="2" Text="{services:TrText WorldTransactionState}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/>
                      </Grid>
                      <Border Classes="statuscard accentWorld"><StackPanel Spacing="6"><TextBlock Text="{services:Tr ui.transaction_plan}" FontWeight="SemiBold"/><ItemsControl ItemsSource="{Binding WorldTransactionPlanSteps}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                      <CheckBox Content="{services:Tr ui.i_reviewed_this_plan_and_confirm_the_server_is_s_fe3a69}" IsChecked="{Binding WorldTransactionConfirmed}"/>
                      <Button Classes="danger" Content="{services:Tr ui.apply_with_fresh_safety_backup}" HorizontalAlignment="Left" Command="{Binding ApplyWorldTransactionCommand}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
              <!-- v0.7.89.0 bug fix: reported live. The checklist below used to keep showing the
                   pre-install "MISSING" row after a successful install, requiring a manual Refresh
                   click. Now wired to a command that auto-refreshes the checklist right after
                   install completes; direct live feedback also asked for more visibility into what
                   the install is actually doing, so SteamCMD's own captured output tail is now shown
                   here too, not just a flat state word. -->
              <!-- v0.7.90.0: direct live feedback. "option to install just the server without
                   mods and then the option of installing it with the extras." The second button
                   chains in UE4SS (the only checklist item that both has a real install path today
                   and isn't behind "BACKEND REQUIRED"), auto-picking the newest stable Palworld Fork
                   release instead of the UE4SS page's own manual Preview/Confirm picker: an explicit
                   tradeoff of that review step for one-click convenience, only taken when this
                   button is deliberately chosen over the plain install. -->
              <WrapPanel>
                <Button Classes="apply" Content="{services:Tr ui.install_palworld_dedicated_server}" Command="{Binding InstallPalworldServerFromWizardCommand}" Margin="0,0,6,6"/>
                <Button Classes="apply" Content="{services:Tr ui.install_with_extras_ue4ss}" Command="{Binding InstallPalworldServerWithExtrasCommand}" Margin="0,0,6,6" ToolTip.Tip="{services:Tr ui.installs_the_server_then_automatically_installs_16f815}"/>
                <TextBlock Text="{services:TrText DistributionState}" VerticalAlignment="Center" Classes="muted"/>
              </WrapPanel>
              <TextBlock Text="{services:TrText DistributionDetail}" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="{services:TrText Ue4ssInstallState}" Classes="muted" TextWrapping="Wrap"/>
              <TextBox AutomationProperties.Name="{services:Tr ui.last_steamcmd_output}" Text="{Binding DistributionOutputText}" IsVisible="{Binding HasDistributionOutput}" AcceptsReturn="True" IsReadOnly="True" MaxHeight="140" FontFamily="Consolas, monospace" FontSize="11"/>

              <!-- v0.7.81.0: read-only environment checklist, direct follow-up request ("it should
                   start a new server installation, like folder paths, steamcmd server, dependencies,
                   UE4SS, etc."). Reuses EnvironmentItems/RefreshEnvironmentCommand unchanged (the
                   exact same data the Server Setup page's own checklist shows), auto-loaded on
                   arrival here (ContinueFromInstallDirectoryAsync). Deliberately read-only here, no
                   per-row Verify/Manage buttons, since several of those navigate to other pages
                   (Configuration/UE4SS/Update Center), which the wizard's full-screen overlay hides
                   while IsCreatingNewProfile is true; those actions stay reachable from the real
                   Server Setup page after finishing setup. -->
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{services:Tr ui.server_environment}" FontSize="13" FontWeight="Bold"/>
                <Button Classes="info" Grid.Column="1" Content="{services:Tr ui.refresh_9cbbfc}" Command="{Binding RefreshEnvironmentCommand}" Padding="8,3" FontSize="11"/>
              </Grid>
              <Border Classes="card accentServer" Padding="0" ClipToBounds="True" MaxHeight="260">
                <Grid RowDefinitions="Auto,*">
                  <Grid Background="{DynamicResource Bg2Brush}" ColumnDefinitions="150,95,2*,2.35*" Height="32">
                    <TextBlock Text="{services:Tr ui.component}" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Grid.Column="1" Text="{services:Tr ui.status}" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Grid.Column="2" Text="{services:Tr ui.location}" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                    <TextBlock Grid.Column="3" Text="{services:Tr ui.details}" Margin="10,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="11"/>
                  </Grid>
                  <ScrollViewer Grid.Row="1" MaxHeight="228" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding EnvironmentItems}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:EnvironmentChecklistItemDto">
                          <Border BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1" Padding="2">
                            <Grid ColumnDefinitions="150,95,2*,2.35*" MinHeight="34">
                              <TextBlock Text="{services:TrText Component}" Margin="10,0" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"/>
                              <Grid Grid.Column="1" Margin="8,4">
                                <Border Classes="tag" services:StatusTag.Status="{Binding Status}"><TextBlock Text="{services:TrText Status}"/></Border>
                              </Grid>
                              <TextBlock Grid.Column="2" Text="{services:TrText Location}" Margin="10,0" VerticalAlignment="Center" FontSize="10" TextTrimming="CharacterEllipsis" ToolTip.Tip="{services:TrText Location}"/>
                              <TextBlock Grid.Column="3" Text="{services:TrText Details}" Margin="10,0" VerticalAlignment="Center" FontSize="10" TextWrapping="Wrap" MaxHeight="30"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </Grid>
              </Border>

              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Classes="plain" Content="{services:Tr ui.back}" Command="{Binding WizardBackCommand}"/>
                <Button Grid.Column="2" Classes="plain" Content="{services:Tr ui.next_mods}" HorizontalAlignment="Right" Command="{Binding FinishInstallAndAdvanceCommand}" ToolTip.Tip="{services:Tr ui.installing_is_optional_here_if_the_files_already_c8f704}"/>
              </Grid>
            </StackPanel>
          </Border>

          <!-- v0.7.86.0: MODs step, install-wizard only, New World/Import only. Reuses the exact same
               Workshop-scan machinery already built for the MOD Library page
               (ScanWorkshopModsCommand/WorkshopItems/ImportSelectedWorkshopModCommand), verbatim.
               Both already correctly resolved the in-progress wizard connection, so no fix was needed
               here (unlike a couple of other reused commands found this session). Entirely optional:
               Next advances whether or not anything was imported. -->
          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStepMods}">
            <StackPanel Spacing="12">
              <TextBlock Text="{services:Tr ui.step_7_of_8_mods}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource BlueBrush}"/>
              <TextBlock Text="{services:Tr ui.optional_scans_locally_installed_steam_workshop_165414}" Classes="muted" TextWrapping="Wrap"/>
              <WrapPanel>
                <Button Classes="verify" Content="{services:Tr ui.scan_workshop_mods}" Command="{Binding ScanWorkshopModsCommand}" Margin="0,0,6,6"/>
                <Button Classes="apply" Content="{services:Tr ui.import_selected}" Command="{Binding ImportSelectedWorkshopModCommand}" Margin="0,0,6,6"/>
                <!-- v0.7.89.0: direct live feedback. A distinctly-colored button (green, matching
                     the other install-type actions in this wizard) for installing a MOD from a local
                     ZIP file directly, separate from the Workshop scan/import flow above. Reuses
                     InstallModZip_Click verbatim, the exact same picker plus InstallModZipAsync path
                     the MOD Library page's own "Choose ZIP and Install" button already uses. ZIP
                     only, same as MOD Library: a bare .pak file has no install path anywhere in this
                     app today and would need its own separate backend capability, not just wiring up
                     a button. -->
                <Button Classes="apply" Content="{services:Tr ui.install_mod_zip}" Click="InstallModZip_Click" IsEnabled="{Binding CanManageAdmin}" Margin="0,0,6,6"/>
              </WrapPanel>
              <TextBlock Text="{services:TrText WorkshopScanState}" Foreground="{DynamicResource VioletBrush}" TextWrapping="Wrap"/>
              <ListBox AutomationProperties.Name="{services:Tr ui.available_local_steam_workshop_mods}" ItemsSource="{Binding WorkshopItems}" SelectedItem="{Binding SelectedWorkshopItem}" MaxHeight="300">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:WorkshopItemDto">
                    <Grid ColumnDefinitions="2*,*,Auto" ColumnSpacing="8" Margin="0,6">
                      <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding WorkshopId}" FontSize="10" Foreground="{DynamicResource MutedBrush}" FontFamily="Consolas, monospace"/></StackPanel>
                      <TextBlock Grid.Column="1" Text="{services:TrText SuggestedPackage}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap"/>
                      <Border Classes="tag" Grid.Column="2" services:StatusTag.Status="{Binding StatusText}"><TextBlock Text="{services:TrText StatusText}"/></Border>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">
                <Button Classes="plain" Content="{services:Tr ui.back}" Command="{Binding WizardBackCommand}"/>
                <Button Grid.Column="2" Classes="plain" Content="{services:Tr ui.next_confirm_and_finish}" HorizontalAlignment="Right" Command="{Binding WizardAdvanceCommand}"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStepSettings}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
              <StackPanel Spacing="10">
                <StackPanel>
                  <TextBlock Text="{services:TrText WizardStepSettingsLabel}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/>
                  <TextBlock Text="{services:Tr ui.once_connected_create_palworldsettings_ini_from_2cef4e}" Classes="muted" TextWrapping="Wrap"/>
                </StackPanel>
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                  <StackPanel><TextBlock Text="{services:Tr ui.server_name}" Classes="muted"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="6"><TextBox AutomationProperties.Name="{services:Tr ui.server_name}" Text="{Binding SetupServerName, Mode=TwoWay}" MaxLength="128"/><Button Classes="info" Grid.Column="1" Content="🎲" Command="{Binding GenerateSetupServerNameCommand}" ToolTip.Tip="{services:Tr ui.generate_a_random_server_name}" AutomationProperties.Name="{services:Tr ui.generate_a_random_server_name}" Padding="10,7"/></Grid></StackPanel>
                  <StackPanel Grid.Column="1"><TextBlock Text="{services:Tr ui.description}" Classes="muted"/><TextBox AutomationProperties.Name="{services:Tr ui.description}" Text="{Binding SetupServerDescription, Mode=TwoWay}" MaxLength="512"/></StackPanel>
                  <StackPanel Grid.Row="1"><TextBlock Text="{services:Tr ui.admin_password}" Classes="muted"/><TextBox Text="{Binding SetupAdminPassword, Mode=TwoWay}" PasswordChar="●" PlaceholderText="{services:Tr ui.optional_sent_only_to_the_authenticated_headless_407242}"/></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1"><TextBlock Text="{services:Tr ui.server_password_optional}" Classes="muted"/><TextBox AutomationProperties.Name="{services:Tr ui.server_password_optional}" Text="{Binding SetupServerPassword, Mode=TwoWay}" PasswordChar="●"/></StackPanel>
                  <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="12">
                    <StackPanel><TextBlock Text="{services:Tr ui.players}" Classes="muted"/><TextBox AutomationProperties.Name="{services:Tr ui.players}" Text="{Binding SetupMaximumPlayers, Mode=TwoWay}" Width="72"/></StackPanel>
                    <StackPanel><TextBlock Text="{services:Tr ui.game_port}" Classes="muted"/><TextBox AutomationProperties.Name="{services:Tr ui.game_port}" Text="{Binding SetupGamePort, Mode=TwoWay}" Width="82"/></StackPanel>
                    <StackPanel><TextBlock Text="{services:Tr ui.rest_port}" Classes="muted"/><TextBox AutomationProperties.Name="{services:Tr ui.rest_port}" Text="{Binding SetupRestPort, Mode=TwoWay}" Width="82"/></StackPanel>
                  </StackPanel>
                  <!-- v0.7.64.0: moved to its own full-width row; crammed into the Players/Game
                       Port/REST Port row above, its label routinely clipped ("I confirm creation
                       o..."). -->
                  <CheckBox Grid.Row="3" Grid.ColumnSpan="2" Content="{services:Tr ui.i_confirm_creation_of_a_new_settings_file}" IsChecked="{Binding SetupCreateConfirmed, Mode=TwoWay}"/>
                  <StackPanel Grid.Row="4" Grid.ColumnSpan="2" Spacing="2">
                    <TextBlock Text="{services:TrText SetupGamePortWarningText}" IsVisible="{Binding HasSetupGamePortWarning}" Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
                    <TextBlock Text="{services:TrText SetupRestPortWarningText}" IsVisible="{Binding HasSetupRestPortWarning}" Foreground="{DynamicResource AmberBrush}" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
                  <!-- v0.7.81.0: starter preset picker, direct request ("choose one of the preset
                       settings like vanilla or quality of life"). Reuses the exact same preset list
                       (PalworldConfigPresets/SelectedConfigPreset, Official/Balanced/Relaxed/custom)
                       already built for the Configuration page, chained through Load -> Apply -> Save
                       in one action (ApplyStarterPresetCommand). Only meaningful after Create Default
                       Settings has created the file this loads/overwrites. -->
                  <StackPanel Grid.Row="5" Grid.ColumnSpan="2" Spacing="4">
                    <TextBlock Text="{services:Tr ui.starter_preset_optional_applied_after_create_def_b56a5c}" Classes="muted" FontSize="11"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <ComboBox AutomationProperties.Name="{services:Tr ui.starter_preset_optional_applied_after_create_def_b56a5c}" ItemsSource="{Binding PalworldConfigPresets}" SelectedItem="{Binding SelectedConfigPreset}"/>
                      <Button Classes="apply" Grid.Column="1" Content="{services:Tr ui.apply_preset}" Command="{Binding ApplyStarterPresetCommand}"/>
                    </Grid>
                  </StackPanel>
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                <Button Classes="apply" Content="{services:Tr ui.create_default_settings}" FontWeight="Bold" Command="{Binding CreateDefaultServerSettingsCommand}" Padding="18,12" ToolTip.Tip="{services:Tr ui.requires_confirmation_the_headless_service_valid_dec086}"/>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                  <Button Classes="plain" Content="{services:Tr ui.back}" Command="{Binding WizardBackCommand}"/>
                  <Button Grid.Column="1" Classes="plain" Content="{services:Tr ui.next}" Command="{Binding WizardAdvanceCommand}" ToolTip.Tip="{services:Tr ui.creating_default_settings_here_is_optional_skip_9caa28}"/>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <!-- v0.7.3.0 wizard's confirm/finish step, additive only. Save Profile/Delete Profile
               remain exactly where they always were in the editing card for editing an existing
               profile; this is just a second, wizard-scoped path to the same SaveProfileCommand for
               a brand-new profile's natural "last step." -->
          <Border Classes="card accentSystem" IsVisible="{Binding IsWizardStepConfirm}">
            <StackPanel Spacing="10">
              <TextBlock Text="{services:TrText WizardStepConfirmLabel}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BlueBrush}"/>
              <Border Classes="statuscard accentSystem">
                <StackPanel Spacing="4">
                  <TextBlock Text="{Binding ProfileName, StringFormat='Server: {0}'}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding ServerUrl, StringFormat='Address: {0}'}" Classes="muted"/>
                  <TextBlock Text="{Binding ConnectionState, StringFormat='Connection: {0}'}" Classes="muted"/>
                </StackPanel>
              </Border>
              <TextBlock Text="{services:Tr ui.save_this_profile_to_add_it_to_your_server_list_590482}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !IsNewServerSetupFlow}"/>
              <!-- v0.7.82.0: install wizard's own Confirm messaging. Identity &amp; Ports and any
                   chosen preset were already applied automatically by FinishInstallAndAdvanceCommand
                   (Clone needs none of this, it already has both). "Customize" points to the
                   Configuration page rather than embedding a duplicate live settings editor here. -->
              <StackPanel IsVisible="{Binding IsNewServerSetupFlow}" Spacing="4">
                <TextBlock Text="{services:Tr ui.server_identity_description_and_ports_were_appli_485f06}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !IsWorldSourceClone}"/>
                <TextBlock Text="{services:TrText SetupOperationDetail}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding !IsWorldSourceClone}"/>
                <TextBlock Text="{services:Tr ui.your_chosen_starter_preset_was_applied_automatic_2bc476}" Classes="muted" TextWrapping="Wrap" IsVisible="{Binding IsWorldSettingsChoicePreset}"/>
                <TextBlock Text="{services:Tr ui.customize_world_settings_any_time_from_server_co_1fa64e}" Foreground="{DynamicResource AmberBrush}" TextWrapping="Wrap" IsVisible="{Binding IsWorldSettingsChoiceCustomize}"/>
                <TextBlock Text="{services:Tr ui.save_this_profile_to_add_it_to_your_server_list}" Classes="muted" TextWrapping="Wrap"/>
                <!-- v0.9.6.0: the new server's game port through the firewall, before players try to join. -->
                <Border Classes="statuscard accentSystem" IsVisible="{Binding HasFirewallStatus}">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{services:TrText FirewallStatusText}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    <Button Classes="apply" Grid.Column="1" Content="{services:Tr ui.allow_through_firewall}" AutomationProperties.Name="{services:Tr ui.allow_through_firewall}" Command="{Binding RepairFirewallCommand}" IsVisible="{Binding FirewallNeedsAction}"/>
                  </Grid>
                </Border>
              </StackPanel>
              <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="10">
                <Button Classes="plain" Content="{services:Tr ui.back}" Command="{Binding WizardBackCommand}"/>
                <Button Grid.Column="1" Classes="apply" Content="{services:Tr ui.save_profile}" FontWeight="Bold" Command="{Binding SaveProfileCommand}"/>
              </Grid>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- v0.7.43.0: findings-completeness fix (item 6). Elapsed time next to the busy reason,
         updated live while IsBusy (MainWindowViewModel.BusyElapsedText/_busyElapsedTimer). The
         reason text itself (StatusBarText) already includes which server the operation belongs to
         when known, set alongside BusyReason in RaiseIsBusyDependents. Real sub-step/percent
         progress stays a disclosed gap, not attempted here (see the property's own comment). -->
    <!-- v0.7.74.0: top border now follows ActiveTab.AccentBrush too, matching the title-bar strip,
         page-header border, and nav pane border; a consistent identity color framing the window
         on every edge, not just the top. -->
    <Border Grid.Row="4" Background="{DynamicResource StatusSurfaceGradient}" BorderBrush="{Binding ActiveTabAccentBrush}" BorderThickness="0,1,0,0" Padding="14,7">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="12">
        <ProgressBar Width="84" Height="5" IsIndeterminate="True" IsVisible="{Binding IsBusy}" VerticalAlignment="Center"/>
        <TextBlock Grid.Column="1" Text="{services:TrText StatusBarText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" Text="{services:TrText BusyElapsedText}" Classes="muted" VerticalAlignment="Center" IsVisible="{Binding IsBusy}" ToolTip.Tip="{services:Tr ui.elapsed_time_since_this_operation_started}"/>
        <TextBlock Grid.Column="3" Text="{services:TrText StatusBarObservedText}" Classes="muted" VerticalAlignment="Center"/>
      </Grid>
    </Border>
  </Grid>
</Window>
