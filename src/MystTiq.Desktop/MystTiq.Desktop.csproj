<!-- MystTiq v1.0.4.0: file reviewed for this release (2026-10-05). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>Assets/PalworldServerManager.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- v0.9.7.0: Avalonia 12, pinned to one exact version for all four packages and Avalonia.Headless in the two
         harnesses; they move together (Dependabot groups them). Earlier: the 11.3 servicing line (11.3.*). -->
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <!-- v0.7.71.0: CredentialStore's Windows DPAPI-backed bearer token persistence. The API throws
         PlatformNotSupportedException at runtime on non-Windows; CredentialStore itself guards
         every call with OperatingSystem.IsWindows(), so this is safe to reference unconditionally
         on the DesktopLinux build too (it just never calls in, matching that build's existing
         no-persistence behavior). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.*" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MystTiq.Core\MystTiq.Core.csproj" />
  </ItemGroup>
</Project>
